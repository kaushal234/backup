{% extends 'sales/equipment_shipping_records/layout.html.twig' %}
{% trans_default_domain 'equipment_shipping_record' %}
{% form_theme form 'form_theme_vertical.html.twig' %}

{% block content %}
    <div class="row">
        <div class="col-md-8">
            {{ form_start(form) }}
            {{ form_errors(form) }}
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    {{ 'planning_daily_limit.edit.title'|trans|capitalize }}
                </div>
                <div class="ibox-content">
                    <div class="row">
                        <div class="col-md-3">
                            {{ form_row(form.factory) }}
                        </div>
                        <div class="col-md-3">
                            {{ form_row(form.days) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_row(form.comment) }}
                        </div>
                        <div class="col-md-2 btn-height" style="padding-top: 34px; display: flex; justify-content: end">
                            {{ form_row(form.submit) }}
                        </div>
                    </div>
                </div>
            </div>
            {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}