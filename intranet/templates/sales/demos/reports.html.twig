{% extends 'sales/demos/layout.html.twig' %}
{% trans_default_domain 'demo' %}

{% block title %}{{ parent() }}{% endblock %}


{% block content %}
    <div class="row">
        <div>
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'demo.report.opened_demos_sso_by_factory' | trans }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {{ include('helper/_matrix_table.html.twig', {
                        data: demoBySSOFactory,
                        removeXTotalsParam: true,
                        removeYTotalsParam: true,
                        link: {
                            route: 'demo_home',
                            xParam: 'sso',
                            yParam: 'factory',
                        },
                    }, with_context=false) }}
                </div>
            </div>
        </div>
    </div><div class="row">
        <div>
