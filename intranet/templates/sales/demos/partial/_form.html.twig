{% block content %}
    {% form_theme form 'form_theme_horizontal.html.twig' %}

    {{ form_start(form, { action: action }) }}
    {{ form_errors(form) }}
    <div class="row">
        <div class="col-md-8 animated">
            <div class="mail-box-header clearfix">
                <h2 class="float-sart">
                    {{ 'demo.main_info' | trans({}, 'demo') }}
                </h2>
            </div>
            <div class="mail-box">
                <div class="mail-body">
                    {{ form_row(form.customer) }}
                    {{ form_row(form.asm) }}
                    {{ form_row(form.psm) }}
                    {{ form_row(form.ast) }}
                    {{ form_row(form.product) }}
                    {{ form_row(form.factory) }}
                    {{ form_row(form.sso) }}
                    {{ form_row(form.country) }}
                    {% if form.expectedClosingStatus is defined %}
                        {{ form_row(form.expectedClosingStatus) }}
                    {% endif %}
                    {% if form.comment is defined %}
                        {{ form_row(form.comment) }}
                    {% endif %}
                    {{ form_row(form.expectedStartDate) }}
                    {% if form.revisedEndDate is defined %}
                        {{ form_row(form.revisedEndDate) }}
                    {% endif %}
                    {% if form.expectedEndDate is defined %}
                        {{ form_row(form.expectedEndDate) }}
                    {% endif %}
                    {% if form.airport is defined %}
                        {{ form_row(form.airport) }}
                    {% endif %}
                    {% if form.equipmentRecord is defined %}
                        {{ form_row(form.equipmentRecord) }}
                    {% endif %}
                    {% if form.closingComment is defined %}
                        {{ form_row(form.closingComment) }}
                    {% endif %}
                    {% if form.futureDemo is defined %}
                        {{ form_row(form.futureDemo) }}
                    {% endif %}
                    {% if form.status is defined %}
                        {{ form_row(form.status) }}
                    {% endif %}
                    {% if form.emissionRating is defined %}
                        {{ form_row(form.emissionRating) }}
                    {% endif %}
                    {{ form_row(form.linkAllocated) }}
                    {{ form_row(form.submit) }}
                </div>
            </div>
        </div>
    </div>
    {{ form_rest(form) }}
    {{ form_end(form) }}

{% endblock %}
