{% extends 'sales/freight_forwarders/layout.html.twig' %}
{% trans_default_domain 'freight_forwarder' %}

{% block title %}{{ parent() }}{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-lg-5">
            {{ include('helper/_association_table.html.twig', {
                associationData: {
                    search: false,
                    title: 'freight_forwarder.detail' |trans,
                    items: {
                        id: {
                            label: 'demo.fields.id'|trans({}, 'demo'),
                        },
                        name: { label: 'fields.name'|trans({}, 'messages') | capitalize },
                        location: {
                            label: 'fields.factory'|trans({}, 'messages'),
                            properties: ['location.name'],
                            link:{
                                route: 'directory_locations_show',
                                params: {'id':'location.@id'},
                            },
                        },
                        supplierNumber: { label: 'fields.supplier.number'|trans({}, 'messages') },
                        language: { label: 'fields.language'|trans({}, 'messages') | capitalize, filters: ['upper'] },
                        emails: {
                            label: 'freight_forwarder.felds.emails'|trans|capitalize,
                            template: 'sales/freight_forwarders/partials/cells/_emails.html.twig',
                        },
                    },
                    data: freightForwarder
                }
            }, with_context = false) }}
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'menu.logs'|trans({}, 'messages') |capitalize }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    <div class="logs-block" data-resource="{{ freightForwarder.iri }}"></div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block translations %}
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'messages' }) }}"></script>
{% endblock %}



