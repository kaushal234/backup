{% extends 'sales/contacts/layout.html.twig' %}
{% trans_default_domain 'contacts' %}

{% block title %}{{ parent() }}{% endblock %}

{% block content %}
{% if add %}
    <div class="row">

        <div class="col-md-6">
            <h3 style="color: red">
                {{ 'contacts.text.no_crt' | trans | capitalize }}
                <br />
                <a href="{{ path('customer_relationship_team_add') }}">{{ 'contacts.text.create_crt' | trans | capitalize }}</a>
            </h3>

            {% form_theme form 'form_theme_horizontal.html.twig' %}
            {{ form_start(form) }}
            {{ form_row(form.customer) }}
            {% if form.crt is defined %}
                {{ form_row(form.crt) }}
            {% endif %}
            {% if form.role is defined %}
                {{ form_row(form.role) }}
            {% endif %}
            {% if form.cDel is defined %}
                {{ form_row(form.cDel) }}
            {% endif %}
            <div>
                <button type="submit" class="btn btn-primary float-end">Submit</button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endif %}
<div class="row mt-2">
    <div class="col-lg-12">
        {{ include('helper/_report_table.html.twig', {
            'reportTable': {
                'items': {
                    'crt': {
                        'properties': ['crt.id'],
                        'label': 'contacts.fields.crt'|trans|upper,
                        'link':{
                            'route': 'customer_relationship_team_show',
                            'params': {'id':'crt.@id'},
                        },
                        'sortable': 'numeric'
                    },
                    'customer': {
                        'properties': ['crt.customer.name'],
                        'label': 'contacts.fields.customer'|trans|capitalize,
                        'link': {
                            'route': 'sales_customers_show',
                            'params': {'id':'crt.customer.@id'}
                        }
                    },
                    'erpLocation': {
                        'properties': ['crt.erpLocation.erp'],
                        'label': 'contacts.fields.erp_location'|trans|capitalize,
                        'link': {
                            'route': 'directory_locations_show',
                            'params': {'id':'crt.erpLocation.@id'}
                        }
                    },
                    'erpCuno': {
                        'properties': ['crt.cuno'],
                        'label': 'contacts.fields.t_cuno'|trans|capitalize,
                    },
                    'cDel': { 'label': 'contacts.fields.t_cdel'|trans },
                    'salesRepresentative': {
                        'properties': ['crt.salesRepresentative.lastname', 'crt.salesRepresentative.firstname'],
                        'label': 'contacts.fields.sales_representative'|trans,
                        'link': {
                            'route': 'directory_people_show',
                            'params': {'id':'crt.salesRepresentative.@id'}
                        }
                    },
                    'partsRepresentative': {
                        'properties': ['crt.partsRepresentative.lastname', 'crt.partsRepresentative.firstname'],
                        'label': 'contacts.fields.parts_representative'|trans,
                        'link': {
                            'route': 'directory_people_show',
                            'params': {'id':'crt.partsRepresentative.@id'}
                        }
                    },
                    'serviceRepresentative': {
                        'properties': ['crt.serviceRepresentative.lastname', 'crt.serviceRepresentative.firstname'],
                        'label': 'contacts.fields.service_representative'|trans,
                        'link': {
                            'route': 'directory_people_show',
                            'params': {'id':'crt.serviceRepresentative.@id'}
                        }
                    },
                    'partsLocation': {
                        'properties': ['crt.partsLocation.name'],
                        'label': 'contacts.fields.partsLocation'|trans,
                        'link': {
                            'route': 'directory_locations_show',
                            'params': {'id':'crt.partsLocation.@id'}
                        }
                    },
                    'serviceLocation': {
                        'properties': ['crt.serviceLocation.name'],
                        'label': 'contacts.fields.serviceLocation'|trans,
                        'link': {
                            'route': 'directory_locations_show',
                            'params': {'id':'crt.partsLocation.@id'}
                        }
                    },
                    'extranetUserGroup': {
                        'properties': ['extranetUserGroup.name'],
                        'label': 'contacts.fields.roles'|trans
                    },
                    'delete': {
                        'label': 'contacts.menu.delete'|trans,
                        'link':{
                            'route': 'sales_contact_delete_crt_roles',
                            'params': {'id':'@id'},
                            'content': '<span class="btn btn-danger btn-sm"><i class="fa fa-trash fa-fw popup"></i></span>',
                            'fixedParams': {'_token': csrf_token('delete_role')},
                            'popup': {
                                'type': 'confirmation',
                                'title': 'Confirmation',
                                'message': 'Are you sure you want to delete ?',
                            },
                        },
                    },
                },
                'title': 'contacts.menu.crt_roles'|trans,
                'data': extranet_user_acls
            }
        }, with_context = false) }}
    </div>
</div>
{% endblock %}
