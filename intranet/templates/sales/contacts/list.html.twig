
{% extends 'sales/contacts/layout.html.twig' %}
{% trans_default_domain 'contacts' %}
{% form_theme idSearchForm 'form_theme_vertical.html.twig' %}
{% form_theme legacyIdSearchForm 'form_theme_vertical.html.twig' %}

{% block title %}{{ parent() }}{% endblock %}

{% block content %}
    <script src="/shared/javascript/hinclude/hinclude.min.js"></script>
    <div class="row">
        <div class="col-md-12">
            <h3>{{ 'titles.quick_access' | trans([], 'messages')|capitalize }}</h3>
            <div class="row">
                <div class="col-md-6">
                    {{ form_start(idSearchForm, { action: path('sales_contact_home') }) }}
                    <div class="row">
                        <div class="col-sm-10">
                            {{ form_widget(idSearchForm) }}
                        </div>

                        <div class="col-sm-2">
                            <input type="submit" name="submit" class="btn btn-primary" value="{{ 'menu.search'|trans([], 'messages')|capitalize }}"/>
                        </div>
                    </div>

                    {{ form_end(idSearchForm) }}
                </div>

                <div class="col-md-6">
                    {{ form_start(legacyIdSearchForm, { action: path('sales_contact_home') }) }}
                    <div class="row">
                        <div class="col-sm-10">
                            {{ form_widget(legacyIdSearchForm) }}
                        </div>

                        <div class="col-sm-2">
                            <input type="submit" name="submit" class="btn btn-primary" value="{{ 'menu.search'|trans([], 'messages')|capitalize }}"/>
                        </div>
                    </div>

                    {{ form_end(legacyIdSearchForm) }}
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            {{ data_table(extranetUserDatatable) }}
        </div>
    </div>
    <div class="ibox float-e-margins">
            <div class="ibox-title">
                <h5>{{ 'contacts.fields.last_seq'|trans }}</h5>
                <div class="ibox-tools">
                    <a class="collapse-link">
                        <i class="fa fa-chevron-up"></i>
                    </a>
                </div>
            </div>
            <div class="ibox-content">
                <hx:include src="/en/private/calendar/seq/seq_extranet_user_hinclude.php" id="block_seq">
                    <div class="text-center"><span class="fa fa-refresh fa-spin"></span></div>
                </hx:include>
            </div>
        </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ include('partial/_footable.html.twig', {'selectors': ['#block_seq']}) }}
{% endblock %}

{% block form_label %}
    {{ include('sales/partial/input_with_no_label.html.twig') }}
{%- endblock form_label %}
