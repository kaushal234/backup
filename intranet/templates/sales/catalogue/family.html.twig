{% extends 'sales/catalogue/layout.html.twig' %}
{% trans_default_domain 'catalogue' %}

{% block title %}{{ parent() }}{% endblock %}

{% block content %}
    <div class="row wrapper-content">
        <div class="col-md-8">
            {{ include('helper/_association_table.html.twig', {
                'associationData': {
                    'items': {
                        'englishDescription': { 'label':'catalogue.family.description'|trans | capitalize },
                    },
                    'title': productFamily.name,
                    'data': productFamily},
            }, with_context = false) }}
            {{ include('helper/_association_table.html.twig', {
                associationData: {
                    collapse: true,
                    search: false,
                    pagination: false,
                    title: 'catalogue.family.information' | trans,
                    items: {
                        dmsPhoto: {
                            label: 'catalogue.family.dmsPhoto'|trans|upper,
                            filters: ['dmsPortalLink', 'raw']
                        },
                        manufacturingFactories: {
                            label: 'catalogue.family.manufacturing_factories'|trans|upper,
                            template: 'sales/catalogue/partial/_manufacturingFactories.html.twig'
                        },
                        tags: {
                            label: 'fields.tags'|trans({}, 'messages')|upper,
                            template: 'sales/catalogue/partial/_tags.html.twig'
                        },
                        public: {
                            label: 'catalogue.family.status'|trans|upper,
                            template: 'sales/catalogue/partial/_public.html.twig'
                        }
                    },
                    data: productFamily
                }
            }, with_context = false) }}
            {{ include('helper/_association_table.html.twig', {
                associationData: {
                    collapse: true,
                    items: {
                        frenchDescription: {label: 'catalogue.type.french'|trans | capitalize },
                        spanishDescription: {label: 'catalogue.type.spanish'|trans | capitalize },
                        russianDescription: {label: 'catalogue.type.russian'|trans | capitalize },
                        chineseDescription: {label: 'catalogue.type.chinese'|trans | capitalize },
                        japaneseDescription: {label: 'catalogue.type.japanese'|trans | capitalize },
                        portugueseDescription: {label: 'catalogue.type.portuguese'|trans | capitalize },
                        germanDescription: {label: 'catalogue.type.german'|trans | capitalize },
                    },
                    title: 'catalogue.family.other_desc' | trans,
                    data: productFamily},
            }, with_context = false) }}
        </div>
        <div class="col-md-4">
            {% if productFamily.dmsPhoto is not same as(null) %}
                    <img class="m-t-xs img-fluid" width="400" src="{{ absolute_url(path('legacy_mis', {m:['help', 'dms'], id: productFamily.dmsPhoto})) }}">
            {% else %}
                    <img class="m-t-xs img-fluid" width="400" src="/shared/no_photo_catalogue.png">
            {% endif %}
        </div>
    </div>
    <div class="row wrapper-content">
        <div class="col-lg-8">
            {% set items = {
                dms: {
                    properties: ['dms.legacyId'],
                    label: 'catalogue.products.id'|trans|capitalize,
                    filters: ['dmsPortalLink', 'raw'],
                },
                dmsTitle: {
                    properties: ['dms.title'],
                    label: 'catalogue.dms.dms_title'|trans|capitalize,
                    class: 'text-center',
                },
                dmsLanguage: {
                    properties: ['dms.language'],
                    label: 'catalogue.dms.language'|trans|capitalize,
                    class: 'text-center',
                },
                dmsType: {
                    label: 'catalogue.dms.type'|trans|capitalize,
                    class: 'text-center',
                },
                file: {
                    label: 'catalogue.dms.file'|trans|capitalize,
                    filters: ['dmsHtmlLink', 'raw'],
                    link:{
                        route: 'legacy_mis',
                        fixedParams: {'m': ['help', 'dms'], 'filenameFromDMS': true},
                        params: {id : 'dms.legacyId'},
                        class : 'text-center',
                        content: '<span class="btn btn-warning btn-sm"><i class="fa fa-download fa-fw"></i></span>',
                    }
                }
            }
            %}

            {% if is_granted('FEATURE_CATALOG_CREATE') or is_granted('MOO_CAT') %}
                {% set items = items | merge ({
                    delete: {
                        label: 'catalogue.dms.field.delete'|trans,
                        link:{
                            route: 'sales_catalogue_delete_family_dms',
                            params: {id:'@id'},
                            class : 'text-center',
                            content: '<span class="btn btn-danger btn-sm"><i class="fa fa-trash fa-fw popup"></i></span>',
                            fixedParams: {'_token': csrf_token('delete')},
                            popup: {
                                type: 'confirmation',
                                title: 'Confirmation',
                                message: 'Are you sure you want to delete ?',
                            }
                        }
                    }
                }) %}
            {% endif %}

            {{ include ('helper/_report_table.html.twig', {
                reportTable: {
                    data: dms,
                    title: 'catalogue.dms.family_title' | trans,
                    items: items,
                }
            }) }}
        </div>
        {% if is_granted('FEATURE_CATALOG_FAMILY_ADD_DMS') or is_granted('MOO_CAT') %}
            <div class="col-md-4">
                <div class="ibox float-e-margins collapsed">
                    <div class="ibox-title">
                        <h5>{{ 'catalogue.dms.add_family_dms' | trans }}</h5>
                        <div class="ibox-tools">
                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                        </div>
                    </div>
                    <div class="ibox-content">
                        {% form_theme form 'form_theme_horizontal.html.twig' %}
                        {{ form_start(form) }}
                        {{ form_row(form.dms) }}
                        {{ form_row(form.dmsType) }}
                        {{ form_row(form.submit) }}
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
    <div class="row wrapper-content">
        <div class="col-lg-12">
                {% set items = {
                    id: {
                        label: 'catalogue.products.id'|trans|upper,
                        link:{
                            route: 'sales_catalogue_product_show',
                            params: {'id':'@id'},
                        },
                    },
                    name: {
                        label: 'catalogue.products.name'|trans|upper,
                        class: 'text-center',
                        link: {
                            route: 'sales_catalogue_product_show',
                            params: {'id':'@id'}
                        }
                    },
                    erpLocation: {
                        label: 'catalogue.products.erp'|trans|upper,
                        properties: ['erpLocation.erp'],
                        class: 'text-center',
                        link: {
                            route: 'directory_locations_show',
                            params: {'id':'erpLocation.@id'}
                        }
                    },
                    innovativeLevel: {label: 'catalogue.products.innovative_level'|trans|upper},
                    hidden: {
                        label: 'catalogue.products.visibility'|trans|upper,
                        class : 'text-center',
                        boolean: {
                            'true': '<button type="button" class="btn btn-warning btn-sm mx-auto">Hidden</button>',
                            'false': '<button type="button" class="btn btn-green btn-sm mx-auto">Not Hidden</button>'
                        }
                    },
                    edit: {
                        label: 'menu.edit'|trans([], 'messages')|capitalize,
                        link:{
                            route: 'sales_catalogue_product_edit',
                            params: {'id':'@id'},
                            content: '<span class="btn btn-warning btn-sm"><i class="fa fa-pencil-alt fa-fw"></i></span>',
                        },
                        sortable: false,
                        class : 'text-center'
                    }
                }
                %}
            {% if is_granted('FEATURE_CATALOG_DELETE') or is_granted('MOO_CAT') %}
                {% set items = items | merge ({
                    delete: {
                        label: 'menu.delete'|trans([], 'messages')|capitalize,
                        link:{
                            route: 'sales_products_delete',
                            params: {'id':'@id'},
                            content: '<span class="btn btn-danger btn-sm"><i class="fa fa-times fa-fw"></i></span>',
                        },
                        sortable: false,
                        class : 'text-center'
                    }
                }) %}
            {% endif %}
            {{ include ('helper/_report_table.html.twig', {
                'reportTable': {
                    'data': products,
                    'search': true,
                    'title': 'catalogue.family.products' | trans,
                    'items': items
                }
            }) }}
        </div>
    </div>
<div>
    <div class="ibox float-e-margins">
        <div class="ibox-content">
            {{ include('helper/_report_table.html.twig', {
                reportTable: {
                    items: {
                        weeks: {
                            label: 'calibration_tool.fields.calibrationIntervalUnit.weeks'|trans({}, 'calibration_tool')
                        },
                        previousValue: {
                            label: 'lead_time.previous_value'|trans
                        },
                        description: {
                            label: 'catalogue.family.description'|trans
                        },
                        updatedBy: {
                            properties: ['updatedBy.lastname', 'updatedBy.firstname'],
                            label: 'lead_time.last_update_by' |trans,
                        },
                        updatedAt: {
                            label: 'lead_time.last_update_at'|trans,
                            filters: 'date("Y-m-d")',
                            preserveNull: true
                        },
                    },
                    title: 'lead_time.lead_time'|trans,
                    data: leadTimes,
                    initialSorting: false,
                    pagination: false,
                    search: false,
                }
            }, with_context = false) }}
        </div>
    <div>
        <div class="ibox float-e-margins">
            <div class="ibox-title">
                <h5>{{ 'menu.logs'|trans({}, 'messages') }}</h5>
                <div class="ibox-tools">
                    <a class="collapse-link">
                        <i class="fa fa-chevron-up"></i>
                    </a>
                </div>
            </div>
            <div class="ibox-content">
                <div class="logs-block" data-resource="{{ productFamily.iri }}" data-show-comment-form="true"></div>
            </div>
        </div>
    </div>
{% endblock %}

{% block translations %}
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'messages' }) }}"></script>
{% endblock %}

