{% form_theme form 'form_theme_vertical.html.twig' %}

{{ form_start(form) }}
        {{ form_errors(form) }}
<div class="row">
    <div class="col-lg-3">
        {{ form_row(form.productType) }}
    </div>
    <div class="col-lg-3">
        {{ form_row(form.product) }}
    </div>
    <div class="col-lg-3">
        {{ form_row(form.factory) }}
    </div>
    <div class="col-lg-3">
        {{ form_row(form.emissionRatings) }}
    </div>
</div>
<div class="row">
    <div class="col-lg-3">
        {{ form_row(form['expiredAt-after']) }}
    </div>
    <div class="col-lg-3">
        {{ form_row(form['expiredAt-before']) }}
    </div>
    <div class="col-lg-3">
        {{ form_row(form['expectedAt-after']) }}
    </div>
    <div class="col-lg-3">
        {{ form_row(form['expectedAt-before']) }}
    </div>
</div>
<div class="row">
    {{ form_rest(form) }}
    <div class="col-lg-12">
        <hr class="hr-line-dashed">
        <div class="float-end">
            <label class="col-form-label">&nbsp;</label>
            <button class="btn btn-primary" type="submit">{{ 'button.filter'| trans | upper }}</button>
            <a href="{{ resetPath }}" class="btn btn-secondary">{{ 'button.reset'| trans | upper }}</a>
        </div>
    </div>
</div>
{{ form_end(form) }}
