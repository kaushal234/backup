{% extends 'sales/catalogue/layout.html.twig' %}
{% trans_default_domain 'catalogue' %}
{% form_theme search_form 'form_theme_vertical.html.twig' %}

{% block title %}{{ parent() }}/{{ 'catalogue.certificates.title' |trans }}{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-4">
            <h3 class="text-capitalize">{{ 'contacts.search'|trans({}, 'contacts') }}</h3>
            <div >
                <div>
                    {{ form_start(search_form, { action: path('sales_product_certificates_home') }) }}
                    <div class="row">
                        <div class="col-sm-10">
                            {{ form_widget(search_form) }}
                        </div>
                        <div class="col-sm-2">
                            <input type="submit" name="submit" class="btn btn-primary" value="{{ 'menu.search'|trans([], 'messages')|capitalize }}"/>
                        </div>
                    </div>
                    {{ form_end(search_form) }}
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div>
            <div class="ibox float-e-margins collapsed">
                <div class="ibox-title">
                    <h5>{{ 'button.filters' | trans([], 'messages') | upper }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {{ include('sales/catalogue/product_certificate/partial/_form_filter.html.twig', {
                        form: formFilter,
                        resetPath: path('sales_product_certificates_home')
                    }) }}
                </div>
            </div>
        </div>
    </div>
    {% set items = {
            view: {
                label: 'menu.view' | trans([], 'messages') | capitalize,
                link:{
                    route: 'sales_product_certificates_show',
                    params: { 'id':'@id' },
                    content: '<span class="btn btn-primary btn-sm"><i class="fa fa-eye fa-fw"></i></span>',
                },
                sortable: false,
            },
            expired: {
                label: 'catalogue.certificates.fields.expired'|trans|capitalize,
                template: 'sales/catalogue/product_certificate/partial/cells/_expired.html.twig',
            },
            announcementCertificateNumber: {
                label: 'catalogue.certificates.fields.announcement_number'|trans,
            },
            productType: {
                properties: ['product.family.productType.englishName'],
                label: 'catalogue.type.product_type'|trans,
                link:{
                    route: 'sales_catalogue_type_show',
                    params: {'id':'product.family.productType.@id'},
                }
            },
            product: {
                label: 'catalogue.products.product'|trans,
                properties: ['product.name'],
                link:{
                    route: 'sales_catalogue_product_show',
                    params: {'id':'product.@id'},
                }
            },
            emissionRatings: {
                label: 'sales_forecasts.fields.tier'|trans({}, 'sales_forecasts'),
                properties: ['emissionRating.name'],
            },
            engineeringActivityProcess: {
                label: 'catalogue.certificates.fields.eap_number'|trans,
            },
            testReportNumber: {
                label: 'catalogue.certificates.fields.test_report_number'|trans,
            },
            expectedAt: {
                label: 'catalogue.certificates.fields.expected_at'|trans,
                filters: 'date("Y-m-d")',
                preserveNull: true,
            },
            expiredAt: {
                label: 'catalogue.certificates.fields.expired_at'|trans,
                filters: 'date("Y-m-d")',
                preserveNull: true,
            },
            factory: {
                properties: ['factory.name'],
                label: 'fields.factory'|trans({}, 'messages'),
                link:{
                    route: 'directory_locations_show',
                    params: {'id':'factory.@id'},
                }
            },
            description: {
                label: 'survey.fields.description'|trans({}, 'surveys'),
            },
            url: {
                label: 'customers.fields.url'|trans({}, 'sales_customers')|trans|capitalize,
                template: 'sales/catalogue/product_certificate/partial/cells/_download.html.twig',
            },
    } %}

    {% if is_granted('FEATURE_PRODUCT_CERTIFICATE_ADMIN') or is_granted('MOO_CAT') %}
        {% set items = items | merge({
            edit: {
                label: 'menu.edit' | trans([], 'messages') | capitalize,
                link:{
                    route: 'sales_product_certificates_edit',
                    params: { 'id':'@id' },
                    content: '<span class="btn btn-warning btn-sm"><i class="fa fa-pencil-alt fa-fw"></i></span>',
                },
                sortable: false,
                class : 'text-end'
            },
            delete: {
                label: 'button.delete' | trans([], 'messages') | capitalize,
                link:{
                    route: 'sales_product_certificates_delete',
                    params: { 'id':'@id' },
                    content: '<span class="btn btn-danger btn-sm"><i class="fa fa-trash fa-fw"></i></span>',
                    popup: {
                        type: 'confirmation',
                        title: 'Confirmation',
                        message: 'Are you sure you want to delete ?',
                    },
                },
                sortable: false,
                class : 'text-end'
            }
        }) %}
    {% endif %}

    <div class="row">
        {{ include('helper/_report_table.html.twig', {
            reportTable: {
                pagination: pagination,
                items: items,
                initialSorting: false,
                search: searchTable,
                title: reportTitle|trans,
                data: productCertificates,
            }
        }, with_context = true) }}
    </div>
{% endblock %}

{% block form_label -%}
    {{ include('sales/partial/input_with_no_label.html.twig') }}
{%- endblock form_label %}
