{% extends 'sales/equipment_shipping_records/layout.html.twig' %}
{% form_theme form 'form_theme_vertical.html.twig' %}
{% trans_default_domain 'equipment_shipping_record' %}

{% block content %}
    <div class="row mt-5">
        <div class="col-md-4">
            <div class="ibox float-e-margins col-md-12 mb-5">
                <div class="ibox-title">
                    <h5>{{ 'fields.location' | trans([], 'messages') }}</h5>
                </div>
                <div class="ibox-content">
                    <div class="row">
                        <div class="col-md-12">
                            {{ form_start(form) }}
                            {{ form_errors(form) }}
                            <div class="row">
                                <div class="col-sm-10">
                                    {{ form_widget(form.location) }}
                                </div>
                                <div class="col-sm-2">
                                    <input id="id-quick-access-submit" type="submit" name="submit" class="btn btn-primary" value="{{ 'menu.search'|trans([], 'messages')|capitalize }}"/>
                                </div>
                            </div>
                            {{ form_rest(form) }}
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% if selectedFactory %}
        <div class="col-md-8">
            <div class="ibox float-e-margins col-md-12 mb-5">
                <div class="ibox-title">
                    <h5>{{ 'planning_daily_exception.form.title' | trans([], 'equipment_shipping_record') }}</h5>
                </div>
                <div class="ibox-content">
                    <div class="row">
                        <div class="col-md-12">
                            {{ form_start(planningDailyExceptionForm) }}
                            {{ form_errors(planningDailyExceptionForm) }}
                            <div class="row">
                                <div class="col-sm-2">
                                    {{ form_widget(planningDailyExceptionForm.date) }}
                                </div>
                                <div class="col-sm-9">
                                    {{ form_widget(planningDailyExceptionForm.comment) }}
                                </div>
                                <div class="col-sm-1 justify-content-end">
                                    <input type="submit" name="planning-daily-exception[submit]" class="btn btn-primary" value="{{ 'button.submit'|trans([], 'messages')|capitalize }}"/>
                                </div>
                            </div>
                            {{ form_rest(planningDailyExceptionForm) }}
                            {{ form_end(planningDailyExceptionForm) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}
    </div>
        <div class="row">
            <div class="col">
                <div class="ibox float-e-margins">
                    <div class="ibox-title">
                        <h5>{{ 'sidebar.manufacturing.planning'|trans({}, 'sidebar') }}</h5>
                        {% if planningDailyLimit is defined and planningDailyLimit is not null %}
                            <div class="ibox-tools">
                                <h5 style="color: red; font-weight: bold">
                                    &nbsp;&nbsp;&nbsp;{{ 'planning_daily_limit.factory_limit'|trans({'%factoryName%': planningDailyLimit.factory.name,'%days%': planningDailyLimit.days,'%comment%': planningDailyLimit.comment}, 'equipment_shipping_record') }}
                                </h5>
                            </div>
                        {% endif %}
                    </div>
                    <div class="ibox-content">
                        <div class="row">
                            {% for key, day in planningByDate %}
                                <div class="col-12">
                                    {% embed 'helper/_report_table.html.twig' with {
                                        reportTable: {
                                            items: {
                                                serialNumber: {
                                                    properties: ['equipmentRecord.serialNumber'],
                                                    label: 'demo.fields.serial_number'|trans({}, 'demo')|capitalize,
                                                    link:{
                                                        route: 'legacy_product_support',
                                                        params: {'id':'equipmentRecord.legacyId'},
                                                        fixedParams: {'m':['equipment', 'view']},
                                                    }
                                                },
                                                equipmentShippingRecord: {
                                                    properties: ['equipmentShippingRecord.id'],
                                                    label: 'equipment_shipping_record.title'|trans|capitalize,
                                                    link:{
                                                        route: 'equipment_shipping_record_show',
                                                        params: {'id':'equipmentShippingRecord.id'},
                                                    }
                                                },
                                                model: {
                                                    label: 'service.equipment_record.fields.model'|trans([], 'service')|capitalize,
                                                    properties: ['equipmentRecord.model'],
                                                },
                                                modality: {
                                                    label: 'equipment_shipping_record.fields.modality'|trans|capitalize,
                                                    properties: ['equipmentShippingRecord.modality'],
                                                },
                                                truckType: {
                                                    label: 'equipment_shipping_record.fields.line.truck_type'|trans,
                                                },
                                                sso: {
                                                    label: 'directory.department.fields.sso'|trans({}, 'directory')|capitalize,
                                                    properties: ['equipmentRecord.salesOrganisation.name'],
                                                },
                                                estimatedPickUpDateConfirmation : {
                                                    label: 'equipment_shipping_record.fields.line.estimated_pick_up_date_confirmation'|trans,
                                                    boolean: {
                                                        false: '<div><span class="d-none">1</span><i class="fa fa-circle text-danger"></i></div>',
                                                        true: '<div><span class="d-none">0</span><i class="fa fa-circle" style="color: #009639"></i></div>'
                                                    }
                                                },
                                                comment: {
                                                    label: 'demo.fields.comment'|trans({}, 'demo')|capitalize,
                                                    class: "w-25"
                                                },
                                                yellowTagDate: {
                                                    properties: ['equipmentRecord.yellowTagDate'],
                                                    label: 'support.equipment_record.fields.yellow_tag_date'|trans({}, 'support'),
                                                    filters: 'date("Y-m-d")',
                                                    preserveNull: true
                                                },
                                                actualGreenTagDate: {
                                                    template: 'sales/equipment_shipping_records/partial/cell/_actual_green_tag_date.html.twig',
                                                    label: 'equipment_shipping_record.fields.actual_gt_date'|trans,
                                                }
                                            },
                                            data: day.lines,
                                            title: key|date('d/m/Y'),
                                            search: false,
                                            pagination: false,
                                        }
                                    } %}
                                        {% block table_row %}
                                            {% set gt = item.equipmentRecord.greenTagDate ?? null %}
                                            {% set yt = item.equipmentRecord.yellowTagDate ?? null %}
                                            {% set rowClass = "" %}

                                            {% if gt is not null %}
                                                {% set rowClass = "table-success" %}
                                            {% elseif yt is not null %}
                                                {% set rowClass = "table-warning" %}
                                            {% else %}
                                                {% set rowClass = "table-danger" %}
                                            {% endif %}

                                            <tr class="{{ rowClass }}">
                                                {% for key, itemProperty in table.items %}
                                                    {% with {reportItem: itemProperty} %}
                                                        {{ block('table_cell') }}
                                                    {% endwith %}
                                                {% endfor %}
                                            </tr>
                                        {% endblock %}

                                        {% block card_header %}
                                            {% include 'sales/equipment_shipping_records/partial/_planning_day_header.html.twig' with {date: key,exception: day.exception ?? null} %}
                                        {% endblock %}
                                    {% endembed %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
{% endblock %}