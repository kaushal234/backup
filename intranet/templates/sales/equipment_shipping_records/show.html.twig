{% extends 'sales/equipment_shipping_records/layout.html.twig' %}
{% trans_default_domain 'equipment_shipping_record' %}

{% block title %} {{ parent() }}#{{ equipmentShippingRecord.id}} {% endblock %}

{% block content %}
    <script src="/shared/javascript/hinclude/hinclude.min.js"></script>
    {{ include('helper/_tabs.html.twig', {
        tabsData: {
            tabs: {
                detail: {
                    defaultTab: true,
                    label: 'contacts.menu.detail' | trans({}, 'contacts') | capitalize,
                    template: 'sales/equipment_shipping_records/partial/tabs/_esr_tab.html.twig',
                    templateParams: {equipmentShippingRecord: equipmentShippingRecord}
                },
                lines: {
                    label: 'equipment_shipping_record.fields.lines' | trans() | capitalize,
                    template: 'sales/equipment_shipping_records/partial/tabs/_lines_tab.html.twig',
                    templateParams: {lines: equipmentShippingRecord.equipmentShippingRecordLines}
                },
                costs: {
                    label: 'equipment_shipping_record.fields.costs' | trans() | capitalize,
                    template: 'sales/equipment_shipping_records/partial/tabs/_costs_tab.html.twig',
                    templateParams: {costs: equipmentShippingRecord.equipmentShippingRecordCosts}
                },
                logs: {
                    label: 'menu.logs' | trans({}, 'messages') | capitalize,
                    template: 'generic/_logs.html.twig',
                },
                links: {
                    label: 'menu.links' | trans({}, 'messages') | capitalize,
                    template: 'generic/_links.html.twig',
                    templateParams: { module: 'ESR', legacy: false }
                },
                tasks: {
                    label: 'menu.people.tasks' | trans({}, 'messages') | capitalize,
                    template: 'sales/equipment_shipping_records/partial/tabs/_tasks_tab.html.twig',
                },
                files: {
                    label: 'menu.files' | trans({}, 'messages') | capitalize,
                    template: 'sales/equipment_shipping_records/partial/tabs/_files_tab.html.twig',
                    templateParams: {form_files: form_files},
                    badge: equipmentShippingRecord.files|length,
                },
            },
            data: equipmentShippingRecord,
            link: app.request.query.get('tab'),
        },
    }, with_context = false) }}
{% endblock %}

{% block translations %}
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'messages' }) }}"></script>
{% endblock %}
