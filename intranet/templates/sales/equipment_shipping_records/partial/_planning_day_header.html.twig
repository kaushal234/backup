<div class="ibox-title mb-0">

    <h5 class=" {{ exception ? 'text-warning' : '' }}" style="line-height: 1;">
        {% if exception %}
            <i class="fa fa-exclamation-triangle"></i>
        {% endif %}

        {{ date|date('d/m/Y') }}

        {% if exception %}
            — {{ exception.comment }}
        {% endif %}
    </h5>

    <div class="ibox-tools">
        {% if exception %}
            <a class="btn text-warning pe-0"
               href="{{ path('planning_daily_exception_edit', {id: exception.id}) }}">
                <i class="fa fa-pencil-alt"></i>
            </a>

            <a class="btn text-danger ps-0"
               href="{{ path('planning_daily_exception_delete', {id: exception.id}) }}"
               onclick="return confirm('Are you sure?');">
                <i class="fa fa-trash"></i>
            </a>
        {% endif %}
        <a class="collapse-link">
            <i class="fa fa-chevron-up"></i>
        </a>
    </div>
</div>