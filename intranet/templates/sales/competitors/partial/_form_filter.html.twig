{% form_theme form 'form_theme_vertical.html.twig' %}
{{ form_start(form) }}
{{ form_errors(form) }}
<div class="row">
    <div class="col-lg-4">
        {{ form_row(form.productTypes) }}
    </div>
    <div class="col-lg-8">
        <hr class="hr-line-dashed">
        <div class="float-end">
            <label class="col-form-label">&nbsp;</label>
            <button class="btn btn-primary" type="submit">{{ 'button.filter'| trans({}, 'messages') | upper }}</button>
            <a href="{{ resetPath }}" class="btn btn-secondary">{{ 'button.reset'| trans | upper }}</a>
            {{ form_widget(form.download) }}
        </div>
    </div>
</div>
{{ form_end(form) }}