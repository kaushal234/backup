{% extends 'sales/competitors/layout.html.twig' %}
{% trans_default_domain 'sales_competitors' %}

{% block title %}{{ parent() }}{% endblock %}

{% block content %}
    {% if is_granted('FEATURE_COMPETITOR_EDIT') %}
    <div class="row">
        <div class="col-lg-9">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ competitor.name }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    <div class="row">
                        <div class="col-lg-12">
                            {% form_theme form 'form_theme_vertical.html.twig' %}

                            {{ form_start(form, { action: path('sales_competitors_files', {'id': competitor.id}) }) }}
                            {{ form_errors(form) }}

                            {{ form_row(form.file) }}
                            {{ form_row(form.description) }}

                            {{ form_rest(form) }}

                            <div>
                                <button class="btn btn-primary">{{ 'button.submit'|trans({}, 'messages') }}</button>
                            </div>

                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    <div id="competitor-files">
    {{ include('helper/_report_table.html.twig', {
        reportTable: {
            items: {
                filePath: {
                    label: 'menu.files'|trans({}, 'messages')|capitalize,
                    filters : 'slice(51)',
                    link:{
                        route: 'sales_competitors_files_show',
                        params: {
                            id: 'id'
                        },
                        fixedParams: {
                            competitorId: competitor.id
                        }
                    },
                },
                description: {
                    label: 'competitors.fields.file_description'|trans|capitalize,
                },
                createdAt: {
                    label: 'competitors.fields.created_at'|trans|capitalize,
                    filters: 'date("Y-m-d H:i:s")'
                },
                poster: {
                    properties: ['poster.lastname', 'poster.firstname'],
                    label: 'competitors.fields.poster'|trans|capitalize
                },
                size: {
                    label: 'size'|trans({}, 'messages')|trans|capitalize,
                    filters : 'readable_filesize'
                },
                delete: {
                    label: 'menu.delete'|trans({}, 'messages')|capitalize,
                    sortable: false,
                    class: 'text-end',
                    link: {
                        route: 'sales_competitors_delete_file',
                        params: {'id': 'id'},
                        fixedParams: {'competitorId': competitor.id, '_token': csrf_token('delete_competitor_file')},
                        content: '<span class="btn btn-danger btn-sm"><i class="fa fa-trash fa-fw"></i></span>',
                        popup: {
                            type: 'confirmation',
                            title: 'Confirmation',
                            message: 'Are you sure to delete ?',
                        },
                    },
                },
            },
            title: 'competitors.fields.files'|trans,
            data: competitor.competitorFiles,
            search: false,
            pagination: false,
            initialSorting: 'createdAt'
        }
    }, with_context = false) }}
    </div>

{% endblock %}
