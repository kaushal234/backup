{% extends 'sales/competitors/layout.html.twig' %}
{% trans_default_domain 'sales_competitors' %}

{% block title %}
    {{ parent() }}
{% endblock %}

{% set competitorProductTypes = [] %}
{% for type in competitor.productTypes %}
    {% set competitorProductTypes = competitorProductTypes | merge([type['@id']]) %}
{% endfor %}

{% block content %}
    <script src="/shared/javascript/hinclude/hinclude.min.js"></script>
    <div class="row">
        <div class="col-md-6">
            {{ include('helper/_association_table.html.twig', {
                associationData: {
                    items: {
                        '@id': {
                            label:'Competitor#',
                            filters: 'iri_id'
                        },
                        legacyId: {label: 'Legacy Id'},
                        shortDescription: { label: 'competitors.fields.short_description'|trans|capitalize },
                        description: { label: 'competitors.fields.description'|trans|capitalize },
                        url: {label: 'competitors.fields.url'|trans|capitalize, filters: ['lower', 'html_link_from_string', 'raw']},
                    },
                    title: competitor.name,
                    data: competitor},
            }, with_context = false) }}
        </div>

        <div class="col-md-6">
            {% if competitor.logo is not empty %}
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'competitors.fields.logo'|trans }}</h5>
                </div>
                <div class="ibox-content">
                    <div class="text-center">
                            <p><img class="img-thumbnail img-fluid" src="{{ asset(upload_uri ~ '/' ~ competitor.logo.filePath) }}"></p>
                    </div>
                </div>
            </div>
            {% endif %}
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'competitors.fields.product_types'|trans }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    <div class="row">
                        {% set nbProductTypes = productTypes|length %}
                        <div class="col-md-6">
                            <ul class="list-unstyled">
                                {% for type in productTypes %}
                                    {% set checked = type['@id'] in competitorProductTypes %}
                                    <li class="{{ checked ? '' : 'text-muted' }}"><button class="btn {{ checked ? 'btn-sm btn-green' : 'btn-sm btn-secondary' }}" {{ checked ? '' : 'disabled="disabled"' }}>{{ type.englishName }}</button></li>
                                    {% if loop.index == ((nbProductTypes/2)|round) %}
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <ul class="list-unstyled">
                                    {% endif %}
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{ include('sales/market_intelligence/partial/_table.html.twig', {
        reportTitle: 'competitors.blocks.mim'|trans,
        marketIntelligences: marketIntelligences,
        searchTable: false,
    }, with_context=false) }}

    <div class="row">
        <div class="col-sm-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'competitors.blocks.fcr'|trans }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                        {{ include('sales/forecast_closures/partial/_table.html.twig', {forecastClosures: forecastClosures, pagination: false, search: false, raw: true}) }}
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'competitors.blocks.cpr'|trans }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {{ include('sales/competitor_pricings/partial/_table.html.twig', {competitorPricings: competitorPricings, pagination: false, search: false, raw: true}) }}
                </div>
            </div>
        </div>
    </div>

    <div class="ibox-content">
        <div class="logs-block" data-resource="{{ competitor['@id'] }}" data-show-comment-form="true"></div>
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ include('partial/_footable.html.twig', {'selectors': ['#latest_mim']}) }}
{% endblock %}
{% block translations %}
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'messages' }) }}"></script>
{% endblock %}
