{% extends '/sales/customers/layout.html.twig' %}
{% trans_default_domain 'sales_customers' %}

{% block content %}
    <div class="row">
        <div class="ibox float-e-margins">
            <div class="ibox-content">
                {% set items = {
                    name: {
                        label: 'catalogue.products.name'|trans({}, 'catalogue')|capitalize,
                    }
                } %}
                {% if is_granted('FEATURE_CUSTOMER_TYPE_WRITE') %}
                    {% set items = items | merge ({
                        edit: {
                            label: 'menu.edit'|trans([], 'messages')|capitalize,
                            link:{
                                route: 'customer_type_edit',
                                params: {'id':'@id'},
                                content: '<span class="btn btn-warning text-capitalize"><i class="fa fa-pencil-alt"></i></span>',
                            },
                        },
                        delete: {
                            label: 'menu.delete'|trans([], 'messages')|capitalize,
                            link:{
                                route: 'customer_type_delete',
                                params: {'id':'@id'},
                                content: '<span class="btn btn-danger text-capitalize"><i class="fa fa-trash-alt"></i></span>',
                            },
                        }
                    }) %}
                {% endif %}
                {{ include('helper/_report_table.html.twig', {
                    reportTable: {
                        items: items,
                        title: 'customer_types.title'|trans|capitalize,
                        data: customerTypes
                    }
                }, with_context = false) }}
            </div>
        </div>
    </div>
{% endblock %}
