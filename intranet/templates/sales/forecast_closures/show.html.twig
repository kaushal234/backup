{% extends 'sales/forecast_closures/layout.html.twig' %}
{% trans_default_domain 'forecast_closures' %}

{% block content %}

    <div class="row">
        <div class="col-md-6">
            {{ include('helper/_association_table.html.twig', {
                associationData: {
                    items: {
                        '@id': {
                            label: 'sidebar.sales.fcr'|trans({}, 'sidebar')~'#',
                            filters: 'iri_id'
                        },
                        legacyId: {
                            label: 'customers.fields.legacyId'|trans({}, 'sales_customers'),
                        },
                        salesForecast: {
                            properties: ['salesForecast.@id'],
                            label: 'sidebar.sales.sfr'|trans({}, 'sidebar')~'#',
                            link:{
                                route: 'sales_forecasts_show',
                                params: {'id':'salesForecast.@id'},
                            }
                        },
                        buyer: {
                            properties: ['salesForecast.buyer.name'],
                            label: 'fields.buyer'|trans({}, 'messages'),
                            link:{
                                route: 'sales_customers_show',
                                params: {'id':'salesForecast.buyer.@id'},
                            }
                        },
                        endUser: {
                            properties: ['salesForecast.endUser.name'],
                            label: 'fields.end_user'|trans({}, 'messages'),
                            link:{
                                route: 'sales_customers_show',
                                params: {'id':'salesForecast.endUser.@id'},
                            }
                        },
                        country: {
                            properties: ['salesForecast.buyer.country.name'],
                            label: 'address.fields.country'|trans({}, 'messages')|capitalize
                        },
                        winning: {
                            properties: ['competitor.name'],
                            label: 'forecast_closures.fields.winning_party'|trans({}, 'forecast_closures'),
                            template: 'sales/forecast_closures/partial/_winning_party.html.twig'
                        },
                        model: {
                            properties: ['salesForecast.product.name'],
                            label: 'sales_forecasts.fields.product'|trans({}, 'sales_forecasts'),
                            link:{
                                route: 'sales_catalogue_product_show',
                                params: {'id':'salesForecast.product.@id'},
                            }
                        },
                        orderedQuantity: {
                            label: 'forecast_closures.fields.quantity'|trans
                        },
                        quantity: {
                            properties: ['salesForecast.quantity'],
                            label: 'forecast_closures.fields.sfr_quantity'|trans
                        },
                        price: {
                            label: 'forecast_closures.fields.price'|trans,
                            filters: ['number_format(2)']
                        },
                        currency: {
                            properties: ['currency.name'],
                            label: 'competitor_pricings.fields.currency'|trans({}, 'competitor_pricings'),
                        },
                        equoteId: {
                            properties: ['salesForecast.equoteId'],
                            label: 'sales_forecasts.fields.equote'|trans({}, 'sales_forecasts')
                        },
                        asm: {
                            properties: ['salesForecast.asm.lastname', 'salesForecast.asm.firstname'],
                            label: 'sales_forecasts.fields.asm'|trans({}, 'sales_forecasts')|capitalize,
                            link: {
                                'route': 'directory_people_show',
                                'params': {'id':'salesForecast.asm.@id'}
                            }
                        },
                        factory: {
                            properties: ['salesForecast.factory.name'],
                            label: 'fields.factory'|trans({}, 'messages')|capitalize,
                            link:{
                                route: 'directory_locations_show',
                                params: {'id':'salesForecast.factory.@id'},
                            }
                        },
                        sso: {
                            properties: ['salesForecast.sso.name'],
                            label: 'fields.sso'|trans({}, 'messages'),
                            link:{
                                route: 'directory_locations_show',
                                params: {'id':'salesForecast.sso.@id'},
                            }
                        },
                        status: {
                            label: 'forecast_closures.fields.fcr_status'|trans
                        },
                        sfrStatus: {
                            properties: ['salesForecast.status'],
                            label: 'forecast_closures.fields.sfr_status'|trans
                        },
                        sfrCreationDate: {
                            properties: ['salesForecast.createdAt'],
                            label: 'forecast_closures.fields.sfr_date_creation'|trans,
                            filters: 'date("Y-m-d H:i:s")'
                        },
                        sfrClosureDate: {
                            properties: ['salesForecast.closedAt'],
                            label: 'forecast_closures.fields.sfr_date_closure'|trans,
                            filters: 'date("Y-m-d H:i:s")'
                        },
                        estimatedSaleDate: {
                            properties: ['salesForecast.estimatedSaleDate'],
                            label: 'forecast_closures.fields.sfr_date'|trans,
                            filters: 'date("Y-m")'
                        },
                        createdAt: {
                            label: 'forecast_closures.fields.sfr_date'|trans,
                            filters: 'date("Y-m-d H:i:s")'
                        },
                        reason: {
                            label: 'forecast_closures.fields.reason'|trans|capitalize,
                            template: 'sales/forecast_closures/partial/_status.html.twig'
                        },
                    },
                    title: 'sidebar.sales.fcr'|trans({}, 'sidebar') ~ '#' ~ forecastClosure.id,
                    data: forecastClosure
                },
            }, with_context = false) }}
        </div>
        <div class="col-md-6">
            {{ include('helper/_report_table.html.twig', {
                reportTable: {
                    items: {
                        id: {
                            label: 'sidebar.sales.cpr'|trans({}, 'sidebar')~'#',
                            link:{
                                route: 'competitor_pricings_show',
                                params: {'id':'@id'},
                            },
                            sortable: 'numeric'
                        },
                        competitor: {
                            properties: ['competitor.name'],
                            label: 'competitors.name'|trans({}, 'sales_competitors'),
                            link:{
                                route: 'sales_competitors_show',
                                params: {'id':'competitor.@id'},
                            }
                        },
                        quantity: {
                            label: 'fields.quantity'|trans({}, 'messages')
                        },
                        price: {
                            label: 'competitor_pricings.fields.price'|trans({}, 'competitor_pricings'),
                            filters: ['number_format(2)'],
                            preserveNull: true
                        },
                        currency: {
                            properties: ['currency.name'],
                            label: 'competitor_pricings.fields.currency'|trans({}, 'competitor_pricings')
                        },
                        markupPercentage: {
                            label: 'competitor_pricings.fields.markup'|trans({}, 'competitor_pricings')
                        },
                    },
                    title: 'competitor_pricings.title'|trans({}, 'competitor_pricings'),
                    data: competitorPricings,
                    initialSorting: false,
                    pagination: false
                }
            }, with_context = false) }}

            {% set items = {
                filePath: {
                    label: 'menu.files'|trans({}, 'messages')|capitalize,
                    filters : 'slice(37)',
                },
                description: {
                    label: 'fields.description'|trans({}, 'messages') | capitalize,
                },
                createdAt: {
                    label: 'customers.fields.created_at'|trans({}, 'sales_customers')|capitalize,
                    filters: 'date("Y-m-d H:i:s")'
                },
                size: {
                    label: 'size'|trans({}, 'messages')|trans|capitalize,
                    filters : 'readable_filesize'
                },
                download: {
                    label: 'menu.download'|trans({}, 'messages')|capitalize,
                    link:{
                        route: 'forecast_closure_files_show',
                        content: '<span class="btn btn-primary btn-sm"><i class="fa fa-download fa-fw"></i></span>',
                        params: {
                            'id': 'id'
                        },
                        fixedParams: {
                            'forecastClosureId': forecastClosure.id
                        }
                    },
                    sortable: false,
                    class: 'text-center'
                }
            } %}
            {% if is_granted('FORECAST_CLOSURE_WRITE_VOTER', forecastClosure['@id']) %}
                {% set items = items | merge ({
                    delete: {
                        label: 'menu.delete'|trans([], 'messages')|capitalize,
                        link:{
                            route: 'forecast_closure_delete_file',
                            fixedParams: {'forecastClosureId': forecastClosure.id, '_token': csrf_token('delete_forecast_closure_file')},
                            params: {'id':'id'},
                            content: '<span class="btn btn-danger btn-sm"><i class="fa fa-trash fa-fw"></i></span>',
                            popup: {
                                type: 'confirmation',
                                title: 'Confirmation',
                                message: 'Are you sure to delete ?',
                            },
                        },
                        sortable: false,
                        class: 'text-center'
                    },
                }) %}
            {% endif %}
            {{ include('helper/_report_table.html.twig', {
                reportTable: {
                    items: items,
                    title: 'forecast_closures.files'|trans,
                    data: forecastClosure.forecastClosureFiles,
                    search: false,
                    initialSorting: false,
                    pagination: false
                }
            }, with_context = false) }}
            {% if is_granted('FORECAST_CLOSURE_WRITE_VOTER', forecastClosure['@id']) %}
                <div class="ibox float-e-margins collapsed">
                    <div class="ibox-title">
                        <h5>{{ 'demo.fields.add_file' | trans([], 'demo') }}</h5>
                        <div class="ibox-tools">
                            <a class="collapse-link">
                                <i class="fa fa-chevron-up"></i>
                            </a>
                        </div>
                    </div>
                    <div class="ibox-content">
                        <div class="row">
                            <div class="col-lg-12">
                                {% form_theme form 'form_theme_vertical.html.twig' %}

                                {{ form_start(form, { action: path('forecast_closures_show', {'id': forecastClosure.id}) }) }}
                                {{ form_errors(form) }}

                                {{ form_row(form.file) }}
                                {{ form_row(form.description) }}
                                {{ form_row(form.submit) }}

                                {{ form_rest(form) }}

                                {{ form_end(form) }}
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'menu.logs' | trans({}, 'messages') }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    <div class="logs-block" data-resource="{{ forecastClosure['@id'] }}"></div>
                </div>
            </div>
        </div>
    </div>

{% endblock %}

{% block translations %}
    {{ parent() }}
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'messages' }) }}"></script>
{% endblock %}
