{% trans_default_domain 'forecast_closures' %}

{% block content %}
    {% form_theme form 'form_theme_vertical.html.twig' %}

    {{ form_start(form, { action: action }) }}
    {{ form_errors(form) }}

    <div class="row">
        <div class="col-md-6">{{ form_row(form.status) }}</div>
        <div class="col-md-6">{{ form_row(form.reason) }}</div>
    </div>
    <div class="row">
        <div class="col-md-6">{{ form_row(form.competitor) }}</div>
        <div class="col-md-2">{{ form_row(form.orderedQuantity) }}</div>
        <div class="col-md-2">{{ form_row(form.price) }}</div>
        <div class="col-md-2">{{ form_row(form.currency) }}</div>
    </div>
    <div class="row">
        <div class="col-md-6">{{ form_row(form.comment) }}</div>
    </div>
    {{ form_row(form.submit) }}

    {{ form_rest(form) }}
    {{ form_end(form) }}
{% endblock %}

