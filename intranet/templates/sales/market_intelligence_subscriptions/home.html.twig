{% extends 'sales/market_intelligence/layout.html.twig' %}
{% trans_default_domain 'market_intelligence' %}

{% block title %}{{ parent() }}{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-lg-12">
            {{ include('helper/_report_table.html.twig', {
                reportTable: {
                    items: {
                        type: {
                            label: 'market_intelligence.fields.mim_type'|trans,
                            properties: ['type.name'],
                        },
                        productType: {
                            properties: ['productType.englishName'],
                            label: 'catalogue.family.type'|trans({}, 'catalogue'),
                        },
                        customer: {
                            properties: ['customer.name'],
                            label: 'demo.fields.customer'|trans({}, 'demo')|capitalize,
                        },
                        competitor: {
                            properties: ['competitor.name'],
                            label: 'competitors.name'|trans({}, 'sales_competitors')|capitalize,
                        },
                        supplier: {
                            label: 'finance.approver.supplier'|trans({}, 'finance')|capitalize,
                        },
                        delete: {
                            label: 'contacts.menu.delete'|trans({}, 'contacts'),
                            link:{
                                route: 'market_intelligence_subscription_delete',
                                params: {'id':'@id'},
                                content: '<span class="btn btn-danger btn-sm"><i class="fa fa-trash fa-fw popup"></i></span>',
                                fixedParams: {'_token': csrf_token('delete_subscription')},
                                popup: {
                                    type: 'confirmation',
                                    title: 'Confirmation',
                                    message: 'Are you sure you want to delete ?',
                                },
                            },
                        },
                    },
                    initialSorting: false,
                    search: false,
                    title: 'subscriptions.my_subscriptions'|trans,
                    data: marketIntelligenceSubscriptions,
                }
            }, with_context = false) }}
        </div>

    </div>
{% endblock %}
