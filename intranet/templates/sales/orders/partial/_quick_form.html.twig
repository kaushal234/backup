{% form_theme idForm 'form_theme_vertical.html.twig' %}
{% form_theme legacyIdForm 'form_theme_vertical.html.twig' %}

<div class="ibox float-e-margins{% if app.request.query.all|length == 0 %} collapsed{% endif %}">
    <div class="ibox-title">
        <h5>SOR {{ 'titles.quick_access'|trans }}</h5>
        <div class="ibox-tools">
            <a class="collapse-link">
                <i class="fa fa-chevron-up"></i>
            </a>
        </div>
    </div>
    <div class="ibox-content">
        {{ form_start(idForm) }}
        {{ form_errors(idForm) }}
        {{ form_row(idForm.id) }}
        {{ form_rest(idForm) }}
        <div>
            <button type="submit" id="id-quick-access-submit" class="btn btn-primary">{{ 'button.submit'|trans }}</button>
        </div>
        {{ form_end(idForm) }}

        {{ form_start(legacyIdForm) }}
        {{ form_errors(legacyIdForm) }}
        {{ form_row(legacyIdForm.legacyId) }}
        {{ form_rest(legacyIdForm) }}
        <div>
            <button type="submit" id="legacy-id-quick-access-submit" class="btn btn-primary">{{ 'button.submit'|trans }}</button>
        </div>
        {{ form_end(legacyIdForm) }}
    </div>
</div>
