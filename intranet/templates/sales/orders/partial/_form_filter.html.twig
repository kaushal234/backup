{% form_theme form 'form_theme_vertical.html.twig' %}

{{ form_start(form) }}
{{ form_errors(form) }}

<div class="row">
    <div class="col-lg-4">
        {{ form_row(form.sso) }}
    </div>
    <div class="col-lg-4">
        {{ form_row(form.juridicalLocation) }}
    </div>
    <div class="col-lg-4">
        {{ form_row(form.baanCustomerNumber) }}
    </div>
</div>
<div class="row">
    <div class="col-lg-4">
        {{ form_row(form.status) }}
    </div>
    <div class="col-lg-4">
        {{ form_row(form.equoteId) }}
    </div>
    <div class="col-lg-4">
        {{ form_row(form.baanOrderNumbers) }}
    </div>
</div>
<div class="row">
    <div class="col-lg-4">
        {{ form_row(form.asm) }}
    </div>
    <div class="col-lg-4">
        {{ form_row(form.buyer) }}
    </div>
    <div class="col-lg-4">
        {{ form_row(form.endUser) }}
    </div>
</div>
<div class="row">
    <div class="col-lg-4">
        {{ form_row(form.salesAgent) }}
    </div>
    <div class="col-lg-4">
        {{ form_row(form.customerPurchaseOrders) }}
    </div>
    <div class="col-lg-4">
        {{ form_row(form.newCustomer) }}
    </div>
</div>
<div class="row">
    <div class="col-lg-4">
        {{ form_row(form.entered_at_after) }}
    </div>
    <div class="col-lg-4">
        {{ form_row(form.entered_at_before) }}
    </div>
    <div class="col-lg-4">
    </div>
</div>

<div class="row">
    {% do form.download.setRendered %}
    {{ form_rest(form) }}
    <div class="col-lg-12">
        <button class="btn btn-primary" type="submit">{{ 'button.filter'| trans | upper }}</button>
        <a href="{{ resetPath }}" class="btn btn-secondary">{{ 'button.reset'| trans | upper }}</a>
        <button class="btn btn-primary btn-danger" type="submit" id="download" name="download"><i class="fa fa-download"></i>&nbsp;{{ 'menu.download'|trans([],'messages')|upper }}</button>
    </div>
</div>
{{ form_end(form) }}
