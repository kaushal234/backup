{% extends 'sales/orders/layout.html.twig' %}
{% trans_default_domain 'sales_orders' %}

{% block content %}
    <div class="row">
        <div class="col-lg-3">
            {{ include('sales/orders/partial/_quick_form.html.twig', { idForm: quickAccess, legacyIdForm: quickAccessLegacy }, with_context=false) }}
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            {{ data_table(orderDatatable) }}
        </div>
    </div>
    {% if ordersBySphByStatusReport|default([])|length > 0 %}
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins{% if app.request.query.all|length > 0 %} collapsed{% endif %}">
                <div class="ibox-title">
                    <h5>{{ 'sales_order.reports.by_sso_status' | trans }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {{ include('helper/_matrix_table.html.twig', {
                        data: ordersBySphByStatusReport,
                        link: {
                            route: 'sales_orders_home',
                            xParam: 'filter_order[sso][value]',
                            yParam: 'filter_order[status][value][]',
                        },
                        headers: {
                            columns: ['PENDING', 'IN PROGRESS', 'CLOSED']
                        },
                    }, with_context=false) }}
                </div>
            </div>
        </div>
    </div>
    {% endif %}
{% endblock %}
