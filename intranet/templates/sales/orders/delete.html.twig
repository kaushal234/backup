{% extends 'sales/orders/layout.html.twig' %}
{% trans_default_domain 'sales_orders' %}

{% block title %}{{ parent() }}\{{ 'menu.delete'|trans([], 'messages')|capitalize }}{% endblock %}

{% block content %}
        {% form_theme form 'form_theme_vertical.html.twig' %}
        {{ form_start(form) }}
        {{ form_errors(form) }}
        <div class="col-lg-6">
            <div class="mail-box-header clearfix">
                <h2 id="customer-title">{{ 'menu.delete'|trans([], 'messages')|capitalize }} #{{ order.id }}</h2>
            </div>
            {% if order.lines is empty %}
                <div class="mail-box">
                    <div class="mail-body">
                        {{ form_rest(form) }}
                    </div>
                </div>
                <button type="submit" class="btn btn-danger float-end text-capitalize">{{ 'menu.delete'|trans([], 'messages') }}</button>
                {{ form_end(form) }}
            {% else %}
                <div class="mail-box">
                    <div class="mail-body">
                        <p>{{ 'sales_order.messages.delete_unavailable' | trans({'%solCount%':order.lines | length}) }}</p>
                    </div>
                </div>
            {% endif %}
        </div>
{% endblock %}
