{% extends 'sales/sales_forecasts/layout.html.twig' %}
{% trans_default_domain 'sales_forecasts' %}

{% block title %}{{ parent() }}{% endblock %}

{% block content %}
    <div class="row">
        <div class="d-flex justify-content-center">
            <div class="col-md-4 col-md-offset-4">
                <div class="ibox float-e-margins">
                    <div class="ibox-title">
                        <h5>{{ 'fields.sso' | trans({}, 'messages') }}</h5>
                        <div class="ibox-tools">
                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                        </div>
                    </div>
                    <div class="ibox-content">
                        {% form_theme form 'form_theme_horizontal.html.twig' %}
                        {{ form_start(form) }}
                        <div class="row">
                            <div class="col-9">
                                {{ form_widget(form) }}
                            </div>
                            <div class="col-3">

                                <button type="submit" class="btn btn-info"><i class="fa fa-plus"></i> {{ 'button.submit' | trans([], 'messages') }}</button>
                            </div>
                        </div>
                        {{ form_rest(form) }}
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="row">
            <div class="col-md-6 highcharts" data-options="{{ chart|json_encode }}" id="container" style="min-width: 400px; height: 500px;"></div>
            <div class="col-md-6 highcharts" data-options="{{ chartPonderated|json_encode }}" id="containerPonderated" style="min-width: 400px; height: 500px;"></div>
        </div>
        <br>
        <div class="row">
            <div class="col-md-6 highcharts" data-options="{{ chartFactory|json_encode }}" id="containerFactory" style="min-width: 400px; height: 500px;"></div>
            <div class="col-md-6 highcharts" data-options="{{ chartPonderatedFactory|json_encode }}" id="containerPonderatedFactory" style="min-width: 400px; height: 500px;"></div>
        </div>
        <br>
    </div>
{% endblock %}

