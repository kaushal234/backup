{% block content %}
    {% form_theme form 'form_theme_vertical.html.twig' %}

    {{ form_start(form, { action: action }) }}
    {{ form_errors(form) }}
    <div class="row">
        <div class="col-md-4">{{ form_row(form.asm) }}</div>
        <div class="col-md-4">{{ form_row(form.sso) }}</div>
        <div class="col-md-4">{{ form_row(form.equoteId) }}</div>
    </div>
    <div class="row">
        <div class="col-md-4">{{ form_row(form.status) }}</div>
        <div class="col-md-4">{{ form_row(form.buyer) }}</div>
        <div class="col-md-4">{{ form_row(form.endUser) }}</div>
    </div>
    <div class="row">
        <div class="col-md-4">{{ form_row(form.thirdParty) }}</div>
        <div class="col-md-4">{{ form_row(form.country) }}</div>
        <div class="col-md-4">{{ form_row(form.quote) }}</div>
    </div>
    <div class="row">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">{{ form_row(form.airport) }}</div>
                        <div class="col-md-3">{{ form_row(form.factory) }}</div>
                        <div class="col-md-3">{{ form_row(form.estimatedSaleDate, {'date_pattern': '<span style="display: none;">{{ day }}</span> {{ month }}{{ year }}'}) }}</div>
                        <div class="col-md-3">{{ form_row(form.quantity) }}</div>
                    </div>
                    <div class="row">
                        <div class="col-md-2">{{ form_row(form.margin) }}</div>
                        <div class="col-md-2">{{ form_row(form.price) }}</div>
                        <div class="col-md-2">{{ form_row(form.successPercentage) }}</div>
                        <div class="col-md-2">{{ form_row(form.customerSuccessPercentage) }}</div>
                        <div class="col-md-2">{{ form_row(form.product) }}</div>
                        <div class="col-md-2">{{ form_row(form.tier) }}</div>
                    </div>
                    {{ form_row(form.comment) }}
                    {{ form_widget(form.notificationRestricted) }}
                    {{ form_widget(form.notifyPackage) }}
                </div>
            </div>
    </div>
    {% if linkedSalesForecasts |length > 0 %}
        <div class="row">
            <div class="col-md-12">
                <hr>
                {{ form_widget(form.synchronized) }}
            </div>
        </div>
    {% endif %}

    {{ form_row(form.submit) }}

    {{ form_rest(form) }}
    {{ form_end(form) }}


{% endblock %}
