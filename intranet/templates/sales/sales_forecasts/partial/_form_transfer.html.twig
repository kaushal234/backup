{% block content %}
    {% form_theme form 'form_theme_vertical.html.twig' %}

    {{ form_start(form, { action: action }) }}
    {{ form_errors(form) }}
    <div class="row">
        <div class="col-md-3">{{ form_row(form.sso) }}</div>
        <div class="col-md-3">{{ form_row(form.asmSource) }}</div>
    </div>
    <div class="row">
        <div class="col-md-3">{{ form_row(form.buyer) }}</div>
        <div class="col-md-3">{{ form_row(form.endUser) }}</div>
        <div class="col-md-3">{{ form_row(form.country) }}</div>
    </div>
    <hr>
    <div class="row">
        <div class="col-md-3">{{ form_row(form.asmTarget) }}</div>
    </div>

    {{ form_row(form.submit) }}

    {{ form_rest(form) }}
    {{ form_end(form) }}

{% endblock %}
