{% form_theme form 'form_theme_vertical.html.twig' %}


{{ form_start(form) }}
{{ form_errors(form) }}

<div class="row">
    <div class="col-lg-3">
        {{ form_row(form.buyer) }}
    </div>
    <div class="col-lg-3">
        {{ form_row(form.endUser) }}
    </div>
    <div class="col-lg-3">
        {{ form_row(form['closedAt-after']) }}
    </div>
    <div class="col-lg-3">
        {{ form_row(form['createdAt-after']) }}
    </div>
</div>
<div class="row">
    <div class="col-lg-3">
        {{ form_row(form.factory) }}
    </div>
    <div class="col-lg-3">
        {{ form_row(form.sso) }}
    </div>
    <div class="col-lg-3">
        {{ form_row(form.airport) }}
    </div>
    <div class="col-lg-3">
        {{ form_row(form.status) }}
    </div>
</div>
<div class="row">
    <div class="col-lg-3">
        {{ form_row(form.asm) }}
    </div>
    <div class="col-lg-3">
        {{ form_row(form.country) }}
    </div>
    <div class="col-lg-3">
        {{ form_row(form.family) }}
    </div>
    <div class="col-lg-3">
        {{ form_row(form.tier) }}
    </div>
</div>
<div class="row">
    <div class="col-lg-3">
        {{ form_widget(form.delinquent) }}
    </div>
    <div class="col-lg-3">
        {{ form_widget(form.hot_deals) }}
    </div>
</div>

<div class="row">
    {{ form_rest(form) }}
    <div class="col-lg-12">
        <hr class="hr-line-dashed">
        <div class="float-end">
            <label class="col-form-label">&nbsp;</label>
            <button class="btn btn-primary" type="submit">{{ 'button.filter'| trans | upper }}</button>
            <a href="{{ resetPath }}" class="btn btn-secondary">{{ 'button.reset'| trans | upper }}</a>
        </div>
    </div>
</div>
{{ form_end(form) }}
