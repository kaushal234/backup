{% trans_default_domain 'sales_forecasts' %}

{% block content %}
    {% form_theme form 'form_theme_vertical.html.twig' %}

    {{ form_start(form, { action: action }) }}
    {{ form_errors(form) }}
        <div class="col-md-6">
            <div>{{ form_row(form.status) }}</div>
            <div>
                {% if form.comment is defined %}<div>{{ form_row(form.comment) }}</div>{% endif %}
                {% if form.cancellationPropagated is defined %}<div>{{ form_row(form.cancellationPropagated) }}</div>{% endif %}
            </div>
            <div class="text-end">
                <button type="submit" class="btn btn-info">{{ 'sales_forecasts.close'|trans }}</button>
            </div>
        </div>

    {{ form_rest(form) }}
    {{ form_end(form) }}
{% endblock %}
