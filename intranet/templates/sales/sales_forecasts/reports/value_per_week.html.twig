{% extends 'sales/sales_forecasts/layout.html.twig' %}
{% trans_default_domain 'sales_forecasts' %}

{% block title %}{{ parent() }}{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'sales_forecasts.reports.valorization_per_week' | trans({'%currency%': selectedCurrency}) }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                    </div>
                </div>
                <div class="ibox-content">
                    {% form_theme form 'form_theme_vertical.html.twig' %}
                    {{ form_start(form) }}
                    <div class="row">
                        <div class="col-md-3">{{ form_row(form.currency) }}</div>
                        <div class="col-md-3">{{ form_row(form.saleDateDistance) }}</div>
                        <div class="col-md-3">{{ form_row(form.startDate) }}</div>
                        <div class="col-md-3">{{ form_row(form.endDate) }}</div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">{{ form_row(form.product) }}</div>
                        <div class="col-md-3">{{ form_row(form.productTypes) }}</div>
                        <div class="col-md-3">{{ form_row(form.sso) }}</div>
                        <div class="col-md-3">{{ form_row(form.factory) }}</div>
                    </div>
                    <div class="row">
                        <div class="col-lg-6 col-md-6">{{ form_widget(form.ponderated) }}</div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">{{ form_row(form.submit) }}</div>
                    </div>
                    {{ form_errors(form) }}
                    {{ form_end(form) }}

                    <hr>
                    {% if chart.rows is defined %}
                        <div class="highcharts" data-options="{{ chart | json_encode }}" style="min-width: 400px; height: 700px;"></div>
                    {% else %}
                        <div class="alert alert-primary text-center" role="alert">{{ 'no_results' | trans({}, 'messages') }}</div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
