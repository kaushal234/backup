{% extends 'sales/sales_forecasts/layout.html.twig' %}
{% trans_default_domain 'sales_forecasts' %}

{% block title %}{{ parent() }}{% endblock %}

{% block content %}
    {% if is_granted('ACL_ROLE_EVP') or is_granted('ACL_ROLE_CEO') or is_granted('ACL_SUPERUSER') %}

        <div class="row">
            <div class="d-flex justify-content-center">
                <div class="col-md-4 col-md-offset-4">
                    <div class="ibox float-e-margins">
                        <div class="ibox-title">
                            <h5>{{ 'sales_forecasts.choose_asm' | trans }}</h5>
                            <div class="ibox-tools">
                                <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                            </div>
                        </div>
                        <div class="ibox-content">
                            {% form_theme form 'form_theme_horizontal.html.twig' %}
                            {{ form_start(form) }}
                            <div class="row">
                                <div class="col-9">
                                    {{ form_widget(form) }}
                                </div>
                                <div class="col-3">
                                    <button type="submit" class="btn btn-info"><i class="fa fa-plus"></i> {{ 'button.submit' | trans([], 'messages') }}</button>
                                </div>
                            </div>
                            {{ form_rest(form) }}
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
    <div class="row">
        <div class="row">
            <div class="col-md-6 highcharts" data-options="{{ chart|json_encode }}" style="min-width: 400px; height: 500px;"></div>
            <div class="col-md-6 highcharts" data-options="{{ chartPonderated|json_encode }}" style="min-width: 400px; height: 500px;"></div>
        </div>
        <br>
        <div class="row">
            <div class="col-md-6 highcharts" data-options="{{ chartFactory|json_encode }}" style="min-width: 400px; height: 500px;"></div>
            <div class="col-md-6 highcharts" data-options="{{ chartPonderatedFactory|json_encode }}" style="min-width: 400px; height: 500px;"></div>
        </div>
        <br>

        <div class="row">
            <div class="col-md-6">
                <div class="ibox float-e-margins">
                    {% set today = 'now' | date('Y-m-d') %}
                    {% set in_three_months = 'now + 3 months' | date('Y-m-d') %}
                    {{ include('helper/_report_table.html.twig', {
                        reportTable: {
                            data: topTenCustomers,
                            pagination: false,
                            search: false,
                            initialSorting: false,
                            title: 'sales_forecasts.reports.top_ten_customer'|trans,
                            items : {
                                name: {
                                    label: 'sales_forecasts.fields.buyer_user'|trans,
                                    link:{
                                        route: 'sales_customers_show',
                                        params: {id: 'id'},
                                    }
                                },
                                value: {
                                    label: 'sales_forecasts.fields.value'|trans,
                                    filters: ["number_format(2, '.', ' ')", 'concat(" ' ~ currency ~ '")']
                                },
                                view: {
                                    label: 'menu.view'|trans([], 'messages')|capitalize,
                                    link:{
                                        route: 'sales_forecasts_home',
                                        params: {customer: 'iri'},
                                        fixedParams: {status: ['BUDGET', 'IN_PROGRESS', 'DELAYED'], estimatedSaleDate: { after : today, before : in_three_months }},
                                        content: '<span class="btn btn-primary btn-sm"><i class="far fa-eye fa-fw"></i></span>',
                                    },
                                    sortable: false,
                                    class: 'text-end'
                                },
                            }
                        }
                    }, with_context=false) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="ibox float-e-margins">
                    <div class="ibox-title">
                        <h5>{{ 'sales_forecasts.reports.by_sso_factory_deliquent_asm' | trans({'%lastname%': asm.lastname, '%firstname%': asm.firstname}) }}</h5>
                        <div class="ibox-tools">
                            <a class="collapse-link">
                                <i class="fa fa-chevron-up"></i>
                            </a>
                        </div>
                    </div>
                    <div class="ibox-content">
                        {{ include('helper/_matrix_table.html.twig', {
                            data: SFRBySSOFactoryDelinquentForAsm,
                            showZero: false,
                            link: {
                                route: 'sales_forecasts_list_gantt',
                                xParam: 'sso',
                                yParam: 'factory',
                                additionalParams: {delinquent: true, asm: asm['@id']},
                            },
                        }, with_context=false) }}
                    </div>
                </div>
            </div>
        </div>
        <div>
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'sales_forecasts.reports.by_factory_customer_asm' | trans({'%lastname%': asm.lastname, '%firstname%': asm.firstname}) }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {{ include('helper/_matrix_table.html.twig', {
                        data: SFRByFactoryCustomerForAsm,
                        showZero: false,
                        link: {
                            route: 'sales_forecasts_list_gantt',
                            xParam: 'buyer',
                            yParam: 'factory',
                            additionalParams: {asm: asm['@id'], status: ['DELAYED', 'IN_PROGRESS', 'BUDGET']},
                        },
                    }, with_context=false) }}
                </div>
            </div>
        </div>
        <div>
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'sales_forecasts.reports.by_sso_factory_hot_deals_asm' | trans({'%lastname%': asm.lastname, '%firstname%': asm.firstname}) }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {{ include('helper/_matrix_table.html.twig', {
                        data: SFRBySSOFactoryHotDealsForAsm,
                        showZero: false,
                        link: {
                            route: 'sales_forecasts_list_gantt',
                            xParam: 'sso',
                            yParam: 'factory',
                            additionalParams: {hot_deals: true, asm: asm['@id']}
                        },
                    }, with_context=false) }}
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="ibox float-e-margins">
                    <div class="ibox-title">
                        <h5>{{ 'sales_forecasts.reports.by_sso_factory_recently_ordered_asm' | trans({'%lastname%': asm.lastname, '%firstname%': asm.firstname}) }}</h5>
                        <div class="ibox-tools">
                            <a class="collapse-link">
                                <i class="fa fa-chevron-up"></i>
                            </a>
                        </div>
                    </div>
                    <div class="ibox-content">
                        {{ include('helper/_matrix_table.html.twig', {
                            data: SFRBySSOFactoryRecentlyOrderedForAsm,
                            showZero: false,
                            link: {
                                route: 'sales_forecasts_home',
                                xParam: 'sso',
                                yParam: 'factory',
                                additionalParams: {status: 'ORDERED', 'closedAt-after': limit_date, gantt:true, asm: asm['@id']}
                            },
                        }, with_context=false) }}
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="ibox float-e-margins">
                    <div class="ibox-title">
                        <h5>{{ 'sales_forecasts.reports.by_sso_factory_recently_lost_asm' | trans({'%lastname%': asm.lastname, '%firstname%': asm.firstname}) }}</h5>
                        <div class="ibox-tools">
                            <a class="collapse-link">
                                <i class="fa fa-chevron-up"></i>
                            </a>
                        </div>
                    </div>
                    <div class="ibox-content">
                        {{ include('helper/_matrix_table.html.twig', {
                            data: SFRBySSOFactoryRecentlyLostForAsm,
                            showZero: false,
                            link: {
                                route: 'sales_forecasts_home',
                                xParam: 'sso',
                                yParam: 'factory',
                                additionalParams: {status: 'LOST', 'closedAt-after': limit_date, gantt:true, asm: asm['@id']}
                            },
                        }, with_context=false) }}
                    </div>
                </div>
            </div>
        </div>

        <div>
            {{ include('helper/_report_table.html.twig', {
                reportTable: {
                    items: {
                        id: {
                            label: 'customers.fields.id'|trans([], 'sales_customers'),
                            link:{
                                route: 'sales_customers_show',
                                params: {'id':'@id'},
                            }
                        },
                        name: {
                            label: 'customers.fields.name'|trans([], 'sales_customers'),
                            link:{
                                route: 'sales_customers_show',
                                params: {'id':'@id'},
                            }
                        },
                        view: {
                            label: 'menu.view'|trans([], 'messages')|capitalize,
                            link:{
                                route: 'sales_customers_show',
                                params: {'id':'@id'},
                                content: '<span class="btn btn-primary btn-sm"><i class="far fa-eye fa-fw"></i></span>',
                            },
                            sortable: false,
                            class : 'text-end'
                        },
                    },
                    title: 'sales_forecasts.not_active_customers'|trans({'%lastname%': asm.lastname, '%firstname%': asm.firstname}),
                    data: notActiveCustomers,
                }
            }, with_context = false) }}
        </div>
    </div>
{% endblock %}

