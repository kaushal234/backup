{% extends 'sales/sales_forecasts/layout.html.twig' %}
{% trans_default_domain 'sales_forecasts' %}

{% block content %}
    <div class="row">
        <div class="col-lg-9 col-sm-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'sales_forecasts.reports.by_sso_customer' | trans }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {% form_theme form 'form_theme_vertical.html.twig' %}
                    {{ form_start(form) }}
                    <div class="row">
                        <div class="col-lg-3 col-md-4">{{ form_row(form.currency) }}</div>
                        <div class="col-lg-3 col-md-4">{{ form_row(form.estimatedSaleDateAfter) }}</div>
                        <div class="col-lg-3 col-md-4">{{ form_row(form.estimatedSaleDateBefore) }}</div>
                    </div>
                    <div class="row">
                        <div class="col-lg-2 col-md-3">{{ form_row(form.watchList) }}</div>
                        <div class="col-lg-6 col-md-6">{{ form_row(form.ponderated) }}</div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">{{ form_row(form.submit) }}</div>
                    </div>
                    {{ form_errors(form) }}
                    {{ form_end(form) }}

                    <hr>
                    {{ include('helper/_matrix_table.html.twig', {
                        data: customerReport,
                        removeXTotalsParam: true,
                        removeYTotalsParam: true,
                        link: {
                            route: 'sales_forecasts_list_gantt',
                            xParam: 'buyer',
                            yParam: 'sso'
                        },
                        filters: {
                            values: ["number_format(0, '.', ' ')", 'slice(0, -4)', 'concat("K ' ~ selectedCurrency ~ '")']
                        },
                        legend: 'all_figures_in_thousands'|trans({}, 'messages'),
                        showZero: false,
                        hideTotals: (customerReport.yTotals|length > 1) ? '': 'x'
                    }, with_context=false) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

