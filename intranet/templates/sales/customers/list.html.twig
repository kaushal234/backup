{% extends 'sales/customers/layout.html.twig' %}
{% trans_default_domain 'sales_customers' %}
{% form_theme idSearchForm 'form_theme_vertical.html.twig' %}
{% form_theme legacyIdSearchForm 'form_theme_vertical.html.twig' %}
{% form_theme search_form 'form_theme_vertical.html.twig' %}

{% block title %}{{ parent() }}{% endblock %}

{% use 'partial/_paginated_list.html.twig' %}

{% block list_header %}
    <div class="paginatedList">
{% endblock %}

{% block content %}
    <script src="/shared/javascript/hinclude/hinclude.min.js"></script>
    <div class="row">
        <div class="col-md-8">
            <h3 class="text-capitalize">{{ 'titles.quick_access' | trans([], 'messages') }}</h3>
            <div class="row">
                <div class="col-md-6">
                    {{ form_start(idSearchForm, { action: path('sales_customers_home') }) }}
                    <div class="row">
                        <div class="col-sm-10">
                            {{ form_widget(idSearchForm) }}
                        </div>
                        <div class="col-sm-2">
                            <input type="submit" name="submit" class="btn btn-primary" value="{{ 'menu.search'|trans([], 'messages')|capitalize }}"/>
                        </div>
                    </div>
                    {{ form_end(idSearchForm) }}
                </div>

                <div class="col-md-6">
                    {{ form_start(legacyIdSearchForm, { action: path('sales_customers_home') }) }}
                    <div class="row">
                        <div class="col-sm-10">
                            {{ form_widget(legacyIdSearchForm) }}
                        </div>
                        <div class="col-sm-2">
                            <input type="submit" name="submit" class="btn btn-primary" value="{{ 'menu.search'|trans([], 'messages')|capitalize }}"/>
                        </div>
                    </div>
                    {{ form_end(legacyIdSearchForm) }}
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <h3 class="text-capitalize">{{ 'customers.search'|trans }}</h3>
            <div >
                <div>
                    {{ form_start(search_form, { action: path('sales_customers_home') }) }}
                    <div class="row">
                        <div class="col-sm-10">
                            {{ form_widget(search_form) }}
                        </div>
                        <div class="col-sm-2">
                            <input type="submit" name="submit" class="btn btn-primary" value="{{ 'menu.search'|trans([], 'messages')|capitalize }}"/>
                        </div>
                    </div>
                    {{ form_end(search_form) }}
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'button.filter' | trans([], 'messages') | upper }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {{ include('sales/partial/_form_filter.html.twig', {
                        form: formFilter,
                        resetPath: path('sales_customers_home')
                    }) }}
                </div>
            </div>
        </div>
    </div>


    <div class="row">
        <div class="col-lg-12">
            {{ include('helper/_report_table.html.twig', {
                reportTable: {
                    search: search_table,
                    pagination: pagination,
                    items: {
                        '@id': {
                            label: 'customers.fields.id'|trans|capitalize,
                            link:{
                                route: 'sales_customers_show',
                                params: {'id':'@id'},
                            },
                            filters: 'iri_id'
                        },
                        name: {label: 'customers.fields.name'|trans|capitalize},
                        customerTypes: {
                            label: 'customers.fields.type'|trans,
                            template: 'sales/customers/partial/cells/_customer_types.html.twig',
                        },
                        country: {
                            properties: ['country.name'],
                            label: 'customers.fields.address_country'|trans|capitalize
                        },
                        asm: {
                            label: 'customers.fields.main_asm'|trans,
                            template: 'sales/customers/partial/cells/_main_asm.html.twig',
                        },
                        status: {label: 'customers.fields.status'|trans|capitalize},
                        view: {
                            label: 'menu.view'|trans([], 'messages')|capitalize,
                            link:{
                                route: 'sales_customers_show',
                                params: {'id':'@id'},
                                content: '<span class="btn btn-primary btn-sm"><i class="far fa-eye fa-fw"></i></span>',
                            },
                            sortable: false,
                            class : 'text-end'
                        },
                    },
                    initialSorting: false,
                    title: report_title|trans,
                    data: customers
                }
            }, with_context = false) }}
        </div>
    </div>
    <div class="ibox float-e-margins">
        <div class="ibox-title">
            <h5>{{ 'customers.fields.last_seq'|trans }}</h5>
            <div class="ibox-tools">
                <a class="collapse-link">
                    <i class="fa fa-chevron-up"></i>
                </a>
            </div>
        </div>
        <div class="ibox-content">
            <hx:include src="/en/private/calendar/seq/seq_hinclude.php" id="block_seq">
                <div class="text-center"><span class="fa fa-refresh fa-spin"></span></div>
            </hx:include>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ include('partial/_footable.html.twig', {'selectors': ['#block_seq']}) }}

{% endblock %}

{% block form_label -%}
    {{ include('sales/partial/input_with_no_label.html.twig') }}
{%- endblock form_label %}

{% block translations %}
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'sales_customers' }) }}"></script>
{% endblock %}
