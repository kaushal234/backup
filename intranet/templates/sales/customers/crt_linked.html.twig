{% extends 'sales/customers/layout.html.twig' %}
{% trans_default_domain 'sales_customers' %}

{% block title %}{{ parent() }}{% endblock %}

{% block content %}
    {% if customer.crt | length == 0 %}
        <h5>No records...</h5>
    {% elseif customer.crt | length > 1 %}
        <div class="ibox float-e-margins">
            <div class="ibox-title">
                <h5>{{ translation |trans }}</h5>
                <div class="ibox-tools">
                    <a class="collapse-link">
                        <i class="fa fa-chevron-up"></i>
                    </a>
                </div>
            </div>
            <div class="ibox-content">
                <table class="footable table table-hover toggle-arrow-tiny report-table">

                    <thead>
                    <th>{{ 'customers.fields.id' | trans | upper }}</th>
                    <th>{{ 'customer_relationship_team.fields.cuno' |trans({}, 'customer_relationship_team') | upper }}</th>
                    <th>{{ 'customer_relationship_team.fields.erp_location' |trans({}, 'customer_relationship_team') | upper }}</th>
                    <th class="text-end">{{ 'menu.view' |trans({}, 'messages') | upper }}</th>
                    </thead>
                    <tbody>
                    {% for crt in customer.crt %}
                        <tr>
                            <td > {{ iri_id(crt) }} </td>
                            <td >{{ crt.customerBusinessPartnerCode }}</td>
                            <td >{% if crt.erpLocation.name is defined %}
                                    <a href="{{ path("directory_locations_show", { 'id': iri_id(crt.erpLocation) }) }}">
                                        {{ crt.erpLocation.name }}
                                    </a>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                {% if target == 'email' %}
                                {% set erp = crt.erpLocation.erp is defined ? crt.erpLocation.erp : '' %}
                                    <a href="{{ path('legacy_sales') }}?m[0]=customers&m[1]=view&m[2]=email&m[3]=compose&id={{ customer.legacyId }}&cuno={{ crt.customerBusinessPartnerCode }}&erp={{ erp }}">
                                        <span class="btn btn-primary btn-sm"><i class="far fa-eye fa-fw"></i></span></a>
                                {% elseif target == 'zip' %}
                                {% set erp = crt.erpLocation.erp is defined ? crt.erpLocation.erp : '' %}
                                    <a href="{{ path('legacy_sales') }}?m[0]=customers&m[1]=view&m[2]=zip&m[3]=download&id={{ customer.legacyId }}&cuno={{ crt.customerBusinessPartnerCode }}&erp={{ erp }}">
                                        <span class="btn btn-primary btn-sm"><i class="far fa-eye fa-fw"></i></span></a>
                                {% else %}
                                {% set cuno = crt.customerBusinessPartnerCode is defined ? '&id=' ~ crt.customerBusinessPartnerCode : '' %}
                                {% set erp = crt.erpLocation.erp is defined ? crt.erpLocation.erp : '' %}
                                <a href="{{ path('legacy_finance') }}?m[0]={{ target }}&m[1]=list&m[2]=byCustomerERP{{ cuno }}&erp={{ erp }}">
                                    <span class="btn btn-primary btn-sm"><i class="far fa-eye fa-fw"></i></span></a>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

{% endblock %}


