{% block content %}
    <div class="row">
        {% form_theme form 'form_theme_vertical.html.twig' %}

        {{ form_start(form, { action: action }) }}
        {{ form_errors(form) }}

        <div class="col-md-6">
            <div class="mail-box-header clearfix">
                <h2 class="float-sart" id="customer-title">
                    Export Customer Type
                </h2>
            </div>
            <div class="mail-box">
                <div class="mail-body">
                    {{ form_row(form.customerType) }}
                    {{ form_row(form.submit) }}
                </div>
            </div>
        </div>
        {{  form_rest(form) }}
        {{ form_end(form) }}
    </div>
{% endblock %}

