{% extends 'sales/market_intelligence/layout.html.twig' %}
{% trans_default_domain 'market_intelligence' %}

{% block title %}{{ parent() }}{% endblock %}

{% block content %}
    <script src="/shared/javascript/hinclude/hinclude.min.js"></script>
    <div class="row">
        <div class="col-md-8">
            {{ include('helper/_association_table.html.twig', {
                associationData: {
                    search: false,
                    title: 'market_intelligence.information' | trans,
                    items: {
                        id: {
                            label: 'market_intelligence.fields.id'|trans
                        },
                        type: {
                            label: 'market_intelligence.fields.mim_type'|trans,
                            properties: ['type.name'],
                        },
                        createdAt: {
                            label: 'demo.fields.created_at'|trans({}, 'demo'),
                            filters: 'date("Y-m-d")'
                        },
                        poster: {
                            label: 'market_intelligence.fields.poster'|trans,
                            properties: ['poster.firstname', 'poster.lastname'],
                            link:{
                                route: 'directory_people_show',
                                params: {'id':'poster.@id'},
                            }
                        },
                        shortDescription: {
                            label: 'market_intelligence.fields.shortDescription'|trans,
                        },
                        url: {
                            label: 'customers.fields.url'|trans({}, 'sales_customers'),
                            template: 'sales/customers/partial/cells/_url.html.twig',
                        },
                        description: {
                            label: 'market_intelligence.fields.description'|trans,
                            filters: ['nl2br']
                        },
                        productTypes: {
                            label: 'market_intelligence.fields.productTypes'|trans|capitalize,
                            template: 'sales/market_intelligence/partial/cells/_product_types.html.twig'
                        },
                        customers: {
                            label: 'market_intelligence.fields.customers'|trans|capitalize,
                            template: 'sales/market_intelligence/partial/cells/_customers.html.twig'
                        },
                        competitors: {
                            label: 'market_intelligence.fields.competitors'|trans|capitalize,
                            template: 'sales/market_intelligence/partial/cells/_competitors.html.twig'
                        },
                        suppliers: {
                            label: 'market_intelligence.fields.suppliers'|trans|capitalize,
                            template: 'sales/market_intelligence/partial/cells/_suppliers.html.twig'
                        },
                        divisions: {
                            label: 'market_intelligence.fields.divisions'|trans|capitalize,
                            template: 'sales/market_intelligence/partial/cells/_divisions.html.twig'
                        },
                        positionLevels: {
                            label: 'market_intelligence.fields.position_levels'|trans|capitalize,
                            template: 'sales/market_intelligence/partial/cells/_position_levels.html.twig'
                        },
                    },
                    data: marketIntelligence
                }
            }, with_context = false) }}
        </div>
        <div class="col-md-4">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'market_intelligence.link.title'|trans }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    <div class="row">
                        <div class="col-lg-12">
                            {% form_theme form_link 'form_theme_vertical.html.twig' %}

                            {{ form_start(form_link, { action: path('market_intelligence_show', {'id': marketIntelligence.id}) }) }}
                            {{ form_errors(form_link) }}
                            <div class="row">
                                <div>
                                    {{ form_widget(form_link.marketIntelligence) }}
                                    {{ form_rest(form_link) }}
                                </div>
                            </div>
                            <div class="float-end">
                                <button class="btn btn-info" type="submit">{{ 'button.submit'| trans({}, 'messages') }}</button>
                            </div>
                            {{ form_end(form_link) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            {{ include('sales/market_intelligence/files_ajax.html.twig', {marketIntelligence: marketIntelligence} )}}
        </div>
        <div class="col-md-6">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'demo.fields.comments'|trans({}, 'demo') }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    <div class="logs-block" data-resource="{{ marketIntelligence.iri }}" data-show-comment-form=true data-hide-logs></div>
                </div>
            </div>
        </div>
    </div>
    {% if marketIntelligence.marketIntelligencesLinked | length > 0 %}
        <div class="row">
            <div class="col-lg-12">
                {{ include('helper/_report_table.html.twig', {
                    reportTable: {
                        items: {
                            id: {
                                label: 'market_intelligence.fields.id'|trans,
                                link:{
                                    route: 'market_intelligence_show',
                                    params: {'id':'@id'},
                                }
                            },
                            type: {
                                label: 'market_intelligence.fields.type'|trans,
                                properties: ['type.name'],
                            },
                            createdAt: {
                                label: 'customers.fields.created_at'|trans({}, 'sales_customers')|capitalize,
                                filters: 'date("Y-m-d")'
                            },
                            shortDescription: {
                                label: 'competitors.fields.short_description'|trans({}, 'sales_competitors')|capitalize,
                            },
                            productTypes: {
                                label: 'market_intelligence.fields.productTypes'|trans|capitalize,
                                template: 'sales/market_intelligence/partial/cells/_product_types.html.twig'
                            },
                            poster: {
                                properties: ['poster.lastname', 'poster.firstname'],
                                label: 'market_intelligence.fields.poster'|trans|capitalize,
                                link: {
                                    route: 'directory_people_show',
                                    params: {'id':'poster.@id'}
                                }
                            },
                            customers: {
                                label: 'market_intelligence.fields.customers'|trans|capitalize,
                                template: 'sales/market_intelligence/partial/cells/_customers.html.twig'
                            },
                            competitors: {
                                label: 'market_intelligence.fields.competitors'|trans|capitalize,
                                template: 'sales/market_intelligence/partial/cells/_competitors.html.twig'
                            },
                            suppliers: {
                                label: 'market_intelligence.fields.suppliers'|trans|capitalize,
                                template: 'sales/market_intelligence/partial/cells/_suppliers.html.twig'
                            },
                        },
                        initialSorting: false,
                        search: false,
                        title: 'market_intelligence.report_title.linked'|trans,
                        data: marketIntelligence.marketIntelligencesLinked,
                    }
                }, with_context = false) }}
            </div>
        </div>
    {% endif %}
    {% if marketIntelligence.legacyId is not same as(null) %}
        <div class="row">
            <div class="col-lg-12">
                <div class="ibox float-e-margins">
                    <div class="ibox-title">
                        <h5>{{ 'market_intelligence.link.tasks_linked'|trans }}</h5>
                        <div class="ibox-tools">
                            <a class="collapse-link">
                                <i class="fa fa-chevron-up"></i>
                            </a>
                        </div>
                    </div>
                    <div class="ibox-content">
                        <hx:include src="/en/private/calendar/tasks/task_sfr_hinclude.php?module=MIM&parent_id={{ marketIntelligence.legacyId }}">
                            <div class="text-center"><span class="fa fa-refresh fa-spin"></span></div>
                        </hx:include>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
    <div class="row">
        <div class="col-md-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'menu.logs'|trans({}, 'messages') |capitalize }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    <div class="logs-block" data-resource="{{ marketIntelligence.iri }}" data-hide-comments></div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block translations %}
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'messages' }) }}"></script>
{% endblock %}
