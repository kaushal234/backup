{% extends 'sales/market_intelligence/layout.html.twig' %}
{% trans_default_domain 'market_intelligence' %}

{% block content %}
    <div id="react" data-is-granted-create="{{ is_granted('FEATURE_COMPETITOR_PRICING_WRITE') }}"></div>
{% endblock %}

{% block javascripts %}
    <script>
      window.SF_INITIAL_STORE_STATE = {{ initialState|json_encode|raw }};
      window.MIM_APP_PROPS = {{ props|json_encode|raw }};
    </script>
    {{ parent() }}
{% endblock %}

{% block translations %}
    {{ parent() }}
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'market_intelligence' }) }}"></script>
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'competitor_pricings' }) }}"></script>
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'sales_competitors' }) }}"></script>
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'sales_customers' }) }}"></script>
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'messages' }) }}"></script>
{% endblock %}
