{% block content %}
    <div class="row">
        {% form_theme form 'form_theme_vertical.html.twig' %}

        {{ form_start(form, { action: action }) }}
        {{ form_errors(form) }}

        <div class="col-md-6 animated fadeInLeft">
            <div class="mail-box-header clearfix">
                <h2 class="float-sart">
                    Main informations
                </h2>
            </div>
            <div class="mail-box">
                <div class="mail-body">
                    {{ form_row(form.customer) }}
                    <hr class="hr-line-dashed">
                    {{ form_row(form.cuno) }}
                </div>
            </div>

            <div class="mail-box-header clearfix">
                <h2 class="float-sart">
                    Contact informations
                </h2>
            </div>
            <div class="mail-box">
                <div class="mail-body">
                    {{ form_row(form.salesRepresentative) }}
                    {{ form_row(form.partsRepresentative) }}
                    {{ form_row(form.serviceRepresentative) }}
                </div>
            </div>
        </div>
        <div class="col-md-6 animated fadeInRight">
            <div class="mail-box-header clearfix">
                <h2 class="float-sart">
                    Locations Information
                </h2>
            </div>
            <div class="mail-box">
                <div class="mail-body">
                    {{ form_row(form.erpLocation) }}
                    <hr class="hr-line-dashed">
                    {{ form_row(form.serviceLocation) }}
                    <hr class="hr-line-dashed">
                    {{ form_row(form.partsLocation) }}
                </div>
            </div>
        </div>

        <div class="col-md-6 animated fadeInRight">
            <div>
                <button type="submit" class="btn btn-primary">{{ 'button.submit'|trans({}, 'messages') }}</button>
            </div>
        </div>
        {{ form_rest(form) }}
        {{ form_end(form) }}
    </div>


{% endblock %}