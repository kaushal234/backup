{% extends 'sales/customer_relationship_teams/layout.html.twig' %}
{% trans_default_domain 'customer_relationship_team' %}

{% block title %}{{ parent() }}{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-6">
            {{ include('helper/_association_table.html.twig', {
                associationData: {
                    search: false,
                    title: 'customer_relationship_team.title.show' | trans,
                    items: {
                        id: {
                            label: 'customer_relationship_team.fields.id'|trans|upper,
                        },
                        legacyId: {
                            label: 'customers.fields.legacyId'|trans({}, 'sales_customers'),
                        },
                        customer: {
                            label: 'customer_relationship_team.fields.customer'|trans,
                            properties: ['customer.name'],
                            link:{
                                route: 'sales_customers_show',
                                params: {'id':'customer.@id'},
                            }
                        },
                        erpLocation: {
                            label: 'customer_relationship_team.fields.erp_location'|trans,
                            properties: ['erpLocation.name'],
                            link:{
                                route: 'directory_locations_show',
                                params: {'id':'erpLocation.@id'},
                            }
                        },
                        serviceLocation: {
                            label: 'customer_relationship_team.fields.service_location'|trans,
                            properties: ['serviceLocation.name'],
                            link:{
                                route: 'directory_locations_show',
                                params: {'id':'serviceLocation.@id'},
                            }
                        },
                        partsLocation: {
                            label: 'customer_relationship_team.fields.parts_location'|trans,
                            properties: ['partsLocation.name'],
                            link:{
                                route: 'directory_locations_show',
                                params: {'id':'partsLocation.@id'},
                            }
                        },
                        customerBusinessPartnerCode: {
                            label: 'customer_relationship_team.fields.business_partner_code'|trans,
                        },
                    },
                    data: customerRelationshipTeam
                }
            }, with_context = false) }}
        </div>
        <div class="col-md-6">
            <div class="ibox float-e-margins {% if associationData.collapse is defined %} collapsed {% endif %}">
                <div class="ibox-title">
                    <h5>{{ 'customer_relationship_team.fields.representative' | trans }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {% if customerRelationshipTeam.salesRepresentative is not same as(null)
                        and customerRelationshipTeam.partsRepresentative is not same as(null)
                        and customerRelationshipTeam.serviceRepresentative is not same as(null) %}
                        <div class="row">
                            {% if customerRelationshipTeam.salesRepresentative is not same as(null) %}
                                <div class="col-md-4">
                                    <h3 class="text-center">{{ 'customer_relationship_team.fields.sales_representative' | trans }}</h3>
                                    {% if customerRelationshipTeam.salesRepresentative.photo is not null %}
                                        <img class="img-fluid rounded-circle"
                                             src="{{ asset(upload_uri ~ '/' ~ customerRelationshipTeam.salesRepresentative.photo.filePath) }}?width=128">
                                    {% else %}
                                        <img class="m-t-xs img-fluid rounded-circle" width="128" src="/shared/no_photo.jpg">
                                    {% endif %}
                                    <h3 class="text-center">
                                        <a href="{{ path('directory_people_show', {'id': iri_id(customerRelationshipTeam.salesRepresentative)}) }}">
                                            {{ customerRelationshipTeam.salesRepresentative.lastname | upper }} {{ customerRelationshipTeam.salesRepresentative.firstname }}
                                        </a>

                                    </h3>
                                </div>
                            {% endif %}
                            {% if customerRelationshipTeam.partsRepresentative is not same as(null) %}
                                <div class="col-md-4">
                                    <h3 class="text-center">{{ 'customer_relationship_team.fields.parts_representative' | trans }}</h3>
                                    {% if customerRelationshipTeam.partsRepresentative.photo is not null %}
                                        <img class="m-t-xs img-fluid rounded-circle"
                                             src="{{ asset(upload_uri ~ '/' ~ customerRelationshipTeam.partsRepresentative.photo.filePath) }}?width=128">
                                    {% else %}
                                        <img class="m-t-xs img-fluid rounded-circle" width="128" src="/shared/no_photo.jpg">
                                    {% endif %}
                                    <h3 class="text-center">
                                        <a href="{{ path('directory_people_show', {'id': iri_id(customerRelationshipTeam.partsRepresentative)}) }}">
                                            {{ customerRelationshipTeam.partsRepresentative.lastname | upper }} {{ customerRelationshipTeam.partsRepresentative.firstname }}
                                        </a>

                                    </h3>
                                </div>
                            {% endif %}
                            {% if customerRelationshipTeam.serviceRepresentative is not same as(null) %}
                                <div class="col-md-4">
                                    <h3 class="text-center">{{ 'customer_relationship_team.fields.service_representative' | trans }}</h3>
                                    {% if customerRelationshipTeam.serviceRepresentative.photo is not null %}
                                        <img class="m-t-xs img-fluid rounded-circle"
                                             src="{{ asset(upload_uri ~ '/' ~ customerRelationshipTeam.serviceRepresentative.photo.filePath) }}?width=128">
                                    {% else %}
                                        <img class="m-t-xs img-fluid rounded-circle" width="128" src="/shared/no_photo.jpg">
                                    {% endif %}
                                    <h3 class="text-center">
                                        <a href="{{ path('directory_people_show', {'id': iri_id(customerRelationshipTeam.serviceRepresentative)}) }}">
                                            {{ customerRelationshipTeam.serviceRepresentative.lastname | upper }} {{ customerRelationshipTeam.serviceRepresentative.firstname }}
                                        </a>
                                    </h3>
                                </div>
                            {% endif %}
                        </div>
                    {% else %}
                        {{ 'customer_relationship_team.no_representatives' | trans}}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    <div>
        {{ include('helper/_report_table.html.twig', {
            reportTable: {
                search: false,
                pagination: false,
                items: {
                    id: {
                        label: 'contacts.fields.id'|trans({}, 'contacts')|capitalize,
                        link:{
                            route: 'sales_contact_show',
                            params: {'id':'@id'},
                        },
                        filters: 'iri_id',
                        sortable: 'numeric'
                    },
                    username: {
                        label: 'contacts.fields.userid'|trans({}, 'contacts')|capitalize,
                    },
                    name: {
                        properties: ['lastname', 'firstname'],
                        label: 'contacts.fields.name'|trans({}, 'contacts')|capitalize
                    },
                    phone: {
                        properties: ['extranetUserProfile.phones.0.type','extranetUserProfile.phones.0.number'],
                        glue : ' : ',
                        label: 'contacts.fields.phone'|trans({}, 'contacts'),
                    },
                    customer: {
                        properties: ['extranetUserProfile.customer.name'],
                        label: 'contacts.fields.customer'|trans({}, 'contacts'),
                        link: {
                            route: 'sales_customers_show',
                            params: {'id':'extranetUserProfile.customer.@id'}
                        }
                    },
                    disabled: {
                        label: 'contacts.fields.extranet_acess' | trans({}, 'contacts'),
                        boolean: {
                            'false': '<span class="d-none">1</span><i class="fa fa-check text-info"></i>',
                            'true': '<span class="d-none">0</span><i class="fa fa-times text-danger"></i>'
                        }
                    },
                },
                title: 'customer_relationship_team.fields.extranet_users_linked'|trans,
                data: extranet_users,
                initialSorting: false
            }
        }, with_context = false) }}
    </div>
    <div>
        <div class="ibox float-e-margins">
            <div class="ibox-title">
                <h5>{{ 'menu.logs'|trans({}, 'messages') }}</h5>
                <div class="ibox-tools">
                    <a class="collapse-link">
                        <i class="fa fa-chevron-up"></i>
                    </a>
                </div>
            </div>
            <div class="ibox-content">
                <div class="logs-block" data-resource="{{ customerRelationshipTeam.iri }}" data-show-comment-form="true"></div>
            </div>
        </div>
    </div>
{% endblock %}

{% block translations %}
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'messages' }) }}"></script>
{% endblock %}

