{% extends 'sales/aircraft_compatibility/layout.html.twig' %}
{% trans_default_domain 'aircraft_compatibility' %}

{% block title %}{{ parent() }}s{% endblock %}

{% block content %}
    <div class="row">
        {% for file in aircraftCompatibility.files %}
            <div class="col-lg-3">
                <div class="widget bg-body">
                    <div class="row d-flex align-items-center">
                        <div class="col-4">
                            <i class="fa fa-2x">{{ file.type }}</i>
                        </div>
                        <div class="col-6 text-end">
                            <a href="{{ path('aircraft_compatibility_file_show', {id: file.id, aircraftCompatibilityId: aircraftCompatibility.id}) }}"><i class="fa fa-3x fa-file-pdf"></i></a>
                        </div>
                        {% if is_granted("FEATURE_EDIT_AIRCRAFT_COMPATIBILITY") or is_granted("MOO_AC") %}
                            <div class="col-2 text-end">
                                <a href="{{ path('aircraft_compatibility_file_delete', {id: file.id, aircraftCompatibilityId: aircraftCompatibility.id, '_token': csrf_token('delete_aircraft_compatibility_file')}) }}" onClick="return confirm('{{ 'Are you sure you want to delete this file ?' }}');"><i class="text-danger fa-2x fa fa-times"></i></a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
    <div class="row">
        <div class="col-8 col-xs-12">
            {{ data_table(productDatatable) }}
        </div>
        <div class="col-4 col-xs-12">
            {{ data_table(aircraftDatatable) }}
        </div>

    </div>
{% endblock %}