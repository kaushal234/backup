{% extends '/sales/aircraft_compatibility/layout.html.twig' %}
{% trans_default_domain 'nto' %}

{% block title %}{{ parent() }}s{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'button.filter' | trans([], 'messages') | upper }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {{ include('sales/aircraft_compatibility/partial/_form_filter.html.twig', {
                        form: filterForm,
                    }, with_context=false) }}
                </div>
            </div>
        </div>
    </div>
    {{ include('helper/_matrix_table.html.twig', {
        data: data,
        template: 'sales/aircraft_compatibility/partial/cells/_matrix.html.twig',
        hideTotals: 'both',
    }, with_context=false) }}
{% endblock %}