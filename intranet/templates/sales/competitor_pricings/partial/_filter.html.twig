{% form_theme form 'form_theme_vertical.html.twig' %}

{{ form_start(form) }}
{{ form_errors(form) }}

<div class="row">
    <div class="col-md-4">
        {{ form_row(form.status) }}
    </div>
    <div class="col-md-4">
        {{ form_row(form.competitor) }}
    </div>
    <div class="col-md-4">
        {{ form_row(form.product) }}
    </div>
</div>

<div class="row">
    {{ form_rest(form) }}
    <div class="col-lg-12">
        <div>
            <button class="btn btn-primary" type="submit">{{ 'button.filter'| trans | upper }}</button>
            <a href="{{ resetPath }}" class="btn btn-secondary" id="quotations-filter-submit">{{ 'button.reset'| trans | upper }}</a>
        </div>
    </div>
</div>
{{ form_end(form) }}
