{% trans_default_domain 'competitor_pricings' %}

{% block content %}
    {% form_theme form 'form_theme_vertical.html.twig' %}

    {{ form_start(form, { action: action }) }}
    {{ form_errors(form) }}

    <div class="row">
        <div class="col-md-6">{{ form_row(form.quotationDate) }}</div>
        <div class="col-md-6">{{ form_row(form.competitor) }}</div>
    </div>
    {{ form_row(form.competitorModel) }}
    {{ form_row(form.competitorOptions) }}
    <div class="row">
        <div class="col-md-4">{{ form_row(form.quantity) }}</div>
        <div class="col-md-4">{{ form_row(form.exchangeRate) }}</div>
        <div class="col-md-4">{{ form_row(form.markupPercentage) }}</div>
    </div>
    <div class="row">
        <div class="col-md-9">{{ form_row(form.price) }}</div>
        <div class="col-md-3">{{ form_row(form.currency) }}</div>
    </div>
    <div class="row">
        <div class="col-md-6">{{ form_row(form.incoterm) }}</div>
        <div class="col-md-6">{{ form_row(form.incotermsLocation) }}</div>
    </div>
    <div class="row">
        <div class="col-md-12">{{ form_widget(form.file) }}</div>
    </div>
    {{ form_row(form.submit) }}

    {{ form_rest(form) }}
    {{ form_end(form) }}
{% endblock %}

