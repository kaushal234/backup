{% extends 'sales/competitor_pricings/layout.html.twig' %}
{% trans_default_domain 'competitor_pricings' %}

{% block content %}

    {% set competitorPricing = competitorPricing | merge({
        unitPrice: competitorPricing.quantity is not null ? competitorPricing.price / competitorPricing.quantity : null
    }) %}

    <div class="row">
        <div class="col-md-9 col-lg-6">
            {{ include('helper/_association_table.html.twig', {
                associationData: {
                    items: {
                        '@id': {
                            label: 'sidebar.sales.cpr'|trans({}, 'sidebar')~'#',
                            filters: 'iri_id'
                        },
                        forecastClosure: {
                            properties: ['forecastClosure.@id'],
                            label: 'sidebar.sales.fcr'|trans({}, 'sidebar')~'#',
                            link:{
                                route: 'forecast_closures_show',
                                params: {'id':'forecastClosure.@id'},
                            }
                        },
                        competitor: {
                            properties: ['competitor.name'],
                            label: 'competitors.name'|trans({}, 'sales_competitors'),
                            link:{
                                route: 'sales_competitors_show',
                                params: {id:'competitor.@id'},
                            },
                        },
                        competitorModel: {
                            label: 'competitor_pricings.fields.model'|trans,
                        },
                        competitorOptions: {
                            label: 'competitor_pricings.fields.options'|trans,
                        },
                        quantity: {
                            label: 'forecast_closures.fields.quantity'|trans({}, 'forecast_closures'),
                        },
                        sfrQuantity: {
                            properties: ['forecastClosure.salesForecast.quantity'],
                            label: 'forecast_closures.fields.sfr_quantity'|trans({}, 'forecast_closures'),
                        },
                        price: {
                            label: 'competitor_pricings.fields.price'|trans,
                            filters: ['number_format(2)']
                        },
                        unitPrice: {
                            label: 'competitor_pricings.fields.unit_price'|trans,
                            filters: ['number_format(2)']
                        },
                        currency: {
                            properties: ['currency.name'],
                            label: 'competitor_pricings.fields.currency'|trans,
                        },
                        exchangeRate: {
                            label: 'competitor_pricings.fields.exchange_rate'|trans,
                            filters: ['number_format(4)']
                        },
                        incoterm: {
                            properties: ['incoterm.code'],
                            label: 'competitor_pricings.fields.incoterms'|trans
                        },
                        incotermsLocation: {
                            label: 'competitor_pricings.fields.incoterms_location'|trans
                        },
                        markup: {
                            label: 'competitor_pricings.fields.markup'|trans,
                        },
                        quotationDate: {
                            label: 'competitor_pricings.fields.quotation_date'|trans,
                            filters: 'date("Y-m-d")',
                        },
                        createdAt: {
                            label: 'fields.created_at'|trans({}, 'messages'),
                            filters: 'date("Y-m-d H:i:s")',
                        },
                    },
                    title: 'CPR#' ~ competitorPricing.id,
                    data: competitorPricing
                },
            }, with_context = false) }}
        </div>
        <div class="col-md-3 col-lg-6">
            {% set items = {
                filePath: {
                    label: 'menu.files'|trans({}, 'messages')|capitalize,
                    filters : 'slice(41)',
                },
                description: {
                    label: 'fields.description'|trans({}, 'messages') | capitalize,
                },
                createdAt: {
                    label: 'customers.fields.created_at'|trans({}, 'sales_customers')|capitalize,
                    filters: 'date("Y-m-d H:i:s")'
                },
                size: {
                    label: 'size'|trans({}, 'messages')|trans|capitalize,
                    filters : 'readable_filesize'
                },
                download: {
                    label: 'menu.download'|trans({}, 'messages')|capitalize,
                    link:{
                        route: 'competitor_pricing_files_show',
                        content: '<span class="btn btn-primary btn-sm"><i class="fa fa-download fa-fw"></i></span>',
                        params: {
                            'id': 'id'
                        },
                        fixedParams: {
                            'competitorPricingId': competitorPricing.id
                        }
                    },
                    sortable: false,
                    class: 'text-center'
                }
            } %}
            {% if is_granted('FEATURE_COMPETITOR_PRICING_WRITE', competitorPricing['@id']) %}
                {% set items = items | merge ({
                    delete: {
                        label: 'menu.delete'|trans([], 'messages')|capitalize,
                        link:{
                            route: 'competitor_pricing_delete_file',
                            fixedParams: {'competitorPricingId': competitorPricing.id, '_token': csrf_token('delete_competitor_pricing_file')},
                            params: {'id':'id'},
                            content: '<span class="btn btn-danger btn-sm"><i class="fa fa-trash fa-fw"></i></span>',
                            popup: {
                                type: 'confirmation',
                                title: 'Confirmation',
                                message: 'Are you sure to delete ?',
                            },
                        },
                        sortable: false,
                        class: 'text-center'
                    },
                }) %}
            {% endif %}
            {{ include('helper/_report_table.html.twig', {
                reportTable: {
                    items: items,
                    title: 'menu.files'|trans([], 'messages') |capitalize,
                    data: competitorPricing.competitorPricingFiles,
                    search: false,
                    initialSorting: false,
                    pagination: false
                }
            }, with_context = false) }}
            {% if is_granted('FEATURE_COMPETITOR_EDIT') %}
                <div class="ibox float-e-margins collapsed">
                    <div class="ibox-title">
                        <h5>{{ 'demo.fields.add_file' | trans([], 'demo') }}</h5>
                        <div class="ibox-tools">
                            <a class="collapse-link">
                                <i class="fa fa-chevron-up"></i>
                            </a>
                        </div>
                    </div>
                    <div class="ibox-content">
                        <div class="row">
                            <div class="col-lg-12">
                                {% form_theme form 'form_theme_vertical.html.twig' %}

                                {{ form_start(form, { action: path('competitor_pricings_show', {'id': competitorPricing.id}) }) }}
                                {{ form_errors(form) }}

                                {{ form_row(form.file) }}
                                {{ form_row(form.description) }}
                                {{ form_row(form.submit) }}

                                {{ form_rest(form) }}

                                {{ form_end(form) }}
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'menu.logs' | trans({}, 'messages') }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    <div class="logs-block" data-resource="{{ competitorPricing['@id'] }}"></div>
                </div>
            </div>
        </div>
    </div>

{% endblock %}

{% block translations %}
    {{ parent() }}
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'messages' }) }}"></script>
{% endblock %}
