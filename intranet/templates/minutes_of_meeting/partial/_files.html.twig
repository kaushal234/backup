{% trans_default_domain "meeting" %}

{% set items = {
    filePath: {
        label: 'menu.files'|trans([], 'messages')|capitalize,
        filters : 'slice(34)',
        link:{
            route: 'meeting_download_file',
            params: {
                'id': 'id'
            },
            fixedParams: {
                'meetingId': meeting.iriId
            }
        },
    },
    description: {
        label: 'fields.description'|trans({}, 'messages')|capitalize,
    },
    createdAt: {
        label: 'fields.created_at'|trans({}, 'messages')|capitalize,
        filters: 'date("Y-m-d H:i:s")'
    },
    size: {
        label: 'size'|trans({}, 'messages')|trans|capitalize,
        filters : 'readable_filesize'
    },
    download: {
        label: 'menu.download'|trans({}, 'messages')|capitalize,
        link:{
            route: 'meeting_download_file',
            content: '<span class="btn btn-primary btn-sm"><i class="fa fa-download fa-fw"></i></span>',
            params: {
                'id': 'id'
            },
            fixedParams: {
                'meetingId': meeting.iriId
            }
        },
        sortable: false,
        class: 'text-center'
    },
} %}

{% if is_granted('MEETING_WRITE_VOTER', meeting['@id']) %}
    {% set items = items | merge ({
        delete: {
            label: 'menu.delete'|trans({}, 'messages')|capitalize,
            sortable: false,
            class: 'text-end',
            link: {
                route: 'meeting_delete_file',
                params: {'id': 'id'},
                fixedParams: {'meetingId': meeting.iriId, '_token': csrf_token('meeting_delete_file')},
                content: '<span class="btn btn-danger btn-sm"><i class="fa fa-trash fa-fw"></i></span>',
                popup: {
                    type: 'confirmation',
                    title: 'Confirmation',
                    message: 'Are you sure to delete ?',
                },
            },
        }
    }) %}
{% endif %}

{{ include('helper/_report_table.html.twig', {
    'reportTable': {
        items: items,
        title: 'meeting.file_title'|trans,
        data: meeting.files,
        search: false,
        pagination: false,
        initialSorting: 'createdAt'
    }
}, with_context = false) }}


