{% extends 'minutes_of_meeting/layout.html.twig' %}
{% trans_default_domain 'meeting' %}
{% form_theme form 'form_theme_vertical.html.twig' %}

{% block title %}{{ parent() }}\{{ ('menu.duplicate')|trans([], 'messages') | capitalize }}{% endblock %}

{% block content %}
    <div class="row">
        {{ form_start(form, { action: actionPath }) }}
        {{ form_errors(form) }}
        <div class="ibox float-e-margins">
            <div class="ibox-title">
                {{ 'meeting.duplicate.title' | trans({'%meeting%': '#' ~ meeting.iriId}) }}
            </div>
            <div class="ibox-content">
                <div class="row">
                    <div class="col-md-12">
                        {{ form_row(form.meetingDate) }}
                        {{ form_row(form.location) }}
                        {{ form_row(form.description) }}
                        {{ form_row(form.submit) }}
                    </div>
                </div>
            </div>
        </div>
        {{ form_rest(form) }}

        {{ form_end(form) }}
    </div>
{% endblock %}
