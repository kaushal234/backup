{% extends 'minutes_of_meeting/layout.html.twig' %}
{% form_theme formAction 'form_theme_vertical.html.twig' %}
{% trans_default_domain "meeting" %}

{% block content %}
    <div class="row">
        <div class="col-md-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'button.new_task' |trans({}, 'messages') | upper }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {{ form_start(formAction, { action: path('meeting_new_task',{'id': meeting.iriId}) } ) }}
                    {{ form_errors(formAction) }}
                    <div class="row">
                        <div class="col-md-3">
                            {{ form_row(formAction.assignee) }}
                        </div>
                        <div class="col-md-3">
                            {{ form_row(formAction.dueDate) }}
                        </div>
                        <div class="col-md-3">
                            {{ form_row(formAction.escalationTrigger) }}
                        </div>
                        <div class="col-md-3">
                            {{ form_row(formAction.customer) }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            {{ form_row(formAction.description) }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            {{ form_row(formAction.cc) }}
                            {{ form_row(formAction.internal) }}
                            {{ form_row(formAction.submit) }}
                        </div>
                    </div>
                    {{ form_end(formAction) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

