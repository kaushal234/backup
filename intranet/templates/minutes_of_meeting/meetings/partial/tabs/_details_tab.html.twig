{% trans_default_domain 'meeting' %}
<div class="row">
    <div class="col-lg-12">
        <div class="ibox float-e-margins ">
            <div class="ibox-title">
                <h5>{{ 'sidebar.sales.mom' | trans({}, 'sidebar') }}#{{ item.iriId }} - {{ item.title }}</h5>
            </div>
            <div class="ibox-content report-table-with-filter">
                <div class="row">
                    <div class="col-md-6">
                        {{ include('helper/_association_table_raw.html.twig', {
                            associationData: {
                                items: {
                                    id: {
                                        label: 'contacts.fields.id'|trans({},'contacts')|capitalize
                                    },
                                    status: {
                                        label: 'demo.fields.status'|trans({}, 'demo')|capitalize
                                    },
                                    createdBy: {
                                        properties: ['createdBy.lastname', 'createdBy.firstname'],
                                        label: 'survey.fields.createdBy'|trans({}, 'surveys')|capitalize,
                                        link:{
                                            route: 'directory_people_show',
                                            params: {'id':'createdBy.@id'},
                                        }
                                    },
                                    createdAt: {
                                        label: 'fields.created_at'|trans({}, 'messages')|capitalize,
                                        filters: 'date("Y-m-d")'
                                    },
                                    meetingDate: {
                                        label: 'meeting.fields.meetingDate'|trans|capitalize,
                                        filters: 'date("Y-m-d")'
                                    },
                                    location: {
                                        label: 'menu.location.title'|trans({}, 'messages')|capitalize,
                                    },
                                    quick: {
                                        label: 'meeting.fields.quickMeeting'|trans|capitalize,
                                        boolean: {
                                            'true': '<span class="d-none">1</span><i class="fa fa-check text-info"></i>',
                                            'false': '<span class="d-none">0</span><i class="fa fa-times text-danger"></i>'
                                        }

                                    },
                                    confidential: {
                                        label: 'meeting.fields.confidential'|trans|capitalize,
                                        boolean: {
                                            'true': '<span class="d-none">1</span><i class="fa fa-check text-info"></i>',
                                            'false': '<span class="d-none">0</span><i class="fa fa-times text-danger"></i>'
                                        }
                                    },
                                    businessUnits: {
                                        template: 'minutes_of_meeting/partial/_cell_businessUnits.html.twig',
                                        label: 'meeting.fields.businessUnits'|trans|capitalize,
                                    },
                                    productTypes: {
                                        template: 'minutes_of_meeting/partial/_cell_product_types.html.twig',
                                        label: 'meeting.fields.productType'|trans|capitalize,
                                    }
                                },
                                title: 'Meeting' ~ item.id,
                                data: item
                            },
                        }, with_context = false) }}
                        <hr>
                    </div>
                    <div class="col-md-6">
                        <h3>{{  'meeting.fields.description' | trans }}:</h3>
                        {{ item.description | raw }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-4 col-md-12">
                        <h4>{{ 'meeting.fields.attendees'|trans }}</h4>
                        {{ include('helper/_report_table_raw.html.twig', {
                            reportTable: {
                                items: {
                                    '@id': {
                                        label: 'contacts.fields.id'|trans({},'contacts')|capitalize,
                                        link: {
                                            route: 'directory_people_show',
                                            params: {'id':'@id'}
                                        },
                                        filters: 'iri_id'
                                    },
                                    attendee: {
                                        properties: ['lastname', 'firstname'],
                                        label: 'meeting.fields.attendees'|trans|capitalize
                                    },
                                    view: {
                                        label: 'menu.view'|trans([], 'messages')|capitalize,
                                        link: {
                                            route: 'directory_people_show',
                                            params: {'id':'@id'},
                                            content: '<span class="btn btn-primary btn-sm"><i class="far fa-eye fa-fw"></i></span>',
                                        },
                                        sortable: false,
                                        class : 'text-end'
                                    },
                                },
                                pagination: false,
                                search: false,
                                initialSorting: false,
                                data: item.attendees,
                            }
                        }, with_context = false) }}
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <h4>{{ 'market_intelligence.fields.competitors'|trans({}, 'market_intelligence') }}</h4>
                        {{ include('helper/_report_table_raw.html.twig', {
                            reportTable: {
                                items: {
                                    '@id': {
                                        label: 'contacts.fields.id'|trans({},'contacts')|capitalize,
                                        link:{
                                            route: 'sales_competitors_show',
                                            params: {'id':'@id'},
                                        },
                                        filters: 'iri_id'
                                    },
                                    name: {
                                        label: 'catalogue.products.name'|trans({}, 'catalogue')|capitalize,
                                    },
                                    view: {
                                        label: 'menu.view'|trans([], 'messages')|capitalize,
                                        link:{
                                            route: 'sales_competitors_show',
                                            params: {'id':'@id'},
                                            content: '<span class="btn btn-primary btn-sm"><i class="far fa-eye fa-fw"></i></span>',
                                        },
                                        sortable: false,
                                        class : 'text-end'
                                    },
                                },
                                pagination: false,
                                search: false,
                                initialSorting: false,
                                data: item.competitors,
                            }
                        }, with_context = false) }}
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <h4>{{ 'survey.publication_form.customer'|trans({}, 'surveys') }}</h4>
                        {{ include('helper/_report_table_raw.html.twig', {
                            reportTable: {
                                items: {
                                    '@id': {
                                        label: 'contacts.fields.id'|trans({},'contacts')|capitalize,
                                        link:{
                                            route: 'sales_customers_show',
                                            params: {'id':'@id'},
                                        },
                                        filters: 'iri_id'
                                    },
                                    name: {
                                        label: 'catalogue.products.name'|trans({}, 'catalogue')|capitalize,
                                    },
                                    view: {
                                        label: 'menu.view'|trans([], 'messages')|capitalize,
                                        link:{
                                            route: 'sales_customers_show',
                                            params: {'id':'@id'},
                                            content: '<span class="btn btn-primary btn-sm"><i class="far fa-eye fa-fw"></i></span>',
                                        },
                                        sortable: false,
                                        class : 'text-end'
                                    },
                                },
                                pagination: false,
                                search: false,
                                initialSorting: false,
                                data: item.customers,
                            }
                        }, with_context = false) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <h4>{{ 'meeting.fields.customer_contacts'|trans }}</h4>

                        {{ include('helper/_report_table_raw.html.twig', {
                            reportTable: {
                                items: {
                                    '@id': {
                                        label: 'contacts.fields.id'|trans({},'contacts')|capitalize,
                                        link:{
                                            route: 'sales_contact_show',
                                            params: {'id':'@id'},
                                        },
                                        filters: 'iri_id'
                                    },
                                    name: {
                                        properties: ['lastname', 'firstname'],
                                        label: 'catalogue.products.name'|trans({}, 'catalogue')|capitalize,
                                    },
                                    view: {
                                        label: 'menu.view'|trans([], 'messages')|capitalize,
                                        link:{
                                            route: 'sales_contact_show',
                                            params: {'id':'@id'},
                                            content: '<span class="btn btn-primary btn-sm"><i class="far fa-eye fa-fw"></i></span>',
                                        },
                                        sortable: false,
                                        class : 'text-end'
                                    },
                                },
                                pagination: false,
                                search: false,
                                initialSorting: false,
                                data: item.customerContacts,
                            }
                        }, with_context = false) }}
                    </div>
                    <div class="col-md-6">
                        <h4>{{ 'meeting.fields.contacts'|trans }}</h4>

                        {{ include('helper/_report_table_raw.html.twig', {
                            reportTable: {
                                items: {
                                    '@id': {
                                        label: 'contacts.fields.id'|trans({},'contacts')|capitalize,
                                        filters: 'iri_id',
                                    },
                                    name: {
                                        properties: ['firstName', 'lastName'],
                                        label: 'catalogue.products.name'|trans({}, 'catalogue')|capitalize
                                    },
                                    mail: {
                                        template: 'minutes_of_meeting/partial/_cell_contact_mail.html.twig',
                                        label: 'contacts.fields.email'|trans({}, 'contacts')|capitalize,

                                    },
                                    phone: {
                                        template: 'minutes_of_meeting/partial/_cell_contact_phone.html.twig',
                                        label: 'customers.fields.phone'|trans({}, 'sales_customers')|capitalize,
                                    },
                                },
                                pagination: false,
                                search: false,
                                initialSorting: false,
                                data: item.contacts,
                            }
                        }, with_context = false) }}
                    </div>
                </div>
                <div class="row">
                    <div class="ibox float-e-margins ">
                        <div class="ibox-title"><h5>{{ 'menu.links' | trans({}, 'messages') }}</h5>
                            <div class="ibox-tools"><a class="collapse-link"><i class="fa fa-chevron-up"></i></a></div>
                        </div>
                        <div class="ibox-content">
                            <hx:include src="/en/private/common/links/links_hinclude.php?module=MOM&parent_id={{ item.IriId }}">
                                <div class="text-center"><span class="fa fa-refresh fa-spin"></span></div>
                            </hx:include>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
