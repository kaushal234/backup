{% trans_default_domain 'meeting' %}
<div class="row">
    <div class="col-lg-12">
        {{ include('helper/_report_table.html.twig', {
            reportTable: {
                items: {
                    task: {
                        label: 'menu.people.tasks'|trans({}, 'messages')|capitalize,
                        link: {
                            route: 'legacy_calendar',
                            fixedParams: {m:['tasks', 'task', 'view']},
                            params: {id:'task'}
                        }
                    },
                    description: {
                        label: 'tasks.description'|trans({}, 'messages')|capitalize,
                    },
                    assignee: {
                        label: 'tasks.assignee'|trans({}, 'messages')|capitalize,
                        properties: ['assignee.lastname', 'assignee.firstname'],
                        link: {
                            route: 'directory_people_show',
                            params: {id:'assignee.@id'}
                        }
                    },
                    completed: {
                        label: 'first_article_qualification.fields.validated'|trans({}, 'first_article_qualification')|capitalize,
                        boolean: {
                            'true': '<span class="d-none">1</span><i class="fa fa-check text-info"></i>',
                            'false': '<span class="d-none">0</span><i class="fa fa-times text-danger"></i>'
                        }
                    },
                    closingComment: {
                        label: 'demo.fields.closing_comment'|trans({},'demo')|capitalize,
                    },
                    internal: {
                        label: 'meeting.actions.confidential'|trans|capitalize,
                        boolean: {
                            'true': '<span class="d-none">1</span><i class="fa fa-check text-info"></i>',
                            'false': '<span class="d-none">0</span><i class="fa fa-times text-danger"></i>'
                        }
                    },
                    customer: {
                        label: 'demo.fields.customer'|trans({}, 'demo')|capitalize,
                        properties: ['customer.name']
                    }
                },
                title: false,
                data: item.actions,
                pagination: false,
                search: false,
                initialSorting: 'createdAt'
            }
        }, with_context = false) }}
    </div>
</div>
