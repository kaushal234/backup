{% extends 'power_bi/layout.html.twig' %}

{% block title %}{{ parent() }} / {{ title }}{% endblock %}

{% block content %}
    <div class="row">
        <section
            data-report-id="{{ reportId }}"
            data-workspace-id="{{ workspaceId }}"
            class="report-container embed-container col m-3 p-0">
        </section>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('powerbiClient') }}
{% endblock javascripts %}
