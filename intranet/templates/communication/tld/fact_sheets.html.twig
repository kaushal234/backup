{% extends 'corporate/pages/layout.html.twig' %}

{% block content %}
    <div class="row">
        <div class="col-lg-10 col-lg-offset-1">
            <div class="ibox">
                <div class="ibox-content">
                    <div class="text-center article-title">
                        {% set entity = entity | replace({'-': ' '}) %}
                        <h1>{{ entity | upper }} Fact Sheets</h1>
                    </div>

                    <div class="">
                        <table class="table table-striped table-responsive">
                            <tbody>
                            {% set factSheets = {
                                'DMS#5566': {
                                    'pptx': 'DMS#5566_PFS Product Factsheet template 2023.pptx',
                                },
                                'TLD Fact sheet example': {
                                    'pdf': 'TLD FACT Sheet EXAMPLE.pdf'
                                }
                            } %}
                            {% for key, factSheet in factSheets %}
                                <tr>
                                    <td>{{ key }}</td>
                                    <td align="right">
                                        {% for extension, path in factSheet %}
                                            {% set filepath = asset(upload_uri ~ '/corporate/tld/fact_sheets/' ~ path) %}
                                            <a class="btn btn-primary" target="_blank" href="{{ filepath }}"><i class="fa fa-file-{{ extension is same as 'pptx' ? 'powerpoint' : extension is same as 'docx' ? 'word' : extension }}"></i>&nbsp;{{ extension | upper }}</a>
                                        {% endfor %}
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}