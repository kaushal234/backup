<div class="row">
    <div class="col-lg-10 col-lg-offset-1">
        <div class="ibox">
            <div class="ibox-content">
                <div class="text-center article-title">
                    {% set entity = entity | replace({'-': ' '}) %}
                    <h1>{{ entity | upper }} Powerpoint Templates</h1>
                </div>

                <div class="">
                    <table class="table table-striped table-responsive">
                        <tbody>
                        {% for key, presentation in presentations %}
                            <tr>
                                <td>{{ key }}</td>
                                <td align="right">
                                    {% for extension, path in presentation %}
                                        {% set filepath = asset(upload_uri ~ '/corporate/' ~ path) %}
                                        <a class="btn btn-primary" target="_blank" href="{{ filepath }}"><i class="fa fa-file-{{ extension in ['pptx', 'potx', 'thmx'] ? 'powerpoint' : (extension is same as 'pdf' ? 'pdf' : 'powerpoint') }}"></i>&nbsp;{{ extension | upper }}</a>
                                    {% endfor %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>