<div class="row">
    <div class="col-lg-10 col-lg-offset-1">
        <div class="ibox">
            <div class="ibox-content">
                <div class="text-center article-title">
                    {% set entity = entity | replace({'-': ' '}) %}
                    <h1>{{ entity | upper }} Colour Palette</h1>
                </div>

                {% if colorIntroduction is defined %}
                    <p>{{ colorIntroduction | nl2br }}</p>
                {% endif %}

                {% if colors is defined %}
                    <p>The colors are as follows:</p>

                    <div class="row">
                        {% for color in colors %}
                            <div class="col-sm-12 {{ colorGridClass | default('col-md-4') }}">
                                <div class="card" style="padding: 4px; margin-bottom: 20px" >
                                    <span style="background: {{ color.hex }}; width: 100%; height: 80px; display: block;"></span>
                                    <div class="caption">
                                        {% if color.description is defined %}
                                            <p><i>{{ color.description }}</i></p>
                                        {% endif %}
                                        <h4>Pantone/PMS {{ color.pantone }}</h4>
                                        <ul>
                                            <li>RGB: {{ color.rgb }}</li>
                                            <li>HEX/HTML: {{ color.hex }}</li>
                                            <li>CMYK: {{ color.cmyk }}</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>