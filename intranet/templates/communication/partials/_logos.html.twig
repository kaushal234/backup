<div class="row">
    <div class="col-lg-10 col-lg-offset-1">
        <div class="ibox">
            <div class="ibox-content">
                <div class="text-center article-title">
                    {% set entity = entity | replace({'-': ' '}) %}
                    <h1>{{ entity | upper }} Logos</h1>
                </div>

                <div class="row">
                    {% for path in mainLogos | default([]) %}
                        <div class="col-sm-6 ">
                            <img src="/shared/corporate/{{ path }}" class="img-fluid">
                        </div>
                    {% endfor %}
                </div>

                <h2>Logo source files</h2>

                <div class="">
                    <table class="table table-striped table-responsive">
                        <tbody>
                        {% for key, logos in secondaryLogos %}
                            <tr>
                                <td>{{ key }}</td>
                                <td align="right">
                                    {% for extension, path in logos %}
                                        {% set filepath = asset(upload_uri ~ '/corporate/' ~ path) %}
                                        <a class="btn btn-primary" target="_blank" href="{{ filepath }}"><i class="fa fa-file-{{ extension is same as 'zip' ? 'archive' : 'image' }}"></i>&nbsp;{{ extension | upper }}</a>
                                    {% endfor %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>