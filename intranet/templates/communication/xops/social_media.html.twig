                    </div>
                    <p>LinkedIn</p>
                    <p><u><a href="https://www.linkedin.com/company/resonate-mp4.com/">https://www.linkedin.com/company/resonate-mp4.com/</a></u></p>
                    <p>Facebook</p>
                    <p><u><a href="https://www.facebook.com/xopsaero/">https://www.facebook.com/xopsaero/</a></u></p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}