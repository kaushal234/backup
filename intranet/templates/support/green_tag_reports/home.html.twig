{% extends 'support/layout.html.twig' %}
{% trans_default_domain 'support' %}
{% form_theme form 'form_theme_vertical.html.twig' %}

{% block content %}
    {{ form_start(form) }}
    {{ form_errors(form) }}
    <div class="row">
        <div class="col-lg-4">{{ form_row(form.manufacturerLocation) }}</div>
        <div class="col-lg-4">{{ form_row(form.family) }}</div>
        <div class="col-lg-4">{{ form_row(form.day) }}</div>
    </div>
    {{ form_end(form) }}

    {% if filtered and chart.series is defined %}
        <div id="green-tag-chart" class="highcharts col-md-12 mt-2"></div>
        <div class="mt-3 p-3 bg-light border rounded">
            {{ 'support.green_tag_report.helper'|trans|nl2br }}
        </div>
    {% endif %}

    {% if summaryTable is not empty %}
        <div class="mt-4">
            {% for row in summaryTable %}
                <h5 class="mt-3">{{ row.label }} ({{ row.month }})</h5>
                <table class="table table-striped table-bordered table-sm">
                    <thead class="table-light">
                    <tr>
                        <th>{{ 'support.green_tag_report.factory'|trans }}</th>
                        <th>{{ 'support.green_tag_report.total'|trans }}</th>
                        <th>{{ 'support.green_tag_report.in_range'|trans }}</th>
                        <th>{{ 'support.green_tag_report.percentage'|trans }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td>{{ row.factory }}</td>
                        <td>{{ row.total }}</td>
                        <td>{{ row.inRange }}</td>
                        <td>
                            {% set value = row.percentage|replace({'%':''}) %}
                            {% if value >= 50 %}
                                <span class="badge bg-success" style="color: white">{{ row.percentage }}</span>
                            {% elseif value >= 25 %}
                                <span class="badge bg-warning text-dark">{{ row.percentage }}</span>
                            {% else %}
                                <span class="badge bg-danger">{{ row.percentage }}</span>
                            {% endif %}
                        </td>
                    </tr>
                    </tbody>
                </table>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    {% if filtered and chart.series is defined %}
        <script type="text/javascript">
            document.addEventListener('DOMContentLoaded', function () {
                var chartOptions = {{ chart | json_encode | raw }};

                chartOptions.tooltip = {
                    useHTML: true,
                    formatter: function () {
                        let html = '<b>' + this.series.name + ' : ' + this.y + '</b>';

                        let serials = [];
                        if (this.point.extraData && this.point.extraData.serialNumbers) {
                            if (Array.isArray(this.point.extraData.serialNumbers)) {
                                serials = this.point.extraData.serialNumbers;
                            } else if (typeof this.point.extraData.serialNumbers === 'string') {
                                serials = this.point.extraData.serialNumbers.split(',');
                            }
                        }

                        if (serials.length > 0) {
                            html += '<br/><b>Serials:</b><ul>';
                            serials.forEach(function (s) {
                                html += '<li>' + s + '</li>';
                            });
                            html += '</ul>';
                        }

                        return html;
                    }
                };

                Highcharts.chart('green-tag-chart', chartOptions);
            });
        </script>
    {% endif %}
{% endblock %}