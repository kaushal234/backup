{% form_theme form 'form_theme_vertical.html.twig' %}

<div class="alert alert-warning">
    Filter <strong>Part Description</strong> is actualy disabled due to performance issue. Sorry for the inconvenience.
</div>

{{ form_start(form) }}
        {{ form_errors(form) }}
<div class="row">
    <div class="col-lg-3">
        {{ form_row(form.partNumber) }}
    </div>
    <div class="col-lg-3">
        {# Disabled during fixing DB request issue (See SP-1722) #}
        {{ form_row(form.partDescription, {disabled: true}) }}
    </div>
    <div class="col-lg-2">
        {{ form_row(form.location) }}
    </div>
    <div class="col-lg-2">
        {{ form_widget(form.productFamily) }}
    </div>
</div>

<div class="row">
    {{ form_rest(form) }}
    <div class="col-lg-12">
        <hr class="hr-line-dashed">
        <div class="float-end">
            <label class="col-form-label">&nbsp;</label>
            <button class="btn btn-primary" type="submit">{{ 'button.filter'| trans | upper }}</button>
            <a href="{{ resetPath }}" class="btn btn-secondary">{{ 'button.reset'| trans | upper }}</a>
        </div>
    </div>
</div>
{{ form_end(form) }}
