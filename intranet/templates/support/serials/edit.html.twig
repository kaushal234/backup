{% extends 'support/serials/layout.html.twig' %}
{% form_theme form 'support/serials/partial/_form.html.twig' %}

{% block content %}
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'titles.edition'|trans({}, 'messages')|capitalize }}</h5>
                </div>
                <div class="ibox-content">
                    <div class="alert alert-warning" role="alert">
                        {{ 'support.serials.component.manual_not_editable'|trans({}, 'support')}}
                    </div>
                    {{ form_start(form) }}
                    {{ form_row(form) }}
                    <div class="text-end">
                        <button type="submit" class="btn btn-primary text-capitalize">{{ 'button.submit'|trans({}, 'messages') }}</button>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

