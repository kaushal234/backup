                    preserveNull: true,
                },
                dateShipped: {
                    label: 'service.equipment_record.fields.shipped_tag'|trans|capitalize,
                    filters: 'date("Y-m-d")',
                    preserveNull: true,
                },
                publishable: {
                    label: 'service.equipment_record.fields.publishable'|trans|capitalize,
                    boolean: {
                        false: '<span><button type="button" class="btn btn-danger btn-sm">No</button></span>',
