{#Add div for delete button#}
{% block _manual_document_parts_entry_critical_widget -%}
    <div class="clearfix"></div>
    <div class="row">
        <div class="col-md-9">{{ form_widget(form) }}</div>
        <div class="col-md-2">
            <br>
            <div class="delete-button-block"></div>
        </div>
        <br>
    </div>
{%- endblock %}

{% block document_element_row %}
    {%- set widget_attr = {} -%}
    {%- if help is not empty -%}
        {%- set widget_attr = {attr: {'aria-describedby': id ~"_help"}} -%}
    {%- endif -%}
    <div
        {% with {
                attr: row_attr|merge({class: (row_attr.class|default('') ~ 'col-sm-' ~ (size) ~ ((not compound or force_error|default(false)) and not valid ? ' has-error'))|trim})
            } %}
            {{ block('attributes') }}
        {% endwith %}
    >
        {{ form_label(form) }}
        <div class="col">
            {{- form_widget(form, widget_attr) -}}
            {{- form_help(form) -}}
            {{- form_errors(form) -}}
        </div>
    </div>
{% endblock %}

{% block checkbox_widget -%}
    {%- set parent_label_class = parent_label_class|default(label_attr.class|default('')) -%}
    <br>
    <div class="checkbox checkbox-primary" style="padding-left: 10px; padding-top: 25px; text-align: center">
        <input type="checkbox" {{ block('widget_attributes') }}{% if value is defined %} value="{{ value }}"{% endif %}{% if checked %} checked="checked"{% endif %} />
        <label for="{{ id }}">{{ translation_domain is same as(false) ? label : label|trans({}, translation_domain) }}</label>
    </div>
{%- endblock checkbox_widget %}

{% block form_label_class -%}
    col
{%- endblock form_label_class %}
