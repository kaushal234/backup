{#Override form_row to delete label#}
{% block form_row -%}
    {%- set widget_attr = {} -%}
    {%- if help is not empty -%}
        {%- set widget_attr = {attr: {'aria-describedby': id ~"_help"}} -%}
    {%- endif -%}
    <div
        {% with {
            attr: row_attr|merge({class: (row_attr.class|default('') ~ '' ~ ((not compound or force_error|default(false)) and not valid ? ' has-error'))|trim})
            }
        %}
            {{ block('attributes') }}
        {% endwith %}
    >
        <div class="col-lg-12">
            {{- form_widget(form, widget_attr) -}}
            {{- form_help(form) -}}
            {{- form_errors(form) -}}
        </div>
    </div>
{%- endblock form_row %}

{% block _manual_document_parts_entry_position_row %}
