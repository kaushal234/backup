{% extends 'support/iata_codes/layout.html.twig' %}
{% trans_default_domain 'support' %}

{% block title %}{{ parent() }}{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'button.filter' | trans([], 'messages') | upper }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {{ include('support/iata_codes/partial/_form_filter.html.twig', {
                        form: formFilter,
                        resetPath: path('support_iata_code_list')
                    }) }}
                </div>
            </div>
        </div>
    </div>


    <div class="row">
        <div class="col-lg-12">
            {{ include('helper/_report_table.html.twig', {
                reportTable: {
                    items: {
                        code: {
                            label: 'support.iata.fields.code'|trans|capitalize,
                            link:{
                                route: 'support_iata_code_show',
                                params: {'id':'@id'},
                            }
                        },
                        name: {label: 'support.iata.fields.name'|trans|capitalize},
                        type: {label: 'support.iata.fields.type'|trans|capitalize},
                        country: {
                            properties: ['country.name'],
                            label: 'support.iata.fields.country'|trans|capitalize
                        },
                        cityName: {
                            label: 'support.iata.fields.city_name'|trans|capitalize,
                            template: 'support/iata_codes/partial/_city_name.html.twig',
                        },
                        view: {
                            label: 'menu.view'|trans([], 'messages')|capitalize,
                            link:{
                                route: 'support_iata_code_show',
                                params: {'id':'@id'},
                                content: '<span class="btn btn-primary btn-sm"><i class="far fa-eye fa-fw"></i></span>',
                            },
                            sortable: false,
                            class : 'text-end'
                        },
                    },
                    title: 'support.iata.title'|trans,
                    data: iataCodes
                }
            }, with_context = false) }}
        </div>
    </div>
{% endblock %}

