{% extends '/support/layout.html.twig' %}
{% trans_default_domain 'support' %}

{% block title %}{{ parent() }}{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ ('support.reports.titles.pre_delivery_inspection_per_' | trans() ~ period)  }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                    </div>
                </div>
                <div class="ibox-content">
                    {% form_theme form 'form_theme_vertical.html.twig' %}
                    {{ form_start(form) }}
                    <div class="row">
                        <div class="col-md-3">{{ form_row(form.sso) }}</div>
                        <div class="col-md-3">{{ form_row(form.manufacturerLocation) }}</div>
                        <div class="col-md-3">{{ form_row(form.product) }}</div>
                        <div class="col-md-3">{{ form_row(form.productTypes) }}</div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">{{ form_row(form.startDate) }}</div>
                        <div class="col-md-3">{{ form_row(form.endDate) }}</div>
                        <div class="col-md-6 btn-height" style="padding-top: 34px; display: flex; justify-content: end">{{ form_widget(form.submit) }}</div>
                    </div>

                    {{ form_errors(form) }}
                    {{ form_end(form) }}

                    <hr>
                    {% if chart.series is defined %}
                        <div id="pre-delivery-inspections-rate-chart" class="highcharts" style="min-width: 400px; height: 700px;"></div>
                    {% else %}
                        <div class="alert alert-primary text-center" role="alert">{{ 'no_results' | trans({}, 'messages') }}</div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col md-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'support.reports.titles.upcoming_pre_delivery_inspections' | trans() }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                    </div>
                </div>
                <div class="ibox-content">
                    {% set estimatedGreenTagDateBefore = ("now +1 days")|date("m/d/Y") %}
                    {% set estimatedGreenTagDateAfter = ("now +30 days")|date("m/d/Y") %}

                    {{ include('helper/_matrix_table.html.twig', {
                        data: nextThirtyDaysInspectionsReport,
                        showZero: false,
                        link: {
                            route: 'on_time_delivery_planning_show',
                            xParam: 'manufacturerLocation',
                            yParam: 'salesOrganisation',
                            additionalParams: {inspection: '1', estimatedGreenTagDateBefore: estimatedGreenTagDateBefore, estimatedGreenTagDateAfter: estimatedGreenTagDateAfter }
                        },
                    }, with_context=false) }}
                    <p class="fst-italic">{{ 'support.reports.helpers.upcoming_pre_delivery_inspections' |trans() }}</p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function () {
            var chartOptions = {{ chart | json_encode | raw }};
            chartOptions.tooltip = {
                formatter: function () {
                    if (this.point && this.point.extraData && typeof this.point.extraData.pdi !== 'undefined' && typeof this.point.extraData.unitGreenTagged !== 'undefined') {
                        return '<b>' + this.series.name + ' : ' + this.y + '%' + '</b><br>' +
                            this.point.extraData.pdi + ' PDI ' + ' / ' + this.point.extraData.unitGreenTagged + ' Unit GTed' ;
                    }
                    return '<b>' + this.series.name + ' : ' +
                        this.y + '%'
                }
            };
            Highcharts.chart('pre-delivery-inspections-rate-chart', chartOptions);
        });
    </script>

{% endblock %}
