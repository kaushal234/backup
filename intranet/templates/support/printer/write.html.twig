{% extends 'support/printer/layout.html.twig' %}
{% trans_default_domain 'support' %}
{% form_theme form 'form_theme_vertical.html.twig' %}

{% block content %}
    <div class="row">
        <div class="col-md-12">
            {{ form_start(form) }}
            {{ form_errors(form) }}
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    {{ 'support.printer.edit.title'|trans|capitalize }}
                </div>
                <div class="ibox-content">
                    <div class="row">
                        <div class="col-md-3">
                            {{ form_row(form.companyName) }}
                        </div>
                        <div class="col-md-3">
                            {{ form_row(form.firstname) }}
                        </div>
                        <div class="col-md-3">
                            {{ form_row(form.lastname) }}
                        </div>
                        <div class="col-md-3">
                            {{ form_row(form.email) }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-5">
                            {{ form_row(form.address.street1) }}
                        </div>
                        <div class="col-md-5">
                            {{ form_row(form.address.street2) }}
                        </div>
                        <div class="col-md-2">
                            {{ form_row(form.address.country) }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 col-xs-6">
                            {{ form_row(form.address.postalCode) }}
                        </div>
                        <div class="col-md-3 col-xs-6">
                            {{ form_row(form.address.city) }}
                        </div>
                        <div class="col-md-3 col-xs-6">
                            {{ form_row(form.address.town) }}
                        </div>
                        <div class="col-md-3 col-xs-6">
                            {{ form_row(form.address.state) }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            {{ form_row(form.submit) }}
                        </div>
                    </div>
                </div>
            </div>
            {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
