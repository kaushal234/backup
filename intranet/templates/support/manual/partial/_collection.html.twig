{% form_theme form 'support/manual/partial/_form.html.twig' %}

{% block content %}
    <div class="row">
        <div class="ibox float-e-margins">
            <div class="ibox-title">
                <h5>{{ 'support.manual_document.collection'|trans({}, 'support')|capitalize }}  {% if category is defined %} : {{ category }} {% endif%} </h5>
            </div>
            <div class="ibox-content">
                {{ form_row(form) }}
            </div>
        </div>
    </div>
{% endblock %}

