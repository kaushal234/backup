{% form_theme form 'form_theme_vertical.html.twig' %}

{{ form_start(form) }}
{{ form_errors(form) }}

<div class="row">
    <div class="col-md-4">
        {{ form_row(form.group) }}
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div>
            <button class="btn btn-primary" type="submit">{{ 'button.filter'|trans|upper }}</button>
        </div>
    </div>
</div>
{{ form_end(form) }}