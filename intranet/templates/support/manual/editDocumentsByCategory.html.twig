{% extends 'support/manual/layout.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" type="text/css" href="{{ asset('manual.css') }}" />
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-lg-12">

                    {{ form_start(form) }}
                        {{ form_errors(form) }}

                        {% block collection %}
                            {{ include('support/manual/partial/_collection.html.twig', {
                                form: form.documents,
                                category: category
                            }, with_context=false) }}
                        {% endblock %}

                        <div class="text-end">
                            <button type="submit" class="btn btn-primary text-capitalize">{{ 'button.submit'|trans({}, 'messages') }}</button>
                        </div>
                    {{ form_end(form) }}

        </div>
    </div>
{% endblock %}

