{% extends 'task/layout.html.twig' %}
{% trans_default_domain 'task' %}
{% form_theme form_id 'form_theme_vertical.html.twig' %}

{% block content %}
    <div class="row" style="gap: 5rem">
        <div class="col-md-12">
            <h3 class="text-capitalize">{{ 'customer_relationship_team.fields.quick_access'|trans([], 'customer_relationship_team') }}</h3>
            <div class="row">
                <div class="col-md-4">
                    {{ form_start(form_id, { action: path('task_home') }) }}
                    <div class="row">
                        <div class="col-sm-10">
                            {{ form_widget(form_id) }}
                        </div>
                        <div class="col-sm-2">
                            <input type="submit" name="submit" class="btn btn-primary" value="{{ 'menu.search'|trans([], 'messages')|capitalize }}"/>
                        </div>
                    </div>
                    {{ form_end(form_id) }}
                </div>
            </div>
        </div>
    </div>
    {{ data_table(taskDatatable) }}
{% endblock %}

