{% trans_default_domain 'task' %}

{% form_theme form with ['form_theme_vertical.html.twig', _self] %}
{{ form_start(form) }}
{{ form_errors(form) }}
<div class="row mb-2">
    <div class="pe-0 d-flex flex-column gap-3">
        <div class="bg-body rounded h-100 m-0 p-2">
            {% if form.assignee is defined %}
                {{ form_row(form.assignee) }}
            {% endif %}
            {{ form_row(form.comment) }}
            {{ form_row(form.recipients) }}
            {{ form_row(form.file) }}
            {% if form.rescheduleDate is defined %}
                {{ form_row(form.rescheduleDate) }}
            {% endif %}
            <div class="row mt-2 d-flex justify-content-end">
                <div class="col-3 text-end">
                    {{ form_row(form.submit) }}
                </div>
                {% if form.nextTask is defined %}
                    <div class="col-auto">
                        {{ form_row(form.nextTask) }}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{{ form_end(form) }}
