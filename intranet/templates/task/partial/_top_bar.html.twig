{% trans_default_domain 'task' %}
<div class="row mb-3">
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="card-body py-2 px-4">
                <div class="row align-items-center">
                    <div class="col-auto border-end pe-3">
                        {{ include('task/partial/_nav_task.html.twig') }}
                    </div>
                    <div class="col-auto pe-4">
                        <div class="text-uppercase text-muted fw-bold">IF {{ task.indicesFactor ?? 1 }}</div>
                    </div>
                    <div class="col d-flex justify-content-start gap-5 ps-4">
                        <div class="d-flex align-items-center gap-2">
                            <div>
                                <div class="text-uppercase text-muted fw-bold"
                                     style="font-size: 0.6rem; letter-spacing: 0.03em;">
                                    {{ 'task.fields.status' | trans }}</div>
                                <div class="fw-bold small">{{ task.status }}</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            {% if task.assignee is not null and task.assignee.photo is not empty %}
                                <img class="d-block rounded-circle shadow-1-strong border"
                                     src="{{ asset(upload_uri ~ '/' ~ task.assignee.photo.filePath) }}"
                                     style="width: 38px; height: 38px; object-fit: cover;" alt="">
                            {% else %}
                                <img class="d-block rounded-circle shadow-1-strong border"
                                     style="width: 38px; height: 38px; object-fit: cover;"
                                     src="/shared/no_photo.jpg" alt="">
                            {% endif %}
                            <div>
                                <div class="text-uppercase text-muted fw-bold"
                                     style="font-size: 0.6rem; letter-spacing: 0.03em;">
                                    {{ 'task.fields.assignee' | trans }}</div>
                                {% if task.assignee %}
                                    <div class="fw-bold text-primary small">{{ task.assignee.firstname }} {{ task.assignee.lastname }}</div>
                                {% else %}
                                    <div class="fw-bold text-primary small">{{ 'task.fields.unassigned'| trans }}</div>
                                {% endif %}
                            </div>
                        </div>
                        {% if task.createdBy is not null %}
                            <div class="d-flex align-items-center gap-2">
                                {% if task.createdBy.photo is not empty %}
                                    <img class="d-block rounded-circle shadow-1-strong border"
                                         src="{{ asset(upload_uri ~ '/' ~ task.createdBy.photo.filePath) }}"
                                         style="width: 38px; height: 38px; object-fit: cover;" alt="">
                                {% else %}
                                    <img class="d-block rounded-circle shadow-1-strong border"
                                         style="width: 38px; height: 38px; object-fit: cover;"
                                         src="/shared/no_photo.jpg" alt="">
                                {% endif %}
                                <div>
                                    <div class="text-uppercase text-muted fw-bold"
                                         style="font-size: 0.6rem; letter-spacing: 0.03em;">
                                        {{ 'task.fields.created_by'| trans }}</div>
                                    <div class="fw-bold text-dark small">{{ task.createdBy.firstname }} {{ task.createdBy.lastname }}</div>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>