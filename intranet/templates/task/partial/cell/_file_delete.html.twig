<td>
    {% set fileRoute = item['@type'] == 'TaskFile'
    ? path('task_delete_file', {taskId: task.iriId, fileId: item.id, '_token': csrf_token('delete_task_file')})
    : path('delete_comment_file', {id: item.commentId, fileId: item.id, '_token': csrf_token('delete_comment_file')})
    %}
    <a href="{{ fileRoute }}" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure to delete ?');">
        <i class="fa fa-trash fa-fw"></i>
    </a>
</td>