{% trans_default_domain 'task' %}
{% extends 'task/layout.html.twig' %}
{% block title %}{{ parent() }} #{{ task.id }}{% endblock %}


{% block content %}
    <div class="container-fluid g-4">
        {{ include('task/partial/_top_bar.html.twig') }}
        {% if form is not null %}
            <div class="row g-3 mb-3">
                <div class="col-12 col-lg-5">
                    <div class="card border-0 shadow-sm rounded-3 h-100">
                        <div class="card-body">
                                {{ include('task/form/form_comment.html.twig') }}
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-7">
                    <div class="card border-0 shadow-sm rounded-3 h-100">
                        <div class="card-body p-3" style="max-height: 500px; overflow-y: auto;">
                            {{ include('mis/trouble_ticket/partial/_comment.html.twig') }}
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
        {{ include('task/partial/_nav_tabs.html.twig', _context) }}
    </div>
{% endblock %}

{% block translations %}
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'subscribers' }) }}"></script>
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'messages' }) }}"></script>
{% endblock %}