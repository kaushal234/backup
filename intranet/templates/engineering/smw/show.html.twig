{% extends 'layout.html.twig' %}
{% form_theme form 'form_theme_horizontal.html.twig' %}

{% trans_default_domain 'engineering_smw' %}

{% block title %} {{ 'engineering_smw.title.index' |trans }} {% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-8">
            <h3 class="text-capitalize">{{ 'engineering_smw.title.index'|trans }}</h3>
            <div class="row">
                <div class="col-md-6">
                    {{ form_start(form, { action: path('smw_meeting', {module: 'engineering'}) }) }}
                    <div class="row">
                        <div class="col-sm-10">
                            {{ form_widget(form) }}
                        </div>
                        <div class="col-sm-2">
                            <input type="submit" name="submit" class="btn btn-primary" value="{{ 'button.submit'|trans([], 'messages')|capitalize }}"/>
                        </div>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="ibox float-e-margins col-md-8">
            <div class="ibox-title">
                <h5>{{ 'manufacturing_smw.title.links'| trans({}, 'manufacturing_smw') }}</h5>
                <div class="ibox-tools">
                    <a class="collapse-link">
                        <i class="fa fa-chevron-up"></i>
                    </a>
                </div>
            </div>
            <div class="ibox-content">
                <div class="">
                    <table class="footable table table-hover toggle-arrow-tiny report-table table-responsive" data-page-size=20>
                        <thead>
                        <tr>
                            <th>{{ 'manufacturing_smw.fields.title'| trans({}, 'manufacturing_smw') }}</th>
                            <th>{{ 'manufacturing_smw.fields.description'| trans({}, 'manufacturing_smw') }}</th>
                            <th>{{ 'manufacturing_smw.fields.link'| trans({}, 'manufacturing_smw') }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr>
                            <td>{{ 'engineering_smw.fields.wc_unit_shipped'| trans }}</td>
                            <td>{{ 'quality_smw.fields.manufacturing_bu'| trans([], 'quality_smw') }}</td>
                            <td><a href="{{ path('legacy_manufacturing_index', {m: ['kpi', 'buid', 'quality', ''], buid: location.legacyId}) }}#wc_targetlist">
                                    <span class="btn btn-green btn-sm"><i class="far fa-eye fa-fw"></i></span>
                                </a></td>
                        </tr>
                        <tr>
                            <td>{{ 'engineering_smw.fields.wc_top'| trans() }}</td>
                            <td>{{ 'engineering_smw.fields.support_module'| trans }}</td>
                            <td><a href="{{ path('legacy_product_support', {m: ['wc', 'reports', 'WCPNPareto']}) }}">
                                    <span class="btn btn-warning btn-sm"><i class="far fa-eye fa-fw"></i></span>
                                </a></td>
                        </tr>
                        <tr>
                            <td>{{ 'engineering_smw.fields.pdc_kpi'| trans }}</td>
                            <td>{{ 'quality_smw.fields.manufacturing_bu'| trans([], 'quality_smw') }}</td>
                            <td><a href="{{ path('legacy_manufacturing_index', {m: ['kpi', 'buid', 'quality', ''], buid: location.legacyId}) }}#pdc12months">
                                    <span class="btn btn-green btn-sm"><i class="far fa-eye fa-fw"></i></span>
                                </a></td>
                        </tr>
                        <tr>
                            <td>{{ 'engineering_smw.fields.engineering_kpi'| trans }}</td>
                            <td>{{ 'engineering_smw.fields.manufacturing_engineering'| trans }}</td>
                            <td><a href="{{ path('legacy_manufacturing_index', {m: ['kpi2'], bu: location.legacyId, graph: 'engineering' }) }}">
                                    <span class="btn btn-green btn-sm"><i class="far fa-eye fa-fw"></i></span>
                                </a></td>
                        </tr>
                        <tr>
                            <td>{{ 'engineering_smw.fields.bi_80.title'| trans }}</td>
                            <td>{{ 'engineering_smw.fields.bi_80.description'| trans }}</td>
                            <td><a href="{{ path('smw_power_bi_report', {id: '8.1', location: location.erp }) }}">
                                    <span class="btn btn-green btn-sm"><i class="far fa-eye fa-fw"></i></span>
                                </a></td>
                        </tr>
                        <tr>
                            <td>{{ 'engineering_smw.fields.timekeeping'| trans }}</td>
                            <td>{{ 'engineering_smw.fields.time_category'| trans }}</td>
                            <td><a href="{{ path('legacy_manufacturing_eng', {m: ['timekeeping', 'graphs', 'perCategoryForm'], factory: location.erp }) }}">
                                    <span class="btn btn-warning btn-sm"><i class="far fa-eye fa-fw"></i></span>
                                </a></td>
                        </tr>
                        <tr>
                            <td>{{ 'engineering_smw.fields.timekeeping'| trans }}</td>
                            <td>{{ 'engineering_smw.fields.time_module'| trans }}</td>
                            <td><a href="{{ path('legacy_manufacturing_eng', {m: ['timekeeping', 'graphs', 'perProjectForm'], factory: location.erp }) }}">
                                    <span class="btn btn-warning btn-sm"><i class="far fa-eye fa-fw"></i></span>
                                </a></td>
                        </tr>
                        <tr>
                            <td>{{ 'engineering_smw.fields.meap_review'| trans }}</td>
                            <td>{{ 'engineering_smw.fields.meap_dashboard'| trans }}</td>
                            <td><a href="{{ path('legacy_manufacturing_eng', {m: ['meap', 'gantt'], z: 'opened', x: 'ALL', y: location.name }) }}">
                                    <span class="btn btn-green btn-sm"><i class="far fa-eye fa-fw"></i></span>
                                </a></td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
