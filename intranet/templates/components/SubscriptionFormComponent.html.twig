{% form_theme form 'form_theme_vertical.html.twig' %}

<div class="row">
    <div class="col-lg-12">
        <div class="ibox float-e-margins">
            <div class="ibox-title">
                <h5>{{ title|default('button.filter'|trans([], 'messages'))|upper }}</h5>
                <div class="ibox-tools">
                    <a class="collapse-link">
                        <i class="fa fa-chevron-up"></i>
                    </a>
                </div>
            </div>
            <div class="ibox-content">
                {{ form_start(form) }}
                    {{ form_errors(form) }}
                    <div class="row">
                        {% for field in form %}
                            {% if field.vars.name not in ['_token', 'submit', 'delete']  %}
                                <div class="col-lg-3 col-md-6">
                                    {{ form_row(field) }}
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                    <div class="row">
                        <div class="col-lg-12 d-flex justify-content-end gap-2 text-capitalize">
                            {{ form_row(form.submit) }}
                            {{ form_row(form.delete, {attr: {class: 'text-capitalize btn-danger'}}) }}
                        </div>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
