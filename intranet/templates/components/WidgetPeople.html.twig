<div class="col my-3">
    <div class="card border-0 shadow-sm rounded-3 h-100 transition-hover">
        <div class="card-body p-3 d-flex flex-column justify-content-between">

            <div class="d-flex justify-content-between align-items-start">
                <div class="flex-shrink-0">
                    {% if user is not null and user.photo is not empty %}
                        <img class="rounded-circle shadow-sm border border-2 border-white"
                             src="{{ asset(upload_uri ~ '/' ~ user.photo.filePath) }}"
                             style="width: {{ iconWidth }}px; height: {{ iconHeight }}px; object-fit: cover;"
                             alt="">
                    {% else %}
                        <img class="rounded-circle shadow-sm border border-2 border-white"
                             style="width: {{ iconWidth }}px; height: {{ iconHeight }}px; object-fit: cover;"
                             src="/shared/no_photo.jpg"
                             alt="No photo">
                    {% endif %}
                </div>

                <div class="text-end ps-2">
                    <span class="text-muted small text-uppercase fw-bold d-block" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                        {{ translationKey | trans([], domain | default(app.request.get('moduleDomain'))) }}
                    </span>
                </div>
            </div>

            {% if linkParameters.id|default is not empty %}
                <a href="{{ path(link, linkParameters) }}" class="text-decoration-none link-dark-hover">
                    {% block content %}
                        {{ value ? value | capitalize : '' }}
                    {% endblock %}
                </a>
            {% else %}
                {% block content_no_link %}
                    {{ value ? value | capitalize : '' }}
                {% endblock %}
            {% endif %}

        </div>
    </div>
</div>