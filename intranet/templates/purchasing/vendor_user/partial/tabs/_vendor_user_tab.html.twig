{% trans_default_domain 'contacts' %}
<div class="row">
    <div class="col-lg-12">
        <div class="ibox float-e-margins">
            <div class="ibox-title">
                <h5>{{ 'vendor_user'|trans({}, 'messages')|upper }} #{{ vendorUser.id }}</h5>
                <div class="ibox-tools">
                    <a class="collapse-link">
                        <i class="fa fa-chevron-up"></i>
                    </a>
                </div>
            </div>
            <div class="ibox-content">
                <div class="row">
                    <div class="col-md-6">
                        {{ include('helper/_association_table_raw.html.twig', {
                            associationData: {
                                items: {
                                    id: {
                                        label: 'contacts.fields.id'|trans,
                                    },
                                    firstname: {
                                        label: 'contacts.fields.firstname'|trans,
                                    },
                                    lastname: {
                                        label: 'contacts.fields.lastname'|trans(),
                                    },
                                    email: {
                                        label: 'contacts.fields.email'|trans()|capitalize,
                                    },
                                    erpIdentifier: {
                                        label: 'fields.erp_identifier'|trans({}, 'messages')|capitalize,
                                    },
                                    createdAt: {
                                        label: 'fields.created_at'|trans({}, 'messages')|capitalize,
                                        filters: ["date('Y-m-d')"],
                                        preserveNull: true
                                    },
                                    lastLogin: {
                                        label: 'contacts.fields.last_login'|trans(),
                                        filters: ["date('Y-m-d')"],
                                        preserveNull: true
                                    },
                                },
                                data: vendorUser,
                            },
                        }, with_context = false) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
