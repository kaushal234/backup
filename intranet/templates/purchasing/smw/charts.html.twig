{% extends 'layout.html.twig' %}

{% trans_default_domain 'purchasing_smw' %}

{% block title %} {{ 'purchasing_smw.title.index' |trans }} {% endblock %}

{% block content %}
    <div class="row">
        <h2 class="smw-section">{{ 'quality_smw.charts.title'| trans([], 'quality_smw') }}</h2>
    </div>

    <div class="row mt-3">
        <div class="ibox float-e-margins col-md-10">
            <div class="ibox-title">
                <h5>{{ 'purchasing_smw.title.links'| trans }}</h5>
                <div class="ibox-tools">
                    <a class="collapse-link">
                        <i class="fa fa-chevron-up"></i>
                    </a>
                </div>
            </div>
            <div class="ibox-content">
                <div class="">
                    <table class="footable table table-hover toggle-arrow-tiny report-table table-responsive" data-page-size=20>
                        <thead>
                            <tr>
                                <th>{{ 'purchasing_smw.fields.title'| trans }}</th>
                                <th>{{ 'purchasing_smw.fields.description'| trans }}</th>
                                <th>{{ 'purchasing_smw.fields.link'| trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>{{ 'quality_smw.charts.steel.title'| trans([], 'quality_smw') }}</td>
                                <td>{{ 'quality_smw.charts.steel.description'| trans([], 'quality_smw') }}</td>
                                <td>
                                    <a href="https://www.lme.com/metals/ferrous/lme-steel-hrc-fob-china-argus#Price+graph">
                                        <span class="btn btn-green btn-sm">
                                            <i class="far fa-eye fa-fw"></i>
                                        </span>
                                    </a>
                                </td>
                            </tr>
                            <tr>
                                <td>{{ 'quality_smw.charts.copper.title'| trans([], 'quality_smw') }}</td>
                                <td>{{ 'quality_smw.charts.copper.description'| trans([], 'quality_smw') }}</td>
                                <td>
                                    <a href="https://www.lme.com/metals/non-ferrous/lme-copper#Price+graphs">
                                        <span class="btn btn-green btn-sm">
                                            <i class="far fa-eye fa-fw"></i>
                                        </span>
                                    </a>
                                </td>
                            </tr>
                            <tr>
                                <td>{{ 'quality_smw.charts.aluminium.title'| trans([], 'quality_smw') }}</td>
                                <td>{{ 'quality_smw.charts.aluminium.description'| trans([], 'quality_smw') }}</td>
                                <td>
                                    <a href="https://www.lme.com/metals/non-ferrous/lme-aluminium#Price+graphs">
                                        <span class="btn btn-green btn-sm">
                                            <i class="far fa-eye fa-fw"></i>
                                        </span>
                                    </a>
                                </td>
                            </tr>
                            <tr>
                                <td>{{ 'quality_smw.charts.lithium.title'| trans([], 'quality_smw') }}</td>
                                <td>{{ 'quality_smw.charts.lithium.description'| trans([], 'quality_smw') }}</td>
                                <td>
                                    <a href="https://carboncredits.com/lithium-prices-today">
                                        <span class="btn btn-green btn-sm">
                                            <i class="far fa-eye fa-fw"></i>
                                        </span>
                                    </a>
                                </td>
                            </tr>
                            <tr>
                                <td>{{ 'quality_smw.charts.scfi.title'| trans([], 'quality_smw') }}</td>
                                <td>{{ 'quality_smw.charts.scfi.description'| trans([], 'quality_smw') }}</td>
                                <td>
                                    <a href="https://tradingeconomics.com/commodity/containerized-freight-index">
                                        <span class="btn btn-green btn-sm">
                                            <i class="far fa-eye fa-fw"></i>
                                        </span>
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    
{% endblock %}
