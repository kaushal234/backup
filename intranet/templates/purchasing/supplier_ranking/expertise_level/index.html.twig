{% extends 'purchasing/supplier_ranking/layout.html.twig' %}
{% trans_default_domain 'supplier_ranking' %}

{% block content %}
    <div class="row">
        <div class="col-lg-12">
            {{ include('helper/_report_table.html.twig', {
                reportTable: {
                    items: {
                        name: {
                            label: 'catalogue.products.name'|trans({}, 'catalogue')|capitalize,
                        },
                        description: {
                            label: 'fields.description'|trans({}, 'messages')|capitalize,
                        },
                        edit: {
                            label: 'menu.edit' | trans([], 'messages') | capitalize,
                            link:{
                                route: 'expertise_level_rankings_edit',
                                params: { id:'@id' },
                                content: '<span class="btn btn-warning btn-sm"><i class="fa fa-pencil-alt"></i></span>',
                            },
                            sortable: false,
                        },
                        transfer: {
                            label: 'menu.delete'|trans([], 'messages')|capitalize,
                            class: 'text-end',
                            link:{
                                route: 'expertise_level_rankings_transfer',
                                params: {'id':'@id'},
                                content: '<span class="btn btn-danger btn-sm text-capitalize"><i class="fa fa-trash-alt"></i></span>',
                            },
                        }
                    },
                    title: 'fields.expertise_level'|trans|capitalize,
                    data: expertiseLevels,
                    pagination: false,
                    search: false
                }
            }, with_context = false) }}
        </div>
    </div>
{% endblock %}
