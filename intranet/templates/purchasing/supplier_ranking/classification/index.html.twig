{% extends 'purchasing/supplier_ranking/layout.html.twig' %}
{% trans_default_domain 'supplier_ranking' %}

{% block content %}
    <div class="row">
        <div class="col-lg-12">
            {{ include('helper/_report_table.html.twig', {
                reportTable: {
                    items: {
                        name: {
                            label: 'catalogue.products.name'|trans({}, 'catalogue')|capitalize,
                        },
                        description: {
                            label: 'fields.description'|trans|capitalize,
                        },
                        color: {
                            label: 'classification.fields.color'|trans|capitalize,
                        },
                        workflowLevel: {
                            label: 'classification.fields.workflow_level'|trans|capitalize,
                        },
                        isSupplierApproved: {
                            label: 'classification.fields.supplier_approved'|trans|capitalize,
                        },
                        targetClassifications: {
                            label: 'classification.fields.target_classifications'|trans|capitalize,
                            template: 'purchasing/supplier_ranking/classification/partial/_cell_target_classification.html.twig',
                        },
                        edit: {
                            label: 'menu.edit' | trans([], 'messages') | capitalize,
                            link:{
                                route: 'classification_rankings_edit',
                                params: { id:'@id' },
                                content: '<span class="btn btn-warning btn-sm"><i class="fa fa-pencil-alt"></i></span>',
                            },
                            sortable: false,
                        },
                        transfer: {
                            label: 'menu.delete'|trans([], 'messages')|capitalize,
                            class: 'text-end',
                            link:{
                                route: 'classification_rankings_transfer',
                                params: {'id':'@id'},
                                content: '<span class="btn btn-danger btn-sm text-capitalize"><i class="fa fa-trash-alt"></i></span>',
                            },
                        }
                    },
                    title: 'fields.classification'|trans|capitalize,
                    data: classifications,
                    pagination: false,
                    search: false
                }
            }, with_context = false) }}
        </div>
    </div>
{% endblock %}
