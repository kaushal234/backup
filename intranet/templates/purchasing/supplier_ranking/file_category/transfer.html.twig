{% extends 'purchasing/supplier_ranking/layout.html.twig' %}
{% trans_default_domain 'supplier_ranking' %}
{% form_theme form 'form_theme_vertical.html.twig' %}

{% block content %}
<div class="row">
    <div class="col-md-6">
        <div class="ibox float-e-margins">
            <div class="ibox-title">
                <h3>
                    {{ 'file_category.transfer.title'|trans|capitalize }}
                </h3>
            </div>
            <div class="ibox-content">
                {{ form_start(form) }}
                {{ form_errors(form) }}
                <div class="row">
                    <div class="col-md-8">
                        {{ form_row(form.target) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_row(form.delete) }}
                    </div>
                    <div class="col-md-12">
                        <button type="submit" class="btn btn-primary float-end">{{ 'button.submit'|trans([], 'messages') }}</button>
                    </div>
                    {{ form_rest(form) }}
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
