{% form_theme form 'form_theme_vertical.html.twig' %}

{{ form_start(form, { action: action }) }}
{{ form_errors(form) }}
    <div class="row">
        <div class="col-md-4">
            {{ form_row(form.supplierNumber) }}
        </div>
        <div class="col-md-4">
            {{ form_row(form.supplierName) }}
        </div>
        <div class="col-md-4">
            {{ form_row(form.buyer) }}
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            {{ form_row(form.location) }}
        </div>
        <div class="col-md-4">
            {{ form_row(form.classification) }}
        </div>
        <div class="col-md-4">
            {{ form_row(form.supplierApproved) }}
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            {{ form_row(form.supplierDisabled) }}
        </div>
    </div>

    <div class="row">
        {% do form.filter.setRendered %}
        {{ form_rest(form) }}
        <div class="col-lg-12">
            <div>
                <label class="col-form-label">&nbsp;</label>
                <button class="btn btn-primary" type="submit" id="supplier_ranking_filter_filter" name="supplier_ranking_filter[filter]">{{ 'button.filter'| trans | upper }}</button>
                <a href="{{ resetPath }}" class="btn btn-secondary">{{ 'button.reset'| trans | upper }}</a>
            </div>
        </div>
    </div>
{{ form_end(form) }}
