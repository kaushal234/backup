{% extends 'purchasing/vendor_warranty_claim/layout.html.twig' %}
{% trans_default_domain 'vendor_warranty_claim' %}
{% form_theme form 'form_theme_vertical.html.twig' %}

{% block title %}{{ parent() }}#{{ vendorWarrantyClaim.id }}{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'vendor_warranty_claim.title.edit' | trans({'%id%': vendorWarrantyClaim.id})}}</h5>
                </div>
                <div class="ibox-content">
                    {{ form_start(form) }}
                    {{ form_errors(form) }}
                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(form.resolution) }}
                        </div>
                    </div>
                    {{ form_row(form.submit) }}
                    {{ form_rest(form) }}
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
