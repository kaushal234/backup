    <a href="{{ path('vendor_warranty_claim_home', { createdAfter: startDate, createdBefore: endDate, location: extraParameters.location, partNumber: cell.x, supplierNumber: extraParameters.supplierNumber }) }}">{{ cell.value }}</a>
</td>
