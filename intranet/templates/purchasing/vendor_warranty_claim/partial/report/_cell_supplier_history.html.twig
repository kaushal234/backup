{% set startDate = '01%2F01%2F' ~ cell.y %}
{% set endDate = cell.y + 1  %}
{% set endDate = endDate|trans %}
{% set endDate = '01%2F01%2F' ~ endDate%}

{% if extraParameters.rejected %}
    <td>
        <a href="{{ path('vendor_warranty_claim_home', { createdAfter: startDate, createdBefore: endDate, location: extraParameters.location, 'status[0]': xIris[cell.x], supplierNumber: extraParameters.supplierNumber, accepted: 1 }) }}">{{ cell.value }}</a>
    </td>
{% else %}
    <td>
        <a href="{{ path('vendor_warranty_claim_home', { createdAfter: startDate, createdBefore: endDate, location: extraParameters.location, 'status[0]': xIris[cell.x], supplierNumber: extraParameters.supplierNumber }) }}">{{ cell.value }}</a>
    </td>
{% endif %}
