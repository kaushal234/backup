{% extends 'purchasing/vendor_warranty_claim/layout.html.twig' %}
{% trans_default_domain 'vendor_warranty_claim' %}
{% form_theme form_id 'form_theme_vertical.html.twig' %}

{% block content %}
    {% if vendorWarrantyClaims.pagination.estimatedNumberOfPages|default(0) > 1 and (vendorWarrantyClaims | length) == 500 %}
        <div class="alert alert-warning" role="alert">
            <button type="button" class="btn-close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true"></span></button>
            {{ 'vendor_warranty_claim.message.items_per_page' | trans }}</div>
    {% endif %}
    <div class="row">
        <div class="col-md-9">
            <h3 class="text-capitalize">{{ 'customer_relationship_team.fields.quick_access'|trans([], 'customer_relationship_team') }}</h3>
            <div class="row">
                <div class="col-md-4">
                    {{ form_start(form_id, { action: path('vendor_warranty_claim_home') }) }}
                    <div class="col-sm-10">
                        {{ form_widget(form_id) }}
                    </div>

                    <div class="ms-2 col-sm-2">
                        <input type="submit" name="submit" class="btn btn-primary" value="{{ 'menu.search'|trans([], 'messages')|capitalize }}"/>
                    </div>
                    {{ form_end(form_id) }}
                </div>
            </div>
        </div>

        {% if showClaimAmount %}
        <div class="col-md-3">
            <div class="widget bg-body">
                <div class="row">
                    <div class="col-4">
                        <i class="fa fa-coins fa-3x"></i>
                    </div>
                    <div class="col-8 text-end">
                        <span>{{ 'vendor_warranty_claim.title.claim_amount'|trans }}</span>
                        <h3 class="font-bold">{{ totalClaimAmount|number_format(2) }} EUR</h3>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}
        
    </div>
    {{ data_table(vendorWarrantyClaimsDatatable) }}
{% endblock %}

{% block form_label %}
    {{ include('sales/partial/input_with_no_label.html.twig') }}
{%- endblock form_label %}

{% block translations %}
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'messages' }) }}"></script>
{% endblock %}

