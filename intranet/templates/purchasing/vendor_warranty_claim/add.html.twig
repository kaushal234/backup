{% extends 'purchasing/vendor_warranty_claim/layout.html.twig' %}
{% trans_default_domain 'vendor_warranty_claim' %}
{% form_theme form with ['form_theme_vertical.html.twig', _self] %}

{% block title %}{{ parent() }}/{{ 'menu.add'|trans({}, 'messages') | capitalize }}{% endblock %}

{% block content %}
<div class="row">
    <div class="col-md-8">
        <div class="ibox float-e-margins">
            <div class="ibox-title">
                {%set originModule = origin['@id'] is defined ? 'NCR' : 'WC' %}
                {%set originId = origin['@id'] is defined ? origin.id : origin %}
                <h5>{{ 'vendor_warranty_claim.title.add' | trans({'%id%': originId, '%origin%': originModule})}}</h5>
            </div>
            <div class="ibox-content">
                {{ form_start(form) }}
                {{ form_errors(form) }}
                <div class="row">
                    <div class="col-md-12">
                        <p style="fw: bold" class="text-danger">{{ 'vendor_warranty_claim.message.supplier' | trans }}</p>
                        {{ form_row(form.supplier) }}
                    </div>
                </div>
                <div class="row">
                    {% if originModule == 'WC' %}
                        <div class="col-md-6">
                            {{ form_row(form.mainFile) }}
                        </div>
                    {% endif %}
                </div>
                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.location) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.supplierNumber) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        {{ form_row(form.type) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        {{ form_row(form.requestedSupplierAction) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.supplierStockVerified) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.tldStockVerified) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        {{ form_row(form.issueOrigin) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        {{ form_row(form.correctiveAction) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.currency) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.requestedCreditAmount) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        {{ form_row(form.scarRequested) }}
                    </div>
                    <div class="col-md-8">
                        {{ form_row(form.supplierCorrectiveActionRequest) }}
                    </div>
                </div>
                {{ form_row(form.submit) }}
                {{ form_rest(form) }}
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ include('purchasing/vendor_warranty_claim/partial/js/_form_action.html.twig', {form: 'vendor_warranty_claim_add'}) }}
{% endblock %}
