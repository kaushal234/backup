{% extends 'purchasing/vendor_warranty_claim/layout.html.twig' %}
{% trans_default_domain 'vendor_warranty_claim' %}
{% form_theme form with ['form_theme_vertical.html.twig', _self] %}

{% block title %}{{ parent() }}#{{ vendorWarrantyClaim.id }}\{{ 'demo.fields.comment'|trans({}, 'demo') }}{% endblock %}

{% block content %}
<div class="row">
    <div class="col-md-6">
        <div class="ibox float-e-margins">
            <div class="ibox-title">
                <h5>{{ 'vendor_warranty_claim.title.comment' | trans({'%id%': vendorWarrantyClaim.id})}}</h5>
            </div>
            <div class="ibox-content">
                {{ form_start(form) }}
                {{ form_errors(form) }}
                {{ form_row(form.message) }}
                {{ form_row(form.public) }}
                {% if form.ccs is defined %}
                    {{ form_row(form.ccs) }}
                {% endif %}
                {{ form_row(form.submit) }}
                {{ form_rest(form) }}
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
