{% extends 'layout.html.twig' %}

{% trans_default_domain 'manufacturing' %}

{% block title %} {{ 'shortage_report.titles.shortage_filter' |trans }} {% endblock %}

{% form_theme form 'form_theme_vertical.html.twig' %}

{% block content %}
    <div class="row">
    <div class="col-lg-12">
    <div class="ibox float-e-margins">
    <div class="ibox-title">
        <h5>{{ 'shortage_report.titles.shortage_filter' |trans | upper }}</h5>
        <div class="ibox-tools">
            <a class="collapse-link">
                <i class="fa fa-chevron-up"></i>
            </a>
        </div>
    </div>
    <div class="ibox-content">
        {{ form_start(form) }}
            {{ form_errors(form) }}
        <div class="row">
            <div class="col-lg-2">
                {{ form_row(form.erp) }}
            </div>
            <div class="col-lg-2">
                {{ form_row(form.sequenceNumber) }}
            </div>
        </div>
        <div class="row">
            {{ form_rest(form) }}
            <div class="col-lg-12">
                <div>
                    <label class="col-form-label">&nbsp;</label>
                    <button class="btn btn-primary" type="submit">{{ 'button.filter'| trans([],'messages') | upper }}</button>
                    <a href="{{ resetPath }}" class="btn btn-secondary">{{ 'button.reset'| trans([],'messages') | upper }}</a>
                </div>
            </div>
        </div>
        {{ form_end(form) }}
    </div>
    </div>
    </div>
    </div>
{% endblock content %}