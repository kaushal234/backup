{% extends 'parts/spq/layout.html.twig' %}
{% trans_default_domain "spq" %}

{% set quotation_id = iri_id(quotation) %}

{% block title %}{{ parent() }}\{{ 'menu.view'|trans([], 'messages') }}{% endblock %}

{% block content %}
    {{ parent() }}
    <script src="/shared/javascript/hinclude/hinclude.min.js"></script>

    <div class="ibox float-e-margins">
        <div class="ibox-title">
            <h5>{{ 'menu.people.tasks'|trans([], 'messages') }}</h5>
            <div class="ibox-tools">
                <a class="collapse-link">
                    <i class="fa fa-chevron-up"></i>
                </a>
            </div>
        </div>
        <div class="ibox-content">
            <a href="{{ path('legacy_calendar') }}?m[0]=tasks&m[1]=form&m[2]=newTask&module=SPQ2&parent_id={{ quotation_id }}" class="btn btn-info text-capitalize"><i class="fa fa-plus"></i>&nbsp;{{ 'menu.add'|trans([], 'messages') }}</a>
            <hx:include src="/en/private/calendar/tasks/tasks_hinclude.php?module=SPQ2&parent_id={{ quotation.id }}" id="block_task">
                <div class="text-center"><span class="fa fa-refresh fa-spin"></span></div>
            </hx:include>
        </div>
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ include('partial/_footable.html.twig', {'selectors': ['#block_task']}) }}
{% endblock %}
