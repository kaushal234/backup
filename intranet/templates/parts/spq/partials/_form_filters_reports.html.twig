{% form_theme form 'form_theme_vertical.html.twig' %}

{{ form_start(form) }}
{{ form_errors(form) }}

<div class="row">
    <div class="col-md-4">
        {{ form_row(form.quotation_sph) }}
    </div>
    <div class="col-md-4">
        {{ form_row(form.quotation_poster) }}
    </div>
    <div class="col-md-4">
        {{ form_row(form.quotation_quoter) }}
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        {{ form_row(form.quotation_status) }}
    </div>
    <div class="col-md-4">
        {{ form_row(form.quotation_baanCustomerNumber) }}
    </div>
    <div class="col-md-4">
        {{ form_row(form.partNumber) }}
    </div>
</div>
<div class="row">
    <div class="col-md-4">
        {{ form_row(form.created_at_after) }}
    </div>
    <div class="col-md-4">
        {{ form_row(form.created_at_before) }}
    </div>
    <div class="col-md-4">
        {{ form_row(form.status) }}
    </div>
</div>
<div class="row">
    <div class="col-md-4">
        {{ form_row(form.quotation_closed_at_after) }}
    </div>
    <div class="col-md-4">
        {{ form_row(form.quotation_closed_at_before) }}
    </div>
    <div class="col-md-4">
        {{ form_row(form.payableService) }}
    </div>
</div>

<div class="row">
    {% do form.download.setRendered %}
    {{ form_rest(form) }}
    <div class="col-lg-12">
        <div>
            <button class="btn btn-primary" type="submit">{{ 'button.filter'|trans|upper }}</button>
            <a href="{{ resetPath }}" class="btn btn-secondary" id="quotations-filter-submit">{{ 'button.reset'|trans|upper }}</a>
            <button class="btn btn-primary btn-danger" type="submit" id="download" name="download"><i class="fa fa-download"></i>&nbsp;{{ 'menu.download'|trans|upper }}</button>
        </div>
    </div>
</div>
{{ form_end(form) }}
