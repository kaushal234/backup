<td><span class="btn btn-sm btn-{% if item.status in ['PENDING', 'SUSPENDED'] %}warning{% elseif item.status in ['SUBMITTED_PARTIAL', 'SUBMITTED_FULL', 'SUBMITTED_FULL_REVISED', 'QUOTED'] %}primary{% elseif item.status in ['CANCELLED'] %}default{% elseif item.status in ['ORDERED_PARTIAL', 'ORDERED_FULL', 'SOLD'] %}info{% else %}danger{% endif %}" style="cursor:default">{{ item.status }}</span></td>
