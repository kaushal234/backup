{% form_theme form 'form_theme_vertical.html.twig' %}

{{ form_start(form) }}
{{ form_errors(form) }}

<div class="row">
    <div class="col-md-3">
        {{ form_row(form.locations) }}
    </div>
    <div class="col-md-3">
        {{ form_row(form.quoter ?? form.poster) }}
    </div>
    <div class="col-md-3">
        {{ form_row(form.cunos) }}
    </div>
    <div class="col-md-3">
        {{ form_row(form.payableService) }}
    </div>
</div>

<div class="row">
    {{ form_rest(form) }}
    <div class="col-lg-12">
        <div>
            <button class="btn btn-primary" type="submit">{{ 'button.filter'|trans|upper }}</button>
        </div>
    </div>
</div>
{{ form_end(form) }}
