{% trans_default_domain 'task' %}

{% set items = {
    filePath: {
        label: 'task.fields.files' | trans,
        filters: 'slice(29)',
        link: {
            route: 'spare_parts_request_download_file',
            params: {
                'fileId': 'id',
            },
            fixedParams: {
                'sparePartsRequestId': sparePartsRequest.id
            }
        },
    },
    description: {
        label: 'task.fields.file_description' | trans,
    },
    createdAt: {
        label: 'task.fields.created_at' | trans,
        filters: 'date("Y-m-d H:i:s")'
    },
    size: {
        label: 'task.fields.size' | trans,
        filters : 'readable_filesize'
    }
} %}

{% set items = items | merge({
    delete: {
        label: 'task.fields.delete' | trans,
        sortable: false,
        class: 'text-end',
        link: {
            route: 'spare_parts_request_delete_file',
            params: {'fileId': 'id'},
            fixedParams: {'sparePartsRequestId': sparePartsRequest.id, '_token': csrf_token('delete_spare_parts_request_file')},
            content: '<span class="btn btn-danger btn-sm"><i class="fa fa-trash fa-fw"></i></span>',
            popup: {
                type: 'confirmation',
                title: 'visibility.popup.confirmation.title'|trans({}, 'file_type'),
                message: 'delete.popup.confirmation.message'|trans({}, 'file_type'),
            }
        },
    }
}
) %}
{{ include('helper/_report_table.html.twig', {
    reportTable: {
        items: items,
        title: 'spare_parts_request.fields.files' | trans({}, 'spare_parts_request'),
        data: sparePartsRequest.sparePartsRequestFiles,
        search: false,
        pagination: false,
        initialSorting: 'createdAt'
    }
}, with_context = false) }}
