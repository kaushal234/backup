{% extends 'parts/layout.html.twig' %}

{% form_theme form 'form_theme_vertical.html.twig' %}

{% block content %}
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'part_number_task.title'|trans({}, 'task') }}</h5>

                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>

                <div class="ibox-content">
                    {% include 'parts/part_number_tasks/partial/_form.html.twig' with { form: form } %}
                </div>
            </div>
        </div>
    </div>

    {{ data_table(datatable) }}
{% endblock %}