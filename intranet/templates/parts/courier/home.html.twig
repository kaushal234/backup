{% extends 'parts/courier/layout.html.twig' %}
{% trans_default_domain 'courier' %}

{% form_theme formAdd 'form_theme_vertical.html.twig' %}

{% set isGrantedAdmin = is_granted('FEATURE_COURIER_ADMIN') or is_granted('MOO_SPR') %}

{% block content %}
    <div class="row">
        <div class="col-md-8">

            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'courier.title' | trans }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {% if isGrantedAdmin %}
                        {{ form_start(form) }}
                        {{ form_errors(form) }}
                    {% endif %}
                    {% set items = {
                        name: {
                            label: 'fields.name'|trans({}, 'messages')|capitalize,
                            template: '/parts/courier/partial/_form_cell_key.html.twig',
                            templateParams: {form: form, isGrantedAdmin: isGrantedAdmin, key: 'name' },
                        },
                        url: {
                            label: 'customers.fields.url'|trans({}, 'sales_customers')|capitalize,
                            template: '/parts/courier/partial/_form_cell_key.html.twig',
                            templateParams: {form: form, isGrantedAdmin: isGrantedAdmin, key: 'url'},
                        },
                        parameterName: {
                            label: 'courier.fields.parameter_name'|trans|capitalize,
                            template: '/parts/courier/partial/_form_cell_key.html.twig',
                            templateParams: {form: form, isGrantedAdmin: isGrantedAdmin, key: 'parameterName'},
                        },
                    } %}

                    {% if isGrantedAdmin %}
                        {% set items = items|merge({
                            delete: {
                                label: 'menu.delete'|trans({}, 'messages')|capitalize,
                                sortable: false,
                                class: 'text-end',
                                link: {
                                    route: 'courier_delete',
                                    params: {'id': 'id'},
                                    fixedParams: {'_token': csrf_token('delete_courier')},
                                    content: '<span class="btn btn-danger btn-sm"><i class="fa fa-trash fa-fw popup"></i></span>',
                                    popup: {
                                        type: 'confirmation',
                                        title: 'Confirmation',
                                        message: 'Are you sure to delete?',
                                    },
                                },
                            },
                        }) %}
                    {% endif %}

                    {{ include('helper/_report_table_raw.html.twig', {
                        reportTable: {
                            items: items,
                            initialSorting: false,
                            data: couriers,
                            search: false,
                            pagination: false,
                        }
                    }, with_context = false) }}
                    {% if isGrantedAdmin %}
                        <div class="text-end">
                            {{ form_row(form.submit) }}
                        </div>
                        {{ form_rest(form) }}
                        {{ form_end(form) }}
                    {% endif %}
                </div>
            </div>
        </div>

        {% if isGrantedAdmin %}
            <div class="col-md-4">
                <div class="ibox float-e-margins">
                    <div class="ibox-title">
                        <h5>{{ 'courier.add'|trans }}</h5>
                        <div class="ibox-tools">
                            <a class="collapse-link">
                                <i class="fa fa-chevron-up"></i>
                            </a>
                        </div>
                    </div>
                    <div class="ibox-content">
                        <div class="row">
                            <div class="col-sm-12">
                                {{ form_start(formAdd) }}
                                {{ form_errors(formAdd) }}
                                {{ form_row(formAdd.name) }}
                                {{ form_row(formAdd.url) }}
                                {{ form_row(formAdd.parameterName) }}
                                {{ form_row(formAdd.submit) }}
                                {{ form_end(formAdd) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block translations %}
    {{ parent() }}
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'messages' }) }}"></script>
{% endblock %}
