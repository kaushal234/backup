{% extends 'parts/layout.html.twig' %}
{% block title %}Parts{% endblock %}

{% block top_navigation_bar %}
    <twig:NavBar:Container>
        <twig:NavItem:Add route="parts_transportation_note_add"
                          :security="is_granted('FEATURE_TRANSPORTATION_NOTE_WRITE')"/>
        <twig:NavItem translationKey="parts.nav_item.home" domain="parts" icon="material-symbols:home-outline-rounded"
                      route="parts_transportation_note_home"/>
        {% if note.id is defined %}
            <twig:NavItem translationKey="parts.nav_item.home" domain="parts"
                          icon="material-symbols:home-outline-rounded" route="parts_transportation_note_show"
                          :routeParameters="{id:note.id}"/>
            <twig:NavItem translationKey="parts.nav_item.logs" domain="parts" icon="mynaui:list"
                          route="parts_transportation_note_logs" :routeParameters="{id:note.id}"/>
            <twig:NavItem:Edit route="parts_transportation_note_edit" :routeParameters="{id:note.id}"
                               :security="is_granted('FEATURE_TRANSPORTATION_NOTE_WRITE')"/>
        {% endif %}
    </twig:NavBar:Container>
{% endblock %}
