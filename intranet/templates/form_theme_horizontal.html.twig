{% use "bootstrap_5_horizontal_layout.html.twig" %}


{# Labels #}
{% block form_label -%}
    {% apply spaceless %}
        {% if label is same as(false) %}
            <div class="{{ block('form_label_class') }}"></div>
        {% else %}
            {% set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' ' ~ block('form_label_class'))|trim}) %}
            {% set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' col-form-label')|trim}) -%}
            {% if not compound %}
                {% set label_attr = label_attr|merge({'for': id}) %}
            {% endif %}
            {% if required %}
                {% set label_attr = label_attr|merge({'class': (label_attr.class|default('') ~ ' required')|trim}) %}
            {% endif %}
            {% if label is empty %}
                {% if label_format is not empty %}
                    {% set label = label_format|replace({
                        '%name%': name,
                        '%id%': id,
                    }) %}
                {% else %}
                    {% set label = name|humanize %}
                {% endif %}
            {% endif %}
            <label{% for attrname, attrvalue in label_attr %} {{ attrname }}="{{ attrvalue }}"{% endfor %}>{% if required -%}<span style="color:#ed5565">*</span>&nbsp;{%- endif -%}{{ translation_domain is same as(false) ? label : label|trans({}, translation_domain) }}</label>
        {% endif %}
    {% endapply %}
{%- endblock form_label %}

{% block checkbox_widget -%}
    {%- set parent_label_class = parent_label_class|default(label_attr.class|default('')) -%}
    <div class="checkbox checkbox-primary">
        <input type="checkbox" {{ block('widget_attributes') }}{% if value is defined %} value="{{ value }}"{% endif %}{% if checked %} checked="checked"{% endif %} />
        <label for="{{ id }}">{{ translation_domain is same as(false) ? label : label|trans({}, translation_domain) }}</label>
    </div>
{%- endblock checkbox_widget %}

{% block radio_widget -%}
    {%- set parent_label_class = parent_label_class|default(label_attr.class|default('')) -%}
    <div class="radio radio-primary {{ 'radio-inline' in parent_label_class ? 'form-check form-check-inline' : '' }}">
        <input type="radio" {{ block('widget_attributes') }}{% if value is defined %} value="{{ value }}"{% endif %}{% if checked %} checked="checked"{% endif %} />
        <label for="{{ id }}">{{ translation_domain is same as(false) ? label : label|trans({}, translation_domain) }}</label>
    </div>
{%- endblock radio_widget %}

{% block submit_row -%}
    <div>
        <div class="{{ block('form_label_class') }}"></div>
        <div class="text-end {{ block('form_group_class_submit') }}">
            {{- form_widget(form) -}}
        </div>
    </div>
{%- endblock submit_row %}

{% block switch_row %}
    {%- set attr_class = attr.class|default('') ~ ' form-control' -%}
    {%- set attr = attr|merge({class: attr_class|trim}) -%}

    <div class="mb-3 row">
        {{ block('form_label') }}
        <div class="col-sm-10">
            {{ block('switch_widget') }}
        </div>
    </div>
{% endblock switch_row %}
