{% extends 'directory/department/layout.html.twig' %}
{% trans_default_domain 'directory' %}

{% set department_id = iri_id(department) %}

{% block title %}{{ parent() }}\{{ 'menu.delete'|trans([], 'messages') }}{% endblock %}

{% block content %}
    <h3>{{ 'directory.department.title.delete'|trans }}</h3>

<div class="row">
    <div class="col-lg-8">
        {% if used %}
            <div class="alert alert-danger">{{ 'directory.department.warning.replacement'|trans }}</div>
        {% endif %}
        {{ form_start(form) }}
        {{ form_errors(form) }}
        <div>
            <label class="col-sm-2 col-form-label">{{ 'directory.department.name'|trans|upper }}#</label>
            <div class="col-sm-10">
                <div class="form-control">{{ department_id }}</div>
            </div>
        </div>
        <div>
            <label class="col-sm-2 col-form-label">{{ 'directory.department.fields.name'|trans }}</label>
            <div class="col-sm-10">
                <div class="form-control">{{ department.name }}</div>
            </div>
        </div>
        {{ form_rest(form) }}
        <div>
            <div class="col-sm-12">
                <button type="submit" class="btn btn-primary float-end text-capitalize">{{ 'button.delete'|trans([], 'messages') }}</button>
            </div>
        </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
