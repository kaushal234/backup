{% extends 'directory/department/layout.html.twig' %}
{% trans_default_domain 'directory' %}

{% set department_id = iri_id(department) %}

{% block title %}{{ parent() }}\{{ 'menu.view'|trans([], 'messages') }}{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-lg-6">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'directory.department.title.view'|trans }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    <div class="">
                        <table class="table table-bordered table-hover association-table table-responsive">
                            <tbody>
                            <tr>
                                <th>{{ 'directory.department.name'|trans|upper }}#</th>
                                <td>{{ department_id }}</td>
                            </tr>
                            <tr>
                                <th>{{ 'directory.department.fields.name'|trans }}</th>
                                <td>{{ department.name }}</td>
                            </tr>
                            <tr>
                                <th>{{ 'directory.department.fields.sso'|trans }}</th>
                                <td>{{ department.sso ? 'yes'|trans([], 'messages') : 'no'|trans([], 'messages') }}</td>
                            </tr>
                            <tr>
                                <th>{{ 'directory.department.fields.factory'|trans }}</th>
                                <td>{{ department.factory ? 'yes'|trans([], 'messages') : 'no'|trans([], 'messages') }}</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
    <div class="ibox-content">
        <div class="logs-block" data-resource="{{ department['@id'] }}" data-show-comment-form="true"></div>
    </div>
{% endblock %}
{% block translations %}
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'messages' }) }}"></script>
{% endblock %}
