{% extends 'directory/layout.html.twig' %}
{% trans_default_domain 'directory' %}

{% block title %}{{ parent() }}\{{ 'directory.region.name'|trans }}{% endblock %}

{% block top_navigation_bar %}
    <twig:NavBar:Container>
        <twig:NavItem:Add route="directory_regions_add"
                          :security="is_granted('FEATURE_DIVISION_WRITE') or is_granted('MOO_DIR')"/>
        {% if region_id is defined %}
            <twig:NavItem:Edit route="directory_regions_edit" :routeParameters="{ id: region_id }"
                               :security="is_granted('FEATURE_DIVISION_WRITE') or is_granted('MOO_DIR')"/>
            <twig:NavItem:Delete route="directory_regions_delete" :routeParameters="{ id: region_id }"
                                 :security="is_granted('FEATURE_DIVISION_WRITE') or is_granted('MOO_DIR')"/>
        {% endif %}
    </twig:NavBar:Container>
{% endblock %}