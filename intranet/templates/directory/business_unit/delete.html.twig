{% extends 'directory/business_unit/layout.html.twig' %}
{% trans_default_domain 'directory' %}

{% set business_unit_id = iri_id(business_unit) %}

{% block title %}{{ parent() }}\{{ 'menu.delete'|trans([], 'messages') }}{% endblock %}

{% block content %}
    <h3>{{ 'directory.business_unit.title.delete'|trans|capitalize }}</h3>

    {% if not used %}
        <div class="row">
            <div class="col-lg-8">
                {{ form_start(form) }}
                {{ form_errors(form) }}
                <div>
                    <label class="col-sm-2 col-form-label">{{ 'directory.business_unit.name'|trans|upper }}#</label>
                    <div class="col-sm-10">
                        <div class="form-control">{{ business_unit_id }}</div>
                    </div>
                </div>
                <div>
                    <label class="col-sm-2 col-form-label">{{ 'directory.business_unit.fields.name'|trans }}</label>
                    <div class="col-sm-10">
                        <div class="form-control">{{ business_unit.name }}</div>
                    </div>
                </div>
                {{ form_rest(form) }}
                <div>
                    <div class="col-sm-12">
                        <button type="submit" class="btn btn-primary float-end text-capitalize">{{ 'button.delete'|trans([], 'messages') }}</button>
                    </div>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    {% else %}
        <p><i style="color: red;">{{ 'directory.business_unit.warning.used'|trans }}</i></p>
    {% endif %}

{% endblock %}
