{% set id = iri_id(subDivision) %}

{% block title %}{{ parent() }}\{{ 'menu.edit'|trans([], 'messages') }}{% endblock %}

{% block content %}
    <h3>{{ 'directory.sub_division.title.edit'|trans([], 'directory')|capitalize }}</h3>

    {{ include('directory/sub_division/partial/_form.html.twig', {
        form: form,
        action: path('directory_sub_divisions_edit', { id: id }),
        cancel_link: path('directory_sub_divisions_show', { id: id }),
        id: id
    }, with_context=false) }}
{% endblock %}
