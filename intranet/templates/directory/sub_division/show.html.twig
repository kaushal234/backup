{% extends 'directory/sub_division/layout.html.twig' %}
{% trans_default_domain 'directory' %}

{% block title %}{{ parent() }}\{{ 'menu.view'|trans([], 'messages') }}{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-lg-6">
            {{ include('helper/_association_table.html.twig', {
                associationData: {
                    items: {
                        '@id': {
                            label: 'directory.sub_division.name'|trans|upper ~ '#',
                            filters: 'iri_id',
                        },
                        name: {'label': 'fields.name'|trans({}, 'messages')|capitalize},
                        division: {
                            label: 'directory.division.name'|trans|capitalize,
                            properties: ['division.name'],
                            link:{ route: 'directory_divisions_show', params: {'id':'division.@id'} },
                        },
                        logo: {
                            label: 'directory.location.fields.logo'|trans,
                            template: 'directory/sub_division/partial/_logo.html.twig',
                        }
                    },
                    title: 'directory.sub_division.title.view'|trans|capitalize,
                    data: subDivision
                },
            }, with_context = false) }}
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'menu.logs'|trans({}, 'messages') }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    <div class="logs-block" data-resource="{{ subDivision.iri }}" data-show-comment-form="true"></div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            {{ include('helper/_report_table.html.twig', {
                reportTable: {
                    items: {
                        name: {
                            label: 'directory.region.name'|trans|capitalize,
                            link:{ route: 'directory_regions_show', params: {'id':'@id'}},
                        },
                    },
                    title: 'directory.region.title.list'|trans|capitalize,
                    data: subDivision.regions,'initialSorting': 'name'
                }
            }, with_context = false) }}
            {{ include('directory/partial/members.html.twig', {members: members}, with_context = false) }}
        </div>
    </div>
{% endblock %}

{% block translations %}
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'messages' }) }}"></script>
{% endblock %}
