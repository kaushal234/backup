{% extends 'directory/position/layout.html.twig' %}
{% trans_default_domain 'directory' %}

{% set position_id = iri_id(position) %}

{% block title %}{{ parent() }}\{{ 'menu.delete'|trans([], 'messages') }}{% endblock %}

{% block content %}
    <h3>{{ 'directory.position.title.delete'|trans|capitalize }}</h3>

    {% if usersCount == 0 %}
        <div class="row">
            <div class="col-lg-8">
                {{ form_start(form) }}
                {{ form_errors(form) }}
                <div class="form-control">
                    <label class="col-sm-2 col-form-label">{{ 'directory.position.name'|trans|upper }}#</label>
                    <div class="col-sm-10">
                        <div class="form-control">{{ position_id }}</div>
                    </div>
                </div>
                <div>
                    <label class="col-sm-2 col-form-label">{{ 'directory.position.fields.code'|trans }}</label>
                    <div class="col-sm-10">
                        <div class="form-control">{{ position.code }}</div>
                    </div>
                </div>
                {{ form_rest(form) }}
                <div>
                    <div class="col-sm-12">
                        <button type="submit" class="btn btn-primary float-end text-capitalize">{{ 'button.delete'|trans([], 'messages') }}</button>
                    </div>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    {% else %}
        <p><i style="color: red;">{{ 'directory.position.warning.users'|trans({ '%usersCount%': usersCount }) }}</i></p>
    {% endif %}

{% endblock %}
