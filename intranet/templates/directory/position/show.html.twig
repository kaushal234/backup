{% extends 'directory/position/layout.html.twig' %}
{% trans_default_domain 'directory' %}

{% set position_id = iri_id(position) %}

{% block title %}{{ parent() }}\{{ 'menu.view'|trans([], 'messages') }}{% endblock %}

{% block content %}
<div class="row">
    <div class="col-lg-6">
        <div class="ibox float-e-margins">
            <div class="ibox-title">
                <h5>{{ 'directory.position.title.view'|trans }}</h5>
                <div class="ibox-tools">
                    <a class="collapse-link">
                        <i class="fa fa-chevron-up"></i>
                    </a>
                </div>
            </div>
            <div class="ibox-content">
                {{ include('helper/_association_table_raw.html.twig', {
                    associationData: {
                        search: false,
                        title: 'directory.position.title.view' |trans,
                        items: {
                            name: {
                                label: 'directory.position.name'|trans|capitalize
                            },
                            code: {
                                label: 'directory.position.fields.code'|trans|capitalize
                            },
                            description: {
                                label: 'directory.position.fields.description'|trans|capitalize
                            },
                            level: {
                                properties: ['level.label'],
                                label: 'directory.position.fields.level'|trans|capitalize
                            },
                            groups: {
                                template: 'directory/position/_cell_standardAcl.html.twig',
                                label: 'directory.position.fields.groups'|trans|capitalize
                            },
                            mentorMandatory: {
                                label: 'directory.position.fields.is_mentor_mandatory'|trans
                            }
                        },
                        data: position
                    },
                }, with_context = false) }}
            </div>
        </div>
    </div>
</div>
    {% if is_granted('ACL_SUPERUSER') %}
        {{ resourceActivities(position['@id'], path('directory_positions_show', { id: position_id })) }}
    {% endif %}
    {% endblock %}

{% block translations %}
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'messages' }) }}"></script>
{% endblock %}