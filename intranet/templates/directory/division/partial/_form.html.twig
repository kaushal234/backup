<div class="row">
    <div class="col-lg-4">
        {{ form_start(form, { action: action }) }}
        {{ form_errors(form) }}
        {{ form_rest(form) }}
        <button type="submit" class="btn btn-primary float-end">{{ 'button.submit'|trans }}</button>
        {{ form_end(form) }}
    </div>
</div>
