{% extends 'directory/location/layout.html.twig' %}
{% trans_default_domain 'directory' %}

{% block content %}
    <div class="row">
        <div class="col-lg-10">
            {{ include('helper/_report_table.html.twig', {
                'reportTable': {
                    'items': {
                        name: {'label': 'directory.location.fields.name'|trans|capitalize},
                        company: {'label': 'directory.location.fields.company'|trans|capitalize},
                        network: {properties:['network.name'], 'label': 'directory.location.fields.network'|trans|capitalize},
                        erp: {
                            'label': 'directory.location.fields.erp'|trans|capitalize,
                            'sortable': 'numeric'
                        },
                        capability_sso: {
                            properties: ['capability.sso'],
                            label: 'directory.location_capability.fields.sso'|trans([], 'directory')|capitalize,
                            boolean: {
                                true: '<span class="d-none">1</span><i class="fa fa-check text-info"></i>',
                                false: '<span class="d-none">0</span><i class="fa fa-times text-danger"></i>'
                            }
                        },
                        capability_factory: {
                            properties: ['capability.factory'],
                            label: 'directory.location_capability.fields.factory'|trans([], 'directory')|capitalize,
                            boolean: {
                                true: '<span class="d-none">1</span><i class="fa fa-check text-info"></i>',
                                false: '<span class="d-none">0</span><i class="fa fa-times text-danger"></i>'
                            }
                        },
                        capability_warehouse: {
                            properties: ['capability.warehouse'],
                            label: 'directory.location_capability.fields.warehouse'|trans([], 'directory')|capitalize,
                            boolean: {
                                true: '<span class="d-none">1</span><i class="fa fa-check text-info"></i>',
                                false: '<span class="d-none">0</span><i class="fa fa-times text-danger"></i>'
                            }
                        },
                        capability_sparePartsHub: {
                            properties: ['capability.sparePartsHub'],
                            label: 'directory.location_capability.fields.sparePartsHub'|trans([], 'directory')|capitalize,
                            boolean: {
                                true: '<span class="d-none">1</span><i class="fa fa-check text-info"></i>',
                                false: '<span class="d-none">0</span><i class="fa fa-times text-danger"></i>'
                            }
                        },
                        capability_serviceHub: {
                            properties: ['capability.serviceHub'],
                            label: 'directory.location_capability.fields.serviceHub'|trans([], 'directory')|capitalize,
                            boolean: {
                                true: '<span class="d-none">1</span><i class="fa fa-check text-info"></i>',
                                false: '<span class="d-none">0</span><i class="fa fa-times text-danger"></i>'
                            }
                        },
                        capability_headQuarter: {
                            properties: ['capability.headQuarter'],
                            label: 'directory.location_capability.fields.headQuarter'|trans([], 'directory')|capitalize,
                            boolean: {
                                true: '<span class="d-none">1</span><i class="fa fa-check text-info"></i>',
                                false: '<span class="d-none">0</span><i class="fa fa-times text-danger"></i>'
                            }
                        },
                        view: {
                            'label': 'menu.view'|trans([], 'messages')|capitalize,
                            'link':{
                                'route': 'directory_locations_show',
                                'params': {'id':'@id'},
                                'content': '<span class="btn btn-primary btn-sm"><i class="far fa-eye fa-fw"></i></span>',
                            },
                            'sortable': false,
                            'class' : 'text-end'
                        },
                    },
                    'title': 'directory.location.title.list'|trans|capitalize,
                    'data': locations,
                    'pagination': false
                }
            }, with_context = false) }}
        </div>
    </div>
{% endblock %}
