{% extends 'directory/people/layout_people.html.twig' %}
{% trans_default_domain 'directory' %}

{% set people_id = iri_id(people) %}

{% block content %}
    <div class="row">
        <h3>{{ 'directory.people.define-password-title'|trans }} <b>{{ people.lastname }} {{ people.firstname }}</b></h3>
        <div class="col-md-8 col-lg-6">
            {% form_theme form 'form_theme_vertical.html.twig' %}
            {{ form_start(form) }}
                {{ form_errors(form) }}
                {{ form_rest(form) }}
                <button type="submit" class="btn btn-primary float-end">{{ 'button.submit'|trans([], 'messages') }}</button>
                {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
