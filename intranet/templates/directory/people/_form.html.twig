{% block javascripts %}
    <script>
        window.onload = function() {
            document.addEventListener('DOMContentLoaded', function () {

                const hiddenInput = document.querySelector('input[name="people[closestAirport]"]');
                const AirportSelectComponent = hiddenInput.nextElementSibling;
                const premiseSelect = document.getElementById('people_premise');
                let isOffSiteLocationPremise = premiseSelect.value === '';

                if (!isOffSiteLocationPremise) {
                    AirportSelectComponent.classList.add('hidden');
                }

                premiseSelect.addEventListener('change', function () {
                    let isOffSiteLocationPremise = premiseSelect.value === '';
                    if (isOffSiteLocationPremise) {
                        AirportSelectComponent.classList.remove('hidden');
                    } else {
                        AirportSelectComponent.classList.add('hidden');
                    }
                });
            });
        }

    </script>

{% endblock %}