{% form_theme form 'form_theme_vertical.html.twig' %}

{{ form_start(form) }}
        {{ form_errors(form) }}
<div class="row">
    <div class="col-lg">
        {{ form_row(form.position) }}
    </div>
    <div class="col-lg">
        {{ form_row(form.businessUnit) }}
    </div>
    <div class="col-lg">
        {{ form_row(form.department) }}
    </div>
    <div class="col-lg">
        {{ form_row(form.region) }}
    </div>
    <div class="col-lg">
        {{ form_row(form.division) }}
    </div>
    <div class="col-lg">
        {{ form_row(form.airport) }}
    </div>
</div>


<div class="row">
    <div class="col-lg-12">
        <hr class="hr-line-dashed">
        <div class="form-group text-end">
            <label class="control-label">&nbsp;</label>
            <button class="btn btn-primary" type="submit">{{ 'button.filter'| trans | upper }}</button>
            <a href="{{ resetPath }}" class="btn btn-secondary">{{ 'button.reset'| trans | upper }}</a>
            {% if (form.download is defined) %}
                {{ form_widget(form.download) }}
            {% endif %}
        </div>
    </div>
</div>
{{ form_end(form) }}
