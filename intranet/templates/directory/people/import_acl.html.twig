{% extends 'directory/people/layout_acls.html.twig' %}

{% block content %}
    <h3>{{ 'directory.import_acl.title'| trans({}, 'directory') }}</h3>
    <div class="row">
        <div class="col-md-8 col-lg-6 m-b-xl">
            {% form_theme form  'form_theme_vertical.html.twig' %}
            {{ form_start(form) }}
            {{ form_errors(form) }}
            {{ form_row(form.user) }}
            {{ form_row(form.location) }}
            {{ form_widget(form.keep_location) }}
            {{ form_row(form.submit_step_1) }}
            {% if  form.acl_choice is defined %}
                {{ form_widget(form.acl_choice) }}
                {{ form_row(form.submit_step_2) }}
            {% endif %}
            {{ form_end(form) }}
            </div>
    </div>
    {{ include('directory/people/_acls_list.html.twig') }}
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('directoryPeople') }}
{% endblock %}
