<h3 class="text-capitalize">{{ 'directory.people.title.search'|trans([], 'directory') }}</h3>
<div class="row">
    <div class="col-md-8 col-lg-6 m-b-xl">
        {% form_theme form 'form_theme_vertical.html.twig' %}
        {{ form_start(form) }}
        {{ form_errors(form) }}
        <div class="row">
            <div class="col-md-10 col-sm-12">
                <div>
                    {{ form_widget(form.name) }}
                </div>
            </div>
            <div class="col-md-2 col-sm-12">
                <div>
                    <button type="submit" class="btn btn-primary text-capitalize">{{ 'button.submit'|trans([], 'messages') }}</button>
                </div>
            </div>
        </div>
        {% if form.hidden is defined %}
            <div class="row" style="margin-top: 20px">
                <div class="col-md-12">
                    <div>
                        {{ form_widget(form.hidden) }}{{ form_label(form.hidden) }}
                    </div>
                </div>
            </div>
        {% endif %}
        {{ form_rest(form) }}
        {{ form_end(form) }}
    </div>
</div>