{% extends 'directory/people/layout.html.twig' %}
{% trans_default_domain 'directory' %}

{% block title %}{{ parent() }}\{{ 'menu.add'|trans([], 'messages') }}{% endblock %}

{% block content %}
<div class="row">
    <div class="col-lg-8">
        <h3>{{ 'directory.people.title.add'|trans }}</h3>

        {{ include('directory/people/_form.html.twig', {
            form: form,
            action: path('directory_people_add'),
            cancel_link: path('legacy_directory_index', { m: ['people'] }),
        }, with_context=false) }}
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        {{ include('directory/people/partial/_people_position_category.js.twig', {classifications: classifications.simpleArrayCopy}, with_context=false) }}
    </script>
{% endblock %}
