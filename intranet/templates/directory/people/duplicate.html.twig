{% extends 'directory/people/layout_people.html.twig' %}
{% trans_default_domain 'directory' %}

{% set people_id = iri_id(people) %}

{% block title %}{{ parent() }}\{{ 'menu.duplicate'|trans([], 'messages') }}{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-lg-8">
            <h3>{{ 'directory.people.title.duplicate'|trans([], 'directory') }}</h3>

            {{ include('directory/people/_form.html.twig', {
                form: form,
                action: path('directory_people_duplicate', { id: people_id }),
                cancel_link: path('legacy_directory_index', { m: ['people'] }),
            }, with_context=false) }}
        </div>
    </div>
{% endblock %}
