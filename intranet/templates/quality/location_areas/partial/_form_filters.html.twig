<div class="ibox">
    <div class="ibox-title">
        <h5>{{ 'button.filter' | trans([], 'messages') | upper }}</h5>
        <div class="ibox-tools">
            <a class="collapse-link">
                <i class="fa fa-chevron-up"></i>
            </a>
        </div>
    </div>
    <div class="ibox-content">
        <div class="row">
            {% form_theme form 'form_theme_vertical.html.twig' %}
            {{ form_start(form, { action: path('quality_location_areas_home'), method: 'GET'}) }}
            {{ form_errors(form) }}

            <div class="col-lg-12 row">
                <div class="col-lg-6">
                    {{ form_row(form.name) }}
                </div>
                <div class="col-lg-6">
                    {{ form_row(form.factory) }}
                </div>
            </div>
            <div class="col-lg-12 row">
                <div class="col-lg-6">
                    {{ form_row(form.supervisor) }}
                </div>
                <div class="col-lg-6">
                    {{ form_row(form.itemsPerPage) }}
                </div>
            </div>
        </div>
        <div class="row text-end">
            <div class="col-lg-12">
                <input type="submit" class="btn btn-primary" value="{{ 'button.filter'|trans([], 'messages')|capitalize }}"/>
            </div>
        </div>
        {{ form_end(form) }}
    </div>
</div>
