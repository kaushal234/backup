<div class="row">
    <div class="col-md-8">
        {{ include('quality/supplier_corrective_action_request/partial/_files.html.twig', {supplierCorrectiveActionRequest: supplierCorrectiveActionRequest} )}}
    </div>
    <div class="col-md-4">
        <div class="ibox float-e-margins">
            <div class="ibox-title">
                <h5>{{ 'demo.fields.add_file' | trans([], 'demo') }}</h5>
                <div class="ibox-tools">
                    <a class="collapse-link">
                        <i class="fa fa-chevron-up"></i>
                    </a>
                </div>
            </div>
            <div class="ibox-content">
                <div class="row">
                    <div class="col-lg-12">
                        {% form_theme formFiles 'form_theme_vertical.html.twig' %}

                        {{ form_start(formFiles, { action: path('supplier_corrective_action_request_show', {'id': supplierCorrectiveActionRequest.id, 'tab': 'file'}) }) }}
                        {{ form_errors(formFiles) }}

                        {{ form_row(formFiles.file) }}
                        {{ form_row(formFiles.description) }}
                        {{ form_row(formFiles.submit) }}

                        {{ form_rest(formFiles) }}

                        {{ form_end(formFiles) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
