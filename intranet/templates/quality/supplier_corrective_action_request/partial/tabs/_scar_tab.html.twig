{% trans_default_domain 'supplier_corrective_action_request' %}
<div class="row">
    <div class="col-lg-12">
        <div class="ibox float-e-margins">
            <div class="ibox-title">
                <h5>{{ 'supplier_corrective_action_request.supplier_corrective_action_request'|trans()|upper }} #{{ supplierCorrectiveActionRequest.id }}</h5>
                <div class="ibox-tools">
                    <a class="collapse-link">
                        <i class="fa fa-chevron-up"></i>
                    </a>
                </div>
            </div>
            <div class="ibox-content">
                <div class="row">
                    <div class="col-md-8">
                        {{ include('helper/_association_table_raw.html.twig', {
                            associationData: {
                                items: {
                                    iFactor: {
                                        label: 'fields.ifactor'|trans({}, 'messages')|capitalize,
                                    },
                                    createdAt: {
                                        label: 'fields.created_at'|trans({}, 'messages')|capitalize,
                                        filters: 'date("Y-m-d H:i:s")'
                                    },
                                    closedAt: {
                                        label: 'wms.picking_alert.closed_at'|trans({}, 'wms'),
                                        filters: 'date("Y-m-d")',
                                        hideNull: true
                                    },
                                    poster: {
                                        label: 'fields.poster'|trans({}, 'messages')|capitalize,
                                        properties: ['poster.lastname', 'poster.firstname'],
                                        link: {
                                            route: 'directory_people_show',
                                            params: {id:'poster.@id'}
                                        }
                                    },
                                    status: {
                                        label: 'sales_forecasts.fields.status'|trans({}, 'sales_forecasts')|capitalize,
                                    },
                                    shortDescription: {
                                        label: 'supplier_corrective_action_request.fields.short_description'|trans()|capitalize,
                                    },
                                    description: {
                                        label: 'directory.position.fields.description'|trans({}, 'directory')|capitalize,
                                    },
                                    issueOrigin: {
                                        label: 'supplier_corrective_action_request.fields.root_cause'|trans()|capitalize,
                                    },
                                    correctiveAction: {
                                        label: 'supplier_corrective_action_request.fields.corrective_actions'|trans()|capitalize,
                                    },
                                    preventiveAction: {
                                        label: 'supplier_corrective_action_request.fields.preventive_actions'|trans()|capitalize,
                                    },
                                    commercialAgreement: {
                                        label: 'supplier_corrective_action_request.fields.commercial_agreement'|trans()|capitalize,
                                    },
                                    verificationDescription: {
                                        label: 'supplier_corrective_action_request.fields.verification_description'|trans()|capitalize,
                                    },
                                    conclusion: {
                                        label: 'supplier_corrective_action_request.fields.conclusion'|trans()|capitalize,
                                    },
                                    supplierName: {
                                        label: 'fields.supplier.name'|trans([], 'messages')|capitalize,
                                    },
                                    supplierNumber: {
                                        label: 'fields.supplier.number'|trans([], 'messages')|capitalize,
                                    },
                                    factory: {
                                        label:'supplier_corrective_action_request.fields.location'|trans()|capitalize,
                                        properties: ['factory.name']
                                    },
                                    representative: {
                                        label: 'directory.location.fields.representative'|trans({}, 'directory')|capitalize,
                                        properties: ['representative.lastname', 'representative.firstname'],
                                        link: {
                                            route: 'directory_people_show',
                                            params: {id:'representative.@id'}
                                        }
                                    },
                                    leader: {
                                        label: 'supplier_corrective_action_request.fields.leader'|trans()|capitalize,
                                        properties: ['leader.lastname', 'leader.firstname'],
                                        link: {
                                            route: 'directory_people_show',
                                            params: {id:'leader.@id'}
                                        }
                                    }
                                },
                                data: supplierCorrectiveActionRequest,
                            },
                        }, with_context = false) }}
                    </div>
                    <div class="col-md-4">
                        <div style="margin-bottom: 5px">
                            {% if supplierCorrectiveActionRequest.mainFile is defined and supplierCorrectiveActionRequest.mainFile is not null %}
                                {% if supplierCorrectiveActionRequest.mainFile.extension not in ['png', 'jpg', 'jpeg'] %}
                                    <a href="{{ path('supplier_corrective_action_request_download_main_file', {id: supplierCorrectiveActionRequest.mainFile.id, scarId: supplierCorrectiveActionRequest.iriId}) }}"><img src="/shared/bluesphere/96x96/mimetypes/document.png"></a>
                                {% else %}
                                    <a href="{{ path('supplier_corrective_action_request_download_main_file', {id: supplierCorrectiveActionRequest.mainFile.id, scarId: supplierCorrectiveActionRequest.iriId}) }}"><img class="m-t-xs img-fluid" width="400" src="{{ asset(upload_uri ~ '/' ~ supplierCorrectiveActionRequest.mainFile.filePath) }}"></a>
                                {% endif %}
                            {% else %}
                                <img class="m-t-xs img-fluid" width="400" src="/shared/no_photo_catalogue.png">
                            {% endif %}
                        </div>
                        {{ include('helper/_report_table.html.twig', {
                            reportTable: {
                                items: {
                                    view: {
                                        label: 'menu.view'|trans([], 'messages')|capitalize,
                                        link:{
                                            route: 'legacy_manufacturing_whse',
                                            params: {id: 'partNumber'},
                                            fixedParams: { m: ['inv', 'byPNPlanned'], erp: item.factory.erp },
                                            content: '<span class="btn btn-primary btn-sm"><i class="far fa-eye fa-fw"></i></span>',
                                        },
                                        sortable: false,
                                    },
                                    partNumber: { label: 'supplier_corrective_action_request.fields.parts.part_numbers'|trans|capitalize },
                                    description: { label: 'directory.position.fields.description'|trans({}, 'directory')|capitalize },
                                },
                                title: 'spare_parts_request.fields.parts'|trans({}, 'spare_parts_request'),
                                data: supplierCorrectiveActionRequest.parts,
                                search: false,
                                initialSorting: false,
                                pagination: false
                            }
                        }, with_context = false) }}
                        <h3>{{ 'supplier_corrective_action_request.title.business_partner_contacts_list'|trans }}</h3>
                        {% if supplierContacts is not empty %}
                            {{ include('helper/_report_table.html.twig', {
                                reportTable: {
                                    items: {
                                        fullName: {label: 'contacts.fields.name'|trans({}, 'contacts')},
                                        emailAddress: {label: 'contacts.fields.email'|trans({}, 'contacts')},
                                        telephone: {label: 'contacts.fields.phone'|trans({}, 'contacts')},
                                    },
                                    data: supplierContacts,
                                    pagination: false,
                                    search: false,
                                    options: {
                                        card: false,
                                    }
                                }
                            }, with_context = false) }}
                        {% else %}
                            <p class="text-muted">{{ 'supplier_corrective_action_request.contacts.empty'|trans }}</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
