{% extends 'quality/crab/layout.html.twig' %}
{% trans_default_domain 'crab' %}
{% form_theme formProductFilter 'form_theme_vertical.html.twig' %}

{% block content %}
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'crab.title.reports_filters' | trans() | upper }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>

                <div class="ibox-content">
                    {{ form_start(formProductFilter) }}
                    <div class="row">
                        <div class="col-lg-6">
                            {{ form_row(formProductFilter.factory) }}
                        </div>
                        <div class="col-lg-3">
                            {{ form_row(formProductFilter.createdAfter) }}
                        </div>
                        <div class="col-lg-3">
                            {{ form_row(formProductFilter.createdBefore) }}
                        </div>
                        <div class="col-lg-6">
                            {{ form_row(formProductFilter.model) }}
                        </div>
                        <div class="col-lg-6">
                            {{ form_row(formProductFilter.family) }}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-lg-12">
                            <hr class="hr-line-dashed">
                            <div class="form-group text-end">
                                <button class="btn btn-primary" type="submit">{{ 'button.filter' | trans({}, 'messages') | upper }}</button>
                            </div>
                        </div>
                    </div>
                    {{ form_end(formProductFilter, {'render_rest': false}) }}
                </div>
            </div>
        </div>
        <div class="ibox float-e-margins">
            <div class="row">
                {% if chartProductReportLastYear is defined and chartProductReportLastYear is not null %}
                    <div class="col-lg-6 col-md-12 mb-4">
                        <div class="highcharts"
                             data-options="{{ chartProductReportLastYear|json_encode }}"
                             style="height: 500px;"></div>
                    </div>
                {% endif %}

                {% if chartFamilyReportLastYear is defined and chartFamilyReportLastYear is not null %}
                    <div class="col-lg-6 col-md-12 mb-4">
                        <div class="highcharts"
                             data-options="{{ chartFamilyReportLastYear|json_encode }}"
                             style="height: 500px;"></div>
                    </div>
                {% endif %}

                {% if chartAvgPerCategoryByPeriod is defined and chartAvgPerCategoryByPeriod is not null %}
                    <div class="col-lg-12 mb-4">
                        <div class="highcharts"
                             data-options="{{ chartAvgPerCategoryByPeriod|json_encode }}"
                             style="height: 500px;"></div>
                    </div>
                {% endif %}
                {% if chartProductReportByCode is defined and chartProductReportByCode is not null %}
                    <div class="col-lg-12 mb-4">
                        <div class="highcharts"
                             data-options="{{ chartProductReportByCode|json_encode }}"
                             style="height: 500px;"></div>
                    </div>
                {% endif %}

                {% if chartFamilyReportByCode is defined and chartFamilyReportByCode is not null %}
                    <div class="col-lg-12 mb-4">
                        <div class="highcharts"
                             data-options="{{ chartFamilyReportByCode|json_encode }}"
                             style="height: 500px;"></div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
