{% extends 'quality/crab/layout.html.twig' %}
{% trans_default_domain 'crab' %}


{% block content %}
    <div class="row">
        <div class="col-md-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'crab.title.count_by_factory'|trans }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {{ include('helper/_matrix_table.html.twig', {
                        data: byCategoryByFactory,
                        link: {
                            route: 'crab_home',
                            xParam: 'filter_crab[factory][value]',
                            yParam: 'filter_crab[category][value][]',
                        },
                    }, with_context=false) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
