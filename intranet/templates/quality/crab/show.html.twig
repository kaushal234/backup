{% extends 'quality/crab/layout.html.twig' %}
{% trans_default_domain 'crab' %}

{% block title %}{{ parent() }}CRAB#{{ crab.id }}{% endblock %}

{% block content %}
    <script src="/shared/javascript/hinclude/hinclude.min.js"></script>
    {{ include('@AlvestTwigHelper/tabs_layout.html.twig', {
        tabsData: {
            tabs: {
                details: {
                    defaultTab: true,
                    label: 'contacts.menu.detail'|trans({}, 'contacts'),
                    template: 'quality/crab/partial/tabs/_details_tab.html.twig',
                    templateParams: {form_fix: form_fix, form_inspect: form_inspect}
                },
                files: {
                    label: 'menu.files' | trans({}, 'messages') | capitalize,
                    template: 'quality/crab/partial/tabs/_files_tab.html.twig',
                    templateParams: {form_files: form_files},
                    badge: crab.files | length,
                },
                links: {
                    label: 'menu.links' | trans({}, 'messages') | capitalize,
                    template: 'generic/_links.html.twig',
                    templateParams: { module: 'CRAB', legacy: true }
                },
                tasks: {
                    label: 'menu.people.tasks' | trans({}, 'messages') | capitalize,
                    template: 'quality/crab/partial/tabs/_tasks_tab.html.twig',
                },
                logs: {
                    label: 'menu.logs' | trans({}, 'messages') | capitalize,
                    template: 'generic/_logs.html.twig',
                },
            },
            data: crab,
            link: app.request.query.get('tab')
        }
    }, with_context = false) }}
{% endblock %}

{% block translations %}
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'messages' }) }}"></script>
{% endblock %}
