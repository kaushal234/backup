{% extends 'quality/first_article_qualification/layout.html.twig' %}
{% trans_default_domain 'first_article_qualification' %}
{% form_theme form 'form_theme_horizontal.html.twig' %}
{% import _self as planLineMacro %}

{% macro planLine(line, isNewLine, plan_item_types, editable) %}
    <div class="row align-items-center py-2 border-bottom form-collection-item"
            {% if isNewLine %}
        data-controller="quality--first-article-qualification--plan-line-type"
        data-quality--first-article-qualification--plan-line-type-types-value="{{ plan_item_types|json_encode|e('html_attr') }}"
            {% endif %}>
        <div class="col-2 align-middle">
            {{ form_widget(line.id) }}
            {% if not isNewLine %}
                {% set typeIri = line.type.vars.value %}
                {% set planItemType = plan_item_types|filter(t => t['@id'] == typeIri)|first %}
                <strong>{{ planItemType ? planItemType.description : '' }}</strong>
            {% endif %}
            {{ form_widget(line.type, isNewLine ? {
                attr: {
                    class: 'form-select form-select-sm',
                    'data-quality--first-article-qualification--plan-line-type-target': 'type',
                    'data-action': 'quality--first-article-qualification--plan-line-type#updateCheckboxes'
                }
            } : {}) }}
        </div>
        <div class="col-3">
            {{ form_widget(line.description, { attr: { class: 'form-control form-control-sm', rows: 2 } }) }}
        </div>
        <div class="col-3">
            {{ form_widget(line.comment, { attr: { class: 'form-control form-control-sm', rows: 2 } }) }}
        </div>
        <div class="col-1 text-center">
            {{ form_widget(line.requestedPriorDelivery, {
                attr: { class: 'form-check-input' }|merge(isNewLine ? { 'data-quality--first-article-qualification--plan-line-type-target': 'prior' } : {})
            }) }}
        </div>
        <div class="col-1 text-center">
            {{ form_widget(line.requestedAtPurchaseOrder, {
                attr: { class: 'form-check-input' }|merge(isNewLine ? { 'data-quality--first-article-qualification--plan-line-type-target': 'purchase' } : {})
            }) }}
        </div>
        <div class="col-1">
            {{ form_widget(line.completionRate, { attr: { class: 'form-select form-select-sm' } }) }}
        </div>
        <div class="col-1 text-center">
            {% if isNewLine or (editable and line.completionRate.vars.value != 100) %}
                <button type="button" class="btn btn-danger btn-sm"
                        data-action="form-collection#removeCollectionElement">
                    {{ ux_icon('tabler:trash',{width: '16', height: '16'}) }}
                </button>
            {% endif %}
        </div>
    </div>
{% endmacro %}

{% block content %}
    {% if firstArticleQualification.plan is not empty and is_granted('FEATURE_FAQ_PLAN_APPROVAL') %}
        <div class="row">
            <div class="ibox float-e-margins">
                <div class="ibox-title d-flex justify-content-between align-items-center">
                    <h5><b>{{ 'first_article_qualification.titles.plan_status' | trans | capitalize }}:</b>
                        {% set planStatusIcon = 'fa-hourglass' %}
                        {% set planStatusBadge = 'badge' %}
                        {% if firstArticleQualification.planApprovalStatus is same as ('APPROVED') %}
                            {% set planStatusIcon = 'fa-bolt' %}
                            {% set planStatusBadge = 'badge bg-info' %}
                        {% elseif firstArticleQualification.planApprovalStatus is same as ('UNAPPROVED') %}
                            {% set planStatusIcon = 'fa-times' %}
                            {% set planStatusBadge = 'badge bg-danger' %}
                        {% endif %}
                        <span class="{{ planStatusBadge }}">
                            <i class="fa {{ planStatusIcon }}"> </i>
                            <b>{{ ('first_article_qualification.status.' ~ firstArticleQualification.planApprovalStatus) | lower | trans | upper }}</b>
                        </span>
                    </h5>
                    <div class="ibox-tools">
                        {% if firstArticleQualification.planApprovalStatus is not same as ('APPROVED') %}
                            <a href="{{ path('first_article_qualifications_plan_status', { 'id': firstArticleQualification.id, 'planStatus': 'APPROVED' }) }}"
                               class="btn btn-info text-capitalize color-white">
                                <span class="text-white">
                                    <i class="fa fa-bolt"> </i> {{ ('first_article_qualification.status.approved') | trans | upper }}
                                </span>
                            </a>
                        {% endif %}
                        {% if firstArticleQualification.planApprovalStatus is not same as ('UNAPPROVED') %}
                            <a href="{{ path('first_article_qualifications_plan_status', { 'id': firstArticleQualification.id, 'planStatus': 'UNAPPROVED' }) }}"
                               class="btn btn-danger text-capitalize color-white">
                                <span class="text-white">
                                    <i class="fa fa-times"></i> {{ ('first_article_qualification.status.unapproved') | trans | upper }}
                                </span>
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {{ form_start(form) }}
    {% set prototypeHtml %}
        {{ planLineMacro.planLine(form.plan.vars.prototype, true, plan_item_types, editable) }}
    {% endset %}

    <div class="row">
        <div class="ibox float-e-margins">
            <div class="ibox-title d-flex justify-content-between align-items-center">
                <h5>PLAN DEFINITION</h5>
            </div>
            <div class="ibox-content"
                 data-controller="form-collection"
                 data-form-collection-prototype-value="{{ prototypeHtml|e('html_attr') }}"
                 data-form-collection-index-value="{{ form.plan|length }}">
                {{ form_errors(form) }}
                {# column headers #}
                <div class="row fw-bold border-bottom pb-2 mb-2">
                    <div class="col-2 text-center">{{ 'first_article_qualification.report.type'|trans }}</div>
                    <div class="col-3 text-center">{{ 'first_article_qualification.report.description'|trans }}</div>
                    <div class="col-3 text-center">{{ 'first_article_qualification.report.comment'|trans }}</div>
                    <div class="col-1 text-center"
                         title="{{ 'first_article_qualification.report.requested_prior'|trans }}">RPD
                    </div>
                    <div class="col-1 text-center"
                         title="{{ 'first_article_qualification.report.requested_purchase'|trans }}">RPO
                    </div>
                    <div class="col-1 text-center">{{ 'first_article_qualification.fields.validated'|trans }}</div>
                    <div class="col-1 text-center">{{ 'menu.delete'|trans([], 'messages') }}</div>
                </div>

                {# Existing lines #}
                <div data-form-collection-target="collectionContainer">
                    {% for line in form.plan %}
                        {{ planLineMacro.planLine(line, line.id.vars.value is empty, plan_item_types, editable) }}
                    {% endfor %}
                </div>
                <div class="mt-3">
                    {% if editable %}
                        <button type="button"
                                class="btn btn-info"
                                data-action="form-collection#addCollectionElement">
                            {{ 'first_article_qualification.report.add_plan_item'|trans }}
                        </button>
                    {% endif %}
                    {% if editable or completion_editable %}
                        <button type="submit" class="btn btn-info">
                            {{ 'button.save'|trans([], 'messages') }}
                        </button>
                    {% endif %}
                    {% if completion_editable and firstArticleQualification.planApprovalStatus is same as ('APPROVED')  and form.plan|length > 0 %}
                        <button type="button" class="btn btn-warning"
                                data-bs-toggle="modal" data-bs-target="#duplicate-plan-modal">
                            {{ 'first_article_qualification.report.duplicate_plan'|trans }}
                        </button>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {% do form.plan.setRendered %}
    {{ form_end(form) }}

    {% if completion_editable and firstArticleQualification.planApprovalStatus is same as ('APPROVED') and form.plan|length > 0 %}
        <twig:Modal id="duplicate-plan-modal"
                    title="{{ 'first_article_qualification.report.duplicate_plan'|trans }}">
            <twig:block name="content">
                {{ form_start(duplicateForm, { attr: { id: 'duplicate-plan-form' } }) }}
                {{ form_row(duplicateForm.targets) }}
                {{ form_end(duplicateForm) }}
            </twig:block>

            <twig:block name="footer">
                <button type="submit" form="duplicate-plan-form" class="btn btn-info">
                    {{ 'button.submit'|trans([], 'messages') }}
                </button>
            </twig:block>
        </twig:Modal>
    {% endif %}

{% endblock %}
