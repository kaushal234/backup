{% extends 'quality/first_article_qualification/layout.html.twig' %}
{% trans_default_domain 'first_article_qualification' %}

{% block title %}{{ parent() }}\{{ 'menu.view'|trans([], 'messages') }}{% endblock %}


{% block content %}
    <div id="react" class="m-b-lg"></div>
    <div class="row">
        <div class="col-md-9" id="files">
            {{ include('quality/first_article_qualification/files_ajax.html.twig', {firstArticleQualification: firstArticleQualification} )}}
        </div>
    </div>
    <div class="row">
        <div class="col-md-9" id="files">
            <div class="ibox">
                <div class="ibox-title">
                    <h5>{{ 'first_article_qualification.titles.first_article_qualification_files_from_tasks'|trans }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                    </div>
                </div>
                <div class="ibox-content">
                    <script src="/shared/javascript/hinclude/hinclude.min.js"></script>
                    <hx:include src="/en/private/inc_sf/block_tasks_files.php?module=FAQ&id={{ firstArticleQualification.id }}" id="block_tasks_files">
                        <div class="text-center"><span class="fa fa-refresh fa-spin"></span></div>
                    </hx:include>
                </div>
            </div>
        </div>
    </div>
{% endblock %}


{% block javascripts %}
    {{ parent() }}
    {{ include('partial/_footable.html.twig', {'selectors': ['#block_tasks_files']}) }}
{% endblock %}
