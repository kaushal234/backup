<td>
    {% if item[key] != 0 %}
        <div class="progress" style="height: 25px;">
            <div class="progress-bar {{ item[key] == 100 ? "progress-bar-success":  "progress-bar-warning" }}"
                 role="progressbar"
                 aria-valuenow="{{ item[key] }}" aria-valuemin="0"
                 aria-valuemax="100"
                 style="width: {{ item[key] }}%"><b>{{ item[key] }}%</b>
            </div>
        </div>
    {% endif %}
</td>