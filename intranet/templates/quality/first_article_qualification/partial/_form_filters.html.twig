{% form_theme form 'form_theme_vertical.html.twig' %}

{{ form_start(form) }}
    {{ form_errors(form) }}
<div class="row">
    <div class="col-lg-2">
        {{ form_row(form.location) }}
    </div>
    <div class="col-lg-2">
        {{ form_row(form.buyer) }}
    </div>
    <div class="col-lg-2">
        {{ form_row(form.owner) }}
    </div>
    <div class="col-lg-2">
        {{ form_row(form.poster) }}
    </div>
    <div class="col-lg-2">
        {{ form_row(form['planDefinitionDueDate-after']) }}
    </div>
    <div class="col-lg-2">
        {{ form_row(form['planDefinitionDueDate-before']) }}
    </div>
</div>
<div class="row">
    <div class="col-lg-2">
        {{ form_row(form.status) }}
    </div>
    <div class="col-lg-2">
        {{ form_row(form.partNumber) }}
    </div>
    <div class="col-lg-2">
        {{ form_row(form.revision) }}
    </div>
    <div class="col-lg-2">
        {{ form_row(form.description) }}
    </div>
    <div class="col-lg-2">
        {{ form_row(form.eap) }}
    </div>
    <div class="col-lg-2">
        {{ form_row(form.meap) }}
    </div>
</div>
<div class="row">
    <div class="col-lg-2">
        {{ form_row(form.supplierName) }}
    </div>
    <div class="col-lg-2">
        {{ form_row(form.supplierNumber) }}
    </div>
    <div class="col-lg-2">
        {{ form_row(form.tags) }}
    </div>
    <div class="col-lg-2">
        {{ form_row(form['dueDate-after']) }}
    </div>
    <div class="col-lg-2">
        {{ form_row(form['dueDate-before']) }}
    </div>
</div>
<div class="row">
    <div class="col-lg-2">
        {{ form_row(form.equipmentRecord) }}
    </div>
    <div class="col-lg-2">
        {{ form_row(form.planApprovalStatus) }}
    </div>
    <div class="col-lg-2">
        {{ form_row(form['createdAt-after']) }}
    </div>
    <div class="col-lg-2">
        {{ form_row(form['createdAt-before']) }}
    </div>
    <div class="col-lg-2">
        {{ form_row(form['completedAt-after']) }}
    </div>
    <div class="col-lg-2">
        {{ form_row(form['completedAt-before']) }}
    </div>
</div>
<div class="row">
    <div class="col-lg-2">
        {{ form_row(form.iFactor) }}
    </div>
    <div class="col-lg-2">
        {{ form_row(form.productFamily) }}
    </div>
</div>
<div class="row">
    <div class="col-lg-2" style="margin-bottom:15px">
        {{ form_widget(form.noOpenTasks) }}
    </div>
    <div class="col-lg-2">
        {{ form_row(form.noPlan) }}
    </div>
</div>
<div class="row">
    {% do form.xls.setRendered %}
    {{ form_rest(form) }}
    <div class="col-lg-12">
        <div>
            <label class="col-form-label">&nbsp;</label>
            <button class="btn btn-primary" type="submit">{{ 'button.filter'| trans | upper }}</button>
            <a href="{{ resetPath }}" class="btn btn-secondary">{{ 'button.reset'| trans | upper }}</a>
            <button class="btn btn-primary btn-danger" type="submit" id="xls" name="xls"><i class="fa fa-download"></i>&nbsp;{{ 'menu.download'|trans([], 'messages')|upper }}</button>
        </div>
    </div>
</div>
{{ form_end(form) }}
