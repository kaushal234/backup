{% form_theme form 'form_theme_vertical.html.twig' %}


{{ form_start(form) }}
    {{ form_errors(form) }}
    <div class="row">
        <div class="col-lg-6">
            {{ form_row(form.description) }}
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div>
                <label class="col-form-label">&nbsp;</label>
                <button class="btn btn-primary">{{ 'button.filter'| trans | upper }}</button>
                <a href="{{ resetPath }}" class="btn btn-secondary">{{ 'button.reset'| trans | upper }}</a>
            </div>
        </div>
    </div>
{{ form_end(form) }}
