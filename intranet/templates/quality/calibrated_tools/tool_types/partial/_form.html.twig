{% block content %}
    <div class="row">
        {% form_theme form 'form_theme_vertical.html.twig' %}

        {{ form_start(form, { action: action }) }}
        {{ form_errors(form) }}

        <div class="col-md-12 col-lg-12">
            <div class="ibox float-e-margins news-list-element">
                <div class="ibox-title">
                    <h4>{{ title }}</h4>
                </div>
                <div class="ibox-content">
                    {{ form_row(form.description) }}
                    <div>
                        <button type="submit" class="btn btn-primary">{{ 'button.submit'|trans({}, 'messages') }}</button>
                        <a href="{{ cancel_link }}" class="btn btn-secondary">
                            {{ 'button.cancel'|trans({}, 'messages') }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="clear-fix"></div>
        {{ form_end(form) }}
    </div>
{% endblock %}

