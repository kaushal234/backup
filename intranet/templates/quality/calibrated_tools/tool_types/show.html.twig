{% extends '/quality/calibrated_tools/layout.html.twig' %}
{% trans_default_domain 'tool_types' %}

{% set sliceLimit = 50 %}

{% block title %}{{ parent() }} \ {{ 'menu.view' | trans([], 'messages') }}{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'tool_types.fields.description'| trans([], "tool_types") }} :
                            {{ toolType.description | u.truncate(200) | u.wordwrap | nl2br }}
                        </h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover association-table">
                            <tbody>
                                <tr>
                                    <th>{{ 'tool_types.fields.index' | trans | upper }}</th>
                                    <td>{{ toolType | iri_id }}</td>
                                </tr>
                                <tr>
                                    <th>{{ 'tool_types.fields.description'| trans | upper  }}</th>
                                    <td>{{ toolType.description | u.truncate(500) | u.wordwrap | nl2br }}</td>
                                </tr>
                                <tr>
                                    <th>{{ 'tool_types.fields.nbTools'| trans | upper }}</th>
                                    <td>{{ toolType.toolsCount | number_format }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% if toolType.tools | length > 0 %}
        {{ include('helper/_report_table.html.twig', {
            'reportTable': {
                'items': {
                    '@id': {
                        'label': 'tool_types.fields.index' | trans | upper,
                        'filters': ['iri_id']
                    },
                    'serialNumber': {
                        'label': 'calibration_tool.fields.serialNumber' | trans([], 'calibration_tool') | capitalize,
                        'filters': ['u.truncate(30)']
                    },
                    'description': {
                        'label': 'calibration_tool.fields.description' | trans([], 'calibration_tool') | capitalize,
                        'filters': ['u.truncate(100)']
                    },
                    'locationArea': {
                        'label': 'calibration_tool.fields.location_area' | trans([], 'calibration_tool') | capitalize,
                        'properties': ['locationArea.name'],
                        'link': {
                            'route': 'quality_location_areas_show',
                            'params': { 'id': 'locationArea.@id' }
                        }
                    },
                    'createdBy': {
                        'label': 'calibration_tool.fields.created_by' | trans([], 'calibration_tool') | capitalize,
                        'properties': ['createdBy.lastname', 'createdBy.firstname'],
                        'link': {
                            'route': 'directory_people_show',
                            'params': {'id': 'createdBy.@id'},
                        }
                    },
                    'view': {
                        'label': 'menu.view'|trans([], 'messages')|capitalize,
                        'link':{
                            'route': 'quality_calibrated_tools_show',
                            'params': {'id':'@id'},
                            'content': '<span class="btn btn-primary btn-sm"><i class="far fa-eye fa-fw"></i></span>',
                        },
                        'sortable': false,
                        'class' : 'text-end'
                    },

                },
                'title': 'calibration_tool.title.index' | trans([], 'calibration_tool') | capitalize,
                'data': tools
            }
        }, with_context = false) }}
    {% endif %}

{% endblock %}
