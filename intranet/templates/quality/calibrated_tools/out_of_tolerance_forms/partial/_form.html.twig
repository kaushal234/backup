{% block content %}
    <div class="row">
        {% form_theme form 'form_theme_vertical.html.twig' %}

        {{ form_start(form, { enctype: 'multipart/form-data' }) }}
        {{ form_errors(form) }}

        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h4>{{ title }}</h4>
                </div>
                <div class="ibox-content">
                    <div class="row">
                        <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
                            {{ form_row(form.analysisBy) }}
                        </div>
                        {% if form.status is defined %}
                            <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
                                {{ form_row(form.status) }}
                            </div>
                        {% endif %}

                    </div>
                    <div class="row">
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-6">
                            {{ form_row(form.impactAnalysis) }}
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-6">
                            {{ form_row(form.correctiveMeasures) }}
                            </div>
                        </div>
                    {% if otf.files is defined %}
                        <div class="row">
                            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-6">
                                {% for file in otf.files %}
                                    <a href="{{ path('quality_calibrated_otf_show_file', {
                                        'id': iri_id(otf),
                                        'fileId': file.id
                                    }) }}" target="_blank">
                                        {{ file.filePath | split('/') | last }}
                                    </a>
                                    <br>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                    <div class="row">
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-6">
                            {{ form_row(form.files) }}
                        </div>
                    </div>
                    <div class="clear-fix"></div>
                    <div class="row">
                        <div class="col-xs-12 col-sm-9 col-md-6 col-lg-4">
                            <div>
                                <button type="submit" class="btn btn-primary">{{ 'button.submit'|trans({}, 'messages') }}</button>
                                <a href="{{ cancel_link }}" class="btn btn-secondary">
                                    {{ 'button.cancel'|trans({}, 'messages') }}
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="clear-fix"></div>
        {{ form_end(form) }}
    </div>
{% endblock %}

