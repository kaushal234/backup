{% form_theme form 'form_theme_vertical.html.twig' %}
{% trans_default_domain 'out_of_tolerance_form' %}

{{ form_start(form) }}
    {{ form_errors(form) }}
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-6 col-lg-3">
            {{ form_row(form.status) }}
        </div>
        <div class="col-xs-12 col-sm-12 col-md-6 col-lg-3">
            {{ form_row(form.impactAnalysis) }}
        </div>
        <div class="col-xs-12 col-sm-12 col-md-6 col-lg-3">
            {{ form_row(form.correctiveMeasures) }}
        </div>
        <div class="col-xs-12 col-sm-12 col-md-6 col-lg-3">
            {{ form_row(form.analysisBy) }}
        </div>

        <div class="col-xs-12 col-sm-12 col-md-6 col-lg-3">
            {{ form_row(form.serialNumber) }}
        </div>
        <div class="col-xs-12 col-sm-12 col-md-6 col-lg-3">
            {{ form_row(form.factory) }}
        </div>
        <div class="col-xs-12 col-sm-12 col-md-6 col-lg-3">
            {{ form_row(form.locationArea) }}
        </div>
        <div class="col-xs-12 col-sm-12 col-md-6 col-lg-3">
            {{ form_row(form.toolType) }}
        </div>
        <div class="col-xs-12 col-sm-12 col-md-6 col-lg-3">
            {{ form_row(form.itemsPerPage) }}
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div>
                <button class="btn btn-primary">{{ 'button.filter'| trans([], 'messages') | upper }}</button>
                <a href="{{ resetPath }}" class="btn btn-secondary">{{ 'button.reset'| trans([], 'messages') | upper }}</a>
            </div>
        </div>
    </div>
{{ form_end(form) }}
