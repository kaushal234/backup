{% extends 'quality/calibrated_tools/layout.html.twig' %}

{% trans_default_domain 'out_of_tolerance_form' %}

{% block title %} {{ parent() }}\{{ 'out_of_tolerance_form.title.index' | trans }} {% endblock %}

{% block content %}
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'button.filter' | trans([], 'messages') | upper }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {{ include('quality/calibrated_tools/out_of_tolerance_forms/partial/_form_filters.html.twig', {
                        form: formFilters,
                        resetPath: path('quality_calibrated_otf_home')
                    }) }}
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            {{ include('helper/_report_table.html.twig', {
                'reportTable': {
                    'title': 'out_of_tolerance_form.title.index' | trans | upper,
                    'data': otfs,
                    'paginationUrl': paginationUrl,
                    'currentPage': page,
                    'items': {
                        '@id': {
                            'label': 'out_of_tolerance_form.fields.index' | trans([], 'out_of_tolerance_form') | capitalize,
                            'filters': ['iri_id'],
                            'sortable': true
                        },
                        'status': {
                            'label': 'out_of_tolerance_form.fields.status' | trans | capitalize,
                            'filters': ['u.wordwrap'],
                            'sortable': true,
                        },
                        'impactAnalysis': {
                            'label': 'out_of_tolerance_form.fields.impactAnalysis' | trans | capitalize,
                            'filters': ['u.truncate(100)', 'u.wordwrap', 'raw'],
                            'sortable': true,
                        },
                        'analysisBy': {
                            'label': 'out_of_tolerance_form.fields.analysisBy' | trans | capitalize,
                            'properties': ['analysisBy.lastname', 'analysisBy.firstname'],
                            'link': {
                                'route': 'directory_people_show',
                                'params': { 'id': 'analysisBy.@id' }
                            }
                        },
                        'view': {
                            'label': 'menu.view'|trans([], 'messages')|capitalize,
                            'link':{
                                'route': 'quality_calibrated_otf_show',
                                'params': {'id':'@id'},
                                'content': '<span class="btn btn-primary btn-sm"><i class="far fa-eye fa-fw"></i></span>',
                            },
                            'sortable': false,
                            'class' : 'text-end'
                        }
                    }
                }
            }, with_context = false) }}
        </div>
    </div>
{% endblock %}
