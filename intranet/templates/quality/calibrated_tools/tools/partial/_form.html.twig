{% block content %}
    <div class="row">
        {% form_theme form 'form_theme_vertical.html.twig' %}
        {% form_theme form.calibrationInterval 'quality/form_themes/form_input_with_addon.html.twig' %}
        {% form_theme form.calibrationNotice 'quality/form_themes/form_input_with_addon.html.twig' %}

        {{ form_start(form, { action: action }) }}
        {{ form_errors(form) }}

        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h4>{{ title }}</h4>
                </div>
                <div class="ibox-content">
                    <div class="row">
                        <div class="col-xs-12 col-sm-9 col-md-6 col-lg-4">
                            {{ form_row(form.serialNumber) }}
                        </div>
                        <div class="col-xs-12 col-sm-9 col-md-6 col-lg-8">
                            {{ form_row(form.description) }}
                        </div>

                    </div>
                    <div class="row">
                        <div class="col-xs-12 col-sm-9 col-md-6 col-lg-4">
                            <div class="row">
                                <div class="col-6">{{ form_row(form.calibrationInterval) }}</div>
                                <div class="col-6">{{ form_row(form.calibrationIntervalUnit) }}</div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-9 col-md-6 col-lg-4">
                            {{ form_row(form.calibrationNotice) }}
                        </div>
                        <div class="col-xs-12 col-sm-9 col-md-6 col-lg-4">
                            {{ form_row(form.purchasingDate) }}
                        </div>
                        <div class="col-xs-12 col-sm-9 col-md-6 col-lg-4">
                            {{ form_row(form.nextCalibrationDate) }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xs-12 col-sm-9 col-md-6 col-lg-4">
                            {{ form_row(form.vendorId) }}
                        </div>
                        <div class="col-xs-12 col-sm-9 col-md-6 col-lg-4">
                            {{ form_row(form.vendorErp) }}
                        </div>
                        <div class="col-xs-12 col-sm-9 col-md-6 col-lg-4">
                            {{ form_row(form.vendorName) }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xs-12 col-sm-9 col-md-6 col-lg-4">
                            {{ form_row(form.toolType) }}
                        </div>
                        <div class="col-xs-12 col-sm-9 col-md-6 col-lg-4">
                            {{ form_row(form.locationArea) }}
                        </div>
                    </div>
                    <div class="clear-fix"></div>
                    <div class="row">
                        <div class="col-xs-12 col-sm-9 col-md-6 col-lg-4">
                            <div>
                                <button type="submit" class="btn btn-primary">{{ 'button.submit' | trans({}, 'messages') | title }}</button>
                                <a href="{{ cancel_link }}" class="btn btn-secondary">
                                    {{ 'button.cancel' | trans({}, 'messages') | title }}
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="clear-fix"></div>
        {{ form_widget(form._token) }}
    </div>

{% endblock %}

