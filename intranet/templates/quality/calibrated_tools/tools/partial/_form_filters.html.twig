{% form_theme form 'form_theme_vertical.html.twig' %}

{{ form_start(form) }}
    {{ form_errors(form) }}
    <div class="row">
        <div class="col-lg-3">
            {{ form_row(form.factory) }}
        </div>
        <div class="col-lg-3">
            {{ form_row(form.locationArea) }}
        </div>
        <div class="col-lg-3">
            {{ form_row(form.supervisor) }}
        </div>
        <div class="col-lg-3">
            {{ form_row(form.toolType) }}
        </div>
    </div>
    <div class="row">
        <div class="col-lg-3">
            {{ form_row(form.status) }}
        </div>
        <div class="col-lg-3">
            {{ form_row(form.serialNumber) }}
        </div>
        <div class="col-lg-3">
            {{ form_row(form.description) }}
        </div>
        <div class="col-lg-3">
            {{ form_row(form.vendorId) }}
        </div>
    </div>
    <div class="row">
        <div class="col-lg-3">
            {{ form_row(form.vendorName) }}
        </div>
        <div class="col-lg-3">
            {{ form_row(form.vendorErp) }}
        </div>
        <div class="col-lg-3">
            {{ form_row(form.itemsPerPage) }}
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div>
                <label class="col-form-label">&nbsp;</label>
                <button class="btn btn-primary" type="submit">{{ 'button.filter'| trans | upper }}</button>
                <a href="{{ resetPath }}" class="btn btn-secondary">{{ 'button.reset'| trans | upper }}</a>
                <button class="btn btn-primary btn-danger" type="submit" id="csv" name="{{ form.csv.vars.full_name }}"><i class="fa fa-download"></i>&nbsp;{{ 'menu.download'|trans([],'messages')|upper }}</button>
            </div>
        </div>
    </div>
    {% do form.csv.setRendered %}
    {{ form_rest(form) }}
{{ form_end(form) }}
