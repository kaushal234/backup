{% extends 'quality/derogation/layout.html.twig' %}
{% trans_default_domain 'crab' %}
{% form_theme form with ['form_theme_vertical.html.twig', _self] %}
{% set title = type == 'add' ? 'crab.title.add_derogation' : 'crab.title.edit_derogation' %}

{% block title %}{{ parent() }}\{{ 'menu.add'|trans({}, 'messages') }}{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ title | trans }}</h5>
                </div>
                <div class="ibox-content">
                    {{ form_start(form) }}
                    {{ form_errors(form) }}
                    <div class="row">
                        <div class="col-md-6">
                            {% if form.assignee is defined %}
                                {{ form_row(form.assignee) }}
                            {% endif %}
                            {{ form_row(form.shortDescription) }}
                            {{ form_row(form.description) }}
                        </div>
                        <div class="col-md-6">
                            {% if form.file is defined %}
                                {{ form_row(form.file) }}
                            {% endif %}
                            {{ form_row(form.submit) }}
                        </div>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block translations %}
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'messages' }) }}"></script>
{% endblock %}


