{% form_theme form 'form_theme_vertical.html.twig' %}

{{ form_start(form) }}
        {{ form_errors(form) }}
<div class="row">
    <div class="col-lg-4">
        {{ form_row(form.assignee) }}
    </div>
    <div class="col-lg-4">
        {{ form_row(form.assignor) }}
    </div>
    <div class="col-lg-4">
        {{ form_row(form.shortDescription) }}
    </div>
</div>
<div class="row">
    <div class="col-lg-4">
        {{ form_row(form.dueDateAfter) }}
    </div>
    <div class="col-lg-4">
        {{ form_row(form.dueDateBefore) }}
    </div>
    <div class="col-lg-4">
        {{ form_row(form.status) }}
    </div>
</div>
<div class="row">
    <div class="col-lg-4">
        {{ form_row(form.equipmentRecord) }}
    </div>
    <div class="col-lg-4">
        {{ form_row(form.model) }}
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <hr class="hr-line-dashed">
        <div class="form-group text-end">
            <label class="control-label">&nbsp;</label>
            <button class="btn btn-primary" type="submit">{{ 'button.filter'| trans | upper }}</button>
            <a href="{{ resetPath }}" class="btn btn-secondary">{{ 'button.reset'| trans | upper }}</a>
            {{ form_widget(form.download) }}
        </div>
    </div>
</div>
{{ form_end(form) }}
