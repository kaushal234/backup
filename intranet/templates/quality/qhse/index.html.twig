{% extends 'quality/qhse/layout.html.twig' %}
{% trans_default_domain 'cleanliness' %}

{% block content %}
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'button.filter' | trans([], 'messages') | upper }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {{ include('quality/cleanliness/partial/_form_filters.html.twig', {
                        form: formFilters,
                        action: path('qhse_home'),
                        resetPath: path('qhse_home')
                    }) }}
                </div>
            </div>
        </div>
    </div>
    {% if is_granted('FEATURE_QHSE_WRITE') %}
        <div class="row">
            <div class="col-lg-12">
                <div class="ibox float-e-margins collapsed">
                    <div class="ibox-title">
                        <h5>{{ 'cleanliness.title.add' | trans([] ) | upper }}</h5>
                        <div class="ibox-tools">
                            <a class="collapse-link">
                                <i class="fa fa-chevron-up"></i>
                            </a>
                        </div>
                    </div>
                    <div class="ibox-content">
                        {{ include('quality/cleanliness/partial/_form.html.twig', {
                            form: form,
                            action: path('qhse_home'),
                            cancel_link: path('qhse_home')
                        }, with_context=false) }}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {% if chart.rows is defined %}
        <div class="highcharts" data-options="{{ chart|json_encode }}" style="min-width: 400px; height: 500px;"></div>
    {% else %}
        <div class="alert alert-primary text-center" role="alert">{{ 'no_results' | trans({}, 'messages') }}</div>
    {% endif %}

{% endblock %}
