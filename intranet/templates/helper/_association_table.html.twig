{% extends '@AlvestTwigHelper/association_table_layout.html.twig' %}

{% block card_class %}ibox float-e-margins {% if table.collapse is defined %} collapsed {% endif %}{% endblock %}
{% block card_body_class %}{% if table.hideTitle is not defined %}ibox-content{% endif %}{% endblock %}
{% block table_class %}{{ parent() }} table-bordered association-table{% endblock %}

{% block card_header %}

    {% if table.hideTitle is not defined %}
        <div class="ibox-title">
            <h5>{% if table.title is defined %}{{ table.title|raw }}{% endif %}</h5>
            {% block card_header_after %}
                <div class="ibox-tools">
                    <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                </div>
            {% endblock %}
        </div>
    {% endif %}
{% endblock card_header %}