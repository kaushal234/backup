<td>
    {% if(item[translatedProperty]|trim is empty) %}
        {{ item[property]|raw }}
    {% else %}
        <div class="row">
            <div class="col-10">
                {{ item[translatedProperty]|raw }}
                <div class="collapse" id="collapse-{{ property }}-{{ item.id }}-translation">
                    <div class="card card-body bg-secondary-subtle mx-2 p-1 rounded-0 text-dark">
                        {{ item[property]|raw }}
                    </div>
                </div>
            </div>
            <div class="col-2">
                <span
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#collapse-{{ property }}-{{ item.id }}-translation"
                    aria-expanded="false"
                    aria-controls="collapse-{{ property }}-{{ item.id }}-translation"
                >
                    <i class="fa fa-language fa-xl"
                       title="{{ 'helper.translation_info'|trans({}, 'messages') }}"
                       data-bs-toggle="tooltip"
                       data-bs-placement="right">
                    </i>
                </span>
            </div>
        </div>
    {% endif %}
</td>
