{% form_theme form 'form_theme_vertical.html.twig' %}
{% trans_default_domain 'account_receivable' %}
{% block content %}

    {{ form_start(form, { action: action }) }}
    {{ form_errors(form) }}
    <div class="row">
        <div class="col-md-10 animated">
            <div class="mail-box-header clearfix">
                <h2 class="float-sart">
                    {{ title }}
                </h2>
            </div>
            <div class="mail-box">
                <div class="mail-body">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="">
                                <table class="footable table table-hover toggle-arrow-tiny report-table table-responsive">
                                    <thead>
                                    <tr>
                                        <th>{{ 'customers.fields.customer_erp_ref'|trans({}, 'sales_customers') }}</th>
                                        <th>{{ 'account_receivable.invoice_record.fields.invoice_number'|trans }}</th>
                                        <th>{{ 'account_receivable.fields.original_amount'|trans|capitalize }}</th>
                                        <th>{{ 'account_receivable.invoice_record.fields.revised_due_date'|trans|capitalize }}</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    <tr>
                                        <td>{{ object.customerErpReference.customerNumber }} / {{ object.customerErpReference.sso.name }}</td>
                                        <td>{% if object.invoiceNumber is defined %}{{ object.invoiceNumber }}{% else %}{{ object.erpInvoiceNumber }}{% endif %}</td>
                                        <td>{{ object.originalAmount | number_format(2, '.', ' ') }} {{ object.currency.name }}</td>
                                        <td>{% if object.revisedDueDate is defined %}{{ object.revisedDueDate | date('Y-m-d') }}{% endif %}</td>
                                    </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <br>
                    <br>
                    <div class="row">
                        <div class="col-md-12">
                            {{ form_row(form.comment) }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(form.category) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.expectedPaymentDate) }}
                        </div>
                    </div>
                </div>
            </div>
            {{ form_row(form.submit) }}

        </div>
    </div>
    {{ form_rest(form) }}
    {{ form_end(form) }}
{% endblock %}
