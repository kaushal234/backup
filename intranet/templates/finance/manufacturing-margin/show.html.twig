{% extends 'finance/manufacturing-margin/layout.html.twig' %}
{% trans_default_domain 'manufacturing_margin' %}

{% block content %}
    <script src="/shared/javascript/hinclude/hinclude.min.js"></script>
    <div class="row">
        <div class="col-md-4">
            {% set currency = manufacturingMargin.currency.name %}
            {{ include('helper/_association_table.html.twig', {
                associationData: {
                    search: false,
                    title: 'manufacturing_margin.record_details' | trans,
                    items: {
                        id: {
                            label: 'finance.finance_family.id'|trans({}, 'finance')|upper
                        },
                        legacyId: {
                            label: 'fields.legacy_id'|trans({}, 'messages')
                        },
                        equipmentRecord: {
                            properties: ['equipmentRecord.serialNumber'],
                            label: 'demo.fields.er_serial_number'|trans({}, 'demo'),
                        },
                        exportedAt: {
                            label: 'fields.date'|trans({}, 'messages')|capitalize,
                            filters: 'date("Y-m")',
                        },
                        currency: {
                            properties: ['currency.name'],
                            label: 'directory.location.fields.currency'|trans({}, 'directory')|capitalize,
                        },
                        factoryRevenue: {
                            label: 'manufacturing_margin.field.factory_revenue'|trans,
                            filters: ["number_format(2, '.', ' ')", 'concat(" ' ~ currency ~ '")'],
                        },
                        standardHours: {
                            label: 'manufacturing_margin.field.standard_hours'|trans,
                        },
                        actualHours: {
                            label: 'manufacturing_margin.field.actual_hours'|trans,
                        },
                        optionConfigurationParameterHours: {
                            label: 'manufacturing_margin.field.ocp_hours'|trans,
                        },
                        standardLabourCost: {
                            label: 'manufacturing_margin.field.standard_labour_cost'|trans,
                            filters: ["number_format(2, '.', ' ')", 'concat(" ' ~ currency ~ '")'],
                        },
                        actualLabourCost: {
                            label: 'manufacturing_margin.field.actual_labour_cost'|trans,
                            filters: ["number_format(2, '.', ' ')", 'concat(" ' ~ currency ~ '")'],
                        },
                        standardMaterialCost: {
                            label: 'manufacturing_margin.field.standard_material_cost'|trans,
                            filters: ["number_format(2, '.', ' ')", 'concat(" ' ~ currency ~ '")'],
                        },
                        actualMaterialCost: {
                            label: 'manufacturing_margin.field.actual_material_cost'|trans,
                            filters: ["number_format(2, '.', ' ')", 'concat(" ' ~ currency ~ '")'],
                        },
                        standardOtherMaterialCost: {
                            label: 'manufacturing_margin.field.standard_other_material_cost'|trans,
                            filters: ["number_format(2, '.', ' ')", 'concat(" ' ~ currency ~ '")'],
                        },
                        actualOtherMaterialCost: {
                            label: 'manufacturing_margin.field.actual_other_material_cost'|trans,
                            filters: ["number_format(2, '.', ' ')", 'concat(" ' ~ currency ~ '")'],
                        },
                        standardOtherDirectCost: {
                            label: 'manufacturing_margin.field.standard_other_direct_cost'|trans,
                            filters: ["number_format(2, '.', ' ')", 'concat(" ' ~ currency ~ '")'],
                        },
                        actualOtherDirectCost: {
                            label: 'manufacturing_margin.field.actual_other_direct_cost'|trans,
                            filters: ["number_format(2, '.', ' ')", 'concat(" ' ~ currency ~ '")'],
                        },
                        comment: {
                            label: 'fields.comment'|trans({}, 'messages')|capitalize,
                        },
                    },
                    data: manufacturingMargin
                }
            }, with_context = false) }}
        </div>
        <div class="col-md-8">
            <hx:include src="/en/private/finance/mfg_margins/mfg_margins_show_hinclude.php?id={{ manufacturingMargin.legacyId }}" id="block_mfg">
                <div class="text-center"><span class="fa fa-refresh fa-spin"></span></div>
            </hx:include>
        </div>
    </div>
    <div>
        <div class="ibox float-e-margins collapsed">
            <div class="ibox-title">
                <h5>{{ 'menu.logs'|trans({}, 'messages') }}</h5>
                <div class="ibox-tools">
                    <a class="collapse-link">
                        <i class="fa fa-chevron-up"></i>
                    </a>
                </div>
            </div>
            <div class="ibox-content">
                <div class="logs-block" data-resource="{{ manufacturingMargin.iri }}" data-show-comment-form="true"></div>
            </div>
        </div>
    </div>

{% endblock %}

{% block translations %}
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'messages' }) }}"></script>
{% endblock %}



