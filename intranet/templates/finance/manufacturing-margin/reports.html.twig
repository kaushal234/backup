{% extends 'finance/manufacturing-margin/layout.html.twig' %}
{% trans_default_domain 'manufacturing_margin' %}

{% block content %}
    <script src="/shared/javascript/hinclude/hinclude.min.js"></script>
    <div class="row">
        <div class="col-md-4">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'manufacturing_margin.report'|trans }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    <div class="row">
                        <div class="col-lg-12">
                            {% form_theme form 'form_theme_vertical.html.twig' %}

                            {{ form_start(form, { action: path('manufacturing_margin_reports') }) }}
                            {{ form_errors(form) }}
                            <div class="row">
                                <div class="col-md-6">
                                    {{ form_row(form.date, {'date_pattern': '<span style="display: none;">{{ day }}</span> {{ month }} {{ year }}'}) }}
                                </div>
                                <div class="col-md-6">
                                    {{ form_row(form.factory) }}
                                </div>
                            </div>
                            {{ form_row(form.submit) }}

                            {{ form_rest(form) }}

                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% if submitted %}
        <div class="ibox-content">
            <hx:include src="/en/private/finance/mfg_margins/mfg_margins_report_hinclude.php?factory={{ factory.legacyId }}&month={{ month }}&year={{ year }}" id="block_mfg">
                <div class="text-center"><span class="fa fa-refresh fa-spin"></span></div>
            </hx:include>
        </div>
    {% endif %}
{% endblock %}
