{% extends 'finance/finance-families/layout.html.twig' %}
{% trans_default_domain 'finance' %}

{% block content %}
    <div id="react" data-is-granted-create="{{ is_granted('FINANCE_FAMILY_CREATE_VOTER') }}"></div>
{% endblock %}

{% block javascripts %}
