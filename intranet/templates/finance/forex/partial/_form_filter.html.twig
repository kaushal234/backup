{% form_theme form 'form_theme_vertical.html.twig' %}

{{ form_start(form) }}
{{ form_errors(form) }}

<div class="row">
    <div class="col-lg-3 col-md-6">
        {{ form_row(form.type) }}
    </div>
    <div class="col-lg-3 col-md-6">
        {{ form_row(form.currency) }}
    </div>
    <div class="col-lg-3 col-md-6">
        {{ form_row(form.applicated_on_after) }}
    </div>
    <div class="col-lg-3 col-md-6">
        {{ form_row(form.applicated_on_before) }}
    </div>
</div>

<div class="row">
    {% do form.download.setRendered %}
    {{ form_rest(form) }}
    <div class="col-lg-12">
        <button class="btn btn-primary" type="submit">{{ 'button.filter'| trans | upper }}</button>
        <a href="{{ resetPath }}" class="btn btn-secondary">{{ 'button.reset'| trans | upper }}</a>
        <button class="btn btn-primary btn-danger" type="submit" id="download" name="download"><i class="fa fa-download"></i>&nbsp;{{ 'menu.download'|trans([],'messages')|upper }}</button>
    </div>
</div>
{{ form_end(form) }}
