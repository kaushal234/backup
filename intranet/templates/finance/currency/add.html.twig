{% extends 'finance/forex/layout.html.twig' %}
{% trans_default_domain 'forex' %}
{% form_theme form 'form_theme_vertical.html.twig' %}

{% block content %}
    <div class="row">
        {{ form_start(form, { action: path('currency_add') }) }}
        {{ form_errors(form) }}
        <div class="ibox float-e-margins">
            <div class="ibox-title">
                {{ 'currency.add.title' | trans | upper}}
            </div>
            <div class="ibox-content">
                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.name) }}
                    </div>
                    {{ form_row(form.submit) }}
                </div>
            </div>
        </div>
        {{ form_rest(form) }}
        {{ form_end(form) }}
    </div>
{% endblock %}
