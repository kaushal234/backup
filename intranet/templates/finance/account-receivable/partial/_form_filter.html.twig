{% form_theme form 'form_theme_vertical.html.twig' %}

{{ form_start(form) }}
{{ form_errors(form) }}
<div class="row">
    <div class="col-lg-3">
        {{ form_row(form.customerErpReference_customer) }}
    </div>
    <div class="col-lg-3">
        {{ form_row(form.customerErpReference_customer_types) }}
    </div>
    <div class="col-lg-3">
        {{ form_row(form.customerErpReference_sso) }}
    </div>
    <div class="col-lg-3">
        {{ form_row(form.customerErpReference_asm) }}
    </div>
</div>
<div class="row">
    <div class="col-lg-3">
        {{ form_row(form.country) }}
    </div>
    <div class="col-lg-3">
        {{ form_row(form.transactionType) }}
    </div>
    <div class="col-lg-3">
        {{ form_row(form.dueDate) }}
    </div>

    <div class="col-lg-3">
        {{ form_row(form.customerErpReference_ssd) }}
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <button class="btn btn-primary" type="submit">{{ 'button.filter'| trans | upper }}</button>
        <a href="{{ resetPath }}" class="btn btn-secondary">{{ 'button.reset'| trans | upper }}</a>
        {{ form_widget(form.download) }}
    </div>
</div>
{{ form_rest(form) }}

{{ form_end(form) }}
