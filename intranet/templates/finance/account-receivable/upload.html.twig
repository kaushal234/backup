{% extends 'finance/account-receivable/layout.html.twig' %}
{% trans_default_domain 'account_receivable' %}

{% block content %}
    <div class="row">
        <div class="col-md-3">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'competitors.fields.file_upload'|trans({}, 'sales_competitors') }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    <div class="row">
                        <div class="col-lg-12">
                            {% form_theme formFileUpload 'form_theme_vertical.html.twig' %}

                            {{ form_start(formFileUpload, { action: path('account_receivable_upload') }) }}
                            {{ form_errors(formFileUpload) }}
                            {{ form_row(formFileUpload.file) }}
                            {{ form_row(formFileUpload.sso) }}
                            {{ form_row(formFileUpload.submit) }}
                            {{ form_rest(formFileUpload) }}
                            {{ form_end(formFileUpload) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
