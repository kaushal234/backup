{% block content %}
<div class="row">
    {% form_theme form 'form_theme_vertical.html.twig' %}

    {{ form_start(form, { action: action }) }}
    {{ form_errors(form) }}
    <div class="row">
        <div class="col-md-12">
            <div class="ibox float-e-margins news-list-element">
                <div class="ibox-title">
                    <h4>{{ title }}</h4>
                </div>
                <div class="ibox-content">
                    <div class="d-flex justify-content-around col-md-12">
                        <div class="col-md-6 pe-2">
                            {{ form_row(form.title) }}
                            {{ form_row(form.content) }}
                            {{ form_row(form.files) }}
                        </div>
                        <div class="col-md-6 ps-2">
                            {{ form_row(form.date) }}
                            {{ form_row(form.people, {value: "/people/"~app.user.id}) }}
                            {{ form_row(form.category) }}
                            {{ form_row(form.department) }}
                            {{ form_row(form.division) }}
                            {{ form_row(form.premise) }}
                            <div class="border p-2">
                                <div class="form-group">
                                    {{ form_label(form.bannerText) }}
                                    {{ form_widget(form.bannerText) }}
                                    {{ form_errors(form.bannerText) }}
                                </div>
                                <div class="row col-md-12" style="font-weight: 700">
                                        <div class="col-md-6">
                                        {{ form_label(form.banner) }}
                                        {{ form_widget(form.banner) }}
                                        {{ form_errors(form.banner) }}
                                        </div>
                                        <div class="col-md-6">
                                        {{ form_label(form.majorIncident) }}
                                        {{ form_widget(form.majorIncident) }}
                                        {{ form_errors(form.majorIncident) }}
                                        </div>
                                </div>
                                <p class="text-danger mb-0">{{ 'news.fields.banner_text_information'|trans([], 'news')|raw }}</p>
                            </div>
                        </div>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-primary">{{ 'button.submit'|trans({}, 'messages') }}</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="clear-fix"></div>
        {{ form_end(form) }}
    </div>
    {% endblock %}

