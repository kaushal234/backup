{% extends 'manufacturing/family/layout.html.twig' %}
{% trans_default_domain 'manufacturing' %}
{% form_theme form 'form_theme_vertical.html.twig' %}

{% block content %}
    <div class="row">
        {{ form_start(form, { action: actionPath }) }}
        {{ form_errors(form) }}
        <div class="ibox float-e-margins">
            <div class="ibox-title">
                {{ 'manufacturing.family.write.title'|trans|capitalize }}
            </div>
            <div class="ibox-content">
                <div class="row">
                    <div class="col-md-4">
                        {{ form_row(form.name) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_row(form.testDuration) }}
                    </div>
                </div>
            </div>
        </div>
        {{ form_rest(form) }}
        {{ form_end(form) }}
    </div>
{% endblock %}
