                        </tr>
                        <tr>
                            <td>{{ 'coo_dashboard.titles.eap_closed'| trans }}</td>
                            <td>{{ 'coo_dashboard.descriptions.eap_closed'| trans }}</td>
                            <td><a href="{{ path('legacy_manufacturing_eng', {m: ['eap'] }) }}">
                                    <span class="btn btn-green btn-sm"><i class="far fa-eye fa-fw"></i></span>
                                </a></td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
