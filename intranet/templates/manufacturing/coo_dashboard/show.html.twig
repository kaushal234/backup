                            <td>{{ 'coo_dashboard.descriptions.toc_factory_support'| trans }}</td>
                            <td><a href="{{ path('legacy_service', {m: ['toc', 'listing', 'byFactorySupportRequired'], x: 'ALL', y: location.name }) }}">
