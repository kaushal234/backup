{% extends 'layout.html.twig' %}
{% form_theme form 'form_theme_horizontal.html.twig' %}

{% trans_default_domain 'coo_dashboard' %}

{% block title %} {{ 'coo_dashboard.title' |trans }} {% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-8">
            <h3 class="text-capitalize">{{ 'coo_dashboard.title'|trans }}</h3>
            <div class="row">
                <div class="col-md-6">
                    {{ form_start(form, { action: path('coo_dashboard') }) }}
                    <div class="row">
                        <div class="col-sm-10">
                            {{ form_widget(form) }}
                        </div>
                        <div class="col-sm-2">
                            <input type="submit" name="submit" class="btn btn-primary" value="{{ 'button.submit'|trans([], 'messages')|capitalize }}"/>
                        </div>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="ibox float-e-margins col-md-8">
            <div class="ibox-title">
                <h5>{{ 'quality_smw.title.links'| trans({}, 'quality_smw') }}</h5>
                <div class="ibox-tools">
                    <a class="collapse-link">
                        <i class="fa fa-chevron-up"></i>
                    </a>
                </div>
            </div>
            <div class="ibox-content">
                <div class="">
                    <table class="footable table table-hover toggle-arrow-tiny report-table table-responsive"" data-page-size=20>
                        <thead>
                        <tr>
                            <th>{{ 'quality_smw.fields.title'| trans({}, 'quality_smw') }}</th>
                            <th>{{ 'quality_smw.fields.description'| trans({}, 'quality_smw') }}</th>
                            <th>{{ 'quality_smw.fields.link'| trans({}, 'quality_smw') }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr>
                            <td>{{ 'coo_dashboard.titles.revenue_invoicing'| trans }}</td>
                            <td>{{ 'coo_dashboard.descriptions.revenue_invoicing'| trans }}</td>
                            <td><a href="{{ path('legacy_manufacturing_index', {m: ['activity', 'revenue', 'sumBySSOERP'], x: location.name, y: 'ALL', year: lastMonth|date('Y') }) }}">
                                    <span class="btn btn-green btn-sm"><i class="far fa-eye fa-fw"></i></span>
                                </a></td>
                        </tr>
                        <tr>
                            <td>{{ 'coo_dashboard.titles.bookings'| trans }}</td>
                            <td>{{ 'coo_dashboard.descriptions.bookings'| trans }}</td>
                            <td><a href="{{ path('legacy_manufacturing_index', {m: ['activity', 'bookings', 'sumBySSOERPYear'], x: location.name, y: 'ALL', year: lastMonth|date('Y')}) }}">
                                    <span class="btn btn-green btn-sm"><i class="far fa-eye fa-fw"></i></span>
                                </a></td>
                        </tr>
                        <tr>
                            <td>{{ 'coo_dashboard.titles.inventory_value'| trans }}</td>
                            <td>{{ 'coo_dashboard.descriptions.inventory_value'| trans }}</td>
                            <td><a href="{{ path('legacy_manufacturing_pur', {m: ['home', 'statistics'], erp: location.erp }) }}">
                                    <span class="btn btn-warning btn-sm"><i class="far fa-eye fa-fw"></i></span>
                                </a></td>
                        </tr>
                        <tr>
                            <td>{{ 'coo_dashboard.titles.wip_value'| trans }}</td>
                            <td>{{ 'coo_dashboard.descriptions.pending'| trans }}</td>
                            <td><a href="#">
                                    <span class="btn btn-danger btn-sm"><i class="far fa-eye fa-fw"></i></span>
                                </a></td>
