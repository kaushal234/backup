{% extends 'layout.html.twig' %}
{% form_theme form 'form_theme_horizontal.html.twig' %}

{% trans_default_domain 'manufacturing_smw' %}

{% block title %} {{ 'manufacturing_smw.title.index' |trans }} {% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-8">
            <h3 class="text-capitalize">{{ 'manufacturing_smw.title.index'|trans }}</h3>
            <div class="row">
                <div class="col-md-6">
                    {{ form_start(form, { action: path('smw_meeting', {module: 'manufacturing'}) }) }}
                    <div class="row">
                        <div class="col-sm-10">
                            {{ form_widget(form) }}
                        </div>

                        <div class="col-sm-2">
                            <input type="submit" name="submit" class="btn btn-primary" value="{{ 'button.submit'|trans([], 'messages')|capitalize }}"/>
                        </div>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="ibox float-e-margins col-md-8">
            <div class="ibox-title">
                <h5>{{ 'manufacturing_smw.title.links'| trans }}</h5>
                <div class="ibox-tools">
                    <a class="collapse-link">
                        <i class="fa fa-chevron-up"></i>
                    </a>
                </div>
            </div>
            <div class="ibox-content">
                <div class="">
                    <table class="footable table table-hover toggle-arrow-tiny report-table table-responsive" data-page-size=20>
                        <thead>
                        <tr>
                            <th>{{ 'manufacturing_smw.fields.title'| trans }}</th>
                            <th>{{ 'manufacturing_smw.fields.description'| trans }}</th>
                            <th>{{ 'manufacturing_smw.fields.link'| trans }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr>
                            <td>{{ 'purchasing_smw.fields.safety_review'| trans({}, 'purchasing_smw') }}</td>
                            <td></td>
                            <td><span class="btn btn-danger btn-sm"><i class="far fa-eye fa-fw"></i></span></td>
                        </tr>
                        <tr>
                            <td>{{ 'purchasing_smw.fields.sop_workload'| trans({}, 'purchasing_smw') }}</td>
                            <td></td>
                            <td><span class="btn btn-danger btn-sm"><i class="far fa-eye fa-fw"></i></span></td>
                        </tr>
                        <tr>
                            <td>{{ 'quality_smw.fields.crab_link'| trans([], 'quality_smw') }}</td>
                            <td>{{ 'quality_smw.fields.manufacturing_crab_report'| trans([], 'quality_smw') }}</td>
                            <td>
                                <a href="{{ path('crab_report', {
                                    'factory': location['@id'],
                                    'createdAfter': ("now - 1 year")|date('m/d/Y'),
                                    'createdBefore': "now"|date('m/d/Y'),
                                }) }}">
                                    <span class="btn btn-green btn-sm"><i class="fa fa-eye fa-fw"></i></span>
                                </a>
                            </td>
                        </tr>
                        </tbody>
                        <tbody>
                        <tr>
                            <td>{{ 'quality_smw.fields.csr_survey'| trans([], 'quality_smw') }}</td>
                            <td>{{ 'quality_smw.fields.csr_2nd_link'| trans([], 'quality_smw') }}</td>
                            <td><a href="{{ path('legacy_manufacturing_index', {m: ['kpi2'], bu: location.legacyId, graph: 'quality' }) }}">
                                    <span class="btn btn-green btn-sm"><i class="fa fa-eye fa-fw"></i></span>
                                </a></td>
                        </tr>
                        <tr>
                            <td>{{ 'quality_smw.fields.csr_imperfect'| trans([], 'quality_smw') }}</td>
                            <td>{{ 'quality_smw.fields.csr_imperfect_link'| trans([], 'quality_smw') }}</td>
                            <td>{% set lastDay = 'now'|date_modify('-1 month')|date_modify('last day of this month') %}
                                <a href="{{ path('customer_service_record_report', {
                                    'commissioning_customer_service_record_filter[manufacturerLocation]': location['@id'],
                                    'commissioning_customer_service_record_filter[completedAfter]': 'now'|date_modify('-1 month')|date('m/01/Y'),
                                    'commissioning_customer_service_record_filter[completedBefore]': lastDay|date('m/d/Y')
                                }) }}">
                                    <span class="btn btn-green btn-sm"><i class="fa fa-eye fa-fw"></i></span>
                                </a></td>
                        </tr>

                        </tbody>
                        <tbody>
                        <tr>
                            <td>{{ 'quality_smw.fields.wc'| trans([], 'quality_smw') }}</td>
                            <td>{{ 'quality_smw.fields.manufacturing_qa'| trans([], 'quality_smw') }}</td>
                            <td><a href="{{ path('legacy_manufacturing_index', {m: ['kpi2'], bu: location.legacyId, graph: 'quality' }) }}">
                                    <span class="btn btn-green btn-sm"><i class="fa fa-eye fa-fw"></i></span>
                                </a></td>
                        </tr>
                        </tbody>
                        <tbody>
                        <tr>
                            <td>{{ 'manufacturing_smw.fields.gt_rate_previous_month'| trans }}</td>
                            <td>{{ 'manufacturing_smw.fields.manufacturing_gt'| trans }}</td>
                            <td><a href="{{ path('legacy_manufacturing_index', {m: ['kpi2'] }) }}">
                                    <span class="btn btn-warning btn-sm"><i class="fa fa-eye fa-fw"></i></span>
                                </a></td>
                        </tr>
                        <tr>
                            <td>{{ 'manufacturing_smw.fields.gt_rate_current_month'| trans }}</td>
                            <td>{{ 'manufacturing_smw.fields.manufacturing_gt'| trans }}</td>
                            <td><a href="{{ path('legacy_manufacturing_index', {m: ['kpi2'] }) }}">
                                    <span class="btn btn-warning btn-sm"><i class="fa fa-eye fa-fw"></i></span>
                                </a></td>
                        </tr>

                        <tr>
                            <td>{{ 'manufacturing_smw.fields.gt_linearity'| trans }}</td>
                            <td>{{ 'manufacturing_smw.fields.gt_linearity_description'| trans }}</td>
                            <td>
                                <a href="{{ path('green_tag_report_home', {
                                    'day': "now - 1 month"|date('m/Y'),
                                    'manufacturerLocation': location['@id']
                                }) }}">
                                    <span class="btn btn-green btn-sm"><i class="fa fa-eye fa-fw"></i></span>
                                </a>
                            </td>
                        </tr>
                        
                        <tr>
                            <td>{{ 'manufacturing_smw.fields.otdp_and_gp'| trans }}</td>
                            <td>{{ 'manufacturing_smw.fields.manufacturing_del'| trans }}</td>
                            <td><a href="{{ path('legacy_manufacturing_index', {m: ['kpi2'], bu: location.legacyId, graph: 'delivery' }) }}">
                                    <span class="btn btn-green btn-sm"><i class="fa fa-eye fa-fw"></i></span>
                                </a></td>
                        </tr>
                        </tbody>
                        <tbody>
                        <tr>
                            <td>{{ 'manufacturing_smw.fields.fse_and_phr'| trans }}</td>
                            <td>{{ 'manufacturing_smw.fields.manufacturing_prod'| trans }}</td>
                            <td><a href="{{ path('power_bi_report_show', {id: 28}) }}">
                                    <span class="btn btn-green btn-sm"><i class="fa fa-eye fa-fw"></i></span>
                                </a></td>
                        </tr>

                        </tbody>
                        <tbody>
                        <tr>
                            <td>{{ 'manufacturing_smw.fields.pt_and_ct'| trans }}</td>
                            <td>{{ 'manufacturing_smw.fields.manufacturing_manu'| trans }}</td>
                            <td><a href="{{ path('legacy_manufacturing_index', {m: ['kpi2']}) }}">
                                    <span class="btn btn-warning btn-sm"><i class="fa fa-eye fa-fw"></i></span>
                                </a></td>
                        </tr>
                        <tr>
                            <td>{{ 'purchasing_smw.fields.productivity_plan'| trans({}, 'purchasing_smw') }}</td>
                            <td>{{ 'purchasing_smw.fields.productivity_plan_desc'| trans({}, 'purchasing_smw') }}</td>
                            <td><span class="btn btn-danger btn-sm"><i class="far fa-eye fa-fw"></i></span></td>
                        </tr>
                        <tr>
                            <td>{{ 'purchasing_smw.fields.pio'| trans({}, 'purchasing_smw') }}</td>
                            <td>{{ 'purchasing_smw.fields.pio_desc'| trans({}, 'purchasing_smw') }}</td>
                            <td><a href="{{ path('legacy_manufacturing_index', {m: ['pi', 'questionsByModelAndFactory']}) }}">
                                    <span class="btn btn-green btn-sm"><i class="fa fa-eye fa-fw"></i></span>
                                </a></td>
                        </tr>
                        <tr>
                            <td>{{ 'purchasing_smw.fields.cpa'| trans({}, 'purchasing_smw') }}</td>
                            <td>{{ 'purchasing_smw.fields.cpa_desc'| trans({}, 'purchasing_smw') }}</td>
                            <td><a href="{{ path('legacy_manufacturing_qa', {m: ['cpa'] }) }}">
                                    <span class="btn btn-green btn-sm"><i class="fa fa-eye fa-fw"></i></span>
                                </a></td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
