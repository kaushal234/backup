{% extends 'manufacturing/timekeeping/layout.html.twig' %}
{% trans_default_domain 'pio' %}
{% form_theme form 'form_theme_vertical.html.twig' %}

{% block content %}
    <div class="row">
        <div class="col-md-3">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'pio.time_keeping.title' | trans }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {{ form(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
