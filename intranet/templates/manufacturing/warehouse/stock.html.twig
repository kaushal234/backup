{% extends 'manufacturing/layout.html.twig' %}
{% trans_default_domain 'manufacturing' %}
{% form_theme form 'form_theme_vertical.html.twig' %}

{% block title %}{{ parent() }} \ {{ 'manufacturing.warehouse.export.title' | trans }} {% endblock %}
{% block content %}
    <div class="row">
        <div class="col-md-6">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'manufacturing.warehouse.export.title' | trans }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {{ form_start(form) }}
                    {{ form_rest(form) }}
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
