{% extends 'mis/layout.html.twig' %}
{% trans_default_domain 'mis' %}

{% block title %}MIS\Gitlab{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-6">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'button.filter' | trans([], 'messages') | upper }}</h5>
                </div>
                <div class="ibox-content">
                    {{ include('mis/gitlab/_filters.html.twig', {
                        form: formFilters,
                        resetPath: path('mis_gitlab_merge_request_list')
                    }) }}
                </div>
            </div>
        </div>
        <div class="col-6 highcharts" data-options="{{ chart|json_encode }}" style="min-width: 100px; height: 310px;"></div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <div class="ibox-tools">
                        <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                    </div>
                </div>
                <div class="ibox-content">
                    <div
                            class="highcharts"
                            data-options="{{ approversChart|json_encode }}"
                    ></div>
                </div>
            </div>
        </div>
    </div>

    {{ include('helper/_report_table.html.twig', {
        reportTable: {
            items: {
                iid: {
                    label: 'id',
                    template: '/mis/gitlab/partial/_merge_request_link.html.twig',
                },
                title: {
                    label: 'title'|capitalize,
                    class: 'text-nowrap'
                },
                merged_at: {
                    label: 'mis.gitlab.merged_at'|trans|capitalize,
                    class: 'text-nowrap',
                    filters: 'date("Y-m-d")',
                },
                author: {
                    label: 'mis.changelog.fields.author'|trans|capitalize,
                },
                approved: {
                    label: 'approved'|capitalize,
                    boolean: {
                        true: '<button type="button" class="btn btn-green btn-sm">Yes</button>',
                        false: '<button type="button" class="btn btn-danger btn-sm">No</button>'
                    },
                    sortable: false
                },
            },
            title: 'mis.gitlab.report_title'|trans|capitalize,
            data: mergeRequests,
            initialSorting: false,
            pagination: 20,
        }
    }, with_context = false) }}

{% endblock %}
