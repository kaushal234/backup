{% extends 'mis/modules/showLight.html.twig' %}
{% trans_default_domain 'mis' %}

{% block content %}
    {{ include('helper/_report_table.html.twig', {
        reportTable: {
            items: {
                createdAt: {
                    label: 'mis.security_review.fields.created_at'|trans,
                    filters: 'date("Y-m-d H:i:s")'
                },
                createdBy: {
                    label: 'mis.security_review.fields.created_by'|trans,
                    properties: ['createdBy.lastname', 'createdBy.firstname'],
                    link: {
                        route: 'directory_people_show',
                        params: {'id':'createdBy.@id'}
                    }
                },
                securityLevel: {
                    label: 'mis.modules.fields.security_level'|trans,
                    properties: ['securityLevel.name'],
                },
                isPasswordPolicyApplied: {
                    label: 'mis.security_review.fields.is_password_policy_applied'|trans,
                    boolean: {
                        'true': '<span class="d-none">1</span><i class="fa fa-check text-info"></i>',
                        'false': '<span class="d-none">0</span><i class="fa fa-times text-danger"></i>',
                    },
                },
                isMFAAdminApplied: {
                    label: 'mis.security_review.fields.is_mfa_admin_applied'|trans,
                    boolean: {
                        'true': '<span class="d-none">1</span><i class="fa fa-check text-info"></i>',
                        'false': '<span class="d-none">0</span><i class="fa fa-times text-danger"></i>',
                    },
                },
                isMFAUserApplied: {
                    label: 'mis.security_review.fields.is_mfa_user_applied'|trans,
                    boolean: {
                        'true': '<span class="d-none">1</span><i class="fa fa-check text-info"></i>',
                        'false': '<span class="d-none">0</span><i class="fa fa-times text-danger"></i>',
                    },
                },
                file: {
                    label: 'menu.file'|trans({}, 'messages'),
                    link:{
                        route: 'mis_modules_security_review_file',
                        fixedParams: {moduleId: module.id},
                        params: {securityReviewId: 'id', id : 'mainFile.id'},
                        class : 'text-center',
                        content: '<span class="btn btn-warning btn-sm"><i class="fa fa-download fa-fw"></i></span>',
                    }
                },
                view: {
                    label: 'menu.view'|trans({}, 'messages'),
                    link:{
                        route: 'mis_modules_security_review_show',
                        params: {'id':'@id'},
                        fixedParams: { moduleId: module.id },
                        content: '<span class="btn btn-primary btn-sm"><i class="far fa-eye fa-fw"></i></span>',
                    },
                    sortable: false,
                    class : 'text-end'
                },
            },
            title: 'mis.security_review.title'|trans,
            data: securityReviews,
        }
    }, with_context = false) }}
{% endblock content %}
