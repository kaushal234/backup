{% extends 'mis/modules/third_party_app/account_review/index.html.twig' %}
{% trans_default_domain 'mis' %}

{% block content %}
    {% embed 'helper/_ibox.html.twig' with {
        title: 'mis.account_review.add_title'|trans,
        options: {
            collapsable: false
        }
    } %}
        {% block card_content %}
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <div class="row">
                <div class="col-sm-12">
                    <button type="submit" class="btn btn-primary float-end text-capitalize" onclick="return confirm('{{ 'mis.account_review.alert_confirm'|trans({}, 'mis') }}')">{{ 'button.submit'|trans }}</button>
                </div>
            </div>
            {{ form_end(form) }}
        {% endblock card_content %}
    {% endembed %}
{% endblock %}

