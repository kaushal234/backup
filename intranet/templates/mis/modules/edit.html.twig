{% extends 'mis/modules/layout.html.twig' %}
{% set id = iri_id(module) %}

{% block content %}
    {% embed 'helper/_ibox.html.twig' with {
        title: 'titles.edition'|trans|capitalize,
    } %}
        {% block card_content %}
            {{ form_start(form) }}
            <div class="row">
                <div class="col-lg-8">
                    {{ form_widget(form) }}
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12 mt-3">
                    <button type="submit" class="btn btn-primary float-end text-capitalize">
                        {{ 'button.submit'|trans }}
                    </button>
                </div>
            </div>
            {{ form_end(form) }}
        {% endblock card_content %}
    {% endembed %}
{% endblock %}