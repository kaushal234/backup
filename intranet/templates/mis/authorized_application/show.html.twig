{% extends 'mis/layout.html.twig' %}
{% trans_default_domain 'mis' %}
{% form_theme form 'form_theme_horizontal.html.twig' %}

{% block content %}
    <div class="row">
        <div class="col-md-4">
            {{ include('helper/_association_table.html.twig', {
                associationData: {
                    items: {
                        createdBy: {
                            label: 'fields.created_by'|trans({}, 'messages'),
                            properties: ['createdBy.lastname', 'createdBy.firstname'],
                            link: {
                                route: 'directory_people_show',
                                params: {'id':'createdBy.@id'}
                            }
                        },
                        keyExpiresOn: {
                            label: 'mis.authorized_applications.fields.key_expires_on'|trans,
                            filters: 'date("Y-m-d")',
                        },
                        keyGeneratedOn: {
                            label: 'fields.created_at'|trans({}, 'messages'),
                            filters: 'date("Y-m-d H:i:s")',
                        },
                    },
                    title: 'mis.authorized_applications.title_singular'|trans ~ ' ' ~ authorizedApplication.name,
                    data: authorizedApplication},
            }, with_context = false) }}
        </div>
        <div class="col-md-8">
            <div class="row">
                <div class="col-lg-12">
                    <div class="ibox float-e-margins">
                        <div class="ibox-title">
                            <h5>{{ 'mis.features.title.list'|trans }}</h5>
                        </div>
                        <div class="ibox-content">
                            {{ form_start(form) }}
                            {{ form_errors(form) }}
                            <div class="row">
                                <div class="col-lg-8">
                                    {{ form_row(form.feature) }}
                                </div>
                                <div class="col-lg-4">
                                    {{ form_row(form.submit) }}
                                </div>
                            </div>
                            {{ form_rest(form) }}
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
            {{ include('helper/_report_table.html.twig', {
                reportTable: {
                    items: {
                        name: {label: 'fields.name'|trans([], 'messages')|capitalize},
                        delete: {
                            label: '',
                            link:{
                                route: 'mis_authorized_application_remove_feature',
                                params: {'featureId':'@id'},
                                content: '<span class="btn btn-danger btn-sm"><i class="fa fa-trash fa-fw popup"></i></span>',
                                fixedParams: {'_token': csrf_token('remove_authorized_application_feature'), id: authorizedApplication.iriId},
                                popup: {
                                    type: 'confirmation',
                                    title: 'Confirmation',
                                    message: 'Are you sure you want to remove ?',
                                },
                            },
                        },
                        view: {
                            label: '',
                            link:{
                                route: 'mis_features_show',
                                params: {'id':'@id'},
                                content: '<span class="btn btn-primary btn-sm"><i class="far fa-eye fa-fw"></i></span>',
                            },
                            sortable: false,
                            class: 'text-end'
                        },
                    },
                    title: 'mis.features.title.list'|trans,
                    data: authorizedApplication.features
                }
            }, with_context = false) }}
        </div>
    </div>
{% endblock %}
