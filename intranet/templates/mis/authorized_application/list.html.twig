{% extends 'mis/layout.html.twig' %}
{% trans_default_domain 'mis' %}


{% block content %}
    <div class="row">
        <div class="col-md-4">
            {% if form is defined %}
            {% form_theme form 'form_theme_vertical.html.twig' %}
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'mis.authorized_applications.new' | trans }}</h5>
                </div>
                <div class="ibox-content">
                    {{ form_start(form) }}
                    {{ form_errors(form) }}
                    <div class="col-sm-6 col-md-12">
                        {{ form_row(form.name) }}
                    </div>
                    <div class="col-sm-6 col-md-12">
                        {{ form_row(form.keyExpiresOn) }}
                    </div>

                    <div class="row">
                        <div class="col-lg-12">
                            {{ form_row(form.submit) }}
                        </div>
                    </div>
                    {{ form_rest(form) }}
                    {{ form_end(form) }}
                </div>
            </div>
            {% endif %}
            {% if authorizedApplication is defined %}
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'mis.authorized_applications.fields.key' | trans }}</h5>
                </div>
                <div class="ibox-content">
                    <p>{{ 'mis.authorized_applications.messages.key' | trans({
                        '%application%': authorizedApplication['name'],
                    }) | raw }}</p>
                    <pre id="authorized-application-key" style="white-space: pre-wrap;">{{ authorizedApplication.key }}</pre>
                    <a class="btn btn-primary" href="{{ path('mis_authorized_application_list') }}">{{ 'mis.authorized_applications.new'|trans }}</a>
                </div>
            </div>
            {% endif %}
        </div>
        <div class="col-md-8">
            {{ include('helper/_report_table.html.twig', {
                reportTable: {
                    items: {
                        name: {label: 'mis.authorized_applications.fields.name'|trans},
                        disabled: {
                            label: 'mis.authorized_applications.fields.disabled'|trans,
                            class: 'text-center',
                            boolean: {
                                false: '<span class="d-none">1</span><i class="fa fa-check text-info"></i>',
                                true: '<span class="d-none">0</span><i class="fa fa-times text-danger"></i>'
                            },
                            link: {
                                route: 'mis_authorized_application_switch',
                                'params': {'id':'@id'},
                            }
                        },
                        createdBy: {
                            label: 'fields.created_by'|trans({}, 'messages'),
                            properties: ['createdBy.lastname', 'createdBy.firstname'],
                            link: {
                                route: 'directory_people_show',
                                params: {'id':'createdBy.@id'}
                            }
                        },
                        keyExpiresOn: {
                            label: 'mis.authorized_applications.fields.key_expires_on'|trans,
                            filters: 'date("Y-m-d")',
                        },
                        keyGeneratedOn: {
                            label: 'fields.created_at'|trans({}, 'messages'),
                            filters: 'date("Y-m-d H:i:s")',
                        },
                        delete: {
                            label: '',
                            link:{
                                route: 'mis_authorized_application_delete',
                                params: {'id':'@id'},
                                content: '<span class="btn btn-danger btn-sm"><i class="fa fa-trash fa-fw popup"></i></span>',
                                fixedParams: {'_token': csrf_token('delete_authorized_application')},
                                popup: {
                                    type: 'confirmation',
                                    title: 'Confirmation',
                                    message: 'Are you sure you want to delete ?',
                                },
                            },
                        },
                        show: {
                            label: '',
                            link:{
                                route: 'mis_authorized_application_show',
                                params: {'id':'@id'},
                                'content': '<span class="btn btn-primary btn-sm"><i class="far fa-eye fa-fw"></i></span>',
                            },
                        },
                    },
                    title: 'mis.authorized_applications.title'|trans,
                    data: authorizedApplications,
                    pagination: false,
                    initialSorting: 'name'
                }
            }, with_context = false) }}
        </div>
    </div>
{% endblock %}
