{% extends 'mis/layout.html.twig' %}
{% trans_default_domain 'mis' %}

{% block title %}{{ 'menu.edit'|trans([], 'messages') }}{% endblock %}

{% block content %}
    {% form_theme form 'form_theme_vertical.html.twig' %}
    <div class="row">
        {{ form_start(form, { action: path('mis_change_logs_edit', {id: changeLog.getIriId()}) }) }}
        {{ form_errors(form) }}
        <div class="row">
            <div class="col-md-12">
                <div class="ibox float-e-margins news-list-element">
                    <div class="ibox-title">
                        <h4>{{ 'mis.changelog.title_edit' | trans({}, 'mis') }}</h4>
                    </div>
                    <div class="ibox-content">
                        <div class="row">
                            <div class="col-4">
                                {{ form_row(form.module) }}
                                {{ form_row(form.ticket) }}
                            </div>
                            <div class="col-4">
                                {{ form_row(form.type) }}
                                {{ form_row(form.author) }}

                            </div>
                            <div class="col-4">
                                {{ form_row(form.date) }}
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-8">
                                {{ form_row(form.message) }}
                            </div>
                        </div>
                        <div class="row">
                            {{ form_row(form.submit) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}