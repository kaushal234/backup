{% extends 'mis/support_team/layout.html.twig' %}
{% trans_default_domain 'support_team' %}

{% block content %}
    <div id="react"></div>
{% endblock %}

{% block javascripts %}
    <script>
        window.SF_INITIAL_STORE_STATE = {{ initialState|json_encode|raw }};
        window.MIS_APP_PROPS = {{ props|json_encode|raw }};
    </script>
    {{ parent() }}
{% endblock %}

{% block translations %}
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'messages' }) }}"></script>
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'support_team' }) }}"></script>
{% endblock %}



