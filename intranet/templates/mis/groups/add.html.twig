{% extends 'mis/groups/layout.html.twig' %}

{% block content %}
    <h3>{{ 'titles.addition'|trans|capitalize }}</h3>
    <div class="row">
        <div class="col-lg-8">
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <div>
                <div class="col-sm-12">
                    <button type="submit" class="btn btn-primary float-end text-capitalize">{{ 'button.submit'|trans }}</button>
                </div>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}