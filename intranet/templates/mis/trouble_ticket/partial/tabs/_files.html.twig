<div class="row">
    <div class="{{ form is not null ? 'col-lg-6 col-12' : 'col-12' }}" id="files_tab">
        {{ include('mis/trouble_ticket/partial/files_ajax.html.twig', {troubleTicket: item} )}}
    </div>
    {% if item.status not in ['RESOLVED', 'NOT AN ISSUE', 'ALREADY RAISED'] %}
        <div class="col-md-6">
            <div id="react" class="m-b-lg"></div>
        </div>
    {% endif %}
</div>
