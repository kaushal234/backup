{% trans_default_domain 'trouble_ticket' %}

{% form_theme form with ['form_theme_vertical.html.twig', _self] %}
{{ form_start(form) }}
{{ form_errors(form) }}
<div class="row mb-2">
    <div class="pe-0 d-flex flex-column gap-3">
        <div class="bg-body rounded h-100 m-0 p-2">
            {% if app.request.attributes.get('_route') == 'trouble_ticket_request_information' and troubleTicket.type.type == 'Incident' %}
                <p style="color: red; font-weight: bold">{{ 'trouble_ticket.message.transfer' | trans({}, 'trouble_ticket') }}</p>
            {% endif %}
            {% if app.request.attributes.get('_route') == 'trouble_ticket_comment' %}
                <p style="color: red; font-weight: bold">{{ 'trouble_ticket.message.comment' | trans({}, 'trouble_ticket') }}</p>
            {% endif %}
            {% if form.assignee is defined %}
                {{ form_row(form.assignee) }}
            {% endif %}
            {{ form_row(form.comment) }}
            {{ form_row(form.ccs) }}
            {{ form_row(form.file) }}
            <div class="row mt-2 d-flex justify-content-end">
                <div class="col-3 text-end">
                    {{ form_row(form.submit) }}
                </div>
                {% if form.nextTask is defined %}
                    <div class="col-auto">
                        {{ form_row(form.nextTask) }}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{{ form_end(form) }}