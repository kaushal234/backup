{% extends 'mis/trouble_ticket/partial/_form.html.twig' %}

{# No creation guidance note on edit (no "attach after creating" / purchase CTA). #}
{% block guidance %}{% endblock %}

{# On edit you're not "opening on behalf"; show the assignor (createdBy) as a plain field. #}
{% block on_behalf %}
    {% if on_behalf|default(false) %}
        <div class="row">
            <div class="col-md-6">{{ form_row(form.createdBy) }}</div>
        </div>
    {% endif %}
{% endblock %}

{# Admin-only workflow fields, shown above the classification section (assignee + status).
   Mirrors the React `isGrantedAdmin && formType === 'edit'` block. #}
{% block workflow %}
    {% if is_admin|default(false) %}
        <div class="row">
            <div class="col-md-6">{{ form_row(form.assignee) }}</div>
            <div class="col-md-6">{{ form_row(form.status) }}</div>
        </div>
    {% endif %}
{% endblock %}

{# Edit page: admin IFactor override + due date, read-only description, and the
   required "Reason For Editing" (-> comment). No ccs. #}
{% block fields %}
    <div class="row">
        {% if form.indiceFactor is defined %}
            <div class="col-md-6">{{ form_row(form.indiceFactor) }}</div>
        {% endif %}
        <div class="col-md-6">{{ form_row(form.dueDate) }}</div>
    </div>

    <div class="text-uppercase small text-muted fw-semibold border-bottom pb-2 mt-4 mb-3">{{ 'trouble_ticket.fields.details'|trans({}, 'trouble_ticket') }}</div>
    {{ form_row(form.url) }}
    {{ form_row(form.shortDescription) }}

    {# Description is shown read-only on edit (not part of the update payload). #}
    {% if read_only_description|default('') %}
        <div class="form-group">
            <label class="control-label">{{ 'fields.description'|trans({}, 'messages') }}</label>
            <div class="form-control-static p-sm"
                 style="background:#f9f9f9;border:1px solid #e5e6e7;border-radius:3px;min-height:40px;">
                {{ read_only_description|raw }}
            </div>
        </div>
    {% endif %}

    {{ form_row(form.comment) }}
{% endblock %}
