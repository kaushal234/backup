{% extends 'mis/trouble_ticket/layout.html.twig' %}
{% trans_default_domain 'trouble_ticket' %}
{% form_theme form 'form_theme_vertical.html.twig' %}

{% block content %}
    <br>
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'button.filter' | trans([], 'messages') | upper }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {{ form_start(form) }}
                    {{ form_errors(form) }}
                    <div class="row">
                        <div class="col-md-3">
                            {{ form_row(form.region) }}
                        </div>
                        <div class="col-md-3">
                            {{ form_row(form.misAssignee) }}
                        </div>
                        <div class="col-md-3">
                            {{ form_row(form.application) }}
                        </div>
                        <div class="col-md-3">
                            {{ form_row(form.module) }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            {{ form_row(form.supportTeam) }}
                        </div>
                        <div class="col-md-3">
                            {{ form_row(form.type) }}
                        </div>
                        <div class="col-md-3">
                            {{ form_row(form.after) }}
                        </div>
                        <div class="col-md-3">
                            {{ form_row(form.before) }}
                        </div>
                        <div class="col-md-1 btn-height" style="padding-top: 34px; display: flex; justify-content: end">
                            {{ form_row(form.submit) }}
                        </div>
                    </div>
                </div>
                    {{ form_rest(form) }}
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
        {% if chartMonth is defined %}
            <div data-options="{{ chartMonth | json_encode }}" class="ibox float-e-margins highcharts mb-0" style="min-width: 400px; height: 500px;"></div>
            <div class="mt-0 p-2 bg-white"><em>{{ 'mis.reports.status_by_month.helper' | trans([], 'mis') }}</em></div>
            <br>
            <div data-options="{{ chartWeek | json_encode }}" class="ibox float-e-margins highcharts mb-0" style="min-width: 400px; height: 500px;"></div>
            <div class="mt-0 p-2 bg-white"><em>{{ 'mis.reports.status_by_week.helper' | trans([], 'mis') }}</em></div>
            <br>
            <div data-options="{{ chartStatusByWeek | json_encode }}" class="ibox float-e-margins highcharts" style="min-width: 400px; height: 500px;"></div>
            <div data-options="{{ chartStatusByMonth | json_encode }}" class="ibox float-e-margins highcharts" style="min-width: 400px; height: 500px;"></div>
            <div class="row">
                <div class="col-md-6">
                    <div data-options="{{ chartIncidentByModule | json_encode }}" class="ibox float-e-margins highcharts mb-0" style="min-width: 400px; height: 500px;"></div>
                </div>
                <div class="col-md-6">
                    <div data-options="{{ chartRequestByModule | json_encode }}" class="ibox float-e-margins highcharts mb-0" style="min-width: 400px; height: 500px;"></div>
                </div>
            </div>
            <div data-options="{{ chartTop10Modules | json_encode }}" class="ibox float-e-margins highcharts mt-2" style="min-width: 400px; height: 500px;"></div>
        {% endif %}
{% endblock %}
