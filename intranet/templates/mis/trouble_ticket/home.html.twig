{% extends 'mis/trouble_ticket/layout.html.twig' %}
{% trans_default_domain 'trouble_ticket' %}

{% block content %}
    <div class="row" style="gap: 5rem">
        <div class="col-md-12">
            <h3 class="text-capitalize">{{ 'customer_relationship_team.fields.quick_access'|trans([], 'customer_relationship_team') }}</h3>
            <div class="row">
                <div class="col-md-4">
                    {% set apiRoute = constant('AppBundle\\Controller\\Mis\\TroubleTicket\\ShowController::RESOURCE_URL') %}

                    {{ id_search_form(
                        idLabel: false,
                        idPlaceholder: 'By ID',
                        redirectRoute: 'trouble_ticket_show',
                        apiRoute: apiRoute,
                    ) }}
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            {{ data_table(troubleTicketDatable) }}
        </div>
    </div>
{% endblock %}

{% block form_label -%}
    {{ include('sales/partial/input_with_no_label.html.twig') }}
{%- endblock form_label %}

{% block translations %}
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'messages' }) }}"></script>
{% endblock %}

