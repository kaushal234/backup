{% block content %}
    <div class="row">
        {% form_theme form 'form_theme_vertical.html.twig' %}

        {% embed 'helper/_ibox.html.twig' %}
            {% block card_content %}
                {{ form_start(form, { action: action }) }}
                <div class="row">
                    <div class="col-md-12">
                        {{ form_errors(form) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.createdBy, {value: "/people/"~app.user.id}) }}
                        <div class="row mb-0">
                            <div id="datetimepicker1" class="col-md-6">{{ form_row(form.publishedAt) }}</div>
                            <div class="col-md-6">{{ form_row(form.unpublishedAt) }}</div>
                        </div>
                        {{ form_row(form.factories) }}
                        {% if evendorsNews.files is defined %}
                            {{ include('materials/evendors_news/partials/_show_files.html.twig', { entry: evendorsNews, deleteButton: 'true' }) }}
                        {% endif %}
                        <div>
                            <span>{{ form_label(form.files) }}</span>
                            <span><small style="font-style: italic">{{ fileInfo }}</small></span>
                        </div>
                        <div>
                            <span>{{ form_errors(form.files) }}</span>
                        </div>
                        <div>
                            <span>{{ form_widget(form.files) }}</span>
                        </div>
                        <div>
                            <small style="font-style: italic">
                            'image/png,
                            pdf,
                            word,
                            excel,
                            powerpoint'
                            </small>
                        </div>

                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.content) }}
                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">{{ 'button.submit'|trans({}, 'messages') }}</button>
                        </div>
                    </div>
                </div>
                {{ form_end(form) }}
            {% endblock card_content %}
        {% endembed %}
    </div>
{% endblock %}
