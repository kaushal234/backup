{% extends 'surveys/layout.html.twig' %}

{% trans_default_domain 'surveys' %}

{% block title %} {{ 'survey.page_titles.list' | trans([]) }} {% endblock %}

{% block content %}
    <div class="row">
        {{ include('surveys/survey/partial/statistics.html.twig', { collection: surveys }) }}
    </div>
    <div class="row">
        <div class="col-lg-9">
            {{ include ('helper/_report_table.html.twig', {
                'reportTable': {
                    'data': surveys,
                    'title': 'survey.page_titles.list' | trans | upper,
                    'currentPage': currentPage,
                    'items': {
                        'name': {
                            'label': 'survey.fields.name'| trans | capitalize,
                            'class': 'small',
                            'filters': ['u.truncate(100)'],
                            'link':{
                                'route': 'surveys_show',
                                'params': {'id':'@id'}
                            },
                        },
                        'expirationDate': {
                            'label': 'survey.fields.expirationDate'| trans | capitalize,
                            'filters': ["date('Y-m-d')"],
                            'class': 'small text-center',
                            'preserveNull': true
                        },
                        'createdAt': {
                            'label': 'general_fields.createdAt'| trans | capitalize,
                            'filters': ["date('Y-m-d')"],
                            'class': 'small text-center',
                            'preserveNull': true
                        },
                        'createdBy': {
                            'label': 'survey.fields.createdBy'| trans |capitalize,
                            'class': 'small text-center',
                            'properties': ['createdBy.lastname', 'createdBy.firstname'],
                            'link': {
                                'route': 'directory_people_show',
                                'params': { 'id': 'createdBy.@id' }
                            },
                        },
                        'view': {
                            'label': 'menu.view'|trans([], 'messages')|capitalize,
                            'link':{
                                'route': 'surveys_show',
                                'params': {'id':'@id'},
                                'content': '<span class="btn btn-primary btn-sm"><i class="far fa-eye fa-fw"></i></span>',
                            },
                            'class' : 'text-end'
                        },
                        'edit': {
                            'label': 'menu.edit'|trans([], 'messages')|capitalize,
                            'link':{
                                'route': 'surveys_edit',
                                'params': {'id':'@id'},
                                'content': '<span class="btn btn-warning btn-sm"><i class="fa fa-pencil-alt fa-fw"></i></span>',
                            },
                            'class' : 'text-end'
                        },
                        'delete': {
                            'label': 'menu.delete'|trans([], 'messages')|capitalize,
                            'link':{
                                'route': 'surveys_delete',
                                'params': {'id':'@id'},
                                'popup': {
                                    'message': 'messages.grid_delete_confirmation' | trans | capitalize
                                },
                                'content': '<span class="btn btn-danger btn-sm"><i class="fa fa-trash fa-fw"></i></span>',
                            },
                            'class' : 'text-end'
                        }
                    }
                }
            }) }}
        </div>
        <div class="col-lg-3">
            <div class="ibox">
                <div class="ibox-title">
                    <h5>{{ 'button.filter' | trans([], 'messages') | upper }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {{ include('surveys/survey/partial/_form_filters.html.twig', {
                        form: formFilters,
                        resetPath: path('surveys_index')
                    }) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
