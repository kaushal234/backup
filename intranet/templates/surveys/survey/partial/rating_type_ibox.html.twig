{% trans_default_domain 'surveys' %}

{% set rating_type_id = iri_id(ratingType) %}

<div class="ibox-content m-b-xxs rating-type">
    <div class="row">
        <div class="col-lg-10">
            <h4>{{ ratingType.description | u.truncate(70) }}</h4>
            <div class="row text-center">
                <div class="col-lg-4">
                    <div class="d-flex flex-column mb-3">
                        <div class="col-lg-12">
                            <span class="font-bold">{{ ratingType.min }}</span>
                        </div>
                        <div class="col-lg-12">
                            <span class="small">{{ ratingType.minLabel }}</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <p class="text-uppercase font-bold">{{ 'general_fields.to' | trans }}</p>
                </div>
                <div class="col-lg-4">
                    <div class="col-lg-12">
                        <span class="small font-bold">{{ ratingType.max }}</span>
                    </div>
                    <div class="col-lg-12">
                        <span class="small">{{ ratingType.maxLabel }}</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-2">
            {% if is_granted('FEATURE_SURVEY_VIEW') %}
                <a href="{{ path('survey_rating_types_show', {id: survey_id, ratingId: rating_type_id}) }}" class="btn btn-sm btn-primary m-b-xxs">
                    <i class="far fa-eye fa-fw"></i>
                </a>
            {% endif %}
            {% if is_granted('FEATURE_SURVEY_WRITE') %}
                <a class="btn btn-sm btn-warning m-b-xxs" href="{{ path('survey_rating_types_edit', {id: survey_id, ratingId: rating_type_id }) }}">
                    <i class="fa fa-pencil-alt fa-fw"></i>
                </a>
            {% endif %}
            {% if is_granted('FEATURE_SURVEY_DELETE') %}
                <a href="{{ path('survey_rating_types_delete', {id: survey_id, ratingId: rating_type_id }) }}" onclick="return confirm('{{ 'messages.grid_delete_confirmation' | trans }}')" class="btn btn-sm btn-danger m-b-xxs" >
                    <i class="fa fa-trash fa-fw"></i>
                </a>
            {% endif %}

        </div>
    </div>
</div>
