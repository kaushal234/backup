{% form_theme form 'form_theme_vertical.html.twig' %}
{{ form_start(form) }}
{{ form_errors(form) }}
<div class="row">
    <div class="col-lg-12">
        {{ form_row(form.name) }}
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        {{ form_row(form.createdBy) }}
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        {{ form_row(form.itemsPerPage) }}
    </div>
</div>
<div class="row">
    {{ form_rest(form) }}
    <div class="col-lg-12">
        <div>
            <button name="submit" class="btn btn-primary" type="submit">{{ 'button.filter'| trans | upper }}</button>
            <a href="{{ resetPath }}" class="btn btn-secondary">{{ 'button.reset'| trans | upper }}</a>
        </div>
    </div>
</div>
{{ form_end(form) }}
