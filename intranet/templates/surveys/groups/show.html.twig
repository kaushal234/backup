{% extends 'surveys/layout.html.twig' %}
{% trans_default_domain 'surveys' %}

{% set survey_id = iri_id(survey) %}

{% block title %}{{ parent() }} \ {{ 'group.page_titles.list' | trans }} \ {{ 'menu.view' | trans([], 'messages') }}{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-lg-12">
            <h2>{{ group.name | u.truncate(100) }}</h2>
            <p class="small">{{ group.description }}</p>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-9">
            {% if group.items | length > 0 %}
                {{ include ('helper/_report_table.html.twig', {
                    'reportTable': {
                        'data': group.items,
                        'title': 'survey_items.page_titles.list' | trans | capitalize,
                        'items': {
                            'description': {
                                'label': 'general_fields.description' | trans | capitalize,
                                'class': 'small',
                                'link':{
                                    'route': 'survey_items_edit',
                                    'params': { 'itemId': '@id' },
                                    'fixedParams': { 'id': survey_id },
                                },
                            },
                            'createdAt': {
                                'label': 'general_fields.createdAt' | trans | capitalize,
                                'class': 'small text-center',
                                'filters': ['format_datetime']
                            },
                            'createdBy': {
                                'label': 'survey.fields.createdBy'| trans | capitalize,
                                'properties': ['createdBy.lastname', 'createdBy.firstname'],
                                'class': 'small text-center',
                                'link': {
                                    'route': 'directory_people_show',
                                    'params': { 'id': 'createdBy.@id' }
                                }
                            },
                            'edit': {
                                'label': 'menu.edit'|trans([], 'messages')|capitalize,
                                'link':{
                                    'route': 'survey_items_edit',
                                    'params': { 'itemId': '@id' },
                                    'fixedParams': { 'id': survey_id },
                                    'content': '<span class="btn btn-warning btn-sm"><i class="fa fa-pencil-alt fa-fw"></i></span>',
                                },
                                'class ': 'text-end'
                            },
                            'delete': {
                                'label': 'menu.delete' | trans([], 'messages') | capitalize,
                                'link': {
                                    'route': 'survey_items_delete',
                                    'params': { 'itemId': '@id' },
                                    'fixedParams': { 'id': survey_id },
                                    'popup': {
                                        'message': 'messages.grid_delete_confirmation' | trans | capitalize
                                    },
                                    'content': '<span class="btn btn-danger btn-sm"><i class="fa fa-trash fa-fw"></i></span>',
                                },
                                'class ': 'text-end'
                            }
                        }
                    }
                }) }}
            {% endif %}
        </div>
        <div class="col-lg-3">
            {% if survey is defined %}
                <div class="ibox-content m-b-xs">
                    <div class="row">
                        <div class="col-lg-12">
                            <h3>{{ survey.name | u.truncate(50) | capitalize }}
                                {% if is_granted('FEATURE_SURVEY_VIEW') %}
                                    <a class="btn btn-sm btn-primary float-end" href="{{ path('surveys_show', { id: survey_id }) }}">
                                        <i class="far fa-eye"></i>
                                    </a>
                                {% endif %}
                            </h3>
                            <p class="small">{{ survey.description }}</p>
                            <dl class="dl-horizontal small float-end">
                                {% if survey.expirationDate is not same as(null) %}
                                    <dt>{{ 'survey.fields.expirationDate' | trans | capitalize }}</dt>
                                    <dd>{{ survey.expirationDate | format_datetime('medium', 'none') }}</dd>
                                {% endif %}
                                <dt>{{ 'general_fields.createdAt' | trans | capitalize }}</dt>
                                <dd>{{ survey.createdAt | format_datetime('medium', 'none') }}</dd>
                                <dt>{{ 'general_fields.createdBy' | trans | capitalize }}</dt>
                                <dd>
                                    <a href="{{ path('directory_people_show', {'id': iri_id(survey.createdBy)}) }}">
                                        {{ survey.createdBy.firstname ~ ' ' ~ survey.createdBy.lastname }} <br/>
                                        {{ survey.createdBy.email }}
                                    </a>
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
