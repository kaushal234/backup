{% extends 'surveys/layout.html.twig' %}

{% trans_default_domain 'surveys' %}

{% set survey_id = iri_id(survey) %}

{% block title %} {{ parent() }} / {{ 'group.page_titles.list' | trans([]) }} {% endblock %}

{% block content %}
    <div class="row">
        <div class="col-lg-12">
            {{ include('surveys/groups/partial/statistics.html.twig', {collection: groups}) }}
        </div>
    </div>
    <div class="row">
        <div class="col-lg-9 col-md-12">
            {{ include ('helper/_report_table.html.twig', {
                'reportTable': {
                    'data': groups,
                    'title': 'group.page_titles.list' | trans | upper,
                    'pagination': {
                        'currentPage': currentPage,
                        'paginationUrl': paginationUrl
                    },
                    'items': {
                        'name': {
                            'label': 'group.fields.name'| trans | capitalize,
                            'class': 'small',
                            'link':{
                                'route': 'survey_groups_show',
                                'params': {'groupId':'@id'},
                                'fixedParams': {'id': survey_id}
                            }
                        },
                        'createdAt': {
                            'label': 'general_fields.createdAt' | trans | capitalize,
                            'class': 'small text-center',
                            'filters': ['format_datetime("medium", "none")']
                        },
                        'createdBy': {
                            'label': 'survey.fields.createdBy'| trans |capitalize,
                            'properties': ['createdBy.lastname', 'createdBy.firstname'],
                            'class': 'small text-center',
                            'link': {
                                'route': 'directory_people_show',
                                'params': { 'id': 'createdBy.@id' }
                            }
                        },
                        'view': {
                            'label': 'menu.view'|trans([], 'messages')|capitalize,
                            'link':{
                                'route': 'survey_groups_show',
                                'params': {'groupId':'@id'},
                                'fixedParams': {'id': survey_id},
                                'content': '<span class="btn btn-primary btn-sm"><i class="far fa-eye fa-fw"></i></span>',
                            },
                            'sortable': false,
                            'class' : 'text-end'
                        },
                        'edit': {
                            'label': 'menu.edit'|trans([], 'messages')|capitalize,
                            'link':{
                                'route': 'survey_groups_edit',
                                'params': { 'groupId':'@id' },
                                'fixedParams': {'id': survey_id},
                                'content': '<span class="btn btn-warning btn-sm"><i class="fa fa-pencil-alt fa-fw"></i></span>',
                            },
                            'sortable': false,
                            'class' : 'text-end'
                        },
                        'delete': {
                            'label': 'menu.delete'|trans([], 'messages')|capitalize,
                            'link':{
                                'route': 'survey_groups_delete',
                                'params': { 'groupId':'@id' },
                                'fixedParams': {'id': survey_id},
                                'popup': {
                                    'message': 'messages.grid_delete_confirmation' | trans | capitalize
                                },
                                'content': '<span class="btn btn-danger btn-sm"><i class="fa fa-trash fa-fw"></i></span>',
                            },
                            'sortable': false,
                            'class' : 'text-end'
                        }
                    }
                }
            }) }}
        </div>
        <div class="col-lg-3 col-md-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'button.filter' | trans([], 'messages') | upper }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {{ include('surveys/groups/partial/_form_filters.html.twig', {
                        form: formFilters,
                        resetPath: path('survey_groups_index', {'id': survey_id})
                    }) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
