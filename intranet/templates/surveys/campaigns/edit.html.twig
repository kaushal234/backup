{% extends 'surveys/layout.html.twig' %}
{% trans_default_domain 'surveys' %}
{% form_theme form 'form_theme_vertical.html.twig' %}

{% block title %}
    {{ parent() }}\{{ 'published.page_titles.edit_campaign' | trans  }}
{% endblock %}

{% block content %}
    <div class="row">
        {{ form_start(form, { action: actionPath }) }}
        {{ form_errors(form) }}
        <div class="ibox float-e-margins">
            <div class="ibox-title">
                {{ 'published.page_titles.edit_campaign'|trans|capitalize }}
            </div>
            <div class="ibox-content">
                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.description) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.submit) }}
                    </div>
                </div>
            </div>
        </div>
        {{ form_rest(form) }}
        {{ form_end(form) }}
    </div>
{% endblock %}
