{% form_theme form 'form_theme_vertical.html.twig' %}
{{ form_start(form) }}
    {{ form_errors(form) }}
    <div class="row">
        <div class="col-lg-12 small">
            {{ form_row(form.customer) }}
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12 small">
            {{ form_row(form.itemsPerPage) }}
        </div>
    </div>
    <div class="row">
        {{ form_rest(form) }}
        <div class="col-lg-12">
            <div>
                <button name="submit" class="btn btn-primary btn-sm" type="submit">{{ 'button.filter'| trans | upper }}</button>
                <a href="{{ resetPath }}" class="btn btn-sm btn-secondary">{{ 'button.reset'| trans | upper }}</a>
            </div>
        </div>
    </div>
{{ form_end(form) }}
