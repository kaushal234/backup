{% block content %}
    <div class="row">
        {% form_theme form 'form_theme_vertical.html.twig' %}

        {{ form_start(form, { action: action }) }}
        {{ form_errors(form) }}

        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h4>{{ title }}</h4>
                </div>
                <div class="ibox-content">
                    <div class="row">
                        <div class="col-md-6">
                            <h2><span class="badge">1</span> {{ 'survey.publication_form.select_criterias' | trans({}, 'surveys') }}</h2>
                            <hr>
                            <div class="">
                                {{ form_label(form.country) }}
                                {{ form_errors(form.country) }}
                                {{ form_widget(form.country) }}
                            </div>
                            <div class="">
                                {{ form_label(form.sales_locations) }}
                                {{ form_errors(form.sales_locations) }}
                                {{ form_widget(form.sales_locations) }}
                            </div>
                            <div class="">
                                {{ form_label(form.service_locations) }}
                                {{ form_errors(form.service_locations) }}
                                {{ form_widget(form.service_locations) }}
                            </div>
                            <div class="">
                                {{ form_label(form.parts_locations) }}
                                {{ form_errors(form.parts_locations) }}
                                {{ form_widget(form.parts_locations) }}
                            </div>
                            <div class="">
                                {{ form_label(form.roles) }}
                                {{ form_errors(form.roles) }}
                                {{ form_widget(form.roles) }}
                            </div>
                        </div>
                        <div class="col-md-6">
                            <h2 class="text-end"><span class="badge">2</span> {{ 'survey.publication_form.refresh_list' | trans({}, 'surveys') }}</h2>
                            <hr>
                            {{ form_widget(form.refresh) }}
                            <div class="">
                                {{ form_label(form.customers) }}
                                {{ form_errors(form.customers) }}
                                {{ form_widget(form.customers) }}
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12">
                            <div class=" text-end">
                                <h2 style="margin-top: 2rem"><span class="badge">3</span> {{ 'survey.publication_form.select_and_generate' | trans({}, 'surveys') }}</h2>
                                <hr>
                                {{ form_widget(form.generate) }}
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="">
                                {% if form.extranet_users is defined %}
                                    {{ form_row(form.extranet_users) }}
                                {% endif %}
                                {% if form.description is defined %}
                                    {{ form_row(form.description) }}
                                {% endif %}
                                {% if form.publish is defined %}
                                    {{ form_widget(form.publish) }}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="clear-fix"></div>

    </div>

{% endblock %}
