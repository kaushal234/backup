{% block content %}
    <div class="row">
        {% form_theme form 'form_theme_vertical.html.twig' %}

        {{ form_start(form, { action: action }) }}
        {{ form_errors(form) }}

        <div class="col-lg-9">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h4>{{ title }}</h4>
                </div>
                <div class="ibox-content">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="">
                                {{ form_label(form.targets) }}
                                {{ form_errors(form.targets) }}
                                {{ form_widget(form.targets) }}
                            </div>
                            <div>
                                <button name="submit" type="submit" class="btn btn-primary">
                                    {{ 'button.submit' | trans({}, 'messages') | title }}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="clear-fix"></div>
        {{ form_rest(form) }}
    </div>

{% endblock %}

