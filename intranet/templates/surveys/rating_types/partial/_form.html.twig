{% block content %}
    <div class="row">
        {% form_theme form 'form_theme_vertical.html.twig' %}

        {{ form_start(form, { action: action }) }}
        {{ form_errors(form) }}

        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h4>{{ title }}</h4>
                </div>
                <div class="ibox-content">
                    <div class="row">
                        <div class="col-lg-12">
                            {{ form_row(form.description) }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            {{ form_row(form.min) }}
                        </div>
                        <div class="col-md-9">
                            {{ form_row(form.minLabel) }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            {{ form_row(form.max) }}
                        </div>
                        <div class="col-md-9">
                            {{ form_row(form.maxLabel) }}
                        </div>
                    </div>
                    <div class="clear-fix"></div>
                    <div class="row">
                        <div class="col-lg-3">
                            <div>
                                <button name="submit" type="submit" class="btn btn-primary">{{ 'button.submit' | trans({}, 'messages') | title }}</button>
                                <a href="{{ cancel_link }}" class="btn btn-secondary">
                                    {{ 'button.cancel' | trans({}, 'messages') | title }}
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="clear-fix"></div>
        {{ form_rest(form) }}
        </form>
    </div>

{% endblock %}

