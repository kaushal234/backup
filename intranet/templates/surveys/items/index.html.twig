{% extends 'surveys/layout.html.twig' %}

{% trans_default_domain 'surveys' %}

{% set survey_id = iri_id(survey) %}

{% block title %} {{ parent() }} / {{ 'survey_items.page_titles.list' | trans([]) }} {% endblock %}

{% block content %}
    {{ include('surveys/items/partial/statistics.html.twig', { collection: items }) }}
    <div class="row">
        <div class="col-lg-9 col-md-12">
            {{ include ('helper/_report_table.html.twig', {
                'reportTable': {
                    'data': items,
                    'title': 'survey_items.page_titles.list' | trans | upper,
                    'pagination': {
                        'currentPage': currentPage,
                        'paginationUrl': paginationUrl
                    },
                    'items': {
                        'description': {
                            'label': 'general_fields.description'| trans | capitalize,
                            'class': 'small'
                        },
                        'totalAnswers': {
                            'label': 'general_fields.totalAnswers'| trans | capitalize,
                            'class': 'small text-center font-bold',
                            'filters': ['format_number']
                        },
                        'totalComments': {
                            'label': 'general_fields.totalComments'| trans | capitalize,
                            'class': 'small text-center font-bold',
                            'filters': ['format_number']
                        },
                        'surveyName': {
                            'label': 'fields_labels.survey'| trans | capitalize,
                            'class': 'small text-center',
                            'properties': ['survey.name'],
                            'link': {
                                'route': 'surveys_show',
                                'params': { 'id': 'survey.@id' }
                            }
                        },
                        'groupName': {
                            'label': 'group.fields.name'| trans | capitalize,
                            'class': 'small text-center',
                            'properties': ['group.name'],
                            'link': {
                                'route': 'survey_groups_show',
                                'params': { 'groupId': 'group.@id' },
                                'fixedParams': { 'id': survey_id }
                            }
                        },
                        'createdAt': {
                            'label': 'general_fields.createdAt' | trans | capitalize,
                            'class': 'small text-center',
                            'filters': ['format_datetime("medium", "none")'],
                            'preserveNull': true
                        },
                        'createdBy': {
                            'label': 'survey.fields.createdBy'| trans | capitalize,
                            'properties': ['createdBy.lastname', 'createdBy.firstname'],
                            'class': 'small text-center',
                            'link': {
                                'route': 'directory_people_show',
                                'params': { 'id': 'createdBy.@id' }
                            },
                        },
                        'edit': {
                            'label': 'menu.edit'|trans([], 'messages')|capitalize,
                            'link':{
                                'route': 'survey_items_edit',
                                'params': { 'itemId': '@id'},
                                'fixedParams': { 'id': survey_id},
                                'content': '<span class="btn btn-warning btn-sm"><i class="fa fa-pencil-alt fa-fw"></i></span>',
                            },
                            'sortable': false,
                            'class' : 'text-end'
                        },
                        'delete': {
                            'label': 'menu.delete' | trans([], 'messages') | capitalize,
                            'link':{
                                'route': 'survey_items_delete',
                                'params': { 'itemId': '@id'},
                                'fixedParams': { 'id': survey_id},
                                'popup': {
                                    'message': 'messages.grid_delete_confirmation' | trans | capitalize
                                },
                                'content': '<span class="btn btn-danger btn-sm"><i class="fa fa-trash fa-fw"></i></span>',
                            },
                            'sortable': false,
                            'class' : 'text-end'
                        }
                    }
                }
            }) }}
        </div>
        <div class="col-lg-3 col-md-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'button.filter' | trans([], 'messages') | upper }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {{ include('surveys/items/partial/_form_filters.html.twig', {
                        form: formFilters,
                        resetPath: path('survey_items_index', {id: survey_id})
                    }) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
