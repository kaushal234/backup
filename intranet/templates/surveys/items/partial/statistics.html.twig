{% trans_default_domain 'surveys' %}
{% set total = collection | length %}
{% set procent = 0 %}
<div class="row">
    <div class="col-lg-2">
        {% if total > 0 %}
            {% set procentAnswered = ((collection | sum('totalAnswers')) / total) * 100 %}
        {% else %}
            {% set procentAnswered = 0 %}
        {% endif %}
        {{ include('surveys/partial/statistics_box.html.twig', {
            'title': 'general_fields.totalAnswers' | trans,
            'procent': procentAnswered,
            'value': collection | sum('totalAnswers') | format_number,
            'tooltip': 'general_fields.totalAnswers' | trans,
            'color': 'info'
        }) }}
    </div>

    <div class="col-lg-2">
        {% if total > 0 %}
            {% set procentComments = ((collection | sum('totalComments')) / total) * 100 %}
        {% else %}
            {% set procentComments = 0 %}
        {% endif %}
        {{ include('surveys/partial/statistics_box.html.twig', {
            'title': 'general_fields.totalComments' | trans,
            'procent': procentComments,
            'value': collection | sum('totalComments') | format_number,
            'tooltip': 'general_fields.totalComments' | trans,
            'color': 'info'
        }) }}
    </div>

    <div class="col-lg-2">
        {% if total > 0 %}
            {% set procentPublishedMonth = ((collection | countWithDateBetween('createdAt')) / total) * 100 %}
        {% else %}
            {% set procentPublishedMonth = 0 %}
        {% endif %}
        {{ include('surveys/partial/statistics_box.html.twig', {
            'title': 'statistics.created.month' | trans,
            'procent': procentPublishedMonth,
            'value': collection | countWithDateBetween('createdAt') | format_number,
            'tooltip': 'statistics.items.created.month' | trans,
            'color': 'info'
        }) }}
    </div>

    <div class="col-lg-2">
        {% if total > 0 %}
            {% set procentPublishedYear = ((collection | countWithDateBetween('createdAt', date('-1 year'))) / total) * 100 %}
        {% else %}
            {% set procentPublishedYear = 0 %}
        {% endif %}
        {{ include('surveys/partial/statistics_box.html.twig', {
            'title': 'statistics.created.year' | trans,
            'procent': procentPublishedYear,
            'value': collection | countWithDateBetween('createdAt', date('-1 year')) | format_number ,
            'tooltip': 'statistics.created.year' | trans,
            'color': 'info'
        }) }}
    </div>
</div>
