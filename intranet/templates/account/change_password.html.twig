{% extends 'account/layout.html.twig' %}

{% block content %}
    <h3>Change password</h3>
    <div class="row">
        <div class="col-md-8 col-lg-6">
            {% form_theme form 'form_theme_vertical.html.twig' %}
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <button type="submit" class="btn btn-primary float-end">Submit</button>
            <span style="font-size:80%; color:#ed5565;">*</span><span style="font-size:80%;"> denotes required field</span>
            <div class="text-center">
                <a href='#' class="toggle-password" id="show"><i class="far fa-eye"></i>&nbsp;{{ 'security.login.show_password'|trans }}</a>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.onload = function() {
            passwordInputFirst = document.getElementById('app_account_password_password_first');
            passwordInputSecond = document.getElementById('app_account_password_password_second');
            passwordToggler = document.querySelector('.toggle-password');
            eyeIcon = document.querySelector('.toggle-password i');

            document.getElementById('show').addEventListener("click", function (e) {
                e.preventDefault();

                if (passwordInputFirst.type === 'password') {
                    passwordInputFirst.type = 'text';
                    passwordInputSecond.type = 'text';
                    eyeIcon.classList.replace('fa-eye', 'fa-eye-slash');
                } else {
                    passwordInputFirst.type = 'password';
                    passwordInputSecond.type = 'password';
                    eyeIcon.classList.replace('fa-eye-slash', 'fa-eye');
                }
            });
        }

    </script>
{% endblock %}