{% extends 'service/maintenance_contracts/layout.html.twig' %}
{% trans_default_domain 'service' %}

{% block content %}
    <div class="row">
        {% form_theme form 'form_theme_vertical.html.twig' %}
        <div class="col-lg-8">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'titles.addition'|trans([], 'messages')|capitalize }}</h5>
                </div>
                <div class="ibox-content">
                    {{ form_start(form) }}
                    {{ form_widget(form) }}
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
