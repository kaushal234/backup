{% extends 'service/maintenance_contracts/layout.html.twig' %}
{% trans_default_domain 'service' %}

{% block title %}{{ parent() }}{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'button.filter' | trans([], 'messages') | upper }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {{ include('service/maintenance_contracts/partial/_form_filter.html.twig', {
                        form: formFilter,
                        resetPath: path('service_maintenance_contracts_home')
                    }) }}
                </div>
            </div>
        </div>
    </div>


    <div class="row">
        <div class="col-lg-12">
            {{ include('helper/_report_table.html.twig', {
                reportTable: {
                    items: {
                        description: {
                            label: 'fields.description'|trans([], 'messages')|capitalize,
                            link:{
                                route: 'service_maintenance_contracts_show',
                                params: {'id':'@id'},
                            }
                        },
                        buyer: {
                            properties: ['buyer.name'],
                            label: 'service.equipment_record.fields.buyer'|trans|capitalize,
                            link:{
                                route: 'sales_customers_show',
                                params: {'id':'buyer.@id'},
                            }
                        },
                        endUser: {
                            properties: ['endUser.name'],
                            label: 'service.equipment_record.fields.end_user'|trans|capitalize,
                            link:{
                                route: 'sales_customers_show',
                                params: {'id':'endUser.@id'},
                            }
                        },
                        startDate: {
                            label: 'service.maintenance_contract.fields.start_date'|trans|capitalize,
                            filters: 'date("Y-m-d")'
                        },
                        expirationDate: {
                            label: 'service.maintenance_contract.fields.expiration_date'|trans|capitalize,
                            filters: 'date("Y-m-d")'
                        },
                        view: {
                            label: 'menu.view'|trans([], 'messages')|capitalize,
                            link:{
                                route: 'service_maintenance_contracts_show',
                                params: {'id':'@id'},
                                content: '<span class="btn btn-primary btn-sm"><i class="far fa-eye fa-fw"></i></span>',
                            },
                            sortable: false,
                            class : 'text-end'
                        },
                    },
                    title: 'service.maintenance_contract.title'|trans,
                    data: contracts
                }
            }, with_context = false) }}
        </div>
    </div>
{% endblock %}

