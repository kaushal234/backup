{% trans_default_domain 'customer_service_record' %}

{% if customerServiceRecord.openIntervention is defined and customerServiceRecord.openIntervention %}
    {% embed 'helper/_ibox.html.twig' %}
        {% block card_header_title %}
            <h5>{{ 'intervention.title.intervention' | trans({}, 'customer_service_record') }}</h5>
        {% endblock %}
        {% block card_content %}
            <twig:InterventionFormComponent :customerServiceRecord="customerServiceRecord" />
        {% endblock card_content %}
    {% endembed %}
{% endif %}

{% if closedForm is defined and closedForm is not empty and is_granted('FEATURE_CUSTOMER_SERVICE_RECORD_FINANCIAL_STEP')%}
    {% embed 'helper/_ibox.html.twig' %}
        {% block card_header_title %}
            <h5>{{ 'csr.title.customer_service_record' | trans({}, 'customer_service_record') }}</h5>
        {% endblock %}
        {% block card_content %}
            {% form_theme closedForm with ['form_theme_vertical.html.twig', _self] %}
            {{ form_start(closedForm) }}
            {{ form_errors(closedForm) }}
            <div class="d-flex justify-content-end {#gap-5 gap-xxl-0#} justify-content-xxl-between">
                <div>
                    <a class="btn btn-warning" href="/en/private/sales_service/service.php?m[0]=csr&m[1]=view&m[2]=costs&id={{ customerServiceRecord.legacyId }}">
                        {{ 'csr.button.add_cost'|trans({}, 'customer_service_record') }}
                    </a>
                </div>
                {{ form_row(closedForm) }}
            </div>
            {{ form_end(closedForm) }}
        {% endblock card_content %}
    {% endembed %}
{% endif %}