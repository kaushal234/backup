<div class="card px-3 border-0">
    <div class="border csr-card-planner
    {% if customerServiceRecord.status is same as 'IN-PROGRESS' %} bl-info {% endif %}
    {% if customerServiceRecord.status is same as 'COMPLETED' %} bl-success {% endif %}
    {% if customerServiceRecord.toContinue or customerServiceRecord.close %} bl-warning {% endif %}
    "
         {% if customerServiceRecord.status is same as 'COMPLETED' %}style="color: lightgrey;"{% endif %}
         data-iri="{{ customerServiceRecord['@id'] }}" data-id="{{ customerServiceRecord['id'] }}">
        <div class="card-body d-flex flex-column px-2">
            <div class="d-flex align-items-center justify-content-between">
                <h4>
                    <a style="color: inherit"
                       href="{{ path('customer_service_record_show', {'id': customerServiceRecord.id}) }}">
                        CSR#{{ customerServiceRecord.id }}  {{ customerServiceRecord.type|upper }}
                    </a>
                </h4>
                {% if customerServiceRecord.openIntervention is not null and customerServiceRecord.openIntervention.plannedBy is not null %}
                    <h5 class="pt-1">{{ customerServiceRecord.openIntervention.plannedBy.firstname }} {{ customerServiceRecord.openIntervention.plannedBy.lastname }}</h5>
                {% endif %}
            </div>
            <span class="font-bold">
            {{ customerServiceRecord.equipmentRecord.serialNumber }} - {{ customerServiceRecord.equipmentRecord.model }}
        </span>
            <div class="d-flex align-items-center justify-content-between">
                {% if customerServiceRecord.airport is defined and customerServiceRecord.airport is not empty %}
                    <h6 class="pt-1">{{ customerServiceRecord.airport.code }} {{ customerServiceRecord.airport.name }}</h6>
                {% endif %}
            </div>
            <p>{{ customerServiceRecord.title }}</p>
        </div>
    </div>
</div>