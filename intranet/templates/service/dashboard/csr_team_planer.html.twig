{% trans_default_domain 'customer_service_record' %}
{% set today = 'now'|date %}

{% block content %}
    <script src="/shared/javascript/hinclude/hinclude.min.js"></script>
    <h2>
        {{ 'csr.title.csr_team_dashboard' | trans }}
        <i class="fa fa-info-circle" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ 'csr.tooltips.csr_team_dashboard'|trans}}"></i>
    </h2>
    <div class="row">
        <div class="col">
            {{ include('@AlvestTwigHelper/tabs_layout.html.twig', {
                tabsData: {
                    tabs: {
                        currentWeek: {
                            defaultTab: true,
                            label: 'planner.title.current_week'|trans({
                                '%from%': today|date_modify('monday this week')|date('d/m'),
                                '%to%': today|date_modify('sunday this week')|date('d/m'),
                                '%week%':  today|date('W'),
                            }, 'customer_service_record'),
                            template: 'service/customer_service_record/partial_tabs/csm.html.twig',
                            templateParams : {week: 'currentWeek', teamMembers: teamMembers}
                        },
                        nextWeek: {
                            label: 'planner.title.other_week'|trans({
                                '%from%': today|date_modify('monday next week')|date('d/m'),
                                '%to%': today|date_modify('sunday next week')|date('d/m'),
                                '%week%':  today|date_modify('next week')|date('W'),
                            }, 'customer_service_record'),
                            template: 'service/customer_service_record/partial_tabs/csm.html.twig',
                            templateParams : {week: 'nextWeek', teamMembers: teamMembers}
                        },
                        secondWeek: {
                            label: 'planner.title.other_week'|trans({
                                '%from%': today|date_modify('monday this week +2 weeks')|date('d/m'),
                                '%to%': today|date_modify('sunday this week +2 weeks')|date('d/m'),
                                '%week%':  today|date_modify('+2 week')|date('W'),
                            }, 'customer_service_record'),
                            template: 'service/customer_service_record/partial_tabs/csm.html.twig',
                            templateParams : {week: 'secondWeek', teamMembers: teamMembers}
                        },
                        thirdWeek: {
                            label: 'planner.title.other_week'|trans({
                                '%from%': today|date_modify('monday this week +3 weeks')|date('d/m'),
                                '%to%': today|date_modify('sunday this week +3 weeks')|date('d/m'),
                                '%week%':  today|date_modify('+3 week')|date('W'),
                            }, 'customer_service_record'),
                            template: 'service/customer_service_record/partial_tabs/csm.html.twig',
                            templateParams : {week: 'thirdWeek', teamMembers: teamMembers}
                        },
                        fourthWeek: {
                            label: 'planner.title.other_week'|trans({
                                '%from%': today|date_modify('monday this week +4 weeks')|date('d/m'),
                                '%to%': today|date_modify('sunday this week +4 weeks')|date('d/m'),
                                '%week%':  today|date_modify('+4 week')|date('W'),
                            }, 'customer_service_record'),
                            template: 'service/customer_service_record/partial_tabs/csm.html.twig',
                            templateParams : {week: 'fourthWeek', teamMembers: teamMembers}
                        },
                        afterFourWeeks: {
                            label: 'planner.title.forecast'|trans({}, 'customer_service_record'),
                            template: 'service/customer_service_record/partial_tabs/csm.html.twig',
                            templateParams : {week: 'afterFourWeeks', teamMembers: teamMembers}
                        },
                    },
                    link: app.request.query.get('tab'),
                    data: customerServiceRecordByTechByWeek,
                }
            }, with_context = false) }}
        </div>
    </div>
{% endblock %}
