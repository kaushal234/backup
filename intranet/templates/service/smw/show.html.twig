{% extends 'layout.html.twig' %}
{% form_theme form 'form_theme_horizontal.html.twig' %}

{% trans_default_domain 'service_smw' %}

{% block title %} {{ 'service_smw.title.index' |trans }} {% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-8">
            <h3 class="text-capitalize">{{ 'service_smw.title.index'|trans }}</h3>
            <div class="row">
                <div class="col-md-6">
                    {{ form_start(form, { action: path('smw_meeting', {module: 'service'}) }) }}
                    <div class="row">
                        <div class="col-sm-10">
                            {{ form_widget(form) }}
                        </div>
                        <div class="col-sm-2">
                            <input type="submit" name="submit" class="btn btn-primary" value="{{ 'button.submit'|trans([], 'messages')|capitalize }}"/>
                        </div>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="ibox float-e-margins col-md-8">
            <div class="ibox-title">
                <h5>{{ 'service_smw.title.links'| trans }}</h5>
                <div class="ibox-tools">
                    <a class="collapse-link">
                        <i class="fa fa-chevron-up"></i>
                    </a>
                </div>
            </div>
            <div class="ibox-content">
                <div class="">
                    <table class="footable table table-hover toggle-arrow-tiny report-table table-responsive" data-page-size=20>
                        <thead>
                        <tr>
                            <th>{{ 'service_smw.fields.title'| trans }}</th>
                            <th>{{ 'service_smw.fields.description'| trans }}</th>
                            <th>{{ 'service_smw.fields.link'| trans }}</th>
                        </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>{{ 'service_smw.pages.kpi.title'| trans }}</td>
                                <td>{{ 'service_smw.pages.kpi.description'| trans }}</td>
                                <td>
                                    <a href="{{ path('technician_on_calls_kpi', {
                                        'technician_on_call_kpi_filter': {
                                            'salesServiceOrganisation': location['@id']
                                        }
                                    }) }}">
                                        <span class="btn btn-green btn-sm"><i class="far fa-eye fa-fw"></i></span>
                                    </a>
                                </td>
                            </tr>
                            <tr>
                                <td>{{ 'service_smw.pages.closure_time.title'| trans }}</td>
                                <td>{{ 'service_smw.pages.closure_time.description'| trans }}</td>
                                <td>
                                    <a href="{{ path('technician_on_calls_closure_time') }}">
                                        <span class="btn btn-green btn-sm"><i class="far fa-eye fa-fw"></i></span>
                                    </a>
                                </td>
                            </tr>
                            <tr>
                                <td>{{ 'service_smw.pages.backlog.title'| trans }}</td>
                                <td>{{ 'service_smw.pages.backlog.description'| trans }}</td>
                                <td>
                                    <a href="{{ path('technician_on_calls_backlog', {
                                        'technician_on_call_kpi_filter': {
                                            'salesServiceOrganisation': location['@id']
                                        }
                                    }) }}">
                                        <span class="btn btn-green btn-sm"><i class="far fa-eye fa-fw"></i></span>
                                    </a>
                                </td>
                            </tr>
                            <tr>
                                <td>{{ 'service_smw.pages.remote.title'| trans }}</td>
                                <td>{{ 'service_smw.pages.remote.description'| trans }}</td>
                                <td>
                                    <a href="{{ path('technician_on_calls_remote', {
                                        'technician_on_call_kpi_filter': {
                                            'salesServiceOrganisation': location['@id']
                                        }
                                    }) }}">
                                        <span class="btn btn-green btn-sm"><i class="far fa-eye fa-fw"></i></span>
                                    </a>
                                </td>
                            </tr>
                            <tr>
                                <td>{{ 'service_smw.pages.spare_part_request.title'| trans }}</td>
                                <td>{{ 'service_smw.pages.spare_part_request.description'| trans }}</td>
                                <td>
                                    <a href="{{ path('technician_on_calls_spare_part_request', {
                                        'technician_on_call_kpi_filter': {
                                            'salesServiceOrganisation': location['@id']
                                        }
                                    }) }}">
                                        <span class="btn btn-green btn-sm"><i class="far fa-eye fa-fw"></i></span>
                                    </a>
                                </td>
                            </tr>
                            <tr>
                                <td>{{ 'service_smw.pages.factory_flag.title'| trans }}</td>
                                <td>{{ 'service_smw.pages.factory_flag.description'| trans }}</td>
                                <td>
                                    <a href="{{ path('technician_on_calls_factory_flag', {
                                        'technician_on_call_kpi_filter': {
                                            'salesServiceOrganisation': location['@id']
                                        }
                                    }) }}">
                                        <span class="btn btn-green btn-sm"><i class="far fa-eye fa-fw"></i></span>
                                    </a>
                                </td>
                            </tr>
                            <tr>
                                <td>{{ 'service_smw.pages.service_bulletin.title'| trans }}</td>
                                <td>{{ 'service_smw.pages.service_bulletin.description'| trans }}</td>
                                <td>
                                    <a href="{{ path('legacy_product_support', {m: ['sb'] }) }}">
                                        <span class="btn btn-green btn-sm"><i class="far fa-eye fa-fw"></i></span>
                                    </a>
                                </td>
                            </tr>
                            <tr>
                                <td>{{ 'service_smw.pages.if1000.title'| trans }}</td>
                                <td>{{ 'service_smw.pages.if1000.description'| trans }}</td>
                                <td>
                                    <a href="{{ datatable_link('technician_on_call_search', 'technician_on_call', {
                                        'salesOrganisationService': [location['@id']],
                                        'indiceFactor': ['IF 1000'],
                                        'status': ['PENDING', 'IN_PROGRESS', 'SUSPENDED']
                                    }) }}">
                                        <span class="btn btn-green btn-sm"><i class="far fa-eye fa-fw"></i></span>
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
