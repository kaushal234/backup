{% extends 'service/service_area/layout.html.twig' %}
{% form_theme form 'form_theme_vertical.html.twig' %}

{% block content %}
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'service_area.title.edit'|trans({}, 'service') }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {{ form_start(form) }}
                    <div class="row">
                        <div class="col-6">
                            {{ form_row(form.name) }}
                        </div>
                        <div class="col-6">
                            {{ form_row(form.representative) }}
                        </div>
                    </div>
                    {{ component('AirportSelector', {
                        selectedAirports: selectedAirports,
                        initialCountries: initialCountries
                    }) }}
                    {{ form_row(form.submit) }}
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}