{% extends 'service/technician_on_call/layout.html.twig' %}
{% trans_default_domain 'technician_on_call' %}

{% macro modalMainFileDropZone(technicianOnCall, elementDataSet) %}
    <div class="modal fade" id="main-file-drop-zone" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h4>{{ (technicianOnCall.mainFile is empty ? 'toc.files.add_main_file' : 'toc.files.change_main_file')|trans }}</h4>
                    <button type="button" class="btn-close pull-right" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="toc-files-dropZone" data-main-file="true" data-data="{{ elementDataSet | json_encode }}"></div>
                </div>
            </div>
        </div>
    </div>
{% endmacro %}

{% macro modal(index, path) %}
    <div class="modal fade" id="modal-files-{{ index }}" tabindex="-1" aria-labelledby="modal-files-{{ index }}Label"
         aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="btn-close pull-right" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <img class="w-100" src="{{ path }}" alt="">
                </div>
            </div>
        </div>
    </div>
{% endmacro %}

{% macro imageCard(technicianOnCall, elementDataSet = {}, index, file, col = 3) %}
    {% set path = asset(upload_uri ~ '/' ~ file.filePath) %}
    <div class="{{ "col-" ~ col ~ " mb-4" }}">
        <div class="card w-100 h-100 rounded-0 p-0">
            <div class="d-inline-flex justify-content-center h-100 position-relative">
                {% if file.public is true %}
                    <div class="badge badge-info h-auto px-2 position-absolute bottom-0 end-0 m-2"
                         title="{{ 'toc.messages.help.file_visible'|trans }}">
                        <i class="fa fa-eye"></i>
                    </div>
                {% endif %}
                {% if file|is_viewable %}
                    <button type="button" class="border-0 p-0 mh-100" data-bs-toggle="modal"
                            data-bs-target="#modal-files-{{ index }}">
                        <img height="300px" class="card-img-top rounded-0 object-fit-contain" src="{{ path }}"
                             alt="">
                    </button>
                    {{ _self.modal(index, path) }}
                {% else %}
                    <a class="h-100 w-50 d-inline-flex align-items-center"
                       href="{{ path('technician_on_call_file_download', {technicianOnCallId: technicianOnCall.id, id: file.id}) }}">
                        {{ file|fa_icon_class }}
                    </a>
                {% endif %}
            </div>
            <div class="d-flex align-items-end m-2">
                <div class="col-12">
                    {% if index == 0 %}
                        <div class="d-flex justify-content-between">
                            <h3>
                                Main file
                            </h3>
                            {{ _self.modalMainFileDropZone(technicianOnCall, elementDataSet) }}
                        </div>
                    {% endif %}
                    {% if file.description is not empty %}
                        <div>
                            {{ file.description|u.truncate(100, ' ...') }}
                        </div>
                    {% endif %}
                    <div class="row mt-2">
                        <div class="col text-secondary">
                            <i>{{ file|file_name }}</i>
                        </div>
                        <div class="d-flex col-auto text-end align-self-end">
                            <a class="mx-1" href="{{ path(index == 0 ? 'technician_on_call_main_file_download' : 'technician_on_call_file_download', {technicianOnCallId: technicianOnCall.id, id: file.id}) }}">
                                <i class="card-img mx-auto fa-solid fa-file-arrow-down fa-2x"></i>
                            </a>
                            {% if index == 0 %}
                                <div class="badge badge-warning h-auto px-2 align-content-center" type="button" data-bs-toggle="modal" data-bs-target="#main-file-drop-zone">
                                    <i class="fa fa-fa fa-pencil-alt"></i>
                                </div>
                            {% else %}
                                <a
                                    class="mx-1"
                                    href="{{ path('technician_on_call_file_delete', {technicianOnCallId: technicianOnCall.id, id: file.id}) }}"
                                    title="delete"
                                >
                                    <i class="card-img mx-auto fa-solid fa-cross fa-file-circle-minus fa-2x text-danger"></i>
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endmacro %}

{% block content %}
    {% set elementDataSet = {
        id: technicianOnCall.id
    } %}
    <div class="row mt-5">
        {% if technicianOnCall.mainFile is empty and technicianOnCall.files is empty %}
            <div class="alert alert-danger text-center" role="alert">
                {{ 'toc.messages.errors.no_files'|trans }}
            </div>
        {% endif %}

        <twig:TechnicianOnCall:CustomerServiceRecordFilesAlert :technicianOnCall="technicianOnCall" />

        <div class="col-9">
            <div class="row" style="min-height: 300px">
                <twig:TechnicianOnCall:MainFileCard
                        :technicianOnCall="technicianOnCall"
                        :elementDataSet="elementDataSet"
                />

                {% for file in technicianOnCall.files %}
                    <twig:TechnicianOnCall:TechnicianOnCallFileCard
                            :technicianOnCall="technicianOnCall"
                            :file="file"
                            :index="loop.index"
                    />
                {% endfor %}
            </div>
        </div>

        <div class="col-3 mb-5">
            <twig:Gallery:FileDropZoneCard :elementDataSet="elementDataSet" title="{{ 'toc.files.add_files'|trans }}" upppyClass="toc-files-dropZone"/>
        </div>

        <div class="col-9">
            <div class="row" style="min-height: 300px">
                <h2>{{ 'toc.title.csr_files'|trans }}</h2>
                {% for customerServiceRecord in technicianOnCall.customerServiceRecords %}
                    {% for file in customerServiceRecord.files %}
                        <twig:TechnicianOnCall:CustomerServiceRecordFileCard
                                :customerServiceRecord="customerServiceRecord"
                                :file="file"
                                :index="loop.index"
                        />
                    {% endfor %}
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}

{% block translations %}
    <script src="{{ url('bazinga_jstranslation_js', { 'domain': 'technician_on_call' }) }}"></script>
{% endblock %}