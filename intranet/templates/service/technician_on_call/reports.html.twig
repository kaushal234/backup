{% extends 'service/technician_on_call/layout.html.twig' %}
{% trans_default_domain 'technician_on_call' %}

{% block content %}
    <div class="row">
        <div class="col-6">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'toc.report.by_indice_factor' | trans }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {{ include('helper/_matrix_table.html.twig', {
                        data: reportByIndiceFactor,
                        link: {
                            route: 'technician_on_call_search',
                            xParam: 'filter_technician_on_call[salesOrganisationService][value][]',
                            yParam: 'filter_technician_on_call[indiceFactor][value][]',
                            additionalParams: datatable_params('technician_on_call', {
                                'status': ['PENDING', 'IN_PROGRESS', 'SUSPENDED']
                            }),
                        },
                    }, with_context=false) }}
                </div>
            </div>
        </div>
        <div class="col-6">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'toc.report.by_status' | trans }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {{ include('helper/_matrix_table.html.twig', {
                        data: reportByStatus,
                        link: {
                            route: 'technician_on_call_search',
                            xParam: 'filter_technician_on_call[salesOrganisationService][value][]',
                            yParam: 'filter_technician_on_call[status][value][]',
                        },
                    }, with_context=false) }}
                </div>
            </div>
        </div>
        <div class="col-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'toc.report.by_factory' | trans }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {{ include('helper/_matrix_table.html.twig', {
                        data: reportByFactory,
                        link: {
                            route: 'technician_on_call_search',
                            xParam: 'filter_technician_on_call[factory][value][]',
                            yParam: 'filter_technician_on_call[salesOrganisationService][value][]',
                            additionalParams: datatable_params('technician_on_call', {
                                'status': ['PENDING', 'IN_PROGRESS', 'SUSPENDED'],
                                'factoryFlag': 1
                            }),
                        },
                    }, with_context=false) }}
                </div>
            </div>
        </div>
        <div class="col-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ 'toc.report.survey.title' | trans }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    {{ include('helper/_matrix_table.html.twig', {
                        data: reportSurvey,
                        link: {
                            route: 'technician_on_call_search',
                            xParam: 'filter_technician_on_call[salesOrganisationService][value][]',
                            yParam: '',
                            additionalParams: datatable_params('technician_on_call', {
                                'surveyAnswerThisMonth': 1,
                                'solvedAt': {
                                    'from': "first day of this months"|date("m/d/Y"),
                                    'to': "first day of next months"|date("m/d/Y"),
                                },
                            }),
                        },
                        hideTotals: 'both',
                        sort: false,
                    }, with_context=false) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}