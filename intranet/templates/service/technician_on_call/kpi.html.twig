{% extends 'service/technician_on_call/layout.html.twig' %}
{% trans_default_domain 'technician_on_call' %}
{% form_theme filterForm 'form_theme_vertical.html.twig' %}

{% block content %}
    {{ form_start(filterForm) }}
    <div class="row mb-3">
        <div class="col-2">
            {{ form_row(filterForm.salesServiceOrganisation) }}
        </div>
        <div class="col-4">
            {{ form_row(filterForm.customers) }}
        </div>
        <div class="col-2">
            {{ form_row(filterForm.from) }}
        </div>
        <div class="col-2">
            {{ form_row(filterForm.to) }}
        </div>
        <div class="col-2 d-flex align-items-center">
            <button class="btn btn-primary">
                {{ 'button.filter'|trans({}, 'messages')|upper }}
            </button>
        </div>
    </div>
    {{ form_end(filterForm) }}
    <div class="row">
        <div class="col-md-12">
            {% if chartCreatedAndSoledByMonth is defined %}
                <div data-options="{{ chartCreatedAndSoledByMonth | json_encode }}" class="ibox float-e-margins highcharts" style="min-width: 400px; height: 500px;"></div>
            {% endif %}
        </div>
        <div class="col-md-12">
            {% if chartImmediateRatio is defined %}
                <div data-options="{{ chartImmediateRatio | json_encode }}" class="ibox float-e-margins highcharts" style="min-width: 400px; height: 500px;"></div>
            {% endif %}
        </div>
        <div class="col-md-12">
            {% if chartAverageTime is defined %}
                <div data-options="{{ chartAverageTime | json_encode }}" class="ibox float-e-margins highcharts" style="min-width: 400px; height: 500px;"></div>
            {% endif %}
        </div>
        <div class="col-md-12">
            {% if chartOldestBuilder is defined %}
                <div
                    id="toc-oldest-chart"
                    data-options="{{ chartOldestBuilder | json_encode }}"
                    class="ibox float-e-margins"
                    style="min-width: 400px; height: 500px;"
                >
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const el = document.getElementById('toc-oldest-chart');
        if (!el) {
          return;
        }

        const options = JSON.parse(el.dataset.options || '{}');

        options.plotOptions = options.plotOptions || {};
        options.plotOptions.series = options.plotOptions.series || {};
        options.plotOptions.series.cursor = 'pointer';

        options.tooltip = options.tooltip || {};
        options.tooltip.formatter = function () {
          const id = this.point && this.point.options ? this.point.options.id : null;
          return '<b>' + this.series.name + ' : ' + this.y + '</b>' + (id ? '<br>#' + id : '');
        };

        const chart = Highcharts.chart('toc-oldest-chart', options);

        chart.series.forEach((serie) => {
          serie.points.forEach((point) => {
            const url = point.options.url;
            if (!url) {
              return;
            }

            Highcharts.addEvent(point, 'click', function () {
              window.location.href = url;
            });
          });
        });
      });
    </script>
{% endblock %}