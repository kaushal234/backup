{% extends 'human_resources/job/layout.html.twig' %}
{% trans_default_domain 'job' %}

{% block content %}
    <div class="row">
        <div class="col-md-12 animated fadeInLeft">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>{{ job.title }}</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    <div class="row">
                        <div class="col-md-6">
                            {{ include('helper/_association_table_raw.html.twig', {
                                associationData: {
                                    items: {
                                        businessUnit: {
                                            properties: ['businessUnit.name'],
                                            label: 'directory.business_unit.name'|trans({}, 'directory')|capitalize,
                                            link: {
                                                route: 'directory_business_units_show',
                                                params: {id:'businessUnit.@id'}
                                            }
                                        },
                                        createdAt: {
                                            label: 'fields.created_at'|trans({}, 'messages')|capitalize,
                                            filters: 'date("Y-m-d H:i:s")'
                                        },
                                        createdBy: {
                                            label: 'fields.poster'|trans({}, 'messages')|capitalize,
                                            properties: ['createdBy.lastname', 'createdBy.firstname'],
                                            link: {
                                                route: 'directory_people_show',
                                                params: {id:'createdBy.@id'}
                                            }
                                        },
                                        enabled: {
                                            label: 'jobs.fields.open'|trans({}, 'job')|capitalize,
                                            boolean: {
                                                true: '<span class="d-none">1</span><i class="fa fa-check text-info"></i>',
                                                false: '<span class="d-none">0</span><i class="fa fa-times text-danger"></i>'
                                            }
                                        },
                                        synchronized: {
                                            label: 'jobs.fields.synchronized'|trans|capitalize,
                                            boolean: {
                                                true: '<span class="d-none">1</span><i class="fa fa-check text-info"></i>',
                                                false: '<span class="d-none">0</span><i class="fa fa-times text-danger"></i>'
                                            }
                                        }
                                    },
                                    data: job},
                            }, with_context = false) }}
                        </div>
                        <div class="col-md-6">
                            <h3><strong><i class="fa fa-certificate"></i>&nbsp;{{ 'jobs.fields.diploma'|trans }}</strong>:</h3><p>{{ job.diploma }}</p>
                            <h3><strong><i class="fa fa-calendar"></i>&nbsp;{{ 'jobs.fields.experience'|trans }}</strong>:</h3><p>{{ job.experience }}</p>
                            <h3><strong><i class="fa fa-cogs"></i>&nbsp;{{ 'jobs.fields.description'|trans }}</strong>:</h3><p>{{ job.description | nl2br }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
