{% extends 'human_resources/employee_staffing/layout.html.twig' %}
{% trans_default_domain 'employee_staffing' %}

{% macro coloredText(value) %}
    {% if value != 0 %}{{ value > 0 ? 'text-red' : 'text-black' }}{% endif %}
{% endmacro %}

{% block bodyClass %}mini-navbar{% endblock %}

{% set directCounts = {direct: 0, indirect: 0} %}
{% set categoryTypeCounts = {} %}
{% set totals = {
    correction: 0,
    correctedTotal: 0,
    budget: 0,
    reforecast: 0,
    previousYearCorrectedTotal: 0,
    versusPreviousYear: 0,
    versusBudget: 0,
    versusReforecast: 0,
} %}
{% set indirectTotals = {
    correction: 0,
    correctedTotal: 0,
    budget: 0,
    reforecast: 0,
    previousYearCorrectedTotal: 0,
    versusPreviousYear: 0,
    versusBudget: 0,
    versusReforecast: 0,
} %}
{% set directTotals = {
    correction: 0,
    correctedTotal: 0,
    budget: 0,
    reforecast: 0,
    previousYearCorrectedTotal: 0,
    versusPreviousYear: 0,
    versusBudget: 0,
    versusReforecast: 0,
} %}

{% for category in positionCategories %}
    {% set direct = category.directHeadcount is same as(true) %}
    {% set countKey = direct ? 'direct' : 'indirect' %}
    {% set directCounts = directCounts|merge({(countKey): directCounts[countKey] + 1 }) %}
    {% set categoryKey = category.positionCategoryType.name ~ countKey %}

    {% set categoryTypeCounts = categoryTypeCounts|merge({
        (categoryKey): (categoryTypeCounts[categoryKey]|default(0)) + 1
    }) %}
{% endfor %}

{% set showLogs = report.metadata.scope|default('') == 'BusinessUnit' %}

{% block content %}
    <div class="row">
        <div class="ibox float-e-margins">
            <div class="ibox-title">
                <h5>{{ 'employee_staffing.title_rrr'|trans }}</h5>
            </div>
            <div class="ibox-content">
                <div class="row">
                    <div class="col-md-6">
                        {{ form_start(filterForm) }}
                        <div class="row">
                            <div class="col-md-4">
                                {{ form_widget(filterForm.entity) }}
                            </div>
                            <div class="col-md-4">
                                {{ form_widget(filterForm.snapshot) }}
                                {{ form_widget(filterForm.categorized) }}
                                {{ form_widget(filterForm.contractType) }}
                                {{ form_widget(filterForm.positionCategory) }}
                            </div>
                            <div class="col-md-2">
                                {{ form_widget(filterForm.submit) }}
                            </div>
                            {% if is_granted('FEATURE_EMPLOYEE_STAFFING_REPORT') %}
                                <div class="col-md-2">
                                    {{ form_widget(filterForm.submitRegionalResultsReview) }}
                                </div>
                            {% endif %}
                        </div>
                        {{ form_end(filterForm) }}
                    </div>
                </div>
                <hr>

                {% if report.metadata.scope|default('') is not same as ('BusinessUnit') %}
                    <p><strong>{{ 'employee_staffing.business_units_list'|trans }}:</strong>
                        {% for businessUnit in report.metadata.businessUnits|sort((a, b) => a.name <=> b.name) %}
                            {{ businessUnit.name }}{% if not loop.last %},{% endif %}
                        {% endfor %}
                    </p>
                    <hr>
                {% endif %}

                <div class=" table-rotated-headers">
                    <table class="table matrix-table matrix-table-no-hover tooltip-container table-responsive">
                        <thead>
                        <tr>
                            <th colspan="3"></th>
                            <th class="top-label">
                                <div><span>{{ 'employee_staffing.headers.total'|trans }}</span></div>
                            </th>
                            <th class="top-label text-grey">
                                <div><span>{{ 'employee_staffing.headers.correction'|trans }}</span></div>
                            </th>
                            <th class="top-label text-grey not-rotated" style="min-width: 30vw">
                                <div><span>{{ 'employee_staffing.headers.comment'|trans }}</span></div>
                            </th>
                            <th class="top-label">
                                <div><span>{{ 'employee_staffing.headers.total_corrected'|trans }}</span></div>
                            </th>
                            <th class="top-label text-grey">
                                <div><span>{{ 'employee_staffing.headers.y-1'|trans }}</span></div>
                            </th>
                            <th class="top-label text-grey">
                                <div><span>{{ 'employee_staffing.headers.budget_y'|trans }}</span></div>
                            </th>
                            <th class="top-label text-grey">
                                <div><span>{{ 'employee_staffing.headers.reforecast_y'|trans }}</span></div>
                            </th>
                            <th class="top-label text-grey">
                                <div><span>{{ 'employee_staffing.headers.versus_y-1'|trans }}</span></div>
                            </th>
                            <th class="top-label text-grey">
                                <div><span>{{ 'employee_staffing.headers.versus_budget'|trans }}</span></div>
                            </th>
                            <th class="top-label text-grey">
                                <div><span>{{ 'employee_staffing.headers.versus_reforecast'|trans }}</span></div>
                            </th>
                            {% if showLogs is same as(true) %}
                                <th></th>
                            {% endif %}
                        </tr>
                        </thead>
                        <tbody>
                        {% for category in positionCategories %}
                            {% set direct = category.directHeadcount is same as(true) %}
                            {% set countKey = direct ? 'direct' : 'indirect' %}
                            {% set categoryKey = category.positionCategoryType.name ~ countKey %}
                            {% if countKey == 'indirect' %}
                            <tr>
                                {% if directCounts[countKey] is not same as(false) %}
                                    <th class="vertical" rowspan="{{ directCounts[countKey] }}">
                                        <div>{{ countKey }}</div>
                                    </th>
                                    {% set directCounts = directCounts|merge({(countKey): false }) %}
                                {% endif %}

                                {% if categoryTypeCounts[categoryKey] is not same as(false) %}
                                    <th rowspan="{{ categoryTypeCounts[categoryKey] }}" style="width: 150px">
                                        <div>{{ category.positionCategoryType.name }}</div>
                                    </th>
                                    {% set categoryTypeCounts = categoryTypeCounts|merge({(categoryKey): false }) %}
                                {% endif %}

                                <th>{{ category.name }}</th>

                                <td class="total">
                                    {% if (report.xTotals[category.name]|default(0)) > 0 %}
                                            {{ report.xTotals[category.name]|number_format(1, '.', ' ') }}
                                    {% else %}
                                        {{ report.xTotals[category.name]|default(0)|number_format(1, '.', ' ') }}
                                    {% endif %}
                                </td>

                                {% set totals = totals|merge({correction: totals.correction + report.metadata.classifications[category.name].correction|default(0)}) %}
                                {% set indirectTotals = indirectTotals|merge({correction: indirectTotals.correction + report.metadata.classifications[category.name].correction|default(0)}) %}
                                <td class="text-end matrix-input" style="width: 35px">
                                        {{ report.metadata.classifications[category.name].correction|default(0)|number_format(1, '.', ' ') }}
                                </td>

                                {% set comments = report.metadata.classifications[category.name].comments|default([]) %}
                                {% set commentsCount = comments|length %}
                                <td class="text-start matrix-input"
                                        {% if commentsCount > 1 %}
                                            {% set tooltipContent = '' %}
                                            {% for comment in comments %}
                                                {% set tooltipContent = tooltipContent ~ comment ~ '<br>' %}
                                            {% endfor %}
                                            data-toggle="tooltip" data-placement="start" data-html="true" title="{{ tooltipContent }}"
                                        {% endif %}
                                >
                                    {% if commentsCount > 0 %}
                                        <small>
                                            {{ comments[0] }}
                                            {% if commentsCount > 1 %}
                                                <span class="badge bg-primary float-end">+{{ commentsCount - 1 }}</span>
                                            {% endif %}
                                        </small>
                                    {% endif %}
                                        {{ report.metadata.classifications[category.name].comment|default('') }}
                                </td>

                                {% set correctedTotal = (report.xTotals[category.name]|default(0)) + (report.metadata.classifications[category.name].correction|default(0)) %}
                                {% set totals = totals|merge({correctedTotal: totals.correctedTotal + correctedTotal}) %}
                                {% set indirectTotals = indirectTotals|merge({correctedTotal: indirectTotals.correctedTotal + correctedTotal}) %}
                                <td class="text-end total">{{ correctedTotal|number_format(1, '.', ' ') }}</td>

                                {% set totals = totals|merge({previousYearCorrectedTotal: totals.previousYearCorrectedTotal + report.metadata.classifications[category.name].previousYearCorrectedTotal|default(0)}) %}
                                {% set indirectTotals = indirectTotals|merge({previousYearCorrectedTotal: indirectTotals.previousYearCorrectedTotal + report.metadata.classifications[category.name].previousYearCorrectedTotal|default(0)}) %}
                                <td class="text-end primary">{{ report.metadata.classifications[category.name].previousYearCorrectedTotal|default(0)|number_format(1, '.', ' ') }}</td>

                                {% set totals = totals|merge({budget: totals.budget + report.metadata.classifications[category.name].budget|default(0)}) %}
                                {% set indirectTotals = indirectTotals|merge({budget: indirectTotals.budget + report.metadata.classifications[category.name].budget|default(0)}) %}
                                <td class="text-end table-success matrix-input" style="width: 40px">
                                        {{ report.metadata.classifications[category.name].budget|default(0)|number_format(1, '.', ' ') }}
                                </td>

                                {% set totals = totals|merge({reforecast: totals.reforecast + report.metadata.classifications[category.name].reforecast|default(0)|number_format(1, '.', ' ')}) %}
                                {% set indirectTotals = indirectTotals|merge({reforecast: indirectTotals.reforecast + report.metadata.classifications[category.name].reforecast|default(0)|number_format(1, '.', ' ')}) %}
                                <td class="text-end table-success matrix-input" style="width: 40px">
                                        {{ report.metadata.classifications[category.name].reforecast|default(0)|number_format(1, '.', ' ') }}
                                </td>

                                {% set versusPreviousYear = (report.xTotals[category.name]|default(0)) + (report.metadata.classifications[category.name].correction|default(0)) - (report.metadata.classifications[category.name].previousYearCorrectedTotal|default(0)) %}
                                {% set totals = totals|merge({versusPreviousYear: totals.versusPreviousYear + versusPreviousYear}) %}
                                {% set indirectTotals = indirectTotals|merge({versusPreviousYear: indirectTotals.versusPreviousYear + versusPreviousYear}) %}
                                <td class="text-end {{ _self.coloredText(versusPreviousYear) }}">{{ versusPreviousYear|number_format(1, '.', ' ') }}</td>

                                {% set versusBudget = (report.xTotals[category.name]|default(0)) + (report.metadata.classifications[category.name].correction|default(0)) - (report.metadata.classifications[category.name].budget|default(0)) %}
                                {% set totals = totals|merge({versusBudget: totals.versusBudget + versusBudget}) %}
                                {% set indirectTotals = indirectTotals|merge({versusBudget: indirectTotals.versusBudget + versusBudget}) %}
                                <td class="text-end {{ _self.coloredText(versusBudget) }}">{{ versusBudget|number_format(1, '.', ' ') }}</td>

                                {% set versusReforecast = (report.xTotals[category.name]|default(0)) + (report.metadata.classifications[category.name].correction|default(0)) - (report.metadata.classifications[category.name].reforecast|default(0)) %}
                                {% set totals = totals|merge({versusReforecast: totals.versusReforecast + versusReforecast}) %}
                                {% set indirectTotals = indirectTotals|merge({versusReforecast: indirectTotals.versusReforecast + versusReforecast}) %}
                                <td class="text-end {{ _self.coloredText(versusReforecast) }}">{{ versusReforecast|number_format(1, '.', ' ') }}</td>

                                {% if showLogs is same as(true) %}
                                    {% if report.metadata.classifications[category.name].iris|default([])|length == 1 %}
                                        {{ include('partial/cells/_activity.html.twig', {
                                            item: {'@id': report.metadata.classifications[category.name].iris[0]},
                                            title: category.name,
                                            class: 'text-start',
                                        }) }}
                                    {% else %}
                                        <td></td>
                                    {% endif %}
                                {% endif %}
                            </tr>
                            {% endif %}
                        {% endfor %}

                        {% for directCategoryType in directCategoryTypes %}
                            <tr>
                                {% if loop.first %}
                                <th class="vertical" rowspan="{{ directCategoryTypes | length }}">
                                    <div>Direct</div>
                                </th>
                                {% endif %}

                                <th colspan="2" style="width: 150px">
                                    <div>{{ directCategoryType }}</div>
                                </th>

                                <td class="total">
                                    {{ report.xTotals[directCategoryType]|default(0)|number_format(1, '.', ' ') }}
                                </td>

                                {% set totals = totals|merge({correction: totals.correction + report.metadata.classifications[directCategoryType].correction|default(0)}) %}
                                {% set directTotals = directTotals|merge({correction: directTotals.correction + report.metadata.classifications[directCategoryType].correction|default(0)}) %}
                                <td class="text-end matrix-input" style="width: 35px">
                                        {{ report.metadata.classifications[directCategoryType].correction|default(0)|number_format(1, '.', ' ') }}
                                </td>

                                {% set comments = report.metadata.classifications[directCategoryType].comments|default([]) %}
                                {% set commentsCount = comments|length %}
                                <td class="text-start matrix-input"
                                        {% if commentsCount > 1 %}
                                            {% set tooltipContent = '' %}
                                            {% for comment in comments %}
                                                {% set tooltipContent = tooltipContent ~ comment ~ '<br>' %}
                                            {% endfor %}
                                            data-toggle="tooltip" data-placement="start" data-html="true" title="{{ tooltipContent }}"
                                        {% endif %}
                                >
                                    {% if commentsCount > 0 %}
                                        <small>
                                            {{ comments[0] }}
                                            {% if commentsCount > 1 %}
                                                <span class="badge bg-primary float-end">+{{ commentsCount - 1 }}</span>
                                            {% endif %}
                                        </small>
                                    {% endif %}
                                        {{ report.metadata.classifications[directCategoryType].comment|default('') }}
                                </td>

                                {% set correctedTotal = (report.xTotals[directCategoryType]|default(0)) + (report.metadata.classifications[directCategoryType].correction|default(0)) %}
                                {% set totals = totals|merge({correctedTotal: totals.correctedTotal + correctedTotal}) %}
                                {% set directTotals = directTotals|merge({correctedTotal: directTotals.correctedTotal + correctedTotal}) %}
                                <td class="text-end total">{{ correctedTotal|number_format(1, '.', ' ') }}</td>

                                {% set totals = totals|merge({previousYearCorrectedTotal: totals.previousYearCorrectedTotal + report.metadata.classifications[directCategoryType].previousYearCorrectedTotal|default(0)}) %}
                                {% set directTotals = directTotals|merge({previousYearCorrectedTotal: directTotals.previousYearCorrectedTotal + report.metadata.classifications[directCategoryType].previousYearCorrectedTotal|default(0)}) %}
                                <td class="text-end primary">{{ report.metadata.classifications[directCategoryType].previousYearCorrectedTotal|default(0)|number_format(1, '.', ' ') }}</td>

                                {% set totals = totals|merge({budget: totals.budget + report.metadata.classifications[directCategoryType].budget|default(0)}) %}
                                {% set directTotals = directTotals|merge({budget: directTotals.budget + report.metadata.classifications[directCategoryType].budget|default(0)}) %}
                                <td class="text-end table-success matrix-input" style="width: 40px">
                                        {{ report.metadata.classifications[directCategoryType].budget|default(0)|number_format(1, '.', ' ') }}
                                </td>

                                {% set totals = totals|merge({reforecast: totals.reforecast + report.metadata.classifications[directCategoryType].reforecast|default(0)|number_format(1, '.', ' ')}) %}
                                {% set directTotals = directTotals|merge({reforecast: directTotals.reforecast + report.metadata.classifications[directCategoryType].reforecast|default(0)|number_format(1, '.', ' ')}) %}
                                <td class="text-end table-success matrix-input" style="width: 40px">
                                        {{ report.metadata.classifications[directCategoryType].reforecast|default(0)|number_format(1, '.', ' ') }}
                                </td>

                                {% set versusPreviousYear = (report.xTotals[directCategoryType]|default(0)) + (report.metadata.classifications[directCategoryType].correction|default(0)) - (report.metadata.classifications[directCategoryType].previousYearCorrectedTotal|default(0)) %}
                                {% set totals = totals|merge({versusPreviousYear: totals.versusPreviousYear + versusPreviousYear}) %}
                                {% set directTotals = directTotals|merge({versusPreviousYear: directTotals.versusPreviousYear + versusPreviousYear}) %}
                                <td class="text-end {{ _self.coloredText(versusPreviousYear) }}">{{ versusPreviousYear|number_format(1, '.', ' ') }}</td>

                                {% set versusBudget = (report.xTotals[directCategoryType]|default(0)) + (report.metadata.classifications[directCategoryType].correction|default(0)) - (report.metadata.classifications[directCategoryType].budget|default(0)) %}
                                {% set totals = totals|merge({versusBudget: totals.versusBudget + versusBudget}) %}
                                {% set directTotals = directTotals|merge({versusBudget: directTotals.versusBudget + versusBudget}) %}
                                <td class="text-end {{ _self.coloredText(versusBudget) }}">{{ versusBudget|number_format(1, '.', ' ') }}</td>

                                {% set versusReforecast = (report.xTotals[directCategoryType]|default(0)) + (report.metadata.classifications[directCategoryType].correction|default(0)) - (report.metadata.classifications[directCategoryType].reforecast|default(0)) %}
                                {% set totals = totals|merge({versusReforecast: totals.versusReforecast + versusReforecast}) %}
                                {% set directTotals = directTotals|merge({versusReforecast: directTotals.versusReforecast + versusReforecast}) %}
                                <td class="text-end {{ _self.coloredText(versusReforecast) }}">{{ versusReforecast|number_format(1, '.', ' ') }}</td>

                                {% if showLogs is same as(true) %}
                                    {% if report.metadata.classifications[directCategoryType].iris|default([])|length == 1 %}
                                        {{ include('partial/cells/_activity.html.twig', {
                                            item: {'@id': report.metadata.classifications[directCategoryType].iris[0]},
                                            title: directCategoryType,
                                            class: 'text-start',
                                        }) }}
                                    {% else %}
                                        <td></td>
                                    {% endif %}
                                {% endif %}
                            </tr>
                        {% endfor %}
                        {% if report.metadata.uncategorized|default([]) is not empty %}
                            <tr>
                                <th colspan="2" class="error"></th>
                                <th class="error">{{ 'employee_staffing.headers.uncategorized'|trans }} <i
                                            class="fa fa-fw fa-exclamation"></i></th>
                                {% set total = 0 %}
                                {% set tooltipContent = '' %}
                                {% for businessUnit in report.metadata.uncategorized %}
                                    {% set total = total + businessUnit.count %}
                                    {% set tooltipContent = tooltipContent ~ businessUnit.name ~ ': ' ~ businessUnit.count ~ '<br>' %}
                                {% endfor %}
                                <td colspan="1" class="error" data-toggle="tooltip" data-placement="top"
                                    data-bs-html="true" title="{{ tooltipContent }}">
                                    <b>{{ total }}</b>
                                    <i class="fa fa-fw fa-info-circle"></i>
                                </td>
                                <td></td>
                                <td></td>
                                <td class="total"></td>
                                <td class="primary"></td>
                                <td class="table-success"></td>
                                <td class="table-success"></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                {% if showLogs is same as(true) %}
                                    <td></td>
                                {% endif %}
                            </tr>
                        {% endif %}
                        </tbody>
                        <tfoot>
                        <tr>
                            <th colspan="3" class="th-total">Indirect Totals</th>
                            <td class="total">
                                {{ report.indirectTotal|number_format(1, '.', ' ') }}
                            </td>
                            <td>{{ totals.correction|number_format(1, '.', ' ') }}</td>
                            <td></td>
                            <td class="text-end total">{{ indirectTotals.correctedTotal|number_format(1, '.', ' ') }}</td>
                            <td class="text-end primary">{{ indirectTotals.previousYearCorrectedTotal|number_format(1, '.', ' ') }}</td>
                            <td class="text-end table-success">{{ indirectTotals.budget|number_format(1, '.', ' ') }}</td>
                            <td class="text-end table-success">{{ indirectTotals.reforecast|number_format(1, '.', ' ') }}</td>
                            <td class="text-end">{{ indirectTotals.versusPreviousYear|number_format(1, '.', ' ') }}</td>
                            <td class="text-end">{{ indirectTotals.versusBudget|number_format(1, '.', ' ') }}</td>
                            <td class="text-end">{{ indirectTotals.versusReforecast|number_format(1, '.', ' ') }}</td>
                            {% if showLogs is same as(true) %}
                                <td></td>
                            {% endif %}
                        </tr>
                        <tr>
                            <th colspan="3" class="th-total">Direct Totals</th>
                            <td class="total">
                                {{ report.directTotal|number_format(1, '.', ' ') }}
                            </td>
                            <td>{{ directTotals.correction|number_format(1, '.', ' ') }}</td>
                            <td></td>
                            <td class="text-end total">{{ directTotals.correctedTotal|number_format(1, '.', ' ') }}</td>
                            <td class="text-end primary">{{ directTotals.previousYearCorrectedTotal|number_format(1, '.', ' ') }}</td>
                            <td class="text-end table-success">{{ directTotals.budget|number_format(1, '.', ' ') }}</td>
                            <td class="text-end table-success">{{ directTotals.reforecast|number_format(1, '.', ' ') }}</td>
                            <td class="text-end">{{ directTotals.versusPreviousYear|number_format(1, '.', ' ') }}</td>
                            <td class="text-end">{{ directTotals.versusBudget|number_format(1, '.', ' ') }}</td>
                            <td class="text-end">{{ directTotals.versusReforecast|number_format(1, '.', ' ') }}</td>
                            {% if showLogs is same as(true) %}
                                <td></td>
                            {% endif %}
                        </tr>
                        <tr>
                            <th colspan="3" class="th-total">Totals</th>
                            <td class="total">
                                {{ report.total|number_format(1, '.', ' ') }}
                            </td>
                            <td>{{ totals.correction|number_format(1, '.', ' ') }}</td>
                            <td></td>
                            <td class="text-end total">{{ totals.correctedTotal|number_format(1, '.', ' ') }}</td>
                            <td class="text-end primary">{{ totals.previousYearCorrectedTotal|number_format(1, '.', ' ') }}</td>
                            <td class="text-end table-success">{{ totals.budget|number_format(1, '.', ' ') }}</td>
                            <td class="text-end table-success">{{ totals.reforecast|number_format(1, '.', ' ') }}</td>
                            <td class="text-end">{{ totals.versusPreviousYear|number_format(1, '.', ' ') }}</td>
                            <td class="text-end">{{ totals.versusBudget|number_format(1, '.', ' ') }}</td>
                            <td class="text-end">{{ totals.versusReforecast|number_format(1, '.', ' ') }}</td>
                            {% if showLogs is same as(true) %}
                                <td></td>
                            {% endif %}
                        </tr>
                        </tfoot>
                    </table>
                    <p class="small">{{ 'employee_staffing.report_info' | trans }}</p>
                </div>
            </div>
        </div>
    </div>
    {% if people|length > 0 %}
        <div class="row">
            {% embed 'helper/_report_table.html.twig' with {
                reportTable: {
                    items: {
                        id: {
                            label: 'directory.location.fields.id'|trans({}, 'directory')|upper,
                            link: {
                                route: 'directory_people_show',
                                params: {id: '@id'},
                            },
                        },
                        lastname: {
                            label: 'directory.people.csv.headers.lastname'|trans({}, 'directory')|capitalize,
                        },
                        firstname: {
                            label: 'directory.people.csv.headers.firstname'|trans({}, 'directory')|capitalize,
                        },
                        position: {
                            label: 'directory.people.fields.position'|trans({}, 'directory')|capitalize,
                            properties: ['position.description'],
                        },
                        contractType: {
                            label: 'directory.people.fields.contract_type'|trans({}, 'directory')|capitalize,
                            properties: ['contractType.name'],
                        },
                        coefficient: {
                            label: 'directory.people.fields.coefficient'|trans({}, 'directory')|capitalize,
                        },
                    },
                    title: 'directory.people.list.filtered_people' |trans({}, 'directory'),
                    data: people,
                    initialSorting: false
                }
            } %}
                {% block card_header %}
                    <div class="ibox-title">
                        <h5>{{ table.title|raw }}</h5>
                        {% block card_header_after %}
                            <div class="ibox-tools">
                                {{ form_start(downloadForm) }}
                                {{ form_end(downloadForm) }}
                                <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                            </div>
                        {% endblock %}
                    </div>
                {% endblock %}
            {% endembed %}
        </div>
    {% endif %}
{% endblock %}

{% block translations %}
    {{ parent() }}
    <script src="{{ path('bazinga_jstranslation_js', { 'domain': 'messages' }) }}"></script>
{% endblock %}
