{% if (app.user is not null) and not is_granted('ROLE_PASSWORD_NOT_EXPIRING') %}
    {% set remainingDays = app.user.timeBeforePasswordExpiration|date("%R%a") %}
    {% if remainingDays <= 5 %}
        <tr>
            <td>
                <div style="color: red; border: 1px solid red; padding: 5px; margin: 5px">
                    {% if remainingDays <=0 %}
                        Your password is expired
                    {% else %}
                        {{ 'security.login.expired_notice'|trans({'%count%': app.user.timeBeforePasswordExpiration|date("%a")}) }}
                    {% endif %}
                </div>
            </td>
        </tr>
    {% endif %}
{% endif %}