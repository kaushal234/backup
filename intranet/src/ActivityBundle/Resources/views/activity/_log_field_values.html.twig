{% if value is not iterable %}
    {% if value is same as(true) or value is same as(false) %}
        {# Boolean #}
        {% if value %}yes{% else %}no{% endif %}
    {% else %}
        {# String #}
        {{ value }}
    {% endif %}
{% else %}
    {# Array #}
    {% if value.date is defined %}
        {# Date format #}
        {{ date(value.date, value.timezone)|format_datetime('short', 'short') }}
    {% else %}
        {# Random array or object #}
        {{ value|json_encode() }}
    {% endif %}
{% endif %}
