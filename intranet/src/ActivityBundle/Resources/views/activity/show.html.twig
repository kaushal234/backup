{% trans_default_domain 'activity' %}
<div class="activity tabs-container" id="activity">
    <ul class="nav nav-tabs" id="myTab" role="tablist">
        {% if activities is not same as(null) %}
            <li role="presentation" class="{% if logs is not same as(null) and comments is not same as(null) %}nav-item active{% endif %}">
                <a href="#all" class="nav-link" data-toggle="tab" role="tab">{{ 'activity.activity.all'|trans }}</a>
            </li>
        {% endif %}
        {% if logs is not same as(null) %}
            <li role="presentation" class="nav-item">
                <a href="#logs" class="nav-link" data-toggle="logs" role="tab">{{ 'activity.activity.log.name'|trans }}</a>
            </li>
        {% endif %}
        {% if comments is not same as(null) %}
            <li role="presentation" class="nav-item">
                <a href="#comments" class="nav-link" data-toggle="comments" role="tab">{{ 'activity.activity.comment.name'|trans }}</a>
            </li>
        {% endif %}
    </ul>

    <div class="tab-content" id="myTabContent">
        {% if activities is not same as(null) %}
            <div class="tab-pane fade show active" id="all" role="tabpanel">
                <div class="card-body">
                    {% for entry in activities %}
                        <div class="row m-b-md">
                            {{ include('@ActivityBundle/activity/_entry.html.twig', { entry: entry }, with_context=false) }}
                        </div>
                    {% else %}
                    <div>
                    <i>{{ 'activity.activity.no_entry'|trans }}</i>
                    </div>
                    {% endfor %}
                    {% if comments is not same as(null) %}
                        {% block addCommentLink %}
                            <a class="btn btn-primary m-t-lg" href="{{ path('comment_add', { resourceIriId: resourceIriId }) }}">
                                {{ 'activity.comment.add'|trans }}
                            </a>
                        {% endblock %}
                    {% endif %}
                </div>
            </div>
        {% endif %}

        {% if logs is not same as(null) %}
        <div class="tab-pane {% if activities is same as(null) and logs is not same as(null) %}fade{% endif %}" id="logs" role="tabpanel">
            <div class="card-body">
                {% for entry in logs %}
                    <div class="row m-b-md">
                        {{ include('@ActivityBundle/activity/_entry.html.twig', { entry: entry }, with_context=false) }}
                    </div>
                {% else %}
                    <div>
                        <i>{{ 'activity.activity.log.no_entry'|trans }}</i>
                    </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}
        {% if comments is not same as(null) %}
            <div class="tab-pane{% if activities is same as(null) and comments is not same as(null) %}fade{% endif %}" id="comments" role="tabpanel">
                <div class="card-body">
                    {% for entry in comments %}
                        <div class="row m-b-md">
                            {{ include('@ActivityBundle/activity/_entry.html.twig', { entry: entry }, with_context=false) }}
                        </div>
                    {% else %}
                        <div>
                            <i>{{ 'activity.activity.comment.no_entry'|trans }}</i>
                        </div>
                    {% endfor %}
                    {{ block('addCommentLink') }}
                </div>
            </div>
        {% endif %}
    </div>
</div>

