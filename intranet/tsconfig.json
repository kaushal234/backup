{
  "compilerOptions": {
    "outDir": "./public/build",
    "target": "ES6",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "importHelpers": true,
    "types": ["node"]
  },
  "include": [
    "assets/react/**/*",
    "assets/controllers/**/*",
    "assets/javascript/powerbi/**/*",
    "assets/types/*"
  ]
}
