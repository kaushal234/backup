{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../packages/twig_helper",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "../packages/translator",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://gitlab.alvest.fr/devteam/kreyu-data-table-bundle.git"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "alvest/translator": "^1.2",
        "alvest/twig-helper": "^1.1",
        "kreyu/data-table-bundle": "v0.32.2-alpha",
        "odolbeau/phone-number-bundle": "^4.2.5",
        "php-standard-library/php-standard-library": "^6.2.1",
        "phpdocumentor/reflection-docblock": "^5.6.7",
        "phpstan/phpdoc-parser": "^2.3.2",
        "symfony/asset": "^7.4.8",
        "symfony/asset-mapper": "^7.4.15",
        "symfony/console": "^7.4.16",
        "symfony/doctrine-messenger": "^7.4.15",
        "symfony/dotenv": "^7.4.15",
        "symfony/expression-language": "^7.4.14",
        "symfony/flex": "^2.11.0",
        "symfony/form": "^7.4.16",
        "symfony/framework-bundle": "^7.4.16",
        "symfony/http-client": "^7.4.16",
        "symfony/intl": "^7.4.16",
        "symfony/mailer": "^7.4.15",
        "symfony/mime": "^7.4.16",
        "symfony/monolog-bundle": "^3.11.2",
        "symfony/process": "^7.4.13",
        "symfony/property-access": "^7.4.16",
        "symfony/property-info": "^7.4.16",
        "symfony/rate-limiter": "^7.4.16",
        "symfony/runtime": "^7.4.14",
        "symfony/security-bundle": "^7.4.15",
        "symfony/serializer": "^7.4.16",
        "symfony/stimulus-bundle": "^2.36.0",
        "symfony/string": "^7.4.15",
        "symfony/translation": "^7.4.16",
        "symfony/twig-bundle": "^7.4.15",
        "symfony/ux-icons": "^2.36.1",
        "symfony/ux-turbo": "^2.36.0",
        "symfony/validator": "^7.4.16",
        "symfony/web-link": "^7.4.8",
        "symfony/yaml": "^7.4.15",
        "twig/cache-extra": "^3.24.0",
        "twig/extra-bundle": "^2.12|^3.24.0",
        "twig/twig": "^2.12|^3.28.0",
        "symfony/ux-autocomplete": "^2.36.2",
        "symfony/ux-live-component": "^2.36",
        "symfony/ux-twig-component": "^2.36"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": ">=3.95.11",
        "phpstan/phpstan": "^2.2.2",
        "phpstan/phpstan-phpunit": "^2.0.16",
        "phpunit/phpunit": "^9.6.34",
        "symfony/browser-kit": "^7.4.14",
        "symfony/css-selector": "^7.4.9",
        "symfony/debug-bundle": "^7.4.8",
        "symfony/maker-bundle": "^1.67.0",
        "symfony/panther": "^2.4.0",
        "symfony/phpunit-bridge": "^7.4.16",
        "symfony/stopwatch": "^7.4.8",
        "symfony/web-profiler-bundle": "^7.4.16"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true,
        "gitlab-domains": [
            "gitlab.alvest.fr"
        ]
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "Kreyu\\Bundle\\DataTableBundle\\Tests\\": "vendor/kreyu/data-table-bundle/tests"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "cs": "php-cs-fixer fix --no-interaction --using-cache=no --config=.php-cs-fixer.dist.php",
        "cs-check": "php-cs-fixer fix --dry-run --diff --using-cache=no --config=.php-cs-fixer.dist.php"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^7.4.0"
        }
    }
}
