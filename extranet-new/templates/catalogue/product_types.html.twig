{#
  Catalogue — Level 1: Product Types
  Route: catalogue:index  (App\Controller\Catalogue\IndexController)
  Vars : productTypes  (each: .id, .englishName, .dms.id)

  Restyled from templates/catalogue/product_types.html.twig.
  Data, routes and |trans keys are UNCHANGED — only markup/classes.
  Overrides {% block body %} (not main) to allow full-width hero;
  content is wrapped in .w-100 because base.html.twig's flex column
  uses align-items:end.
#}
{% extends 'base.html.twig' %}

{% block title %}{{ 'extranet.title.catalogue'|trans }}{% endblock %}

{% block body %}
<div class="w-100">
    <section class="page-hero">
        <div class="page-hero-pattern"></div>
        <div class="container-fluid px-4 position-relative" style="z-index:2">
            <nav class="page-crumbs" aria-label="breadcrumb">
                <a href="{{ path('index') }}">{{ 'header.menu.home'|trans }}</a>
                <span class="sep">/</span>
                <span class="current">{{ 'extranet.menu.catalogue'|trans }}</span>
            </nav>
            <h1 class="page-hero-title">{{ 'extranet.menu.catalogue'|trans }}</h1>
            <p class="page-hero-sub">{{ 'extranet.catalogue.intro'|trans }}</p>
        </div>
    </section>

    <section class="py-5">
        <div class="container-fluid px-4">
            <div class="cat-grid">
                {% for productType in productTypes %}
                    <a class="cat-card" href="{{ path('catalogue:product_families', {id: productType.id}) }}">
                        <div class="cat-media">
                            <img src="{{ absolute_url('https://www.tld-gse.com/en/private/public/dms.php?id=' ~ productType.dms.legacyId) }}"
                                 alt="{{ productType.englishName }}" loading="lazy">
                        </div>
                        <div class="cat-foot">
                            <h3 class="cat-name">{{ productType.englishName }}</h3>
                            <svg class="cat-arrow" width="20" height="20" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                    </a>
                {% endfor %}
            </div>
        </div>
    </section>
</div>
{% endblock %}
