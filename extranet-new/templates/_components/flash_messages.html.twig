{% if is_impersonating() and app.current_route != "security:login" %}
<div class="mb-2 w-100">
    <div class="alert alert-dismissible alert-danger fade show rounded-0" role="alert">
        You are connected as {{ app.user.email }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
</div>
{% endif %}
{% if app.request.hasPreviousSession %}
    {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-2 w-100">
                    <div class="alert alert-dismissible alert-{{ type }} fade show rounded-0" role="alert">
                        <span>{{ message|trans|raw }}</span>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </div>
            {% endfor %}
        {% endfor %}
{% endif %}