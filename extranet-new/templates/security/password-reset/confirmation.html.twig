<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'security.reset_password.title'|trans({}, 'security') }}</title>
    <link rel="icon" href="{{ asset('images/favicon.ico') }}">
    {{ importmap('app') }}
</head>
<body>
{% if app.request.cookies.has('ALVEST_STAGING') %}
    {{ include('top_message.html.twig') }}
{% endif %}

<div class="login-shell">

    <div class="login-brand">
        <div class="login-brand-photo">
            <img src="{{ asset('images/login-bg.jpg') }}" alt="" onerror="this.style.display='none'">
        </div>
        <div class="login-brand-pattern"></div>

        <img class="login-brand-logo" src="{{ asset('images/logo.svg') }}" alt="TLD SAS">

        <div class="login-brand-copy">
            <div class="login-brand-eyebrow"><span class="dot"></span> Customer Portal</div>
            <h2 class="login-brand-title">{{ 'security.login.tagline'|trans }}</h2>
            <p class="login-brand-sub">{{ 'security.login.tagline_sub'|trans }}</p>
        </div>

        <div class="login-brand-foot">ALVEST GROUP</div>
    </div>

    <div class="login-form-side">
        <div class="login-card">
            <div class="login-head">
                <div class="login-eyebrow">● &nbsp;{{ 'security.login.form.password_reset'|trans }}</div>
                <h1>{{ 'security.reset_password.subtitle'|trans({}, 'security') }}</h1>
                <p class="login-welcome">{{ 'security.reset_password.title'|trans({}, 'security') }}</p>
            </div>

            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type }} mb-3" role="alert">{{ message|trans|raw }}</div>
                {% endfor %}
            {% endfor %}

            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
            {{ form_errors(form) }}
            <div class="login-field">
                <label for="{{ form.newPassword.first.vars.id }}">{{ form_label(form.newPassword.first) }}</label>
                <div class="input-wrap">
                    <svg class="ico" width="18" height="18" viewBox="0 0 16 16" fill="none"><rect x="3" y="7" width="10" height="7" rx="1.2" stroke="currentColor" stroke-width="1.4"/><path d="M5.5 7V4.8a2.5 2.5 0 0 1 5 0V7" stroke="currentColor" stroke-width="1.4"/></svg>
                    {{ form_widget(form.newPassword.first, {attr: {class: 'form-control'}}) }}
                </div>
                {{ form_errors(form.newPassword.first) }}
            </div>

            <div class="login-field">
                <label for="{{ form.newPassword.second.vars.id }}">{{ form_label(form.newPassword.second) }}</label>
                <div class="input-wrap">
                    <svg class="ico" width="18" height="18" viewBox="0 0 16 16" fill="none"><rect x="3" y="7" width="10" height="7" rx="1.2" stroke="currentColor" stroke-width="1.4"/><path d="M5.5 7V4.8a2.5 2.5 0 0 1 5 0V7" stroke="currentColor" stroke-width="1.4"/></svg>
                    {{ form_widget(form.newPassword.second, {attr: {class: 'form-control'}}) }}
                </div>
                {{ form_errors(form.newPassword.second) }}
            </div>

            {{ form_errors(form.newPassword) }}

            {{ include('security/_password_rules.html.twig') }}
            <button type="submit" class="login-submit">
                {{ 'security.login.submit'|trans }}
                {{ ux_icon('tabler:arrow-right', { class: 'arrow', width: 16, height: 16 }) }}
            </button>
            {{ form_end(form) }}

            <div class="login-links">
                <div class="signin-row">
                    <a href="{{ path('security:login') }}">
                        {{ ux_icon('tabler:arrow-left', { width: 14, height: 14 }) }}
                        Back to sign in
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>
</body>
</html>