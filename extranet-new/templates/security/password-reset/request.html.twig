<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'security.password_reset.form.legend'|trans }}</title>
    <link rel="icon" href="{{ asset('images/favicon.ico') }}">
    {{ importmap('app') }}
</head>
<body>
{% if app.request.cookies.has('ALVEST_STAGING') %}
    {{ include('top_message.html.twig') }}
{% endif %}

<div class="login-shell">

    {# LEFT — brand panel #}
    <div class="login-brand">
        <div class="login-brand-photo">
            <img src="{{ asset('images/login-bg.jpg') }}" alt="" onerror="this.style.display='none'">
        </div>
        <div class="login-brand-pattern"></div>

        <img class="login-brand-logo" src="{{ asset('images/logo.svg') }}" alt="TLD SAS">

        <div class="login-brand-copy">
            <div class="login-brand-eyebrow"><span class="dot"></span> Customer Portal</div>
            <h2 class="login-brand-title">{{ 'security.login.tagline'|trans }}</h2>
            <p class="login-brand-sub">{{ 'security.login.tagline_sub'|trans }}</p>
        </div>

        <div class="login-brand-foot">ALVEST GROUP</div>
    </div>

    {# RIGHT — form #}
    <div class="login-form-side">
        <div class="login-card">
            <div class="login-head">
                <div class="login-eyebrow">● &nbsp;{{ 'security.login.form.password_reset'|trans }}</div>
                <h1>{{ 'security.password_reset.form.legend'|trans }}</h1>
                <p class="login-welcome">{{ 'security.password_reset.form.email.label'|trans }}</p>
            </div>

            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type }} mb-3" role="alert">{{ message|trans|raw }}</div>
                {% endfor %}
            {% endfor %}

            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                <div class="login-field">
                    <label for="{{ form.email.vars.id }}">{{ form_label(form.email) }}</label>
                    <div class="input-wrap">
                        <svg class="ico" width="18" height="18" viewBox="0 0 16 16" fill="none"><rect x="1.5" y="3.5" width="13" height="9" rx="1.5" stroke="currentColor" stroke-width="1.4"/><path d="M1.5 5l6.5 4.5L14.5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                        {{ form_widget(form.email, {attr: {class: 'form-control', placeholder: 'you@example.com'}}) }}
                    </div>
                    {{ form_errors(form.email) }}
                </div>

                <button type="submit" class="login-submit">
                    {{ 'security.password_reset.form.submit.label'|trans }}
                    <svg class="arrow" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
            {{ form_end(form) }}

            <div class="login-links">
                <div class="signin-row">
                    <a href="{{ path('security:login') }}">
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M13 8H4M8 4.5 4.5 8 8 11.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        Back to sign in
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>
</body>
</html>
