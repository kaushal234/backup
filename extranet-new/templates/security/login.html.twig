<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'extranet.title.login'|trans }}</title>
    <link rel="icon" href="{{ asset('images/favicon.ico') }}">
    {{ importmap('app') }}
</head>
<body>
{% if app.request.cookies.has('ALVEST_STAGING') %}
    {{ include('top_message.html.twig') }}
{% endif %}

<div class="login-shell">

    {# LEFT — brand panel #}
    <div class="login-brand">
        <div class="login-brand-photo">
            <img src="{{ asset('images/login-bg.jpg') }}" alt="" onerror="this.style.display='none'">
        </div>
        <div class="login-brand-pattern"></div>

        <img class="login-brand-logo" src="{{ asset('images/logo.svg') }}" alt="TLD SAS">

        <div class="login-brand-copy">
            <div class="login-brand-eyebrow"><span class="dot"></span> Customer Portal</div>
            <h2 class="login-brand-title">{{ 'security.login.tagline'|trans }}</h2>
            <p class="login-brand-sub">{{ 'security.login.tagline_sub'|trans }}</p>
        </div>

        <div class="login-brand-foot">ALVEST GROUP</div>
    </div>

    {# RIGHT — form #}
    <div class="login-form-side">
        <div class="login-card">
            <div class="login-head">
                <div class="login-eyebrow">● &nbsp;{{ 'security.login.form.submit.label'|trans }}</div>
                <h1>{{ 'security.login.welcome_extranet'|trans }}</h1>
                <p class="login-welcome">Sign in with your credentials to continue.</p>
            </div>

            <form action="{{ path('security:login') }}" method="POST">
                {% if error %}
                    <div class="login-error">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 2 1 14h14L8 2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M8 6.5v3.5M8 12h.01" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                        <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                    </div>
                {% endif %}

                <div class="login-field">
                    <label for="identifier">{{ 'security.login.form.identifier.label'|trans }}</label>
                    <div class="input-wrap">
                        <svg class="ico" width="18" height="18" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="5" r="3" stroke="currentColor" stroke-width="1.4"/><path d="M2.5 14a5.5 5.5 0 0 1 11 0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                        <input type="text" id="identifier" name="_identifier" value="{{ last_username }}" autocomplete="username" autofocus>
                    </div>
                </div>

                <div class="login-field">
                    <label for="password">{{ 'security.login.form.password.label'|trans }}</label>
                    <div class="input-wrap">
                        <svg class="ico" width="18" height="18" viewBox="0 0 16 16" fill="none"><rect x="3" y="7" width="10" height="7" rx="1.5" stroke="currentColor" stroke-width="1.4"/><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" stroke="currentColor" stroke-width="1.4"/></svg>
                        <input type="password" id="password" name="_password" autocomplete="current-password"
                               data-controller="password-toggle" data-password-toggle-target="input">
                        <button type="button" class="pw-toggle" aria-label="Show password"
                                data-action="password-toggle#toggle">
                            <svg width="18" height="18" viewBox="0 0 16 16" fill="none"><path d="M1.5 8S4 3.5 8 3.5 14.5 8 14.5 8 12 12.5 8 12.5 1.5 8 1.5 8Z" stroke="currentColor" stroke-width="1.4"/><circle cx="8" cy="8" r="2" stroke="currentColor" stroke-width="1.4"/></svg>
                        </button>
                    </div>
                </div>

                <input type="hidden" name="_target_path" value="{{ app.request.query.get('_target_path') }}">
                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="login-submit">
                    {{ 'security.login.form.submit.label'|trans }}
                    <svg class="arrow" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
            </form>

            <div class="login-links">
                <a href="{{ path('security:password-reset:index') }}">{{ 'security.login.form.password_reset'|trans }}</a>
                <div class="signin-row">
                    <a target="_blank" rel="noopener" href="https://www.tld-group.com/extranet/">{{ 'security.login.form.signin'|trans }}</a>
                </div>
            </div>
        </div>
    </div>

</div>
</body>
</html>
