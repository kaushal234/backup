{% trans_default_domain 'security' %}

<div class="password-rules">
    <p class="password-rules-title">{{ 'security.password_rules.title'|trans }}</p>
    <ul>
        <li>{{ 'security.password_rules.min_length'|trans }}</li>
        <li>{{ 'security.password_rules.must_contain_letter'|trans }}</li>
        <li>
            {{ 'security.password_rules.two_of_three'|trans }}
            <ul>
                <li>{{ 'security.password_rules.uppercase_and_lowercase'|trans }}</li>
                <li>{{ 'security.password_rules.number'|trans }}</li>
                <li>{{ 'security.password_rules.special_char'|trans }}</li>
            </ul>
        </li>
        <li>{{ 'security.password_rules.no_spaces'|trans }}</li>
        <li>{{ 'security.password_rules.no_name'|trans }}</li>
        <li>{{ 'security.password_rules.no_previous'|trans }}</li>
    </ul>
</div>