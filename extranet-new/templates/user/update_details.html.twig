{#
  user/update_details.html.twig — EDIT DETAILS (restyled)
  Route: account:form  (App\Controller\User\FormAccountController / UpdateAccountController)
  Var  : form  — unchanged Symfony form (all the same fields).

  Keeps form_start/form_row/form_end and every field; only the layout is themed
  (page hero + Identity/Contact/Address info-cards + save bar). Field widget
  styling comes from your form_theme.html.twig — the .cf-input class is applied
  here via form_row variables where helpful, otherwise the theme governs widgets.
#}
{% extends 'base.html.twig' %}

{% block title %}{{ 'extranet.title.account_information'|trans }}{% endblock %}

{% block body %}
<div class="w-100">
    {% include '_components/page_hero.html.twig' with {
        hero_eyebrow: 'extranet.title.my_account'|trans,
        hero_title: 'menu.edit'|trans|capitalize,
        hero_sub: 'extranet.account.edit_intro'|trans,
        hero_crumbs: [
            { label: 'header.menu.home'|trans, href: path('index') },
            { label: 'extranet.title.my_account'|trans, href: path('account:index') },
            { label: 'menu.edit'|trans|capitalize }
        ]
    } %}

    <section class="py-5">
        <div class="container-fluid px-4">
            {{ form_start(form) }}
            <div class="info-grid">

                {# Identity #}
                <div class="info-card span-2">
                    <div class="info-head"><span class="ph-bar"></span><h3>{{ 'extranet.title.identity'|trans }}</h3></div>
                    <div class="info-body">
                        <div class="field-grid">
                            <div class="field-block">{{ form_row(form.lastname) }}</div>
                            <div class="field-block">{{ form_row(form.firstname) }}</div>
                            <div class="field-block">{{ form_row(form.title) }}</div>
                            <div class="field-block">{{ form_row(form.language) }}</div>
                            <div class="field-block">{{ form_row(form.division) }}</div>
                            <div class="field-block">{{ form_row(form.department) }}</div>
                        </div>
                    </div>
                </div>

                {# Contact #}
                <div class="info-card">
                    <div class="info-head"><span class="ph-bar"></span><h3>{{ 'extranet.title.contact'|trans }}</h3></div>
                    <div class="info-body">
                        <div class="field-grid">
                            <div class="field-block">{{ form_row(form.reception) }}</div>
                            <div class="field-block">{{ form_row(form.phone) }}</div>
                            <div class="field-block">{{ form_row(form.mobile) }}</div>
                        </div>
                    </div>
                </div>

                {# Address #}
                <div class="info-card">
                    <div class="info-head"><span class="ph-bar"></span><h3>{{ 'address.name'|trans|capitalize }}</h3></div>
                    <div class="info-body">
                        <div class="field-grid">
                            <div class="field-block full">{{ form_row(form.street) }}</div>
                            <div class="field-block full">{{ form_row(form.street2) }}</div>
                            <div class="field-block">{{ form_row(form.city) }}</div>
                            <div class="field-block">{{ form_row(form.postalCode) }}</div>
                            <div class="field-block">{{ form_row(form.state) }}</div>
                            <div class="field-block">{{ form_row(form.country) }}</div>
                        </div>
                    </div>
                </div>

            </div>

            <div class="acct-savebar">
                <a class="btn-outline-tld" href="{{ path('account:index') }}">{{ 'menu.cancel'|trans|capitalize }}</a>
                <button type="submit" class="btn-find">{{ 'extranet.form.update'|trans }}</button>
            </div>
            {{ form_end(form) }}
        </div>
    </section>
</div>
{% endblock %}
