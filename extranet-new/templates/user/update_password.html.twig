{% extends 'base.html.twig' %}

{% block title %}{{ 'title.settings'|trans }}{% endblock %}

{% block main %}
    <h3><a href="{{ path('account:index') }}">{{ 'extranet.title.account_information' | trans }}</a> / {{ 'extranet.title.update_password' | trans | capitalize }}</a></h3>
    <hr>

    <div class="card">
        <div class="card-body">
            <div class="my-4">
                {{ form_start(form) }}
                <div class="row mb-4">
                    <div class="col">
                        <div class="form-error">
                            {{ form_errors(form) }}
                            {{ form_errors(form.password) }}
                        </div>
                        <div>
                            {{ form_label(form.password, null, {'label_attr': {'class': 'mb-1'}}) }}
                            {{ form_widget(form.password) }}
                        </div>
                    </div>
                    <div class="col ms-4">
                        <p class="mb-2">{{ 'settings.change_password.form.new_password.requirements.title'|trans }}</p>
                        <p class="small text-muted mb-2">{{ 'settings.change_password.form.new_password.requirements.description'|trans }}</p>
                        <ul class="small text-muted pl-4 mb-0">
                            <li>{{ 'settings.change_password.form.new_password.requirements.length'|trans }}</li>
                            <li>{{ 'settings.change_password.form.new_password.requirements.no_starting_space'|trans }}</li>
                            <li>{{ 'settings.change_password.form.new_password.requirements.at_least_one_letter'|trans }}</li>
                            <li>{{ 'settings.change_password.form.new_password.requirements.require_2_of_3_constaints'|trans }}</li>
                            <li>{{ 'settings.change_password.form.new_password.requirements.no_3_common_letters_with_name'|trans }}</li>
                            <li>{{ 'settings.change_password.form.new_password.requirements.same_password'|trans }}</li>
                            <li><a href="https://haveibeenpwned.com/Passwords" target="_blank">{{ 'settings.change_password.form.new_password.requirements.safe'|trans }}</a></li>
                        </ul>
                    </div>
                </div>
                <div class="mt-3">
                    <button type="submit" data-turbo="false" class="btn btn-outline-primary">{{ 'settings.change_password.form.submit.label'|trans }}</button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
