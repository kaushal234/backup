{#
  pages/monitor_fleet_telemetry.html.twig — STATIC
  Route: page:telemetry
  Controller: App\Controller\StaticPageController::telemetry
#}
{% extends 'base.html.twig' %}

{% block title %}{{ 'extranet.page.telemetry.title'|trans }}{% endblock %}

{% block body %}
<div class="w-100">
    {% include '_components/page_hero.html.twig' with {
        hero_eyebrow: 'extranet.menu.service_support'|trans,
        hero_title: 'extranet.page.telemetry.title'|trans,
        hero_sub: 'extranet.page.telemetry.sub'|trans,
        hero_crumbs: [
            { label: 'header.menu.home'|trans, href: path('index') },
            { label: 'extranet.menu.service_support'|trans },
            { label: 'extranet.page.telemetry.title'|trans }
        ]
    } %}

    <section class="py-5">
        <div class="container-fluid px-4">
            <div class="section-head">
                <div class="titles">
                    <div class="eyebrow"><span class="accent">●</span> &nbsp;{{ 'extranet.page.telemetry.fms'|trans }}</div>
                    <h2 class="section-title mt-2">{{ 'extranet.page.telemetry.access'|trans }}</h2>
                    <p class="section-sub">{{ 'extranet.page.telemetry.pick'|trans }}</p>
                </div>
            </div>

            <div class="tele-grid">
                {# Existing account #}
                <div class="tele-card">
                    <div class="tele-ico">
                        <svg width="26" height="26" viewBox="0 0 16 16" fill="none"><path d="M6 2h6v12H6M9 8H2m0 0 3-3M2 8l3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <div class="tele-step">{{ 'extranet.page.telemetry.existing_step'|trans }}</div>
                    <h3 class="tele-title">{{ 'extranet.page.telemetry.existing_title'|trans }}</h3>
                    <p class="tele-desc">{{ 'extranet.page.telemetry.existing_desc'|trans }}</p>
                    <a class="tele-cta primary" href="https://www.linkfms.com/fms/html5/index.html#/login" target="_blank" rel="noopener">
                        {{ 'extranet.page.telemetry.login'|trans }}
                        <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M6 3h7v7M13 3 7 9M11 9v4H3V5h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </a>
                </div>

                {# New account #}
                <div class="tele-card is-new">
                    <div class="tele-ico">
                        <svg width="26" height="26" viewBox="0 0 16 16" fill="none"><circle cx="6" cy="5" r="2.5" stroke="currentColor" stroke-width="1.4"/><path d="M2 13c0-2.2 1.8-4 4-4s4 1.8 4 4M12 6v4M10 8h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                    </div>
                    <div class="tele-step">{{ 'extranet.page.telemetry.new_step'|trans }}</div>
                    <h3 class="tele-title">{{ 'extranet.page.telemetry.new_title'|trans }}</h3>
                    <p class="tele-desc">{{ 'extranet.page.telemetry.new_desc'|trans }}</p>
                    <a class="tele-cta accent" href="{{ path('contact:index') }}?dept=sales">
                        {{ 'extranet.page.telemetry.contact_sales'|trans }}
                        <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </a>
                </div>
            </div>

            {# Learn more #}
            <div class="tele-learn">
                <div class="tl-text">
                    <div class="tl-eyebrow">{{ 'extranet.page.telemetry.powered'|trans }}</div>
                    <h3>{{ 'extranet.page.telemetry.learn_title'|trans }}</h3>
                    <p>{{ 'extranet.page.telemetry.learn_desc'|trans }}</p>
                </div>
                <a class="tl-btn" href="https://xops-aero.com/" target="_blank" rel="noopener">
                    {{ 'extranet.page.telemetry.visit_xops'|trans }}
                    <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M6 3h7v7M13 3 7 9M11 9v4H3V5h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
            </div>
        </div>
    </section>
</div>
{% endblock %}
