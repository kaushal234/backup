{% extends 'base.html.twig' %}

{% block title %}{{ 'extranet.title.technician_on_call'|trans|capitalize }}{% endblock %}

{% block body %}
<div class="w-100">
    {% include '_components/page_hero.html.twig' with {
        hero_eyebrow: 'extranet.title.customer_portal'|trans,
        hero_title: 'extranet.title.technician_on_call'|trans,
        hero_crumbs: [
            { label: 'header.menu.home'|trans, href: path('index') },
            { label: 'extranet.title.technician_on_call'|trans|capitalize, href: path('technician_on_call:index') },
            { label: 'menu.add'|trans|capitalize }
        ]
    } %}

    <section class="py-5">
        <div class="container-fluid px-4">
            <div class="section-head">
                <div class="titles">
                    <div class="eyebrow"><span class="accent">●</span> &nbsp;{{ 'extranet.title.customer_portal'|trans }}</div>
                </div>
            </div>

            <twig:TechnicianOnCallLiveComponent
                equipmentId="{{ equipmentId }}"
            />
        </div>
    </section>
</div>
{% endblock %}