{% extends 'base.html.twig' %}

{% block title %}{{ 'extranet.title.technician_on_call'|trans|capitalize }}{% endblock %}

{% block body %}
<div class="w-100">
    {% include '_components/page_hero.html.twig' with {
        hero_eyebrow: 'extranet.title.customer_portal'|trans,
        hero_title: 'extranet.form.add_file'|trans|capitalize,
        hero_sub: technicianOnCall.equipmentRecord.serialNumber,
        hero_crumbs: [
            { label: 'header.menu.home'|trans, href: path('index') },
            { label: 'extranet.title.technician_on_call'|trans|capitalize, href: path('technician_on_call:index') },
            { label: technicianOnCall.equipmentRecord.serialNumber, href: path('technician_on_call:show', {id: technicianOnCall.id}) },
            { label: 'extranet.form.add_file'|trans|capitalize }
        ]
    } %}

    <section class="py-5">
        <div class="container-fluid px-4">
            {{ form_start(form) }}
            <div class="info-grid">
                <div class="info-card span-2">
                    <div class="info-head"><span class="ph-bar"></span><h3>{{ 'extranet.form.add'|trans }}</h3></div>
                    <div class="info-body">
                        {{ form_errors(form) }}
                        <div class="field-grid">
                            <div class="field-block full">{{ form_row(form.file) }}</div>
                            <div class="field-block full">{{ form_row(form.description) }}</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="acct-savebar">
                <a class="btn-outline-tld" style="height:52px" href="{{ path('technician_on_call:show', {id: technicianOnCall.id}) }}">{{ 'menu.cancel'|trans|capitalize }}</a>
                <button type="submit" class="btn-find" data-turbo="false">{{ 'extranet.form.add'|trans }}</button>
            </div>
            {{ form_end(form) }}
        </div>
    </section>
</div>
{% endblock %}