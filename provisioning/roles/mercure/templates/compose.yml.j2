services:
  mercure:
    image: dunglas/mercure
    container_name: {{ mercure_container_name }}
    restart: unless-stopped
    env_file:
      - .env
    environment:
      SERVER_NAME: ":80"
      USE_FORWARDED_HEADERS: "1"
    ports:
      - "{{ mercure_internal_host }}:{{ mercure_internal_port }}:80"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - mercure_data:/data
      - mercure_config:/config
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://localhost/healthz"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 20s

volumes:
  mercure_data:
  mercure_config: