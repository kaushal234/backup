{{ monorepo_path }}/shared/api/var/log/prod.ion-requests-*.log {
    size 100M
    rotate 10
    notifempty
    missingok
    compress
    delaycompress
    postrotate
            find {{ monorepo_path }}/shared/api/var/log -name "prod.ion-requests-*" -mtime +5 -delete
    endscript
}

