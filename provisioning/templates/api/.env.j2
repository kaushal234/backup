# BC purpose
SYMFONY_ENV=prod

# App
APP_ENV=prod
APP_SECRET={{ app.secret }}

# Symfony Lock
LOCK_DSN=semaphore

# Database
DATABASE_URL={{ database.api }}
LEGACY_DATABASE_URL={{ database.legacy }}
WP_DATABASE_URL={{ database.wordpress }}

# Bin Paths
WKHTMLTOPDF_PATH=/usr/local/bin/wkhtmltopdf
WKHTMLTOIMAGE_PATH=/usr/local/bin/wkhtmltoimage

# JWT
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE={{ jwt.passphrase }}

# CORS
CORS_ALLOW_ORIGIN=^http.+

# Emails
MAILER_DSN="{{ mailer.dsn }}"

# Messenger
MESSENGER_TRANSPORT_DSN=doctrine://default

# Gitlab
GITLAB_URL=https://{{ gitlab_url }}/api/v4/
GITLAB_PRIVATE_TOKEN={{ gitlab.token }}
GITLAB_GRAPHQL_URL=https://{{ gitlab_url }}
GITLAB_PROJECT_PATH={{ gitlab_project_path }}

# Paths
UPLOAD_DIR=%kernel.project_dir%/uploads
MOUNT_DIRECTORY=/mnt
INVOICES_PATH=/mnt/grpfps10.online_approvals/invoices
STRS_PDF_PATH=/mnt/grpfps10.strs_pdf

# Survey
SURVEY_HOST=https://survey.tld-gse.com

# Microsoft Azure AD
CSA_MICROSOFT_URL=https://graph.microsoft.com/v1.0/
CSA_MICROSOFT_TENANT_ID={{ microsoft.tenant }}
CSA_MICROSOFT_CLIENT_ID={{ microsoft.client }}
CSA_MICROSOFT_CLIENT_SECRET={{ microsoft.secret }}

EPARTS_DATABASE_URL={{ eparts.url }}
EPARTS_HOST={{ eparts.host }}
EPARTS_USERNAME="{{ eparts.username }}"
EPARTS_PASSWORD={{ eparts.password }}
PARTS_PICTURES_PATH={{ eparts.picture_path }}

PRINT_SERVER_HOST=http://printserver.com:631

# ION
ION_CLIENT_ID={{ ion.id }}
ION_CLIENT_SECRET={{ ion.secret }}
ION_URL_ACCESS_TOKEN={{ ion.token }}
ION_USERNAME="{{ ion.username }}"
ION_PASSWORD={{ ion.password }}
ION_ENVIRONMENT={{ ion.env }}
ION_COMPANY={{ ion.company }}

#Deepl API for translations
DEEPL_PRO_URL=https://api.deepl.com/v2/
DEEPL_PRO_AUTH_HEADER=DeepL-Auth-Key
DEEPL_TOKEN={{ deepl.token }}

# Sage
SAGE_SECRET={{ sage.secret }}
SAGE_MTYPE="{{ sage.mtype }}"
SAGE_CID="{{ sage.cid }}"

TOKEN_LIFETIME={{ token.lifetime }}

#JIRA
JIRA_URL=https://alvestgroup.atlassian.net
JIRA_CLIENT_TOKEN={{ jira.token }}

JAVELO_API_URL=https://api.javelo.io/scim/v2/
JAVELO_API_TOKEN={{ javelo.token }}

#JIRA Tracteasy (for TOC Sync)
JIRA_TRACTEASY_URL=https://tracteasy-service-desk.atlassian.net

MODULO_API_BASE_URI=https://www.tld-group.com/wp-json/custom/v1/
MODULO_API_USERNAME=tld_external
MODULO_API_PASSWORD={{ modulo_api.password }}

#Agile API for Agile users
AGILE_API_GET_URL=https://public.api.learn.link
AGILE_API_POST_URL=https://user.api.learn.link
AGILE_API_TENANT_ID={{ agile.tenant }}
AGILE_API_KEY={{ agile.key }}

#SAGEPARTS P21 API
SAGEPARTS_P21_BASE_URI={{ sage_p21.uri }}
SAGEPARTS_P21_CONSUMER_KEY={{ sage_p21.consumer_key }}

#LINK FMS API
LINK_API_URL={{ link.global_url }}
LINK_API_KEY={{ link.global_token }}
LINK_CHINESE_API_URL={{ link.chinese_url }}
LINK_CHINESE_API_KEY={{ link.chinese_token }}

# Default ERP to use main vault
VAULT_PARTS_IMAGES_PATH=grpfps10.parts_pics

#MISTRAL
MISTRAL_API_KEY={{ mistral.key }}
MISTRAL_BASE_URI=https://api.mistral.ai/v1/chat/completions

#MERCURE
MERCURE_URL=http://{{ mercure_internal_host }}:{{ mercure_internal_port }}/.well-known/mercure
MERCURE_PUBLIC_URL=https://{{ alvest_api_url }}/.well-known/mercure
MERCURE_JWT_SECRET="{{ mercure.token }}"

#OLLAMA
OLLAMA_URL=http://{{ ollama_internal_host }}:{{ ollama_internal_port }}

#QDRANT
QDRANT_HOST=http://{{ qdrant_host }}:{{ qdrant_port }}

#AZURE
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://alvest-docintel.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_KEY="{{ azure_document_intelligence.key }}"

###> azure/mcp-auth ###
ALVEST_AZURE_CLIENT_ID={{ azure.client_id }}
ALVEST_AZURE_CLIENT_SECRET={{ azure.client_secret }}
ALVEST_AZURE_TENANT_ID={{ azure.tenant_id }}
MCP_ALLOWED_CALLER_APP_IDS={{ azure.allowed_caller_app_ids }}
###< azure/mcp-auth ###


#LN REST API
LN_API_URL={{ ln_rest.url }}

#Snowflake SQL API
SNOWFLAKE_API_BASE_URL={{ snowflake.api_base_url }}
SNOWFLAKE_TOKEN={{ snowflake.token }}
SNOWFLAKE_WAREHOUSE={{ snowflake.warehouse }}