{% extends 'base.html.twig' %}

{% block title %}{{ 'title.login'|trans }}{% endblock %}

{% block main %}
    <div class="row justify-content-md-center my-5">
        <div class="col-sm-8">
            <div class="card">
                <div class="card-header border-dark">
                    <p class="fs-3 text-dark my-1">{{ 'security.login.form.legend'|trans }}</p>
                </div>
                <div class="card-body">
                    <form action="{{ path('security:login') }}" method="POST">
                        <fieldset>
                            {% if error %}
                                <div class="alert alert-danger mb-2">
                                    {{ error.messageKey|trans(error.messageData, 'security') }}
                                </div>
                            {% endif %}

                            <div class="mb-2">
                                <label class="mb-1" for="identifier">{{ 'security.login.form.identifier.label'|trans }}</label>
                                <input type="text" id="identifier" name="_identifier" value="{{ last_username }}" class="form-control"/>
                            </div>

                            <div class="mb-2 form-outline form-white">
                                <label class="mb-1" for="password">{{ 'security.login.form.password.label'|trans }}</label>
                                <input type="password" id="password" name="_password" class="form-control" />
                            </div>

                            <div class="form-check mb-2 ">
                                <input class="form-check-input" type="checkbox" id="tos-agreement" name="terms_of_use_agreement" required />
                                <label class="form-check-label" for="tos-agreement">{{ 'security.login.form.terms_of_use_agreement.label'|trans({tos: '<a target="_blank" href="' ~ path('terms-of-use:index') ~ '">' ~ 'terms_of_use.term'|trans ~ '</a>'})|raw }}</label>
                            </div>

                            <input type="hidden" name="_target_path" value="{{ app.request.attributes.get('redirect_to') }}"/>
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"/>

                            <button type="submit" class="mt-2 btn btn-primary w-100">{{ 'security.login.form.submit.label'|trans }}</button>

                            <br/><br/>
                            <div class="alert alert-info alert-dismissable">
                                {{ 'security.login.reminder' | trans() }}
                            </div>
                            <div class="w-100 mt-4">
                                <a class="link-secondary" href="{{ path('security:password-reset:index') }}">{{ 'security.login.form.password_reset'|trans }}</a>
                            </div>
                        </fieldset>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
