{% extends 'base.html.twig' %}

{% block title %}{{ 'title.password_reset'|trans }}{% endblock %}

{% block main %}
    <div class="row justify-content-md-center my-5">
        <div class="col-sm-8">
            <div class="card">
                <div class="card-header border-dark">
                    <p class="fs-3 text-dark my-1">{{ 'security.password_reset.form.legend'|trans }}</p>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                        <fieldset>
                            <div class="mb-2 form-outline form-white">

                                {{ form_label(form.email, null, {'label_attr': {'class': 'mb-1'}}) }}
                                {{ form_widget(form.email) }}
                            </div>

                            <button type="submit" class="mt-2 btn btn-primary w-100">{{ 'security.password_reset.form.submit.label'|trans }}</button>
                        </fieldset>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
