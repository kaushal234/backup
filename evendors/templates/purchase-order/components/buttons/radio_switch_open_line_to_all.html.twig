<div class="col-2 form-inline d-flex justify-content-start" id="flexRadioOpenOrAll">
    <div class="form-check col-6">
        <input class="form-check-input" type="radio" name="flexRadioSwitchView" id="flexRadioOpenLine" checked>
        <label class="form-check-label" for="flexRadioOpenLine">
            {{ 'display.table.purchase_order.action.switchViewOpenLine'|trans }}
        </label>
    </div>
    <div class="form-check col-6">
        <input class="form-check-input" type="radio" name="flexRadioSwitchView" id="flexRadioAll">
        <label class="form-check-label" for="flexRadioAll">
            {{ 'display.table.purchase_order.action.switchViewAll'|trans }}
        </label>
    </div>
</div>
