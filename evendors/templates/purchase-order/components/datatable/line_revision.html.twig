<td>
    <div data-name="{{ key }}">
        <div>
            {{ 'display.table.purchase_order_line.headers.revision'|trans }} : {{ value }}
        </div>
        <div>
            {{ 'display.table.purchase_order_line.headers.revision_status'|trans }} :
            {% if item.expired %}
                {{ 'manufacturing.bill_of_materials.status_change'|trans({date: attribute(item, expiryDateProperty|default('expiryDate'))|date('Y-m-d')}) }}
            {% else %}
                OK
            {% endif %}
        </div>
    </div>
</td>