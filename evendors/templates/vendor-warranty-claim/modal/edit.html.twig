{% set form = edit_vwc_form(claim) %}
<button type="button" class="btn btn-outline-primary float-end" data-bs-toggle="modal" data-bs-target="#edit_vwc_modal">
    <span class="mx-4">{{ 'display.table.vwc.form.new.approved'|trans }}</span>
</button>

<div class="modal carousel-fade" id="edit_vwc_modal" tabindex="-1" aria-labelledby="#edit_vwc_modal_label" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content display-style">
            {{ form_start(form) }}
            <div class="modal-header border-dark border-1">
                <h5 class="modal-title text-black" id="edit_vwc_modal_label">{{ 'display.table.vwc.form.new.approved'|trans }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <fieldset>
                    <div class="mb-2">
                        {{ form_label(form.supplierCreditAmount, null, {'label_attr': {'class': 'mb-1'}}) }}
                        {{ form_widget(form.supplierCreditAmount) }}
                    </div>
                    <div class="mb-2">
                        {{ form_label(form.supplierShippingInstruction, null, {'label_attr': {'class': 'mb-1'}}) }}
                        {{ form_widget(form.supplierShippingInstruction, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="mb-2">
                        {{ form_label(form.accepted, null, {'label_attr': {'class': 'mb-1'}}) }}
                        {{ form_widget(form.accepted) }}
                    </div>
                    <div class="mb-2">
                        {{ form_label(form.shipBackDefectivePart, null, {'label_attr': {'class': 'mb-1'}}) }}
                        {{ form_widget(form.shipBackDefectivePart) }}
                    </div>
                    <div class="mb-2">
                        {{ form_label(form.supplierReturnMerchandiseAuthorization, null, {'label_attr': {'class': 'mb-1'}}) }}
                        {{ form_widget(form.supplierReturnMerchandiseAuthorization, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="mb-2">
                        {{ form_label(form.file, null, {'label_attr': {'class': 'mb-1'}}) }}
                        {{ form_widget(form.file, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="mb-2">
                        {{ form_label(form.description, null, {'label_attr': {'class': 'mb-1'}}) }}
                        {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </fieldset>
            </div>
            <div class="modal-footer border-dark">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'display.comments.form.new.hide'|trans }}</button>
                <button type="submit" class="btn btn-primary" id="{{ form.vars.id }}_new_submit" >{{ 'display.comments.form.new.submit'|trans }}</button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
