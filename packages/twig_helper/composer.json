{
    "name": "alvest/twig-helper",
    "description": "Helper to create datatables easily with twig",
    "type": "symfony-bundle",
    "version": "1.1",
    "require": {
        "php": "^8.3 || ^8.4",
        "symfony/intl": "^6.4.15 || ^7.0.0",
        "symfony/property-access": "6.4.4 || ^6.4.18 || ^7.0.0",
        "symfony/translation": "^6.4.13 || ^7.0.0",
        "symfony/twig-bundle": "^6.4.13 || ^7.0.0",
        "symfony/yaml": "^6.4.18 || ^7.0.0",
        "twig/extra-bundle": "^2.12 || ^3.22.1",
        "twig/intl-extra": "^2.12 || ^3.22.1",
        "twig/twig": "^2.12 || ^3.22.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.91.1 || ^3.91.1",
        "phpstan/phpstan-symfony": "^1.4.16",
        "phpunit/phpunit": "^9.6.30",
        "phpstan/phpstan": "^0.12.40 || ^1.12.32",
        "phpstan/phpstan-phpunit": "^0.12.16 || ^1.4.2",
        "symfony/phpunit-bridge": "^4.0 || ^6.4.26 || ^7.0.0",
        "symfony/css-selector": "^6.4.13 || ^7.0.0",
        "symfony/dom-crawler": "^6.4.18 || ^7.0.0"
    },
    "autoload": {
        "psr-4": {
            "Alvest\\TwigHelper\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alvest\\TwigHelper\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true,
        "bump-after-update": true
    }
}
