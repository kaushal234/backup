{
    "name": "alvest/twig-helper",
    "description": "Helper to create datatables easily with twig",
    "type": "symfony-bundle",
    "version": "1.1",
    "require": {
        "php": "~8.3.0",
        "symfony/intl": "^6.4.0 || ^7.4.16",
        "symfony/property-access": "^6.4.0 || ^7.4.16",
        "symfony/translation": "^6.4.0 || ^7.4.16",
        "symfony/twig-bundle": "^6.4.0 || ^7.4.15",
        "symfony/yaml": "^6.4.0 || ^7.4.15",
        "twig/extra-bundle": "^3.24",
        "twig/intl-extra": "^3.26",
        "twig/twig": "^3.28"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6.35",
        "phpstan/phpstan": "^1.12.34",
        "phpstan/phpstan-phpunit": "^1.0.0",
        "friendsofphp/php-cs-fixer": "^3.95.18",
        "symfony/phpunit-bridge": "^6.1 || ^7.4.16",
        "symfony/css-selector": "^6.4.0 || ^7.4.9",
        "symfony/dom-crawler": "^6.4.0 || ^7.4.12"
    },
    "autoload": {
        "psr-4": {
            "Alvest\\TwigHelper\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alvest\\TwigHelper\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true,
        "bump-after-update": true
    }
}
