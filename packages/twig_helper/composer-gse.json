{
    "name": "alvest/twig-helper",
    "description": "Helper to create datatables easily with twig",
    "type": "symfony-bundle",
    "version": "1.1",
    "require": {
        "php": "~8.3.0",
        "symfony/intl": "^6.4.42",
        "symfony/property-access": "6.4.4",
        "symfony/translation": "^6.4.42",
        "symfony/twig-bundle": "^6.4.43",
        "symfony/yaml": "^6.4.43",
        "twig/extra-bundle": "^3.24.0",
        "twig/intl-extra": "^3.26.0",
        "twig/twig": "^3.28.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6.35",
        "phpstan/phpstan": "^0.12.40",
        "phpstan/phpstan-phpunit": "^0.12.16",
        "friendsofphp/php-cs-fixer": "^3.95.18",
        "symfony/phpunit-bridge": "^4.0",
        "symfony/css-selector": "^6.4.0",
        "symfony/dom-crawler": "^6.4.40"
    },
    "autoload": {
        "psr-4": {
            "Alvest\\TwigHelper\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alvest\\TwigHelper\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true,
        "bump-after-update": true
    }
}
