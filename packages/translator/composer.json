{
    "name": "alvest/translator",
    "description": "Component to use translation files for multiple symfony project",
    "type": "symfony-bundle",
    "version": "1.2.0",
    "require": {
        "php": "~8.3.0 || ~8.4.0",
        "symfony/translation": "^6.4.13 || ^7.4.6"
    },
    "config": {
        "sort-packages": true,
        "bump-after-update": true
    },
    "autoload": {
        "psr-4": {
            "Alvest\\Translator\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alvest\\Translator\\Tests\\": "tests"
        }
    }
}
