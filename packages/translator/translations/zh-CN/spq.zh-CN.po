msgid "spq.kpi.definitions.qir"
msgstr "Percentage of quotations submitted in less than 24 hours from the creation date.\n\nNumber of quotation where the difference between submission and creation is less than 24 hours in a month divided by the number of quotations submitted in this month.\n"

msgid "spq.kpi.definitions.atq"
msgstr "Average number of days between quotation's reception and submission.\n\nSum of the differences between reception and submission dates in a month divided by the number of quotations submitted in this month.\n"

msgid "spq.kpi.definitions.cat"
msgstr "Average number of days between quotation's submission and closing.\n\nSum of the differences between submission and closing dates in a month divided by the number of quotations closed in this month.\n"

msgid "spq.kpi.definitions.scr"
msgstr "SRCV\n====\nPercentage of quotations' lines value sold.\n\nSum all SOLD quotations' lines amount converted in USD in a month devided by the sum of quotations' lines amount created in this month.\n\nSRCL\n====\nPercentage of quotations' lines sold.\n\nNumber of SOLD quotations' lines in a month devided by the number of quotations' lines created in this month.\n"

msgid "spq.kpi.definitions.wr"
msgstr "WRV\n====\nPercentage of quotations' lines value sold.\n\nSum all SOLD quotations' lines amount converted in USD in a month devided by the sum of quotations' lines amount closed in this month.\n\nWRL\n====\nPercentage of quotations' lines sold.\n\nNumber of SOLD quotations' lines in a month devided by the number of quotations' lines closed in this month.\n"

msgid "spq.kpi.definitions.quotationsNumber"
msgstr "Number of quotations received per month.\n"

msgid "spq.kpi.definitions.quotationLinesNumber"
msgstr "Number of quotations' lines received per month.\n"
