msgid "errors.404_title"
msgstr "Page non trouvée"

msgid "errors.404_content"
msgstr "Désolé, mais la page que vous cherchez n'a pas été trouvée. Essayez de vérifier si l'URL ne contient pas d'erreur, puis cliquez sur le bouton recharger de votre navigateur."

msgid "errors.500_title"
msgstr "Erreur Interne au Serveur"

msgid "errors.500_content"
msgstr "Le serveur a rencontré quelque chose d'inattendu qui ne permettait pas de mener à bien la demande. Nous nous excusons."
