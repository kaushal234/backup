msgid "ai.copilot_modal.title"
msgstr "Microsoft Copilot"

msgid "ai.copilot_modal.message"
msgstr "Veuillez vous connecter à votre compte Microsoft avec votre compte professionnel (c'est-à-dire votre adresse e-mail et votre mot de passe habituel) pour utiliser Copilot. Pour ce faire, **cliquez sur l'icône utilisateur (<i class=\"fa fa-user\"></i>) située en bas à gauche** de la page Copilot. Ce service fonctionne au sein de l'infrastructure Microsoft, garantissant que vos données restent sécurisées et soumises aux politiques de conformité de votre organisation."

msgid "ai.copilot_modal.certify"
msgstr "Je certifie que je me connecterai avec mon compte professionnel avant de soumettre des données de l'entreprise à Copilot."

msgid "ai.copilot_modal.confirm"
msgstr "Ouvrir Copilot"

msgid "ai.copilot_modal.cancel"
msgstr "Annuler"

msgid "ai.actions.pin"
msgstr "Épingler"

msgid "ai.actions.unpin"
msgstr "Désépingler"

msgid "ai.actions.delete"
msgstr "Supprimer"

msgid "ai.documentation.section_title"
msgstr "Documentation"

msgid "ai.deepl_modal.title"
msgstr "DeepL Traducteur"

msgid "ai.deepl_modal.message"
msgstr "Vous êtes sur le point de vous connecter à Deepl-free. Conformément à notre politique de sécurité de l'information, il est strictement interdit de soumettre des documents confidentiels à cet outil de traduction. Veuillez respecter strictement cette règle."

msgid "ai.deepl_modal.certify"
msgstr "Oui, je m'engage à respecter cette règle"

msgid "ai.deepl_modal.confirm"
msgstr "Ouvrir DeepL"

