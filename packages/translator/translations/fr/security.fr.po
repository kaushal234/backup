msgid "security.forgot"
msgstr "Mot de passe perdu"

msgid "security.forgot-link"
msgstr "Perdu votre mot de pase?"

msgid "security.forgot-title"
msgstr "Merci de renseigner votre Login, un email comprenant les instructions pour renouveler votre mot de passe vous sera transmis."

msgid "security.forgot-success"
msgstr "Un email comprenant les instructions pour renouveler votre mot de passe vous a été transmis, il doit arriver bientôt. Sinon, merci de contacter le webmaster."

msgid "security.oauth-link"
msgstr "Connexion Single-Sign-On"

msgid "security.reset_my"
msgstr "J'ai perdu mon mot de passe"

msgid "security.reset_my-title"
msgstr "Confirmez votre choix, un email avec votre nouveau mot de passe sera envoyé."

msgid "security.reset_my-success"
msgstr "Un email vous a été envoyé avec votre nouveau mot de passe, il doit arriver bientôt. Sinon, merci de contacter le webmaster."

msgid "security.reset_my-error"
msgstr "Un email vous a été envoyé avec les indications pour renouveler votre nouveau mot de passe, il doit arriver bientôt. Sinon, merci de contacter le webmaster."

msgid "security.reset_other-title"
msgstr "Confirmez votre choix, un email avec votre nouveau mot de passe sera envoyé à l'utilisateur."

msgid "security.reset_other-success"
msgstr "Un email contenant un nouveau mot de passe vous a été transmis, il doit arriver bientôt. Sinon, merci de contacter le webmaster."

msgid "security.fields.username"
msgstr "Login"

msgid "security.reset_password.title"
msgstr "Choisissez un nouveau mot de passe"

msgid "security.reset_password.subtitle"
msgstr "Veuillez saisir et confirmer votre nouveau mot de passe ci-dessous."

msgid "security.password_reset_confirmation.form.legend"
msgstr "Choisissez un nouveau mot de passe"

msgid "security.password_reset_confirmation.form.subtitle"
msgstr "Veuillez saisir et confirmer votre nouveau mot de passe ci-dessous."

msgid "security.password_reset_confirmation.form.submit.label"
msgstr "Réinitialiser le mot de passe"

msgid "security.password_reset_confirmation.form.new_password.label"
msgstr "Nouveau mot de passe"

msgid "security.password_reset_confirmation.form.confirm_password.label"
msgstr "Confirmer le nouveau mot de passe"

msgid "security.password_reset_confirmation.form.password_mismatch"
msgstr "Les deux mots de passe ne correspondent pas."

msgid "security.password_reset_confirmation.success"
msgstr "Votre mot de passe a été mis à jour avec succès. Vous pouvez maintenant vous connecter."

msgid "security.password_reset_confirmation.error"
msgstr "Votre lien ne semble plus être valide. Veuillez en demander un nouveau."

msgid "security.password_reset_confirmation.weak_password"
msgstr "Votre mot de passe ne respecte pas les règles de sécurité."

msgid "security.password_rules.title"
msgstr "Le mot de passe doit respecter les règles suivantes :"

msgid "security.password_rules.min_length"
msgstr "Au moins 15 caractères"

msgid "security.password_rules.must_contain_letter"
msgstr "Au moins une lettre"

msgid "security.password_rules.two_of_three"
msgstr "Au moins 2 des 3 critères suivants :"

msgid "security.password_rules.uppercase_and_lowercase"
msgstr "Des majuscules et des minuscules"

msgid "security.password_rules.number"
msgstr "Au moins un chiffre"

msgid "security.password_rules.special_char"
msgstr "Au moins un caractère spécial (_ @ $ # & % ! .)"

msgid "security.password_rules.no_spaces"
msgstr "Ne doit pas commencer ou se terminer par un espace"

msgid "security.password_rules.no_name"
msgstr "Ne doit pas contenir 3 lettres consécutives de votre prénom ou nom"

msgid "security.password_rules.no_previous"
msgstr "Doit être différent de vos 3 derniers mots de passe"
