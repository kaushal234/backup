msgid "toc.fields.indice_factor.tooltip"
msgstr "Signification du Facteur d'Importance (IF)\n\nIF=1 : Action administrative, demande de pièces, question technique simple\nIF=10 : Opérations courantes, dépannage technique, nécessite un technicien TLD\nIF=100 : Problèmes techniques graves nécessitant l'attention du CSM et/ou du SSD, ou un support usine\nIF=1000 : Gestion de crise ; accident, mise en danger de personnes et/ou destruction d'équipement, impact commercial négatif grave ou altération sévère de l'image TLD."

msgid "toc.fields.hour_meter.tooltip"
