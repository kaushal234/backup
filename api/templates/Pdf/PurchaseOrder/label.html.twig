{% trans_default_domain "pdfs" %}

<div class="row">
    <div class="col-md-2 packing-slip" >
            <img alt="label" src="{{ generate_qrcode(line.packingSlip, 2) }}" />
            <p>{{ 'purchase_order.labels.packing_slip'|trans }}</p>
    </div>
    <div class="col-md-10">
        <div class="col-md-12">
            <div>
                {{ line.itemCode }} - {{ line.description|u.truncate(45, '...') }}
            </div>
        </div>

        <div class="col-md-6">
            {{ line.site }}<br>
            {{ 'purchase_order.labels.revision'|trans }}: {{ line.engineeringItemRevision }}<br>
            {{ 'purchase_order.labels.purchase_order_identifier'|trans }}: {{ purchaseOrder.orderIdentifier }} <br>
            {{ 'purchase_order.labels.quantity'|trans }}:  {{ line.labelDeliveredQuantity }} <br>
            <div>{{ "now"|date("d-M-y") }}</div>
            {% if line.supplierItemCode is not null %}
                {{ 'purchase_order.labels.part_number'|trans }}:  {{ line.supplierItemCode }} <br>
            {% endif %}
        </div>
        <div class="col-md-6">
            <div class="row">
                <div class="col-md-7">
                    <img alt="label" src="{{ generate_qrcode('%s|%s|%s'|format(purchaseOrder.orderIdentifier, line.itemCode, line.lineIdentifier)) }}" />
                </div>
            </div>
        </div>
    </div>
</div>

