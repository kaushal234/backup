{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block menu %}
    {% set logsLength = ('logs' in collector|keys) ? collector.logs|length : 0 %}
    {% set commentsLength = ('comments' in collector|keys) ? collector.comments|length : 0 %}
    {% set count = (logsLength)+(commentsLength) %}
    <span class="label {{ count > 0 ? 'label-status-warning' }} {{ count == 0 ? 'disabled' }}">
        <span class="icon">
            <svg version="1.1" xmlns="http://www.w3.org/2000/svg">
                <polygon fill="#FFF" points="19.6 7.1 8.2 9 15.5 15.4"/>
                <path fill="#FFF" class="st0" d="m19.9 9.7c-0.4-0.2-0.8-0.4-1.3-0.5l-0.4 0.8c0.5 0.2 0.9 0.4 1.3 0.6 1.5 0.9 2.4 2 2.5 3.1 0 1.1-0.8 2.4-2.2 3.4-1.7 1.2-4 1.9-6.5 2s-4.8-0.4-6.6-1.4c-1.5-0.9-2.4-2-2.5-3.1 0-1 0.6-2.1 1.8-3.1l-0.3-1.2c-0.1 0-0.1 0.1-0.2 0.1-2.1 1.3-3.2 3-3.2 4.9 0.1 1.8 1.3 3.5 3.5 4.6 1.8 0.9 4.1 1.4 6.5 1.4h0.8c2.7-0.1 5.3-0.8 7.2-2 2.1-1.3 3.2-3 3.2-4.9-0.1-2-1.4-3.6-3.6-4.7z"/>
                <polygon fill="#FFF" class="st0" points="5.9 11.5 8.2 9 9.6 10.3"/>
                <polygon fill="#FFF" class="st0" points="0.4 2.4 4.2 5.2 19.6 7.1"/>
            </svg>
        </span>
        <strong>Activity</strong>
        {% if count > 0 %}
            <span class="count">
                <span>{{ count }}</span>
            </span>
        {% endif %}
    </span>
{% endblock %}

{% block panel %}
    {% set logsLength = ('logs' in collector|keys) ? collector.logs|length : 0 %}
    {% set commentsLength = ('comments' in collector|keys) ? collector.comments|length : 0 %}

    <div class="metrics">
        <div class="metric">
            <span class="value">{{ logsLength }}</span>
            <span class="label">Logs</span>
        </div>
        <div class="metric">
            <span class="value">{{ commentsLength }}</span>
            <span class="label">Comments</span>
        </div>
    </div>

    <h2>Logs</h2>
    <table>
        <tr>
            <th>Type</th>
            <th>Resource</th>
            <th>Changeset</th>
        </tr>

        {% for log in (logsLength > 0 ? collector.logs : []) %}
            <tr>
                <td>{{ log.action }}</td>
                <td>{{ log.resource }}</td>
                <td>
                    <ul>
                    {% for property, values in log.changeset %}
                        {% set parsedValues = {
                            before: values[0],
                            after: values[1],
                        } %}
                        {% for value in ['before', 'after'] %}
                            {% if parsedValues[value] is null %}
                                {% set parsedValues = parsedValues|merge({(value): 'null'}) %}
                            {% endif %}
                            {% if parsedValues[value] is same as(true) %}
                                {% set parsedValues = parsedValues|merge({(value): 'true'}) %}
                            {% endif %}
                            {% if parsedValues[value] is same as(false) %}
                                {% set parsedValues = parsedValues|merge({(value): 'false'}) %}
                            {% endif %}
                        {% endfor %}
                        {% if log.action == 'update' %}
                            <li>Property "{{ property }}" has been changed from "{{ parsedValues.before }}" to "{{ parsedValues.after }}"</li>
                        {% else %}
                            <li>Property "{{ property }}" has been set to "{{ parsedValues.after }}"</li>
                        {% endif %}
                    {% endfor %}
                    </ul>
                </td>
            </tr>
        {% endfor %}
    </table>

    <h2>Comments</h2>
    <table>
        <tr>
            <th>Resource</th>
            <th>Comment</th>
            <th>User</th>
        </tr>

        {% for comment in (commentsLength > 0 ? collector.comments : [])  %}
            <tr>
                <td>{{ comment.resource }}</td>
                <td>{{ comment.message }}</td>
                <td>{{ comment.user is not null ? comment.user.username : '' }}</td>
            </tr>
        {% endfor %}
    </table>
{% endblock %}
