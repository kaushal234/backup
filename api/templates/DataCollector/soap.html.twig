{% block panel %}
    <div class="metrics">
        <div class="metric">
            <span class="value">{{ collector.queries|length }}</span>
            <span class="label">Soap Queries</span>
        </div>
    </div>

    {% for query in collector.queries %}
        <table>
        <thead>
            <tr>
                <th>
                    <span class="label"># {{ loop.index }} </span>
                </th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <th>Operation</th>
                <td>{{ query.operation }}</td>
            </tr>
            <tr>
                <th>Execution time</th>
                <td>{{ query.executionTime }}</td>
            </tr>
            <tr>
                <th>Request body</th>
                <td>{% if query.requestBody is not empty %}{{ profiler_dump(query.requestBody[0], maxDepth=1) }}{% endif %}</td>
            </tr>
            <tr>
                <th>XML Request</th>
                <td>
                    <pre lang="xml">{{ query.xmlRequest }}</pre>
                </td>
            </tr>
            <tr>
                <th>Request headers</th>
                <td>{{ query.requestHeaders | nl2br }}</td>
            </tr>
            <tr>
                <th>Response</th>
                <td>
                    <button class="btn btn-sm hidden" data-clipboard-text="{{ query.xmlResponse|e('html_attr') }}">Copy Response</button>
                    <script type="text/javascript">
                        if (navigator.clipboard) {
                            document.querySelectorAll('[data-clipboard-text]').forEach(function(button) {
                                Sfjs.removeClass(button, 'hidden');
                                button.addEventListener('click', function() {
                                    navigator.clipboard.writeText(button.getAttribute('data-clipboard-text'));
                                })
                            });
                        }
                    </script>
                    <hr>
                    <pre lang="xml">{{ query.xmlResponse }}</pre>
                </td>
                <td><pre lang="xml">{{ query.xmlResponse }}</pre></td>
            </tr>
            <tr>
                <th>Response headers</th>
                <td>{{ query.responseHeaders | nl2br }}</td>
            </tr>
        </tbody>
    </table>
    <br>
    {% endfor    %}
{% endblock %}
