{% extends 'Emails/alvest/layout_condensed.html.twig' %}

{% trans_default_domain "emails" %}

{% block body %}
    {{ parent() }}
    <row>
        <columns>
            <p>{{ 'mis_project.message.status' | trans({'%id%': project.id, '%project_name%': project.name, '%status%': project.status}) }}:</p>

            {% if comment is not null %}
                {{ comment | raw }}
            {% endif %}

            <p><a href="{{ url('project', { 'id': project.id }) }}">{{ 'mis_project.message.generic' | trans }}</a></p>
        </columns>
    </row>
{% endblock %}
