{% extends 'Emails/alvest/layout_condensed.html.twig' %}

{% trans_default_domain "emails" %}

{% block body %}
    {{ parent() }}
    <row>
        <columns>
            {% if comment is not null %}
                {{ 'trouble_ticket.message.reason' | trans({'%comment%': comment}) | raw }}
            {% endif %}
            <ul>
                {% for field, values in changeSet %}
                    <li>{{ 'sfr.change' | trans({
                            '%field%': field,
                            '%before%': '<b>' ~ (values[0] is same as ('') ? 'empty' : values[0]) ~ '</b>',
                            '%after%': '<b>' ~ (values[1] is same as ('') ? 'empty' : values[1]) ~ '</b>'
                        }) | raw }}</li>
                {% endfor %}
            </ul>

            <p><a href="{{ url('trouble_ticket', { 'id': troubleTicket.id }) }}">{{ 'trouble_ticket.message.generic' | trans }}</a></p>

            {{ include('Emails/MIS/TroubleTicket/partial/_trouble_ticket.html.twig', {troubleTicket: troubleTicket}, with_context = false) }}
        </columns>
    </row>
{% endblock %}
