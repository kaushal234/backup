{% extends 'Emails/alvest/layout.html.twig' %}
{% trans_default_domain "emails" %}

{% block banner %}
{% endblock %}

{% block body %}
    {{ parent() }}
    <row>
        <columns>
            <p>{{ 'task.task.name' | trans }} <a href="{{ url('calendar', { 'm': ['tasks', 'task', 'view'], 'id': taskId }) }}">#{{ taskId }}</a> {{ 'task.task.assigned' | trans }}</p>

            <p>{{ 'task.description' | trans }}:</p>

            <p>{{ description | raw | nl2br }}</p>
        </columns>
    </row>
{% endblock %}
