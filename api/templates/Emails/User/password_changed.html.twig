{% set _layout = user['@type'] == 'ExtranetUser'
    ? 'Emails/Extranet/layout.html.twig'
    : user['@type'] == 'VendorUser'
    ? 'Emails/Evendors/layout.html.twig'
    : 'Emails/alvest/layout.html.twig'
%}

{% embed _layout %}

    {% trans_default_domain "emails" %}

    {% block body %}
        {{ parent() }}
        <row>
            <columns>
                <p class="text-introduction">{{ 'password.changed.message.hello' | trans({'%firstName%': user.firstname, '%lastName%': user.lastname}) }}</p>
                <p>{{ 'password.changed.message.body' | trans }}</p>
                <p>{{ 'password.changed.message.warning' | trans }}</p>
                <p>{{ 'password.changed.message.regards' | trans }}</p>
            </columns>
        </row>
    {% endblock %}

{% endembed %}