{% extends 'Emails/Extranet/layout.html.twig' %}

{% trans_default_domain "emails" %}

{% block body %}
    {{ parent() }}
    <row>
        <columns>
            <p class="text-introduction">{{ 'password.reset_confirmation.message.hello' | trans({'%firstName%': user.firstname, '%lastName%': user.lastname}) }}</p>
            <a href="https://extranet.tld-gse.com">
                {{ 'password.notification.reminder' | trans({'%days_remaining%' : days_remaining, '%expiration_date%' : expiration_date}) }}
            </a>
            <p style="padding-top: 10px">{{ 'extranet_user.update_password.regards' | trans }}</p>
        </columns>
    </row>
{% endblock %}
