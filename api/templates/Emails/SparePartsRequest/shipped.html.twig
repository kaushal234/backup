{% extends 'Emails/alvest/layout.html.twig' %}
{% trans_default_domain "emails" %}

{% block banner %}
{% endblock %}

{% block body %}
    {{ parent() }}
    <row>
        <columns>
            <p>{{ 'spr.message.shipped'|trans({'%id%': sparePartsRequest.id}) }} {% if trackingNumbers is not empty %}{{ 'spr.message.shipped_extra'|trans }}{% endif %}</p>
            {% if trackingNumbers is not empty %}
                <ul>
                    {% for trackingNumber, courier in trackingNumbers %}
                    <li>{{ courier }}: {{ trackingNumber }}</li>
                    {% endfor %}
                </ul>
            {% endif %}

            {{ include('Emails/SparePartsRequest/partials/_spr.html.twig', {sparePartsRequest: sparePartsRequest}, with_context = false) }}
        </columns>
    </row>
{% endblock %}
