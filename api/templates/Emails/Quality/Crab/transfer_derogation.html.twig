{% extends 'Emails/alvest/layout_condensed.html.twig' %}
{% trans_default_domain "emails" %}

{% block body %}
    <row>
        <columns>
            <a href="{{ url('crab', { id: crab.id }) }}">
                {{ 'crab.derogation.transfer' | trans({
                    '%id%': crab.id,
                    '%assignee_firstname%': crab.derogation.assignee.firstname,
                    '%assignee_lastname%': crab.derogation.assignee.lastname
                }) }}
            </a>
            <br/>
            {{ include('Emails/Quality/Crab/partials/_crab_association_data.html.twig', {crab: crab}) }}
        </columns>
    </row>
{% endblock %}
