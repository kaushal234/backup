{% extends 'Emails/alvest/layout.html.twig' %}

{% block content %}
    <div id="tld">
        {{ parent() }}
    </div>
{% endblock %}

{% block header %}
    {% include 'Emails/tld/_partials/header.html.twig' %}
    <row id="hero">
        <columns>
            {% block banner %}
                <img class="banner" src="https://www.tld-gse.com/shared/emails/banner-1.jpg">
            {% endblock %}
        </columns>
    </row>
{% endblock %}

{% block footer %}
    {% include 'Emails/alvest/_partials/footer.html.twig' with {'link': 'https://www.tld-group.com', 'img': 'https://www.tld-gse.com/shared/emails/tld-watermark.png'} only %}
{% endblock %}
