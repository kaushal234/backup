{% extends 'Emails/alvest/layout_condensed.html.twig' %}
{% trans_default_domain "emails" %}
{% block body %}
    {{ parent() }}
    <row>
        <p>{{ 'sales.pre_delivery_inspection.date_changed.message'|trans({
                '%serialNumber%': preDeliveryInspection.equipmentRecord.serialNumber|default(''),
                '%previousDate%': previousDate,
                '%newDate%': preDeliveryInspection.plannedAt|date('Y-m-d'),
            }, 'emails')|nl2br }}
        </p>

        {{ include('Helpers/_association_table.html.twig', {
            associationData: {
                items: {
                    serialNumber: {
                        label: 'service.equipment_record.fields.serial_number'|trans({}, 'service'),
                        link: {
                            'route': 'legacy_product_support',
                            'fixedParams': {
                                m: ['equipment', 'view'],
                                id: preDeliveryInspection.equipmentRecord.legacyId
                            }
                        }
                    },
                    model: {
                        label: 'service.equipment_record.fields.model'|trans({}, 'service'),
                    },
                    type: {
                        label: 'service.equipment_record.fields.type'|trans({}, 'service'),
                    },
                    customer: {
                        label: 'service.equipment_record.fields.buyer'|trans({}, 'service'),
                        properties: ['buyer.name'],
                    },
                    estimatedGreenTagDate: {
                        label: 'service.equipment_record.fields.estimated_green_tag_date'|trans({}, 'service'),
                        filters: ['date("Y-m-d")'],
                        preserveNull: true,
                    },
                    firstGreenTagDate: {
                        label: 'service.equipment_record.fields.first_green_tag_date'|trans({}, 'service'),
                        filters: ['date("Y-m-d")'],
                        preserveNull: true,
                    }
                },
                data: preDeliveryInspection.equipmentRecord,
            },
        }, with_context = false) }}
    </row>
{% endblock %}
