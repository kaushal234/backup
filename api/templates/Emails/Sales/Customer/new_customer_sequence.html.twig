{% extends 'Emails/alvest/layout.html.twig' %}
{% trans_default_domain "emails" %}

{% block banner %}
{% endblock %}

{% block body %}
    {{ parent() }}
    <row>
        <columns>
            <p>{{ 'customer.message' | trans({
                    '%customerId%': customerId,
                    '%customerName%': customerName
                }, 'emails') }}</p>

            <center>
                <a href="{{ url('calendar', { 'm': ['tasks', 'task', 'view'], 'id': sequenceId }) }}">{{ 'customer.link' | trans({'%sequenceId%': sequenceId}, 'emails') }}</a>
            </center>

            <p>{{ 'task.description' | trans }}:</p>

            <p>{{ sequenceDescription | raw | nl2br }}</p>
        </columns>
    </row>
{% endblock %}
