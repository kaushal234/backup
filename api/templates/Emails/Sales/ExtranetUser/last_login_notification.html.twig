{% extends 'Emails/alvest/layout.html.twig' %}
{% trans_default_domain 'emails' %}

{% block banner %}
{% endblock %}

{% block body %}
    <row>
        <columns>
            <p>{{ 'extranet_user.last_login.intro' | trans | nl2br }}</p>
            <br>
            {{ include('Helpers/_report_table.html.twig', {
                reportTable: {
                    title: false,
                    items: {
                        id: { label: 'extranet_user.fields.id'|trans },
                        name: {
                            label: 'extranet_user.fields.name'|trans,
                            properties: ['lastname', 'firstname'],
                        },
                        customer: {
                            label: 'demo.fields.customer' | trans,
                        },
                        nbConnections: {
                            label: 'extranet_user.fields.counter' | trans,
                        }
                    },
                    data: extranet_users_connections
                }
            }, with_context = false) }}
        </columns>
    </row>

{% endblock %}
