{% extends 'Emails/Extranet/layout.html.twig' %}
{% trans_default_domain "emails" %}

{% block body %}
    <row>
        <columns>
            <p>
                {{ 'extranet_user.update_password.intro' | trans({
                    '%gender%': extranetUser.gender,
                    '%firstname%': extranetUser.firstname | lower | capitalize,
                    '%lastname%': extranetUser.lastname | upper,
                }, 'emails') }}
            </p>
            <p>
                {{ 'extranet_user.update_password.link' | trans }}
                <br>
                <a href="{{ url('extranet_update_password') ~ '?updateToken=' ~ extranetUser.token }}">Update my password</a>            </p>
            <p>
                {{ 'extranet_user.update_password.regards' | trans({}, 'emails') }}
            </p>
        </columns>
    </row>
{% endblock %}
