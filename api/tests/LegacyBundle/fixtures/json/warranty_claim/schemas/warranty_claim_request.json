{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "@id": {
      "type": "string",
      "pattern": "^/warranty_claims/\\d+$"
    },
    "@type": {
      "type": "string"
    },
    "@context": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "claimDate": {
      "type": ["string", "null"],
      "format": "date"
    },
    "description": {
      "type": ["string", "null"]
    },
    "type": {
      "type": "string"
    },
    "equipmentModel": {
      "type": "string"
    },
    "serialNumber": {
      "type": ["string", "null"]
    },
    "equipmentHours": {
      "type": ["integer", "null"]
    },
    "customerName": {
      "type": ["string", "null"]
    },
    "claimantDetails": {
      "type": ["string", "null"]
    },
    "equipmentLocation": {
      "type": ["string", "null"]
    },
    "enteredBy": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "@id": {
          "type": "string"
        },
        "@type": {
          "type": "string"
        },
        "username": {
          "type": "string"
        }
      },
      "required": [
        "username"
      ]
    },
    "details": {
      "type": ["string", "null"]
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "@id": {
            "type": "string"
          },
          "@type": {
            "type": "string"
          },
          "partNumber": {
            "type": "string"
          },
          "partDescription": {
            "type": "string"
          },
          "quantity": {
            "type": "string"
          },
          "unitOfMeasure": {
            "type": "string"
          },
          "spr": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "@id": {
                "type": "string"
              },
              "@type": {
                "type": "string"
              },
              "id": {
                "type": "integer"
              },
              "status": {
                "type": "string"
              },
              "createdAt": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "status",
              "createdAt"
            ]
          }
        },
        "required": [
          "partNumber",
          "partDescription",
          "quantity",
          "unitOfMeasure",
          "spr"
        ]
      }
    }
  },
  "required": [
    "@id",
    "@type",
    "status",
    "claimDate",
    "type",
    "equipmentModel",
    "serialNumber",
    "equipmentHours",
    "customerName",
    "claimantDetails",
    "equipmentLocation",
    "enteredBy",
    "details",
    "description",
    "parts"
  ]
}