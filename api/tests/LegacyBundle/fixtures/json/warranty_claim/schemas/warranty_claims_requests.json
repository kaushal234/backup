{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "@id": {
            "pattern": "^/warranty_claims"
        },
        "hydra:member": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "@id": {
                        "pattern": "^/warranty_claims/\\d+$"
                    },
                    "@type": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "claimDate": {
                        "type": ["string", "null"]
                    },
                    "description": {
                        "type": ["string", "null"]
                    },
                    "type": {
                        "type": "string"
                    },
                    "equipmentModel": {
                        "type": "string"
                    },
                    "serialNumber": {
                        "type": ["string", "null"]
                    },
                    "customerName": {
                        "type": ["string", "null"]
                    },
                    "equipmentLocation": {
                        "type": ["string", "null"]
                    }
                },
                "required": [
                    "@id",
                    "@type",
                    "status",
                    "claimDate",
                    "type",
                    "equipmentModel",
                    "serialNumber",
                    "customerName",
                    "equipmentLocation",
                    "description"
                ]
            },
            "minItems": 1
        }
    },
    "required": ["hydra:member", "@id"]
}