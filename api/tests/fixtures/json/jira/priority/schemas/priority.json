{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {"type": "string"},
    "@id": {"pattern": "^/jira/priorities/\\d+$"},
    "@type": { "type": "string" },
    "id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" }
  },
  "required": ["@context", "@id", "@type", "id", "name", "description"],
  "additionalProperties": false
}
