{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {"type": "string"},
    "@id": {"pattern": "^/jira/(issues|trouble_ticket_issues|user_story_issues)/[\\w\\-]+$"},
    "@type": { "type": "string" },
    "id": { "type": "string" },
    "troubleTicketId": { "type": ["integer", "null"] },
    "userStoryId": { "type": ["string", "null"] },
    "startDueDate": { "type": ["string", "null"] },
    "endDueDate": { "type": ["string", "null"] },
    "status": { "type": "string" },
    "priority": {
      "type": "object",
      "properties": {
        "@id": {"pattern": "^/jira/priorities/\\d+$"},
        "@type": { "type": "string" },
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["@id", "@type", "id", "name"],
      "additionalProperties": false
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "id",
    "startDueDate",
    "endDueDate",
    "status",
    "priority"
  ],
  "additionalProperties": false
}
