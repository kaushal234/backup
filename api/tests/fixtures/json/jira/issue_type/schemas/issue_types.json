{
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/jira/issue_types"},
    "hydra:member": {
      "type": "array",
      "items": {
        "properties": {
          "@id": {"pattern": "^/jira/issue_types/\\d+$"},
          "@type": { "type": "string" },
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        },
        "required": ["@id", "@type", "id", "name", "description"],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:member"
  ]
}
