{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {
      "pattern": "^/quality/derogations"
    },
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {"pattern": "^/quality/derogations/\\d+$"},
          "@type": {"type": "string"},
          "id": {"type": "integer"},
          "shortDescription": {"type": "string"},
          "crabs": {
            "type": "array",
            "items": {
              "properties": {
                "@id": {"type": "string"},
                "@type": {"type": "string"},
                "equipmentRecord": {
                  "type": "object",
                  "properties": {
                    "@id": {"type": "string"},
                    "@type": {"type": "string"},
                    "serialNumber": {"type": "string"},
                    "model": {"type":  "string"},
                    "type": {"type":  "string"}
                  },
                  "required": ["@id", "@type", "serialNumber", "model", "type"],
                  "additionalProperties": false
                }
              },
              "required": ["@id", "@type", "equipmentRecord"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "@id",
          "@type",
          "id",
          "shortDescription",
          "crabs"
        ],
        "additionalProperties": false
      }
    }
  }
}
