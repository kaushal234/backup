{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {
      "pattern": "^/quality/derogations"
    },
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {"pattern": "^/quality/derogations/\\d+$"},
          "@type": {"type": "string"},
          "id": {"type": "integer"},
          "description": {"type": "string"},
          "shortDescription": {"type": "string"},
          "status": {"type": "string"},
          "dueDate": {"type": "string"},
          "comment": {
            "type": ["string", "null"]
          },
          "crabs": {
            "type": "array",
            "items": {
              "properties": {
                "@id": {"type": "string"},
                "@type": {"type": "string"},
                "equipmentRecord": {
                  "type": "object",
                  "properties": {
                    "@id": {"type": "string"},
                    "@type": {"type": "string"},
                    "serialNumber": {"type": "string"},
                    "model": {"type":  "string"},
                    "type": {"type":  "string"}
                  },
                  "required": ["@id", "@type", "serialNumber", "model", "type"],
                  "additionalProperties": false
                }
              },
              "required": ["@id", "@type", "equipmentRecord"],
              "additionalProperties": false
            }
          },
          "assignee": {
            "type": "object",
            "properties": {
              "@id": {"pattern": "^/(people|((sales|purchasing)/(extranet_|vendor_))?users)/\\d+$"},
              "@type": {
                "type": "string"
              },
              "id": {
                "type": "integer"
              },
              "firstname": {
                "type": "string"
              },
              "lastname": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "legacyId": {
                "type": "integer"
              },
              "username": {
                "type": "string"
              }
            },
            "required": [
              "@id",
              "@type",
              "firstname",
              "lastname",
              "email",
              "username"
            ],
            "additionalProperties": false
          },
          "assignor": {
            "type": "object",
            "properties": {
              "@id": {"pattern": "^/(people|((sales|purchasing)/(extranet_|vendor_))?users)/\\d+$"},
              "@type": {
                "type": "string"
              },
              "id": {
                "type": "integer"
              },
              "firstname": {
                "type": "string"
              },
              "lastname": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "legacyId": {
                "type": "integer"
              },
              "username": {
                "type": "string"
              }
            },
            "required": [
              "@id",
              "@type",
              "firstname",
              "lastname",
              "email",
              "username"
            ],
            "additionalProperties": false
          },
          "closedAt": {"type": ["string", "null"]},
          "closedBy": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "../../directory_people/schemas/directory_people_public.json"}
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "iri-reference"
            }
          }
        },
        "required": [
          "@id",
          "@type",
          "id",
          "status",
          "description",
          "assignee",
          "assignor",
          "dueDate",
          "crabs",
          "shortDescription",
          "closedAt",
          "closedBy",
          "comment",
          "files"
        ],
        "additionalProperties": false
      }
    }
  }
}
