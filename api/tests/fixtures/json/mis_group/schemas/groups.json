{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/groups$"},
    "@type": {"type": "string"},
    "@context": {"type": "string"},
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {"pattern": "^/groups/\\d+$"},
          "@type": {"type": "string"},
          "id": {"type": "integer"},
          "name": {"type": "string"},
          "description": {"type": "string"},
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "legacyId": {"type": "integer"}
        },
        "required": ["@id", "@type", "legacyId", "name", "description", "features"],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": ["@context", "@id", "@type", "hydra:member"]
}
