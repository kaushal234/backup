{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {"pattern": "^/regions/\\d+$"},
    "@type": {
      "type": "string"
    },
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "legacyId": {
      "type": "integer"
    },
    "subDivision": {
      "type": "object",
      "properties": {
        "@id": {"pattern": "^/sub_divisions/\\d+$"},
        "@type": {"type": "string"},
        "legacyId": {"type": "integer"},
        "name": {"type": "string"}
      },
      "required": ["@id", "@type", "legacyId", "name"],
      "additionalProperties": false
    },
    "representative": {
      "type": "object",
      "properties": {
        "@id": {"pattern": "^/people/\\d+$"},
        "@type": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "firstname": {
          "type": "string"
        },
        "lastname": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "legacyId": {
          "type": "integer"
        }
      },
      "required": [
        "@id",
        "@type",
        "firstname",
        "lastname",
        "email",
        "legacyId",
        "username"
      ],
      "additionalProperties": false
    },
    "businessUnits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "@id",
          "@type",
          "name"
        ]
      }
    }
  },
  "required": [
    "@id",
    "@context",
    "@type",
    "id",
    "legacyId",
    "name",
    "representative",
    "businessUnits",
    "subDivision"
  ],
  "additionalProperties": false
}
