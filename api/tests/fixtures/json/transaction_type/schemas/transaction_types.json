{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/finance/transaction_types$"},
    "hydra:member": {
      "type": "array",
      "items": {
        "properties": {
          "@id": {"pattern": "^/finance/transaction_types/\\d+$"},
          "@type": { "type": "string" },
          "name": { "type": "string" }
        },
        "required": ["@id", "@type", "name"],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": ["@context", "@id", "@type", "hydra:member"]
}
