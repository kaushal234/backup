{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/quality/non_quality_costs"},
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {"pattern": "^/quality/non_quality_costs/\\d+$"},
          "@type": {"type": "string"},
          "location": {"$ref": "../../directory_location/schemas/directory_location_public.json"},
          "defaultCosts": {"type": "integer"}
        },
        "required": [
          "@id",
          "@type",
          "location",
          "defaultCosts"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:member"
  ]
}
