{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {
      "pattern": "^/mis/support_teams/\\d+$"
    },
    "@type": {
      "type": "string"
    },
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    }
  },
  "required": [
    "@id",
    "@type",
    "id",
    "name"
  ],
  "additionalProperties": false
}
