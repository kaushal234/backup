{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {"pattern": "^/sub_divisions$"},
    "@type": {
      "type": "string"
    },
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {"pattern": "^/sub_divisions/\\d+$"},
          "@type": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "legacyId": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "division": {
            "type": "object",
            "properties": {
              "@id": {"pattern": "^/divisions/\\d+$"},
              "@type": {"type": "string"},
              "id": {"type": "integer"},
              "legacyId": {"type": "integer"},
              "name": {"type": "string"}
            },
            "required": ["@id", "@type", "id", "legacyId", "name"],
            "additionalProperties": false
          }
        },
        "required": [
          "@id",
          "@type",
          "id",
          "legacyId",
          "name",
          "division"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:member"
  ]
}
