{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "@context": {
            "type": "string"
        },
        "@id": {
            "pattern": "^/purchasing/supplier_ranking_files$"
        },
        "@type": {
            "type": "string"
        },
        "hydra:member": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "@id": {"pattern": "^/purchasing/supplier_ranking_files/\\d+$"},
                    "@type": {
                        "type": "string"
                    },
                    "category": {
                        "type": "object",
                        "properties": {
                            "@id": {"pattern": "^/purchasing/supplier_ranking/file_categories/\\d+$"},
                            "@type": {
                                "type": "string"
                            },
                            "name": {
                                "type": "string"
                            },
                            "id": {
                                "type": "integer"
                            }
                        },
                        "required": [
                            "@id",
                            "@type",
                            "id",
                            "name"
                        ]
                    },
                    "expiredAt": {
                        "type": ["string", "null"]
                    },
                    "expired": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "@id",
                    "@type",
                    "category",
                    "expired"
                ],
                "additionalProperties": false
            },
            "minItems": 1
        }
    },
    "required": [
        "@context",
        "@id",
        "@type",
        "hydra:member"
    ]
}
