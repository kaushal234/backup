{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "@id": {"pattern": "^/purchasing/supplier_ranking_files/\\d+$"},
        "@type": {
            "type": "string"
        },
        "category": {
            "type": "object",
            "properties": {
                "@id": {"pattern": "^/purchasing/supplier_ranking/file_categories/\\d+$"},
                "@type": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                }
            },
            "required": [
                "@id",
                "@type",
                "id",
                "name"
            ]
        },
        "expiredAt": {
            "type": ["string", "null"]
        },
        "expired": {
            "type": "boolean"
        }
    },
    "required": [
        "@id",
        "@type",
        "name",
        "isSupplierApproved",
        "color"
    ],
    "additionalProperties": false
}
