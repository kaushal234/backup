{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "@context": {
            "type": "string"
        },
        "@id": {
            "pattern": "^/purchasing/supplier_ranking/criterias/\\d+$"
        },
        "@type": {
            "type": "string"
        },
        "name": {
            "type": "string"
        },
        "minTurnover": {
            "type": "integer"
        },
        "public": {
            "type": "boolean"
        },
        "id": {
            "type": "integer"
        }
    },
    "required": [
        "@id",
        "@type",
        "id",
        "name"
    ],
    "additionalProperties": false
}
