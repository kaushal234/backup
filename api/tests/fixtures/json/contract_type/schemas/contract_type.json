{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": { "type": "string" },
    "@id": {"pattern": "^/contract_types/\\d+$"},
    "@type": { "type": "string" },
    "id": { "type": "integer" },
    "name": { "type": "string" },
    "description": { "type": "string" }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "id",
    "name",
    "description"
  ],
  "additionalProperties": false
}
