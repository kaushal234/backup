{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {
      "readOnly": true,
      "type": "string",
      "pattern": "^/support/manual_prints/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "@type": {
      "type": "string"
    },
    "id": {
      "type": "integer"
    },
    "legacyId": {
      "type": "integer"
    }
  },
  "required": [
    "@id",
    "@type",
    "legacyId"
  ]
}