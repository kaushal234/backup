{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {"pattern": "^/support/manual_documents/\\d+$"},
    "@type": {
      "type": "string"
    },
    "id": {
      "type": "integer"
    },
    "legacyId": {
      "type": "integer"
    }
  },
  "required": [
    "@id",
    "@type",
    "legacyId"
  ]
}