{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {
      "pattern": "^/quality/crab_codes/\\d+$"
    },
    "@type": {
      "type": "string"
    },
    "id": {
      "type": "integer"
    },
    "code": {
      "type": "integer"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "@id",
    "@type",
    "id",
    "code",
    "description"
  ],
  "additionalProperties": false
}