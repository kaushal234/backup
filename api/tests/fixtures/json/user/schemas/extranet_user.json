{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {
      "pattern": "^/((sales/extranet_)?users)/\\d+$"
    },
    "@type": {
      "type": "string"
    },
    "id": {
      "type": "integer"
    },
    "firstname": {
      "type": "string"
    },
    "lastname": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "legacyId": {
      "type": "integer"
    },
    "username": {
      "type": "string"
    },
    "disabled": {
      "type": "boolean"
    },
    "phones": {
      "type": "array",
      "items": {
        "type": [
          "object"
        ],
        "properties": {
          "@id": {
            "pattern": "^/people/\\d+$"
          },
          "@type": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "number": {
            "type": "string"
          }
        },
        "required": [
          "@id",
          "@type",
          "type",
          "number"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "extranetUserProfile": {
      "type": "object",
      "properties": {
        "@id": {
          "pattern": "^/sales/extranet_user_profiles/\\d+$"
        },
        "@type": {
          "type": "string"
        },
        "legacyId": {
          "type": "integer"
        }
      }
    }
  },
  "required": [
    "@id",
    "@type",
    "firstname",
    "lastname",
    "email",
    "username"
  ],
  "additionalProperties": false
}
