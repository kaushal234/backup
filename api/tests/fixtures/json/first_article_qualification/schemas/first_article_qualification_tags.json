{
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {"pattern": "^/tags$"},
    "@type": {
      "type": "string"
    },
    "hydra:member": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "@id": {"pattern": "^/quality/first_article_qualification_tags/\\d+$"},
          "@type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "@id",
          "@type",
          "name"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "hydra:totalItems": {
      "type": "integer"
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:member"
  ]
}

