              "type": "object",
              "properties": {
                "@id": {"pattern": "^/quality/first_article_qualifications_part_numbers/\\d+$"},
                "@type": {
                  "type": "string"
                },
                "number": {
                  "type": "string"
                },
                "revision": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "supplierNumber": {
            "type": "string"
          },
          "supplierName": {
            "type": "string"
          },
          "buyer": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "../../directory_people/schemas/directory_people_public.json"
              }
            ]
          },
          "poster": {
            "$ref": "../../directory_people/schemas/directory_people_public.json"
          },
          "owner": {
            "$ref": "../../directory_people/schemas/directory_people_public.json"
          },
          "createdAt": {
            "type": "string"
          },
          "completedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "planDefinitionCompletedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "planDefinitionDueDate": {
            "type": "string"
          },
          "deliverablesDueDate": {
            "type": ["string", "null"]
          },
          "dueDate": {
            "type": "string"
          },
          "iFactor": {
            "type": ["string", "null"]
          },
          "eap": {
            "type": [
              "integer",
              "null"
            ]
          },
          "meap": {
            "type": [
              "integer",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "planApprovalStatus": {
            "type": "string"
          }
        },
        "required": [
          "@id",
          "@type",
          "id",
          "location",
          "partNumbers",
          "supplierNumber",
          "supplierName",
          "buyer",
          "poster",
          "owner",
          "createdAt",
          "completedAt",
          "planDefinitionCompletedAt",
          "planDefinitionDueDate",
          "deliverablesDueDate",
          "dueDate",
          "eap",
          "meap",
          "status",
          "planApprovalStatus",
          "iFactor"
