{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {
      "pattern": "^/materials/warehouse/sectors$"
    },
    "@type": {
      "type": "string"
    },
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {
            "pattern": "^/materials/warehouse/sectors/\\d+$"
          },
          "@type": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "location": {
            "$ref": "../../directory_location/schemas/directory_location_public.json"
            }
        },
        "additionalProperties": false,
        "required": [
          "@id",
          "@type",
          "id",
          "name",
          "location"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:totalItems",
    "hydra:member",
    "hydra:search"
  ]
}


