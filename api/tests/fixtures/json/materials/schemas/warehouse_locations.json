{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {
      "pattern": "^/materials/warehouse/locations$"
    },
    "@type": {
      "type": "string"
    },
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {
            "pattern": "^/materials/warehouse/locations/\\d+$"
          },
          "@type": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "erp": {
            "type": "integer"
          },
          "warehouse": {
            "type": "string"
          },
          "locationNumber": {
            "type": "string"
          },
          "sector": {
            "type": ["object", "null"],
            "pattern": "^/materials/warehouse/sectors/\\d+$"
          }
        },
        "additionalProperties": false,
        "required": [
          "@id",
          "@type",
          "id",
          "erp",
          "warehouse",
          "locationNumber"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:member"
  ]
}

