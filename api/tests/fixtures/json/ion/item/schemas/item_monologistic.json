{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "readOnly": true,
      "type": "string"
    },
    "@id": {
      "pattern": "^/ion/item_monologistics/.+$"
    },
    "@type": {
      "readOnly": true,
      "type": "string"
    },
    "itemCode": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "unitOfMeasure": {
      "type": "string"
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "itemCode",
    "description",
    "unitOfMeasure"
  ],
  "additionalProperties": false
}
