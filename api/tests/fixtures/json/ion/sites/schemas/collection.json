{
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {"pattern": "^/ion/sites/.+$"},
          "@type": {"type": "string"},
          "siteID": {"type": "string"},
          "siteDescription": {"type": "string"},
          "siteAddressCode": {"type": "string"},
          "siteAddressName": {"type": "string"}
        },
        "required": [
          "@id",
          "@type",
          "siteID",
          "siteDescription",
          "siteAddressCode",
          "siteAddressName"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "additionalProperties": false
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:member"
  ]
}
