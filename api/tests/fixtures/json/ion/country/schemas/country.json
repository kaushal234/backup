{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$ref": "#/definitions/ionCountries.jsonld",
    "definitions": {
        "ionCountries.jsonld": {
            "type": "object",
            "description": "",
            "properties": {
                "@context": {
                    "readOnly": true,
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "object",
                            "properties": {
                                "@vocab": {
                                    "type": "string"
                                },
                                "hydra": {
                                    "type": "string",
                                    "enum": [
                                        "http://www.w3.org/ns/hydra/core#"
                                    ]
                                }
                            },
                            "required": [
                                "@vocab",
                                "hydra"
                            ],
                            "additionalProperties": true
                        }
                    ]
                },
                "@id": {
                    "readOnly": true,
                    "type": "string",
                    "pattern": "^/ion/countries/\\w{2}$"
                },
                "@type": {
                    "readOnly": true,
                    "type": "string"
                },
                "country": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "isoCodeAlpha2": {
                    "type": "string"
                },
                "isoCodeAlpha3": {
                    "type": "string"
                },
                "telephone": {
                    "type": "string"
                },
                "telex": {
                    "type": "string"
                },
                "fax": {
                    "type": "string"
                },
                "euMember": {
                    "default": "no",
                    "example": "no",
                    "type": "string"
                },
                "currency": {
                    "type": "string"
                }
            },
            "required": [
                "@context",
                "@id",
                "@type",
                "country",
                "description",
                "isoCodeAlpha2",
                "isoCodeAlpha3",
                "telephone",
                "telex",
                "fax",
                "euMember",
                "currency"
            ],
            "additionalProperties": false
        }
    }
}
