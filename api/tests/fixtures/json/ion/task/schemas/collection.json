{
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {"pattern": "^/ion/tasks/.+$"},
          "@type": {"type": "string"},
          "code": {"type": "string"},
          "description": {"type": "string"},
          "type": {"type": "string"}
        },
        "required": [
          "@id",
          "@type",
          "code",
          "description",
          "type"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "additionalProperties": false
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:member"
  ]
}
