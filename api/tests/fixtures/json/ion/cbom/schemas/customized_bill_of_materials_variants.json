{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/ion/customized_bill_of_materials/site=\\d{3};project=.*$"},
    "@type": {"type": "string"},
    "@context": {"type": "string"},
    "site": {"type": "integer"},
    "project": {"type": "string"},
    "product": {"type": "string"},
    "billOfMaterials":  {
      "type": "object",
      "properties": {
        "@type": {"pattern": "^BillOfMaterial"},
        "@id": { "type": "string" },
        "code": {"type":  "string"},
        "revision": {"type":  "string"},
        "effectiveDate": {"type":  "string"},
        "expiryDate": {"type": "string"}
      },
      "required": [
        "@type",
        "@id",
        "code",
        "revision",
        "effectiveDate",
        "expiryDate"
      ],
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {"$ref": "item.json"},
      "minItems": 0
    },
    "productVariants": {
      "type": "array",
      "items": {"$ref": "product_variant.json"},
      "minItems": 1
    },
    "standardItemProject": {"type":  ["string", "null"]},
    "standardItem": {"type":  "string"},
    "position": {"type":  "integer"},
    "partNumberProject": {"type": ["string", "null"]},
    "partNumber": {"type": "string"},
    "quantity": {"type": "number"},
    "level": {"type": "integer"},
    "operation": {"type": "string"},
    "unitOfMeasure":{"type": ["string", "null"]},
    "itemSignalCode": {"type": ["string", "null"]},
    "itemDescription": {"type": ["string", "null"]},
    "itemOtherDescription": {"type": ["string", "null"]},
    "itemSelectionCode": {"type": ["string", "null"]},
    "extraInformation": {"type": ["string", "null"]},
    "itemType": {"type": ["string", "null"]},
    "itemGroup": {"type": ["string", "null"]},
    "customized": {"type": ["boolean", "null"]},
    "purchaseStatisticsGroup": {"type": ["string", "null"]},
    "buyFromBusinessPartner": {"type": ["string", "null"]},
    "buyFromBusinessPartnerName": {"type": ["string", "null"]},
    "buyer": {"type": ["string", "null"]},
    "supplyTime": {"type": ["integer", "null"]},
    "engineeringRevision": {"type": ["string", "null"]},
    "engineeringSignalCode": {"type": ["string", "null"]},
    "engineeringDescription": {"type": ["string", "null"]},
    "engineeringOtherDescription": {"type": ["string", "null"]},
    "engineeringSelectionCode": {"type": ["string", "null"]},
    "orderQuantityIncrement": {"type": ["integer", "null"]},
    "minimumOrderQuantity": {"type": ["integer", "null"]},
    "safetyStock": {"type": ["integer", "null"]},
    "salesPriceGroup": {"type": ["string", "null"]},
    "warehouse":  {"type": ["string", "null"]},
    "estimatedStandardCost":  {"type": ["number", "null"]},
    "backflushIfMaterial":  {"type": ["boolean", "null"]},
    "phantom":  {"type": ["boolean", "null"]},
    "signalCodeDescription": {"type": ["string", "null"]},
    "preventive":  {"type": ["boolean", "null"]},
    "maintenance":  {"type": ["boolean", "null"]},
    "overhaul":  {"type": ["boolean", "null"]},
    "critical":  {"type": ["boolean", "null"]},
    "engineeringRevisionDescription":  {"type": ["string", "null"]},
    "engineeringRevisionEffectiveDate":  {"type": ["string", "null"]},
    "engineeringRevisionExpiryDate":  {"type": ["string", "null"]},
    "engineeringRevisionDrawing":  {"type": ["string", "null"]},
    "expired":  {"type": ["boolean"]}
  },
  "required": [
    "@id",
    "@type",
    "@context",
    "site",
    "project",
    "product",
    "expired",
    "productVariants"
  ],
  "additionalProperties": false
}
