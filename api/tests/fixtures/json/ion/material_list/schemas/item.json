{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/ion/material_lists/.+$"},
    "@type": {"type": "string"},
    "@context": {"type": "string"},
    "site": {"type": "string"},
    "productionOrder": {"type": "string"},
    "productionOrderStatus": {"type": "string"},
    "project": {"type": "string"},
    "projectStatus": {"type": "string"},
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {"type": "string"},
          "@type": {"type": "string"},
          "position": {"type": "string"},
          "operation": {"type": "string"},
          "item": {"type": "string"},
          "itemDescription": {"type": "string"},
          "itemOtherDescription": {"type": "string"},
          "warehouse": {"type": "string"},
          "netQuantity": {"type": "number"},
          "estimatedQuantity": {"type": "number"},
          "actualQuantity": {"type": "number"},
          "unitOfMeasure": {"type": "string"},
          "revision": {"type": "string"},
          "reportMaterial": {"type": "string"},
          "inventoryOnHand": {"type": "integer"},
          "inventoryOnOrder": {"type": "integer"},
          "costPrice": {"type": "number"},
          "currency": {"type": "string"}
        },
        "required": [
          "@id",
          "@type",
          "position",
          "operation",
          "item",
          "itemDescription",
          "itemOtherDescription",
          "warehouse",
          "netQuantity",
          "estimatedQuantity",
          "actualQuantity",
          "unitOfMeasure",
          "costPrice",
          "currency"
        ],
        "additionalProperties": false
      },
      "additionalProperties": false
    }
  },
  "required": [
    "@id",
    "@type",
    "@context",
    "site",
    "productionOrder",
    "productionOrderStatus",
    "project",
    "projectStatus",
    "materials"
  ],
  "additionalProperties": false
}
