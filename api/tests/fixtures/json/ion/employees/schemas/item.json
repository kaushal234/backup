{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/ion/employees/.+$"},
    "@type": {"type": "string"},
    "@context": {"type": "string"},
    "employeeCode": {"type": "string"},
    "fullName": {"type": "string"},
    "erp": {"type": ["string", "null"]},
    "emailAddress": {"type": ["string", "null"]},
    "baanLegacyId": {"type": "string"}
  },
  "required": [
    "@id",
    "@type",
    "employeeCode",
    "fullName",
    "erp",
    "baanLegacyId",
    "emailAddress"
  ],
  "additionalProperties": false
}
