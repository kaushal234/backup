{
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {"pattern": "^/ion/employees/.+$"},
          "@type": {"type": "string"},
          "employeeCode": {"type": "string"},
          "fullName": {"type": "string"},
          "erp": {"type": "string"},
          "baanLegacyId": {"type": "string"},
          "emailAddress": {"type": ["string", "null"]}
        },
        "required": [
          "@id",
          "@type",
          "employeeCode",
          "fullName",
          "erp",
          "baanLegacyId",
          "emailAddress"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "additionalProperties": false
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:member",
    "hydra:search"
  ]
}
