{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "@context": {"type": "string"},
        "@id": {"type": "string"},
        "@type": {"type": "string"},
        "code": {"type": "string"},
        "name": {"type": "string"},
        "role": {"type": "string"},
        "status": {"type": "string"},
        "currency": {"type": "string"},
        "text": {"type": "string"},
        "contacts": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "@id": {"type": "string"},
                    "@type": {"type": "string"},
                    "contactCode": {"type": "string"},
                    "emailAddress": {"type": "string"},
                    "firstName": {"type": "string"},
                    "familyName": {"type": "string"},
                    "fullName": {"type": "string"},
                    "middleName": {"type": "string"},
                    "telephone": {"type": "string"},
                    "grantedQualityCategory": {"type": "boolean"},
                    "categories": {
                        "type": "array",
                        "properties": {
                            "@id": {"type": "string"},
                            "@type": {"type": "string"},
                            "description": {"type": "string"}
                        },
                        "required": ["@id", "@type", "description"],
                        "additionalProperties": false
                    }
                },
                "required": ["@id", "@type", "contactCode", "emailAddress", "firstName", "familyName", "fullName", "categories", "middleName"],
                "additionalProperties": false
            }
        },
        "buyer": {
            "oneOf": [
                { "type": "null" },
                { "$ref": "../../employees/schemas/item.json" }
            ]
        },
        "buyFromDepartments":{
            "type": "array",
            "items": {
                "$ref": "../../department/schemas/department.json"
            }
        }
    },
    "required": [
        "@type",
        "code",
        "name",
        "role",
        "status",
        "buyer",
        "buyFromDepartments",
        "currency",
        "text",
        "contacts"
    ],
    "additionalProperties": false
}
