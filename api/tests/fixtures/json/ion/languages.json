{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/ion/languages"},
    "hydra:member": {
      "type": "array",
      "items": [
        {
          "properties": {
            "iso639_2": {"type": "string"},
            "codeAlpha2": {"type": "string"},
            "iso639": {"type": "string"}
          },
          "required": [
            "@id",
            "@type",
            "iso639_2",
            "iso639"
          ]
        }
      ]
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:member"
  ]
}