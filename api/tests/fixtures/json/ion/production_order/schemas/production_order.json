{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {"type": "string"},
    "@type": {"type": "string"},
    "@id": {"pattern": "^/ion/production_orders/.*"},
    "site": {"type":  "integer"},
    "project": {
      "type": "array",
      "items":{
        "additionalProperties": false,
        "properties": {
          "@id": {"type": "string"},
          "@type": {"type": "string"},
          "code": {"type": "string"},
          "openCrabs": {"type": "integer"},
          "totalCrabs": {"type": "integer"},
          "status": {"type": "string"}
        },
        "required": [
          "@id",
          "@type",
          "code",
          "openCrabs",
          "totalCrabs",
          "status"
        ],
        "type": "object"
      }
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "site",
    "project"
  ],
  "additionalProperties": false
}