{
  "type": "object",
  "properties": {
    "@context": { "type": "string" },
    "@id": { "pattern": "^/contract/sub_categories$" },
    "@type": { "enum": ["hydra:Collection"] },
    "hydra:totalItems": { "type": "integer" },
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": { "pattern": "^/contract/sub_categories/\\d+$" },
          "@type": { "enum": ["SubCategory"] },
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "displayedName": { "type": "string" },
          "isAllow": { "type": "boolean" },
          "category": { "pattern": "^/contract/categories/\\d+$" }
        },
        "required": ["@id", "@type", "id", "name", "category", "displayedName", "isAllow"],
        "additionalProperties": false
      }
    },
    "hydra:search": {
      "type": "object",
      "properties": {
        "@type": { "type": "string" },
        "hydra:template": { "type": "string" },
        "hydra:variableRepresentation": { "type": "string" },
        "hydra:mapping": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "@type": { "type": "string" },
              "variable": { "type": "string" },
              "property": { "type": "string" },
              "required": { "type": "boolean" }
            },
            "required": ["@type", "variable", "property", "required"],
            "additionalProperties": false
          }
        }
      },
      "required": ["@type", "hydra:template", "hydra:mapping"],
      "additionalProperties": false
    }
  },
  "required": ["@context", "@id", "@type", "hydra:totalItems", "hydra:member", "hydra:search"],
  "additionalProperties": false
}
