{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {"pattern": "^/power_bi/reports/\\d+$"},
    "@type": {"type": "string"},
    "id": {"type": "integer"},
    "title": {"type": "string"},
    "description": {"type": ["string", "null"]},
    "powerBiUuid": {"type": "string"},
    "category": {"type": "string"},
    "subCategories": {"type": "array"},
    "groups": {
      "type": "array",
      "items": {
        "ref": "../../mis_group/schemas/group.json"
      }
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "id",
    "title",
    "powerBiUuid",
    "category",
    "subCategories"
  ],
  "additionalProperties": false
}