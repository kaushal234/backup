{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": { "type": "string" },
    "@id": { "pattern": "^/contract/categories/\\d+$" },
    "@type": { "enum": ["Category"] },
    "id": { "type": "integer" },
    "name": { "type": "string" },
    "displayedName": { "type": "string" },
    "isAllow": { "type": "boolean" }
  },
  "required": ["@context", "@id", "@type", "id", "name", "displayedName", "isAllow"],
  "additionalProperties": false
}