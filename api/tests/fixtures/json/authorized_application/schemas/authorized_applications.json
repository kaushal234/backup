{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/authorized_applications$"},
    "hydra:member": {
      "type": "array",
      "items": {
        "properties": {
          "@id": {"pattern": "^/authorized_applications/\\d+$"},
          "@type": {"type": "string"},
          "id": {"type": "integer"},
          "name": {"type": "string"},
          "disabled": {"type": "boolean"},
          "createdBy": {"$ref": "../../directory_people/schemas/directory_people_public.json"},
          "keyExpiresOn": {"type": "string"},
          "keyGeneratedOn": {"type": "string"},
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "@id": {"type":  "string"},
                "@type": {"type":  "string"},
                "name": {"type":  "string"}
              },
              "required": ["@id", "@type", "name"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "@id",
          "@type",
          "id",
          "name",
          "disabled",
          "createdBy",
          "keyExpiresOn",
          "keyGeneratedOn",
          "features"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:member"
  ]
}
