{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/quality/calibrated_tools/tools$"},
    "@context": {
      "type": "string"
    },
    "@type": {
      "type": "string"
    },
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {"pattern": "^/quality/calibrated_tools/tools/\\d+$"},
          "@type": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "toolType": {
            "type": "object",
            "properties": {
              "id": { "type": "integer"},
              "@id": { "type": "string"},
              "@type": { "type": "string"},
              "description": { "type": "string"}
            },
            "required": ["id", "@id", "@type", "description"],
            "additionalProperties" : false
          },
          "serialNumber": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "calibrationInterval": {
            "type": "integer"
          },
          "calibrationNotice": {
            "type": "integer"
          },
          "nextCalibrationDate": {
            "oneOf": [
              {"type": "null"},
              {"type": "string", "format": "date-time"}
            ]
          },
          "statusUpdatedAt": {
            "oneOf": [
              {"type": "null"},
              {"type": "string", "format": "date-time"}
            ]
          },
          "status": {
            "type": "string"
          },
          "locationArea": {
            "type": "object",
            "properties": {
              "id": { "type": "integer"},
              "@id": { "type": "string"},
              "@type": { "type": "string"},
              "name": { "type": "string"},
              "factory": { "type": "string"},
              "supervisor": {
                "type": "object",
                "properties": {
                  "@id": { "type": "string" },
                  "@type": { "type": "string" },
                  "firstname": { "type": "string" },
                  "lastname": { "type": "string" },
                  "email": { "type": "string" },
                  "username": { "type": "string" }
                },
                "required": [ "@id", "@type", "firstname", "lastname", "email", "username"],
                "additionalProperties": false
              }
            },
            "required": ["id", "@id", "@type", "name", "factory", "supervisor"],
            "additionalProperties" : false
          },
          "createdBy": {
            "type": "object",
            "properties": {
              "@id": { "type": "string" },
              "@type": { "type": "string" },
              "firstname": { "type": "string" },
              "lastname": { "type": "string" },
              "email": { "type": "string" },
              "username": { "type": "string" }
            },
            "required": [ "@id", "@type", "firstname", "lastname", "email", "username"],
            "additionalProperties": false
          },
          "availableStatuses": {
            "type": "array"
          },
          "remainingDaysBeforeExpiration": {
            "type": ["integer", "null"]
          }
        },
        "required": [
          "@id",
          "@type",
          "id",
          "toolType",
          "serialNumber",
          "description",
          "calibrationInterval",
          "calibrationNotice",
          "nextCalibrationDate",
          "statusUpdatedAt",
          "status",
          "locationArea",
          "createdBy",
          "availableStatuses",
          "remainingDaysBeforeExpiration"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:member"
  ]
}
