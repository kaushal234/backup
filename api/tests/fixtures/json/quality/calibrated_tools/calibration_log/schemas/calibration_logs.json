{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/quality/calibrated_tools/calibration_logs$"},
    "@context": {
      "type": "string"
    },
    "@type": {
      "type": "string"
    },
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {"pattern": "^/quality/calibrated_tools/calibration_logs/\\d+$"},
          "@type": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "outOfToleranceForm": {
            "type": ["string", "null"]
          },
          "calibrationDate": {
            "type": ["string", "null"]
          },
          "startDate": {
            "type": "string"
          },
          "endDate": {
            "type": "string"
          },
          "certificate": {
            "oneOf": [
              { "type": "null" },
              { "$ref": "../../../../shared/schemas/file.json" }
            ]
          },
          "tool": {
            "type": "string"
          }
        },
        "required": [
          "@id",
          "@type",
          "id",
          "outOfToleranceForm",
          "calibrationDate",
          "startDate",
          "endDate",
          "certificate",
          "tool"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:member"
  ]
}
