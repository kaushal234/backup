{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {"pattern": "^/quality/processes/\\d+$"},
    "@type": {"type": "string"},
    "category": {"type": "string"},
    "description": {"type": "string"}
  },
  "required": [
    "@id",
    "@type",
    "category",
    "description"
  ],
  "additionalProperties": false
}
