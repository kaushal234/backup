{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {
      "type": "string",
      "pattern": "^/materials/warehouse/monthly_activities$"
    },
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "@id",
          "@type",
          "location",
          "applicatedOn",
          "inboundLines",
          "outboundLines",
          "inboundHours",
          "outboundHours",
          "improductiveHours",
          "excludedHours",
          "inboundRate",
          "outboundRate",
          "productiveRatio"
        ],
        "properties": {
          "@id": {"type": "string", "pattern": "^/materials/warehouse/monthly_activities/\\d+$"},
          "@type": {"type": "string", "pattern": "^MonthlyActivities$"},
          "location": {"$ref": "../../directory_location/schemas/directory_location_public.json"},
          "applicatedOn": {
            "type":  "string",
            "pattern": "^\\d{4}-\\d{2}"
          },
          "inboundLines": {
            "type": "integer",
            "minimum": 0
          },
          "outboundLines": {
            "type": "integer",
            "minimum": 0
          },
          "inboundHours": {
            "type": "integer",
            "minimum": 0
          },
          "outboundHours": {
            "type": "integer",
            "minimum": 0
          },
          "improductiveHours": {
            "type": "integer",
            "minimum": 0
          },
          "excludedHours": {
            "type": "integer",
            "minimum": 0
          },
          "inboundRate": {
            "type": "number",
            "minimum": 0
          },
          "outboundRate": {
            "type": "number",
            "minimum": 0
          },
          "productiveRatio": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        }
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:totalItems",
    "hydra:member",
    "hydra:search"
  ]
}
