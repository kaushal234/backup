{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties" : {
        "@context": {
            "type": "string"
        },
        "@id": {"pattern": "^/surveys/items$"},
        "@type": {
            "type": "string"
        },
        "hydra:member": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "@id": {"pattern": "^/surveys/items/\\d+$"},
                    "@type": {"type": "string"},
                    "id": {"type": "integer"},
                    "description": {"type": "string"},
                    "group": {
                        "type": ["object", "null"],
                        "properties": {
                            "@id": {"pattern": "^/surveys/groups/\\d+$"},
                            "@type"    : { "type": "string"},
                            "name"     : { "type": "string" },
                            "createdAt": { "type": "string" },
                            "updatedAt": { "type": "string" },
                            "createdBy": {
                                "type": "object",
                                "properties": {
                                    "@id": {"pattern": "^/people/\\d+$"},
                                    "@type"    : {"type": "string"},
                                    "firstname": {"type": "string"},
                                    "lastname" : {"type": "string"},
                                    "photo": {
                                        "oneOf": [
                                            { "type": "null" },
                                            { "$ref": "../../shared/schemas/file_light.json" }
                                        ]
                                    },
                                    "email"    : {"type": "string"},
                                    "username" : {"type": "string"}
                                },
                                "required": [ "@id", "@type", "firstname", "lastname", "photo", "email", "username" ],
                                "additionalProperties": false
                            },
                            "updatedBy": {
                                "type": ["object", "null"],
                                "properties": {
                                    "@id": {"pattern": "^/people/\\d+$"},
                                    "@type"    : {"type": "string"},
                                    "firstname": {"type": "string"},
                                    "lastname" : {"type": "string"},
                                    "photo": {
                                        "oneOf": [
                                            { "type": "null" },
                                            { "$ref": "../../shared/schemas/file_light.json" }
                                        ]
                                    },
                                    "email"    : {"type": "string"},
                                    "username" : {"type": "string"}
                                },
                                "required": [ "@id", "@type", "firstname", "lastname", "photo", "email", "username" ],
                                "additionalProperties": false
                            }
                        },
                        "required": [ "@id", "@type", "name", "createdBy", "updatedBy", "createdAt", "updatedAt" ],
                        "additionalProperties": false
                    },
                    "survey": {
                        "type" : ["object", "null"],
                        "properties": {
                            "@id": {"pattern": "^/surveys/models/\\d+$"},
                            "@type"    : {"type" : "string"},
                            "name"     : {"type" : "string"},
                            "createdAt": {"type" : "string"},
                            "updatedAt": {"type" : "string"},
                            "createdBy": {
                                "type": "object",
                                "properties": {
                                    "@id": {"pattern": "^/people/\\d+$"},
                                    "@type"    : {"type": "string"},
                                    "firstname": {"type": "string"},
                                    "lastname" : {"type": "string"},
                                    "photo": {
                                        "oneOf": [
                                            { "type": "null" },
                                            { "$ref": "../../shared/schemas/file_light.json" }
                                        ]
                                    },
                                    "email"    : {"type": "string"},
                                    "username" : {"type": "string"}
                                },
                                "required": [ "@id", "@type", "firstname", "lastname", "photo", "email", "username" ],
                                "additionalProperties": false
                            },
                            "updatedBy": {
                                "type": ["object", "null"],
                                "properties": {
                                    "@id": {"pattern": "^/people/\\d+$"},
                                    "@type"    : {"type": "string"},
                                    "firstname": {"type": "string"},
                                    "lastname" : {"type": "string"},
                                    "photo": {
                                        "oneOf": [
                                            { "type": "null" },
                                            { "$ref": "../../shared/schemas/file_light.json" }
                                        ]
                                    },
                                    "email"    : {"type": "string"},
                                    "username" : {"type": "string"}
                                },
                                "required": [ "@id", "@type", "firstname", "lastname", "email", "photo", "username" ],
                                "additionalProperties": false
                            }
                        },
                        "required": [ "@id", "@type", "name", "createdAt", "updatedAt", "createdBy", "updatedBy" ],
                        "additionalProperties": false
                    },
                    "createdBy": {
                        "type": "object",
                        "properties": {
                            "@id": {"pattern": "^/people/\\d+$"},
                            "@type"    : {"type": "string"},
                            "firstname": {"type": "string"},
                            "lastname" : {"type": "string"},
                            "photo": {
                                "oneOf": [
                                    { "type": "null" },
                                    { "$ref": "../../shared/schemas/file_light.json" }
                                ]
                            },
                            "email"    : {"type": "string"},
                            "username" : {"type": "string"}
                        },
                        "required": [ "@id", "@type", "firstname", "lastname", "photo", "email", "username" ],
                        "additionalProperties": false
                    },
                    "updatedBy": {
                        "type": ["object", "null"],
                        "properties": {
                            "@id": {"pattern": "^/people/\\d+$"},
                            "@type"    : {"type": "string"},
                            "firstname": {"type": "string"},
                            "lastname" : {"type": "string"},
                            "photo": {
                                "oneOf": [
                                    { "type": "null" },
                                    { "$ref": "../../shared/schemas/file_light.json" }
                                ]
                            },
                            "email"    : {"type": "string"},
                            "username" : {"type": "string"}
                        },
                        "required": [ "@id", "@type", "firstname", "lastname", "photo", "email", "username" ],
                        "additionalProperties": false
                    },
                    "createdAt"    : {"type": "string"},
                    "updatedAt"    : {"type": "string"},
                    "totalAnswers" : {"type": "integer"},
                    "totalComments": {"type": "integer"}
                },
                "required": [ "@id", "@type", "id", "description", "group", "totalAnswers", "totalComments", "survey", "createdAt", "updatedAt", "createdBy", "updatedBy" ],
                "additionalProperties": false
            },
            "minItems": 0
        },
        "hydra:totalItems": {
            "type": "integer"
        },
        "hydra:search": {
            "type": "object",
            "properties": {
                "@type": {"type": "string"},
                "hydra:template": {"type": "string"},
                "hydra:variableRepresentation": {"type": "string"},
                "hydra:mapping": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "@type": {"type": "string"},
                            "variable": {"type": "string"},
                            "property": {"type": "string"},
                            "required" : {"type": "boolean"}
                        },
                        "required": [ "@type", "variable", "property", "required" ],
                        "additionalProperties": false
                    },
                    "minItems": 0
                }

            },
            "required": [ "@type", "hydra:template", "hydra:variableRepresentation", "hydra:mapping" ],
            "additionalProperties": false
        },
        "hydra:view": {
            "type": ["object", "null"],
            "properties": {
                "@id": { "type": "string" },
                "@type": { "type": "string" }
            },
            "required": [ "@id", "@type" ]
        }
    },
    "required": [ "@context", "@id", "@type", "hydra:member", "hydra:totalItems", "hydra:search" ]
}
