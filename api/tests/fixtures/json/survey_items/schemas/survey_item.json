{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "@context"   : {"type": "string"},
        "@id": {"pattern": "^/surveys/items/\\d+$"},
        "@type"      : {"type": "string"},
        "id"         : {"type": "integer"},
        "description": {"type": "string"},
        "group": {
            "type": ["object", "null"],
            "properties": {
                "@id": {"pattern": "^/surveys/groups/\\d+$"},
                "@type"      : { "type": "string" },
                "id"         : { "type": "integer"},
                "name"       : { "type": "string" },
                "description": { "type": ["string", "null"] },
                "createdAt"  : { "type": "string" },
                "updatedAt"  : { "type": "string" },
                "createdBy": {
                    "type": "object",
                    "properties": {
                        "@id": {"pattern": "^/people/\\d+$"},
                        "@type"    : {"type": "string"},
                        "firstname": {"type": "string"},
                        "lastname" : {"type": "string"},
                        "photo": {
                            "oneOf": [
                                { "type": "null" },
                                { "$ref": "../../shared/schemas/file_light.json" }
                            ]
                        },
                        "email"    : {"type": "string"},
                        "username" : {"type": "string"}
                    },
                    "required": [ "@id", "@type", "firstname", "lastname", "photo", "email", "username" ],
                    "additionalProperties": false
                },
                "updatedBy": {
                    "type": ["object", "null"],
                    "properties": {
                        "@id": {"pattern": "^/people/\\d+$"},
                        "@type"    : {"type": "string"},
                        "firstname": {"type": "string"},
                        "lastname" : {"type": "string"},
                        "photo": {
                            "oneOf": [
                                { "type": "null" },
                                { "$ref": "../../shared/schemas/file_light.json" }
                            ]
                        },
                        "email"    : {"type": "string"},
                        "username" : {"type": "string"}
                    },
                    "required": [ "@id", "@type", "firstname", "lastname", "photo", "email", "username" ],
                    "additionalProperties": false
                }
            },
            "required": [ "@id", "@type", "id", "name", "description", "createdBy", "updatedBy", "createdAt", "updatedAt" ],
            "additionalProperties": false
        },
        "createdBy": {
            "type": "object",
            "properties": {
                "@id": {"pattern": "^/people/\\d+$"},
                "@type"    : {"type": "string" },
                "firstname": {"type": "string" },
                "lastname" : {"type": "string" },
                "photo": {
                    "oneOf": [
                        { "type": "null" },
                        { "$ref": "../../shared/schemas/file_light.json" }
                    ]
                },
                "email"    : {"type": "string" },
                "username" : {"type": "string" }
            },
            "required": [ "@id", "@type", "firstname", "lastname", "photo", "email", "username"],
            "additionalProperties": false
        },
        "updatedBy": {
            "type": ["object", "null"],
            "properties": {
                "@id": {"pattern": "^/people/\\d+$"},
                "@type"    : { "type": "string" },
                "firstname": { "type": "string" },
                "lastname" : { "type": "string" },
                "photo": {
                    "oneOf": [
                        { "type": "null" },
                        { "$ref": "../../shared/schemas/file_light.json" }
                    ]
                },
                "email"    : { "type": "string" },
                "username" : { "type": "string" }
            },
            "required": [ "@id", "@type", "firstname", "lastname", "photo", "email", "username"],
            "additionalProperties": false
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "survey": {
            "type": ["object", "null"],
            "properties": {
                "@id"           : {"type": "string"},
                "@type"         : {"type": "string"},
                "id"            : {"type": "integer"},
                "name"          : {"type": "string"},
                "description"   : {"type": "string"},
                "expirationDate": {"type": ["string", "null"]},
                "createdAt"     : {"type": "string"},
                "updatedAt"     : {"type": "string"},
                "createdBy": {
                    "type": "object",
                    "properties": {
                        "@id": {"pattern": "^/people/\\d+$"},
                        "@type"    : {"type": "string" },
                        "firstname": {"type": "string" },
                        "lastname" : {"type": "string" },
                        "photo": {
                            "oneOf": [
                                { "type": "null" },
                                { "$ref": "../../shared/schemas/file_light.json" }
                            ]
                        },
                        "email"    : {"type": "string" },
                        "username" : {"type": "string" }
                    },
                    "required": [ "@id", "@type", "firstname", "lastname", "photo", "email", "username"],
                    "additionalProperties": false
                },
                "updatedBy": {
                    "type": ["object", "null"],
                    "properties": {
                        "@id": {"pattern": "^/people/\\d+$"},
                        "@type"    : { "type": "string" },
                        "firstname": { "type": "string" },
                        "lastname" : { "type": "string" },
                        "photo": {
                            "oneOf": [
                                { "type": "null" },
                                { "$ref": "../../shared/schemas/file_light.json" }
                            ]
                        },
                        "email"    : { "type": "string" },
                        "username" : { "type": "string" }
                    },
                    "required": [ "@id", "@type", "firstname", "lastname", "photo", "email", "username"],
                    "additionalProperties": false
                }
            },
            "required": [ "@id", "@type", "id", "name", "description", "expirationDate", "createdAt", "updatedAt", "createdBy", "updatedBy"],
            "additionalProperties": false
        }
    },
    "required": [ "@context", "@id", "@type", "id", "description", "group", "createdAt", "updatedAt", "createdBy", "updatedBy" ],
    "additionalProperties": false
}
