{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {
      "pattern": "^/quality/crab_departments"
    },
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {
            "pattern": "^/quality/crab_departments/\\d+$"
          },
          "@type": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "@id",
          "@type",
          "id",
          "name"
        ],
        "additionalProperties": false
      }
    }
  }
}
