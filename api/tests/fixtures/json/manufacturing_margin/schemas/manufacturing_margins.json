{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/finance/manufacturing_margins"},
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "equipmentRecord",
          "exportedAt",
          "legacyId"
        ],
        "properties": {
          "@context": {
            "type": "string"
          },
          "@id": {
            "pattern": "^/finance/manufacturing_margins/\\d+$"
          },
          "@type": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "equipmentRecord": {
            "type": "object",
            "$ref": "../../equipment_record/schemas/equipment_record_list.json"
          },
          "exportedAt": {
            "type": "string",
            "format": "date-time"
          },
          "legacyId": {
            "type": "integer"
          }
        }
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "hydra:totalItems": {
      "type": "integer"
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:member"
  ]
}
