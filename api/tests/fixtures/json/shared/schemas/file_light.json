{
  "type": "object",
  "properties": {
    "@context": {"pattern": "/contexts/[a-zA-Z]+File"},
    "@id": {"pattern": "^/[a-z_\/]+_files/\\d+$"},
    "@type": { "type": "string" },
    "id": { "type": "integer" },
    "filePath": { "type": "string" },
    "createdAt": { "type": "string" },
    "mimeType": { "type": "string" }
  },
  "required": [
    "@id",
    "@type",
    "id",
    "filePath",
    "createdAt",
    "mimeType"
  ],
  "additionalProperties": false
}
