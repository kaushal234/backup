{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/ai_logs"},
    "hydra:member": {
      "type": "array",
      "items": {
        "properties": {
          "@id": {"pattern": "^/ai_logs"},
          "@type": { "type": "string" },
          "id": { "type": "integer" },
          "createdAt": { "type": "string" },
          "title": { "type": ["string", "null"] },
          "pinned": { "type": "boolean" }
        },
        "required": [
          "@id",
          "@type",
          "id",
          "title",
          "pinned"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:member"
  ]
}
