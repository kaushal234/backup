{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {"type": "string"},
    "@id": {"pattern": "^/ai_files/\\d+$"},
    "@type": {"type": "string"},
    "id": {"type": "integer"},
    "filePath": {"type": "string"},
    "createdAt": {"type": "string"}
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "id",
    "filePath",
    "createdAt"
  ],
  "additionalProperties": false
}
