{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {"type": "string"},
    "logIri": {"type": ["string"]},
    "results": {
      "type": "object",
      "properties": {
        "hydra:member": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "@id": {"type": "string"},
              "@type": {"type": "string"},
              "id": {"type": "integer"},
              "module": {"type": ["string", "null"]},
              "description": {"type": ["string", "null"]},
              "link": {"type": ["string", "null"]}
            },
            "required": [
              "@id",
              "@type",
              "id",
              "description",
              "link"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  },
  "required": ["logIri", "results"]
}
