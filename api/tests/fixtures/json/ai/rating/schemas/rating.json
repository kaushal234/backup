{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {"type": "string"},
    "@id": { "pattern": "^/ai/ratings/\\d+$" },
    "@type": { "type": "string" },
    "rating": { "type": "integer" },
    "comment": { "type": "string" }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "rating",
    "comment"
  ],
  "additionalProperties": false
}