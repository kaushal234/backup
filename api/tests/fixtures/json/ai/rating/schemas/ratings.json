{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/ai/ratings"},
    "hydra:member": {
      "type": "array",
      "items": {
        "properties": {
          "@id": { "pattern": "^/ai/ratings/\\d+$" },
          "@type": { "type": "string" },
          "rating": { "type": "integer" },
          "comment": { "type": "string" }
        },
        "required": [
          "@id",
          "@type",
          "rating",
          "comment"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:member"
  ]
}
