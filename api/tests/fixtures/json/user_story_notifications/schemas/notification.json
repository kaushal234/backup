{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {
      "pattern": "^/mis/user_story_notifications/\\d+$"
    },
    "@type": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "follower": {
      "type": "boolean"
    },
    "id": {
      "type": "integer"
    },
    "roleToNotify": {
      "type": "array",
      "items": {
        "ref": "../../notifications_accesses/schemas/notifications_access.json"
      }
    }
  },
  "required": [
    "@id",
    "@type",
    "message",
    "follower",
    "id",
    "roleToNotify"
  ],
  "additionalProperties": false
}