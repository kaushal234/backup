{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {"pattern": "^/service_areas$"},
    "@type": {
      "type": "string"
    },
    "hydra:totalItems": {
      "type": "integer"
    },
    "hydra:search": {
      "type": "object"
    },
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {"pattern": "^/service_areas/\\d+$"},
          "@type": {"type": "string"},
          "id": {"type": "integer"},
          "name": {"type": "string"},
          "representative": {
            "$ref": "../../directory_people/schemas/directory_people_public.json"
          },
          "airports": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "@id": {"pattern": "^/airports/\\d+$"},
                "@type": {"type": "string"},
                "id": {"type": "integer"},
                "type": {"type": "string"},
                "code": {"type": "string"},
                "cityCode3": {"type": ["string", "null"]},
                "cityName": {"type": ["string", "null"]},
                "state": {"type": ["string", "null"]},
                "name": {"type": ["string", "null"]},
                "source": {"type": "string"},
                "latitude": {"type": ["number", "null"]},
                "longitude": {"type": ["number", "null"]},
                "country": {
                  "type": ["object", "null"],
                  "properties": {
                    "@id": {"pattern": "^/countries/\\d+$"},
                    "@type": {"type": "string"},
                    "id": {"type": "integer"},
                    "name": {"type": "string"}
                  },
                  "required": ["@id", "@type", "id", "name"],
                  "additionalProperties": false
                }
              },
              "required": [
                "@id",
                "@type",
                "code"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "@id",
          "@type",
          "id",
          "name",
          "representative",
          "airports"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "@context",
    "@id",
    "hydra:member"
  ]
}