{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {"type": "string"},
    "@id": {"pattern": "^/modules/third_party_app/business_unit_positions/\\d+$"},
    "@type": {"type": "string"},
    "id": {"type": "integer"},
    "thirdPartyApp": {"type":  "object"},
    "position": {
      "type": "object",
      "properties": {
        "@id": {"type": "string"},
        "@type": {"type": "string"},
        "id": {"type": "integer"},
        "code": {"type": "string"},
        "description": {"type": "string"}
      },
      "required": [
        "@id",
        "@type",
        "id",
        "code",
        "description"
      ],
      "additionalProperties": false
    },
    "businessUnit": {
      "type": "object",
      "properties": {
        "@id": {"type": "string"},
        "@type": {"type": "string"},
        "id": {"type": "integer"},
        "name": {"type": "string"},
        "domain": {"type": ["string", "null"]},
        "region": {"type":  ["string", "null"]}
      },
      "required": [
        "@id",
        "@type",
        "id",
        "name",
        "domain",
        "region"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "@id",
    "@type",
    "id",
    "thirdPartyApp",
    "position",
    "businessUnit"
  ],
  "additionalProperties": false
}
