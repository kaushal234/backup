{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {
      "pattern": "^/modules/third_party_app/account_reviews$"
    },
    "@type": {
      "type": "string"
    },
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@context": {"type": "string"},
          "@id": {"pattern": "^/modules/third_party_app/account_reviews/\\d+$"},
          "@type": {"type": "string"},
          "id": {"type": "integer"},
          "thirdPartyApp": {"type": "object"},
          "createdAt": {"type": "string"},
          "countStartAdminUsers": {"type": ["integer", "null"]},
          "countEndAdminUsers": {"type": ["integer", "null"]},
          "adminsComment": {"type": ["string", "null"]},
          "adminAccountsConfirmed": {"type": "boolean"},
          "countAppUsers": {"type": ["integer", "null"]},
          "countStartMembers": {"type": ["integer", "null"]},
          "countEndMembers": {"type": ["integer", "null"]},
          "countDisabledAccounts": {"type": ["integer", "null"]},
          "disabledAccountsComment": {"type": ["string", "null"]},
          "countEnabledAccounts": {"type": ["integer", "null"]},
          "enabledAccountsComment": {"type": ["string", "null"]},
          "userAccountsConfirmed": {"type": "boolean"},
          "createdBy": {"$ref": "../../directory_people/schemas/directory_people_public.json"},
          "mainFile": {
            "oneOf" : [
              {"type": "null"},
              {"$ref" :  "../../shared/schemas/file.json"}
            ]
          }
        },
        "required": [
          "@id",
          "@type",
          "id",
          "thirdPartyApp",
          "createdAt",
          "countStartAdminUsers",
          "countEndAdminUsers",
          "adminsComment",
          "adminAccountsConfirmed",
          "countAppUsers",
          "countStartMembers",
          "countEndMembers",
          "countDisabledAccounts",
          "disabledAccountsComment",
          "countEnabledAccounts",
          "enabledAccountsComment",
          "userAccountsConfirmed",
          "createdBy",
          "mainFile"
        ],
        "additionalProperties": false
      }
    }
  }
}
