{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {
      "pattern": "^/mis/user_stories/\\d+(/status)?$"
    },
    "@type": {
      "type": "string"
    },
    "id": {
      "type": "integer"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "peopleProperties": {
      "type": "array"
    },
    "specification": {
      "pattern": "^/mis/specifications/\\d+$"
    },
    "currentEmail": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "../../user_story_emails/schemas/email.json"}
      ]
    },
    "currentNotification": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "../../user_story_notifications/schemas/notification.json"}
      ]
    },
    "status": {
      "type": "string"
    },
    "userStoryFiles": {
      "type": "array"
    },
    "roleAccesses": {
      "type": "array",
      "items": {
        "$ref": "../../roles_accesses/schemas/role_access.json"
      }
    },
    "jiraIssueNumber": {
      "type": [
        "null",
        "string"
      ]
    },
    "projectNumber": {
      "type": [
        "null",
        "integer"
      ]
    },
    "createdBy": {"$ref": "../../directory_people/schemas/directory_people_public.json"}
  },
  "required": [
    "@id",
    "@type",
    "id",
    "category",
    "description",
    "specification",
    "status",
    "userStoryFiles",
    "roleAccesses",
    "jiraIssueNumber",
    "currentEmail",
    "currentNotification",
    "projectNumber",
    "createdBy"
  ],
  "additionalProperties": false
}