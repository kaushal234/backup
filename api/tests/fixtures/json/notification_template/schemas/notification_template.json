{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {"pattern": "^/notification_templates/\\d+$"},
    "@type": {"type": "string"},
    "module": {
      "type": "object",
      "properties": {
        "@id": {"pattern": "^/modules/\\d+$"},
        "@type": {"type": "string"},
        "name": {"type": "string"},
        "shortDescription": {"type": "string"},
        "notificationColor": {"type": ["string", "null"]}
      },
      "required": ["@id", "@type", "name", "shortDescription", "notificationColor"],
      "additionalProperties": false
    },
    "name": {"type": ["string"]},
    "text": {"type": ["string"]}
  },
  "required": ["@id", "@type", "name", "text", "module"],
  "additionalProperties": false
}
