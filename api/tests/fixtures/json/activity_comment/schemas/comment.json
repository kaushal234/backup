{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/comments/\\d+$"},
    "@context": {"type": "string"},
    "@type": {"type": "string"},
    "id": {"type": "integer"},
    "legacyId": {"type": "integer"},
    "resource": {"type": "string"},
    "message": {"type": "string"},
    "discriminator": {"type": ["string", "null"]},
    "user": {"type": ["object", "null"]},
    "createdAt": {"type": "string"},
    "updatedAt": {"type": "string"},
    "public": {"type": "boolean"},
    "metadata": { "type": ["object", "array"] },
    "files": {
      "type": "array",
      "items": {
        "$ref": "../../shared/schemas/file.json"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "@id",
    "@context",
    "@type",
    "id",
    "legacyId",
    "message",
    "user",
    "createdAt",
    "updatedAt",
    "public",
    "resource",
    "metadata",
    "files"
  ],
  "additionalProperties": false
}
