{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": { "type": "string" },
    "@id": { "pattern": "^/sales/planning_daily_exceptions/\\d+$" },
    "@type": { "type": "string" },
    "id": { "type": "integer" },
    "date": {
      "type": "string"
    },
    "comment": { "type": ["string", "null"] },
    "factory": { "$ref": "../../directory_location/schemas/directory_location_public.json" }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "id",
    "date",
    "comment",
    "factory"
  ],
  "additionalProperties": false
}
