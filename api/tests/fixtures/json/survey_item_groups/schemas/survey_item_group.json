{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "@context"   : { "type": "string" },
        "@id": {"pattern": "^/surveys/groups/\\d+$"},
        "@type"      : { "type": "string" },
        "id"         : { "type": "integer" },
        "name"       : { "type": "string" },
        "description": { "type": ["string", "null"] },
        "sorting"    : { "type": ["integer", "null"] },
        "items": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "@id": {"pattern": "^/surveys/items/\\d+$"},
                    "id"         : {"type": "integer"},
                    "@type"      : {"type": "string"},
                    "description": {"type": "string"},
                    "createdAt"  : {"type": "string"},
                    "updatedAt"  : {"type": "string"},
                    "createdBy": {
                        "type": "object",
                        "properties": {
                            "@id": {"pattern": "^/people/\\d+$"},
                            "@type"    : {"type": "string"},
                            "firstname": {"type": "string"},
                            "lastname" : {"type": "string"},
                            "email"    : {"type": "string"},
                            "username" : {"type": "string"},
                            "photo": {
                                "oneOf": [
                                    { "type": "null" },
                                    { "$ref": "../../shared/schemas/file_light.json" }
                                ]
                            }
                        },
                        "required": [ "@id", "@type", "firstname", "lastname", "email", "username", "photo"],
                        "additionalProperties": false
                    },
                    "updatedBy": {
                        "type": ["object", "null"],
                        "properties": {
                            "@id": {"pattern": "^/people/\\d+$"},
                            "@type"    : {"type": "string"},
                            "firstname": {"type": "string"},
                            "lastname" : {"type": "string"},
                            "email"    : {"type": "string"},
                            "username" : {"type": "string"},
                            "photo": {
                                "oneOf": [
                                    { "type": "null" },
                                    { "$ref": "../../shared/schemas/file_light.json" }
                                ]
                            }
                        },
                        "required": [ "@id", "@type", "firstname", "lastname", "email", "username", "photo"],
                        "additionalProperties": false
                    }
                },
                "required": [ "@id", "id", "@type", "createdAt", "updatedAt", "createdBy", "updatedBy", "description"],
                "additionalProperties": false
            },
            "minItems": 0
        },
        "survey":  {
            "type": [ "object", "null" ],
            "properties": {
                "@id": {"pattern": "^/surveys/models/\\d+$"},
                "id"            : {"type": "integer"},
                "@type"         : {"type": "string"},
                "name"          : {"type": "string"},
                "description"   : {"type": "string"},
                "expirationDate": {"type": ["string", "null"]},
                "createdAt"     : {"type": "string"},
                "updatedAt"     : {"type": "string"},
                "createdBy": {
                    "type": "object",
                    "properties": {
                        "@id": {"pattern": "^/people/\\d+$"},
                        "@type"    : {"type": "string"},
                        "firstname": {"type": "string"},
                        "lastname" : {"type": "string"},
                        "photo": {
                            "oneOf": [
                                { "type": "null" },
                                { "$ref": "../../shared/schemas/file_light.json" }
                            ]
                        },
                        "email"    : {"type": "string"},
                        "username" : {"type": "string"}
                    },
                    "required": [ "@id", "@type", "firstname", "lastname", "photo",  "email", "username" ],
                    "additionalProperties": false
                },
                "updatedBy": {
                    "type": ["object", "null"],
                    "properties": {
                        "@id": {"pattern": "^/people/\\d+$"},
                        "@type"    : {"type": "string"},
                        "firstname": {"type": "string"},
                        "lastname" : {"type": "string"},
                        "photo": {
                            "oneOf": [
                                { "type": "null" },
                                { "$ref": "../../shared/schemas/file_light.json" }
                            ]
                        },
                        "email"    : {"type": "string"},
                        "username" : {"type": "string"}
                    },
                    "required": [ "@id", "@type", "firstname", "lastname", "photo", "email", "username" ],
                    "additionalProperties": false
                }
            },
            "required": [ "@id", "@type", "createdAt", "updatedAt", "createdBy", "updatedBy" ],
            "additionalProperties": false
        },
        "createdBy": {
            "type": "object",
            "properties": {
                "@id": {"pattern": "^/people/\\d+$"},
                "@type"    : {"type": "string"},
                "firstname": {"type": "string"},
                "lastname" : {"type": "string"},
                "photo": {
                    "oneOf": [
                        { "type": "null" },
                        { "$ref": "../../shared/schemas/file_light.json" }
                    ]
                },
                "email"    : {"type": "string"},
                "username" : {"type": "string"}
            },
            "required": [ "@id", "@type", "firstname", "lastname", "photo", "email", "username" ],
            "additionalProperties": false
        },
        "updatedBy": {
            "type": ["object", "null"],
            "properties": {
                "@id": {"pattern": "^/people/\\d+$"},
                "@type"    : {"type": "string"},
                "firstname": {"type": "string"},
                "lastname" : {"type": "string"},
                "photo": {
                    "oneOf": [
                        { "type": "null" },
                        { "$ref": "../../shared/schemas/file_light.json" }
                    ]
                },
                "email"    : {"type": "string"},
                "username" : {"type": "string"}
            },
            "required": [ "@id", "@type", "firstname", "lastname", "photo", "email", "username"],
            "additionalProperties": false
        },
        "createdAt": {"type": "string"},
        "updatedAt": {"type": "string"}
    },
    "required": [ "@context", "@id", "@type", "id", "name", "description", "createdBy", "updatedBy", "sorting", "survey", "createdAt", "updatedAt" ],
    "additionalProperties": false
}
