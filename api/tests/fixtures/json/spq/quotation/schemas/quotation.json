          "@id",
          "@type",
          "id",
          "position",
          "status",
          "partNumber",
          "displayedPartNumber",
          "description",
          "unitBasePrice",
          "totalPrice",
          "salesUnit",
          "discount",
          "commission",
          "leadtime",
          "comment",
          "tax",
          "weight",
          "countryOfOrigin",
          "commodityCode",
          "itemType",
          "currency",
          "quantity"
