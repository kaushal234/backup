{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/notifications"},
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@context": {
            "type": "string"
          },
          "@id": {"pattern": "^/notifications/\\d+$"},
          "@type": {"type": "string"},
          "unread": {"type": "boolean"},
          "textDisplayed": {"type": "string"},
          "url": {"type": "string"},
          "createdAt": {"type": "string"},
          "id": {"type": "integer"},
          "template": {
            "type": "object",
            "properties": {
              "@id": {"pattern": "^/notification_templates/\\d+$"},
              "@type": {"type": "string"},
              "module": {
                "type": "object",
                "properties": {
                  "@id": {"pattern": "^/modules/\\d+$"},
                  "@type": {"type": "string"},
                  "name": {"type": "string"},
                  "shortDescription": {"type": "string"},
                  "notificationColor": {"type": ["string", "null"]}
                },
                "required": ["@id", "@type", "name", "shortDescription", "notificationColor"],
                "additionalProperties": false
              },
              "name": {"type": ["string"]},
              "text": {"type": ["string"]}
            },
            "required": ["@id", "@type", "name", "text", "module"],
            "additionalProperties": false
          }
        },
        "required": [
          "@id",
          "@type",
          "id",
          "template",
          "unread",
          "textDisplayed",
          "url",
          "createdAt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:member"
  ]
}
