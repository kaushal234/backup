{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {"pattern": "^/engineering/pictogram/categories$"},
    "@type": {
      "type": "string"
    },
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {
            "pattern": "^/engineering/pictogram/categories/\\d+$"
          },
          "@type": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "color": {
            "type": ["string", "null"]
          }
        },
        "required": [
          "@id",
          "@type",
          "id",
          "name",
          "color"
        ],
        "additionalProperties": false
      }
    }
  }
}