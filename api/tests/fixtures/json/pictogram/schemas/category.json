{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {
      "pattern": "^/engineering/pictogram/categories/\\d+$"
    },
    "@type": {
      "type": "string"
    },
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "color": {
      "type": ["string", "null"]
    }
  },
  "required": [
    "@id",
    "@type",
    "id",
    "name",
    "color"
  ],
  "additionalProperties": false
}