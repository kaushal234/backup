{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {"type": "string", "pattern": "^/training_categories$"},
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {"type": "string", "pattern": "^/training_categories/\\d+$"},
          "@type": {"type": "string", "pattern": "^TrainingCategory$"},
          "id": {"type": "integer"},
          "name": {"type": "string"}
        },
        "required": [
          "@id",
          "@type",
          "id",
          "name"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:totalItems",
    "hydra:member",
    "hydra:search"
  ]
}
