{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {"type": "string"},
    "@id": {"type": "string", "pattern": "^/training_categories/\\d+$"},
    "@type": {"type": "string", "pattern": "^TrainingCategory$"},
    "id": {"type": "integer"},
    "name": {"type": "string"}
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "id",
    "name"
  ],
  "additionalProperties": false
}
