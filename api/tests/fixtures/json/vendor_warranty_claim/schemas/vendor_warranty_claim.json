{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {"type": "string"},
    "@id": {"pattern": "^/purchasing/(ncr_|wc_|)vendor_warranty_claims/\\d+$"},
    "@type": {"type": "string"},
    "id": {"type": "integer"},
    "type": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "properties": {
            "@id": {"type":  "string"},
            "@type": {"type":  "string"},
            "name": {"type":  "string"},
            "description": {"type":  "string"}
          },
          "required": ["@id", "@type", "name", "description"],
          "additionalProperties": false
        }
      ]
    },
    "supplierName": {"type": "string"},
    "supplierNumber": {"type": "string"},
    "supplierErp": {"type": ["integer", "null"]},
    "createdAt": {"type": "string"},
    "closedAt": {"type": ["string", "null"]},
    "statusUpdatedAt": {"type": ["string", "null"]},
    "status": {
      "type": "object",
      "properties": {
        "@id": {"pattern": "^/purchasing/vendor_warranty_claim_statuses/\\d+$"},
        "@type": {"type": "string"},
        "name": {"type": "string"},
        "description": {"type": "string"},
        "position": {"type": "integer"}
      },
      "required": ["@id", "@type", "name", "description", "position"],
      "additionalProperties": false
    },
    "requestedSupplierAction": {"type": "string"},
    "requestedCreditAmount": {"type": "number"},
    "supplierCreditAmount": {"type": ["number", "null"]},
    "supplierShipperName": {"type": ["string", "null"]},
    "actualCreditAmount": {"type": ["number", "null"]},
    "supplierStockVerified": {"type": ["string", "null"]},
    "tldStockVerified": {"type": ["string", "null"]},
    "issueOrigin": {"type": ["string", "null"]},
    "correctiveAction": {"type": ["string", "null"]},
    "scarRequested": {"type": "boolean"},
    "assignee": {"$ref": "../../directory_people/schemas/directory_people_public.json"},
    "poster": {"$ref": "../../directory_people/schemas/directory_people_public.json"},
    "files": {
      "type": "array",
      "items": {
        "$ref": "../../shared/schemas/file.json"
      },
      "uniqueItems": true
    },
    "mainFile": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "../../shared/schemas/file.json"}
      ]
    },
    "warrantyClaimFiles": {
      "type": "array",
      "items": {
        "$ref": "../../shared/schemas/legacy_file.json"
      },
      "uniqueItems": true
    },
    "tocFiles": {
      "type": "array",
      "items": {
        "$ref": "../../shared/schemas/legacy_file.json"
      },
      "uniqueItems": true
    },
    "supplierCorrectiveActionRequest": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "properties": {
            "@id": {"pattern": "^/quality/supplier_corrective_action_requests/\\d+$"},
            "@type": {"type": "string"},
            "id": {"type": "integer"},
            "createdAt": {"type": "string"},
            "iFactor": {"type": "string"},
            "status": {"type": "string"},
            "shortDescription": {"type": ["string", "null"]},
            "supplierName": {"type": "string"},
            "supplierNumber": {"type": "string"},
            "factory":{
              "type": "object",
              "properties": {
                "@id": {"pattern": "^/locations/\\d+$"},
                "@type": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "erp": {
                  "type": ["integer", "null"]
                },
                "currency": {
                  "oneOf": [
                    {"type": "null"},
                    {"$ref": "../../finance_currency/schemas/currency.json"}
                  ]
                }
              },
              "required": ["@id", "@type", "name", "erp", "currency"],
              "additionalProperties": false
            },
            "poster":{
              "oneOf": [
                {"type": "null"},
                {"$ref": "../../directory_people/schemas/directory_people_public.json"}
              ]
            },
            "leader": {
              "oneOf": [
                {"type": "null"},
                {"$ref": "../../directory_people/schemas/directory_people_public.json"}
              ]
            }
          },
          "required": ["@id", "@type", "id", "createdAt", "iFactor", "status", "shortDescription", "factory", "leader", "poster", "supplierName", "supplierNumber"],
          "additionalItems": false
        }
      ]
    },
    "nonConformity": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "properties": {
            "@id": {"pattern": "^/quality/non_conformities/\\d+$"},
            "@type": {"type": "string"},
            "id": {"type": "integer"},
            "status": {"type": "string"},
            "createdAt": {"type": "string"},
            "reportedBy": {"$ref": "../../directory_people/schemas/directory_people_public.json"},
            "location": {
              "type": "object",
              "properties": {
                "@id": {"pattern": "^/locations/\\d+$"},
                "@type": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "erp": {
                  "type": ["integer", "null"]
                },
                "currency": {
                  "oneOf": [
                    {"type": "null"},
                    {"$ref": "../../finance_currency/schemas/currency.json"}
                  ]
                }
              },
              "required": ["@id", "@type", "name", "erp", "currency"],
              "additionalProperties": false
            },
            "shortDescription": {"type": "string"}
          },
          "required": [
            "@id",
            "@type",
            "id",
            "status",
            "createdAt",
            "reportedBy",
            "location",
            "shortDescription"
          ],
          "additionalItems": false
        }
      ]
    },
    "warrantyClaimId": {"type":  ["integer", "null"]},
    "location": {
      "type": "object",
      "properties": {
        "@id": {"pattern": "^/locations/\\d+$"},
        "@type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "erp": {
          "type": ["integer", "null"]
        },
        "currency": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "../../finance_currency/schemas/currency.json"}
          ]
        }
      },
      "required": ["@id", "@type", "name", "erp", "currency"],
      "additionalProperties": false
    },
    "supplierReturnMerchandiseAuthorization": {"type":  ["string", "null"]},
    "supplierCreditNote": {"type":  ["string", "null"]},
    "supplierShippingInstruction": {"type":  ["string", "null"]},
    "costBreakdown": {"type":  ["string", "null"]},
    "resolution": {"type":  ["string", "null"]},
    "trackingNumber": {"type":  ["string", "null"]},
    "accepted": {"type": "boolean"},
    "shipBackDefectivePart": {"type": "boolean"},
    "vendorToRespondAt": {"type": ["string", "null"]},
    "currency": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "../../finance_currency/schemas/currency.json"}
      ]
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {"pattern": "^/parts/vendor_warranty_claim_parts/\\d+$"},
          "@type": {"type": "string"},
          "id": {"type": "integer"},
          "createdAt": {"type": "string"},
          "createdBy": {"$ref": "../../directory_people/schemas/directory_people_public.json"},
          "deletedAt": {"type": ["null", "string"]},
          "deletedBy": {"oneOf": [
            {"type": "null"},
            {"$ref": "../../directory_people/schemas/directory_people_public.json"}
          ]},
          "partNumber": {"type": "string"},
          "description": {"type": "string"},
          "unitOfMeasure": {"type": "string"},
          "quantity": {"type": "integer"},
          "serialNumber": {"type": ["string", "null"]},
          "vendorPartNumber": {"type": ["string", "null"]},
          "vendorSerialNumber": {"type": ["string", "null"]},
          "failureType": {"type": ["string", "null"]},
          "failureSystem": {"type": ["string", "null"]},
          "receivedQuantity": {"type": ["integer", "null"]},
          "standardCost": {"type": ["number", "null"]},
          "ship": {"type": "boolean"}
        },
        "required": [
          "@id",
          "@type",
          "id",
          "createdAt",
          "createdBy",
          "deletedAt",
          "deletedBy",
          "partNumber",
          "description",
          "unitOfMeasure",
          "quantity",
          "serialNumber",
          "failureType",
          "failureSystem",
          "receivedQuantity",
          "vendorPartNumber",
          "vendorSerialNumber",
          "ship",
          "standardCost"
        ],
        "additionalProperties": false
      }
    },
    "activity": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {"pattern": "^/(comments|logs|)/\\d+$"},
          "@type": { "type" : "string" },
          "@context": { "type" : "string" },
          "id": { "type":  "number"},
          "message": { "type": "string" },
          "files": {
            "type": "array",
            "items": {
              "$ref": "../../shared/schemas/file_light.json"
            },
            "uniqueItems": true
          },
          "metadata": { "type": ["object", "array"] },
          "changeSet": { "type": ["object", "array"] },
          "resource": { "type" : "string"},
          "action": { "type" : "string"},
          "discriminator": {"type": ["string", "null"]},
          "from": { "type" : "string"},
          "user": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "../../directory_people/schemas/directory_people_public.json"}
            ]},
          "createdAt": { "type":  "string"},
          "updatedAt": { "type":  "string"},
          "public": { "type":  "boolean"},
          "legacyId": { "type":  "number"}
        },
        "required": ["@id", "@type", "id", "metadata", "user", "resource", "createdAt", "updatedAt", "public"],
        "additionalProperties": false
      }
    }
