  "required": [
    "@context",
    "@id",
    "@type",
    "id",
    "type",
    "supplierCreditAmount",
    "requestedSupplierAction",
    "requestedCreditAmount",
    "assignee",
    "actualCreditAmount",
    "supplierName",
    "supplierNumber",
    "createdAt",
    "closedAt",
    "supplierCorrectiveActionRequest",
    "costBreakdown",
    "poster",
    "accepted",
    "resolution",
    "scarRequested",
    "shipBackDefectivePart",
    "supplierCreditNote",
    "supplierReturnMerchandiseAuthorization",
    "supplierShippingInstruction",
    "status",
    "location",
    "parts",
    "trackingNumber",
    "currency",
    "supplierShipperName",
    "files",
    "statusUpdatedAt",
    "activity",
    "vendorToRespondAt"
  ],
  "additionalProperties": false
}
