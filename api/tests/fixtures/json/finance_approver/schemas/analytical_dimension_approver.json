{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {
      "pattern": "^/finance/analytical_dimension_approvers/\\d+$"
    },
    "@type": {
      "type": "string"
    },
    "analyticalDimension": {
      "type": "string"
    },
    "location": {
      "type":"object",
      "properties": {
        "@id": {"pattern": "^/locations/\\d+$"},
        "@type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "erp": {
          "type": "integer"
        }
      },
      "required": [
        "@id",
        "@type",
        "name",
        "erp"
      ],
      "additionalProperties": false
    },
    "assignor": {
      "type": "object",
      "properties": {
        "@id": {
          "pattern": "^/people/\\d+$"
        },
        "@type": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "firstname": {
          "type": "string"
        },
        "lastname": {
          "type": "string"
        }
      },
      "required": [
        "@id",
        "@type",
        "username",
        "email",
        "firstname",
        "lastname"
      ],
      "additionalProperties": false
    },
    "assignee": {
      "type": "object",
      "properties": {
        "@id": {
          "pattern": "^/people/\\d+$"
        },
        "@type": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "firstname": {
          "type": "string"
        },
        "lastname": {
          "type": "string"
        }
      },
      "required": [
        "@id",
        "@type",
        "username",
        "email",
        "firstname",
        "lastname"
      ],
      "additionalProperties": false
    },
    "paymentBlocked": {
      "type": "boolean"
    },
    "id": {
      "type": "integer"
    }
  },
  "additionalProperties": false,
  "required": [
    "@context",
    "@id",
    "@type",
    "analyticalDimension",
    "location",
    "assignee",
    "assignor",
    "paymentBlocked",
    "id"
  ]
}
