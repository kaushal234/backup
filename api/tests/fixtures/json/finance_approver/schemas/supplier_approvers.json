{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {
      "pattern": "^/finance/supplier_approvers$"
    },
    "@type": {
      "type": "string"
    },
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {
            "pattern": "^/finance/supplier_approvers/\\d+$"
          },
          "@type": {
            "type": "string"
          },
          "supplier": {
            "type": "string"
          },
          "supplierName": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "type":"object",
            "properties": {
              "@id": {"pattern": "^/locations/\\d+$"},
              "@type": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "erp": {
                "type": "integer"
              }
            },
            "required": [
              "@id",
              "@type",
              "name",
              "erp"
            ],
            "additionalProperties": false
          },
          "assignor": {
            "type": "object",
            "properties": {
              "@id": {
                "pattern": "^/people/\\d+$"
              },
              "@type": {
                "type": "string"
              },
              "username": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "firstname": {
                "type": "string"
              },
              "lastname": {
                "type": "string"
              }
            },
            "required": [
              "@id",
              "@type",
              "username",
              "email",
              "firstname",
              "lastname"
            ],
            "additionalProperties": false
          },
          "assignee": {
            "type": "object",
            "properties": {
              "@id": {
                "pattern": "^/people/\\d+$"
              },
              "@type": {
                "type": "string"
              },
              "username": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "firstname": {
                "type": "string"
              },
              "lastname": {
                "type": "string"
              }
            },
            "required": [
              "@id",
              "@type",
              "username",
              "email",
              "firstname",
              "lastname"
            ],
            "additionalProperties": false
          },
          "paymentBlocked": {
            "type": "boolean"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "@id",
        "@type",
        "supplier",
        "supplierName",
        "location",
        "assignee",
        "assignor",
        "paymentBlocked"
      ]
    },
    "uniqueItems": true,
    "minItems": 1
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:member"
  ]
}
