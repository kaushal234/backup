{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {"pattern": "^/mis/types/\\d+$"},
    "@type": {"type": "string"},
    "id": {"type":  "integer"},
    "indiceFactor": {"type": ["string", "null"]},
    "type": {"type": "string"},
    "description": {"type": "string"}
  },
  "required": [
    "@id",
    "@type",
    "id",
    "indiceFactor",
    "description",
    "type"
  ],
  "additionalProperties": false
}
