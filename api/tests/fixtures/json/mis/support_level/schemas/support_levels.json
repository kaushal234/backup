{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/mis/support_levels$"},
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@context": {"type": "string"},
          "@id": {"pattern": "^/mis/support_levels/\\d+$"},
          "@type": {"type": "string"},
          "id": {"type": "integer"},
          "level": {"type": "integer"},
          "name": {"type": "string"},
          "description": {"type": ["string", "null"]}
        },
        "required": [
          "@id",
          "@type",
          "id",
          "level",
          "name",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "additionalProperties": false
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:member",
    "hydra:search"
  ]
}
