{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {"pattern": "^/mis/applications/\\d+$"},
    "@type": {"type": "string"},
    "id": {"type":  "integer"},
    "name": {"type":  "string"},
    "jiraProjectId": {"type":  ["integer", "null"]}
  },
  "required": [
    "@id",
    "@type",
    "id",
    "name",
    "jiraProjectId"
  ],
  "additionalProperties": false
}
