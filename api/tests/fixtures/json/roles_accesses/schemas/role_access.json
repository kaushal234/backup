{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {
      "pattern": "^/mis/role_accesses/\\d+$"
    },
    "@type": {
      "type": "string"
    },
    "group": {
      "type": "object",
      "properties": {
        "@id": {
          "pattern": "^/groups/\\d+$"
        },
        "@type": {
          "type": "string"
        },
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "features": {
          "type": "array"
        }
      },
      "required": [
        "@id",
        "@type",
        "id",
        "name",
        "description",
        "features"
      ],
      "additionalProperties": false
    },
    "locationProperty": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "integer"
    }
  },
  "required": [
    "@id",
    "@type",
    "group",
    "locationProperty",
    "id"
  ],
  "additionalProperties": false
}