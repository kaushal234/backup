{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {"pattern": "^/equipment_records/\\d+$"},
    "@type": {
      "type": "string"
    },
    "id": {
      "type": "integer"
    },
    "serialNumber": {
      "type": "string"
    },
    "type": {
      "type": ["string", "null"]
    },
    "model": {
      "type": ["string", "null"]
    },
    "location": {
      "type": ["string", "null"]
    },
    "legacyId": {
      "type": "integer"
    },
    "publishable": {"type": "boolean"},
    "dateShipped": {
      "type": ["string", "null"]
    },
    "greenTagDate": {
      "type": ["string", "null"]
    },
    "manufacturerLocation": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "@id": {"pattern": "^/locations/\\d+$"},
            "name": {"type": "string"},
            "erp": {"type": ["integer", "null"]},
            "@type": {"type": "string"},
            "legacyId": {"type": "integer"}
          },
          "required": [
            "@id",
            "@type",
            "legacyId"
          ]
        }
      ]
    },
    "buyer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "@id": {"pattern": "^/sales/customers/\\d+$"},
        "@type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "legacyId": {
          "type": "integer"
        }
      },
      "required": [
        "@id",
        "@type",
        "name",
        "legacyId"
      ]
    }
  },
  "required": [
    "@id",
    "@type",
    "id",
    "serialNumber",
    "type",
    "model",
    "location",
    "publishable",
    "legacyId",
    "dateShipped",
    "greenTagDate",
    "manufacturerLocation",
    "buyer"
  ]
}
