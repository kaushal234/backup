{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "@id": {"pattern": "^/equipment_records/\\d+$"},
    "@type": {
      "type": "string"
    },
    "serialNumber": {
      "type": "string"
    },
    "type": {
      "type": ["string", "null"]
    },
    "model": {
      "type": ["string", "null"]
    },
    "legacyId": {
      "type": "integer"
    }
  },
  "required": [
    "@id",
    "@type",
    "serialNumber",
    "type",
    "model",
    "legacyId"
  ]
}
