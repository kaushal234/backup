{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "@context": {"type": "string"},
    "@id": {"pattern": "^/equipment_records/\\d+$"},
    "@type": {"type": "string"},
    "id": {"type": "integer"},
    "serialNumber": {"type": "string"},
    "endUser":  {"$ref": "../../sales/customer/schemas/customer_light.json"},
    "model": {"type": ["string", "null"]},
    "type": {"type": ["string", "null"]},
    "airport": {"$ref": "../../iata_code/schemas/airport.json"},
    "dateCommissioned": {"type": ["string", "null"]}
  },
  "required": [
    "@id",
    "@type",
    "id",
    "serialNumber",
    "endUser",
    "model",
    "type",
    "airport",
    "dateCommissioned"
  ]
}
