          "specification": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "@id": {
                "pattern": "^/mis/specifications/\\d+$"
              },
              "@type": {
                "type": "string"
              },
              "module": {
                "type": "string"
              },
              "id": {
                "type": "integer"
              },
              "userStories": {
                "type": [
                  "array",
                  "null"
                ]
              },
              "status": {
                "type": "string"
              }
            }
          },
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "notificationColor": {
            "type": ["string", "null"]
          },
          "legacyId": {
            "type": "integer"
          },
          "misRelative": {
            "type": "boolean"
          },
          "notifyOperationalOwner": {
            "type": "boolean"
          },
          "notifyKeyUser": {
            "type": "boolean"
          },
          "operationalOwner": {
            "type": "object",
            "properties": {
              "@id": {
                "pattern": "^/people/\\d+$"
              },
              "@type": {
                "type": "string"
              },
              "username": {
                "type": "string"
              },
              "firstname": {
                "type": "string"
              },
              "lastname": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "legacyId": {
                "type": "integer"
              },
              "jobTitle": {
                "type": ["string", "null"]
              },
              "businessUnit": {
                "type": ["object", "string", "null"]
              },
              "position": {
                "type": ["object", "string", "null"]
              },
              "photo": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "../../../shared/schemas/file_light.json"
                  }
                ]
              }
            },
            "required": [
              "@id",
              "@type",
              "firstname",
              "lastname",
              "email",
              "legacyId",
              "jobTitle",
              "businessUnit",
              "position",
              "username",
              "photo"
            ],
            "additionalProperties": false
