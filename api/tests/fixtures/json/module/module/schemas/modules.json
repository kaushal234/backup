                "type": "object",
                "properties": {
                  "@id": {"pattern": "^/people/\\d+$"},
                  "@type": {
                    "type": "string"
                  },
                  "username": {
                    "type": "string"
                  },
                  "firstname": {
                    "type": "string"
                  },
                  "lastname": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "legacyId": {
                    "type": "integer"
                  },
                  "jobTitle": {
                    "type": ["string", "null"]
                  },
                  "businessUnit": {
                    "type": ["object", "string", "null"]
                  },
                  "position": {
                    "type": ["object", "string", "null"]
                  },
                  "photo": {
                    "oneOf": [
                      { "type": "null" },
                      { "$ref": "../../../shared/schemas/file_light.json" }
                    ]
                  }
                },
                "required": [
                  "@id",
                  "@type",
                  "firstname",
                  "lastname",
                  "email",
                  "legacyId",
                  "jobTitle",
                  "businessUnit",
                  "position",
                  "username",
                  "photo"
                ],
                "additionalProperties": false
              }
            ]
