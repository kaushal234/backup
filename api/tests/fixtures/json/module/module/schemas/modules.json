                "required": [
                  "@id",
                  "@type",
                  "id",
                  "name",
                  "description"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "@id",
          "@type",
          "specification",
          "id",
          "legacyId",
          "name",
          "operationalOwner",
          "keyUser",
          "shortDescription",
          "fullDescription",
          "dmsProcedureId",
          "dmsHelpId",
          "legacyLoc",
          "migrationCurrentStep",
          "migrationEstimatedHours",
          "migrated",
          "department",
          "application",
          "typeDefaultAssignees",
          "misRelative",
          "notifyOperationalOwner",
          "notifyKeyUser",
          "notificationColor",
          "disabledForTroubleTicket"
        ],
        "additionalProperties" : true
      },
      "minItems": 2
    }
