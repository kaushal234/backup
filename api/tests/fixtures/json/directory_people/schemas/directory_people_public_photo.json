{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {"pattern": "^/(people|(sales/extranet_)?users)/\\d+$"},
    "@type": {
      "type": "string"
    },
    "id": {
      "type": "integer"
    },
    "firstname": {
      "type": "string"
    },
    "lastname": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "legacyId": {
      "type": "integer"
    },
    "username": {
      "type": "string"
    },
    "photo": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "../../shared/schemas/file_light.json" }
      ]
    }
  },
  "required": [
    "@id",
    "@type",
    "firstname",
    "lastname",
    "email",
    "username",
    "photo"
  ],
  "additionalProperties": false
}
