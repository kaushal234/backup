{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {"pattern": "^/people/\\d+$"},
    "@type": {
      "type": "string"
    },
    "id": {
      "type": "integer"
    },
    "firstname": {
      "type": "string"
    },
    "lastname": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "legacyId": {
      "type": "integer"
    },
    "username": {
      "type": "string"
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "firstname",
    "lastname",
    "email",
    "username"
  ],
  "additionalProperties": false
}
