{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "required": [ "hydra:member", "@id" ],
  "properties": {
    "@id": {"pattern": "^/people$"},
    "hydra:member": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "@id": {"pattern": "^/people/\\d+$"},
          "@type": {
            "type": "string"
          },
          "jobTitle": {
            "type": ["string", "null"]
          },
          "businessUnit": {
            "type": ["object", "string", "null"]
          },
          "position": {
            "type": ["object", "string", "null"]
          },
          "firstname": {
            "type": "string"
          },
          "lastname": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "@id",
          "@type",
          "jobTitle",
          "businessUnit",
          "position",
          "firstname",
          "lastname",
          "email"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  }
}
