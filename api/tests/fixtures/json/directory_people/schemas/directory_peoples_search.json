{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "required": [ "hydra:member", "@id" ],
  "properties": {
    "@id": {"pattern": "^/people/search$"},
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {"pattern": "^/people/\\d+$"},
          "@type": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "firstname": {
            "type": "string"
          },
          "lastname": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "jobTitle": {
            "type": ["string","null"]
          }
        },
        "required": [
          "@id",
          "@type",
          "id",
          "firstname",
          "lastname",
          "email",
          "jobTitle"
        ],
        "additionalProperties": false
      }
    }
  }
}
