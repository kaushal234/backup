{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {"type": "string"},
    "@id": {"pattern": "^/freight_forwarders/\\d+$"},
    "@type": { "type": "string" },
    "id": { "type": "integer" },
    "name": { "type": "string" },
    "language": { "type": "string" },
    "supplierNumber": { "type": ["string", "null"] },
    "location": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "../../directory_location/schemas/directory_location_public.json"}
      ]
    },
    "emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "id",
    "name",
    "language",
    "supplierNumber",
    "location",
    "emails"
  ],
  "additionalProperties": false
}
