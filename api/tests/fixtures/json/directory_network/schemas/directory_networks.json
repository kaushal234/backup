{
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {"pattern": "^/networks$"},
    "@type": {
      "type": "string"
    },
    "hydra:totalItems": {
      "type": "integer"
    },
    "hydra:search": {
      "type": "object"
    },
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {"pattern": "^/networks/\\d+$"},
          "@type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "@id",
          "@type",
          "name"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "@context",
    "@id",
    "hydra:member"
  ]
}
