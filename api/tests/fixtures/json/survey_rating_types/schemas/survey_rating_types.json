{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "@context": {"type": "string"},
        "@id": {"pattern": "^/surveys/rating_types$"},
        "@type"   : {"type": "string"},
        "hydra:member": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "@id"        : {"type": "string"},
                    "@type"      : {"type": "string"},
                    "id"         : {"type": "integer"},
                    "min"        : {"type": "integer"},
                    "max"        : {"type": "integer"},
                    "minLabel"   : {"type": "string"},
                    "maxLabel"   : {"type": "string"},
                    "description": {"type": ["string", "null"]},
                    "survey": {
                        "type": ["object", "null"],
                        "properties": {
                            "@id": {"pattern": "^/surveys/models/\\d+$"},
                            "@type": {"type": "string"},
                            "name": {"type": "string"},
                            "createdAt": {"type": "string"},
                            "updatedAt": {"type": "string"},
                            "createdBy": {
                                "type": "object",
                                "properties": {
                                    "@id": {"pattern": "^/people/\\d+$"},
                                    "@type"    : {"type": "string"},
                                    "firstname": {"type": "string"},
                                    "lastname" : {"type": "string"},
                                    "photo": {
                                        "oneOf": [
                                            { "type": "null" },
                                            { "$ref": "../../shared/schemas/file_light.json" }
                                        ]
                                    },
                                    "email"    : {"type": "string"},
                                    "username" : {"type": "string"}
                                },
                                "required": [ "@id", "@type", "firstname", "lastname", "photo", "email", "username" ],
                                "additionalProperties": false
                            },
                            "updatedBy": {
                                "type": ["object", "null"],
                                "properties": {
                                    "@id": {"pattern": "^/people/\\d+$"},
                                    "@type"    : {"type": "string"},
                                    "firstname": {"type": "string"},
                                    "lastname" : {"type": "string"},
                                    "photo": {
                                        "oneOf": [
                                            { "type": "null" },
                                            { "$ref": "../../shared/schemas/file_light.json" }
                                        ]
                                    },
                                    "email"    : {"type": "string"},
                                    "username" : {"type": "string"}
                                },
                                "required": [ "@id", "@type", "firstname", "lastname", "photo", "email", "username" ],
                                "additionalProperties": false
                            }
                        },
                        "required": [ "@id", "@type", "name", "createdAt", "updatedAt", "createdBy", "updatedBy" ],
                        "additionalProperties": false
                    }
                },
                "required": [ "@id", "@type", "id", "min", "max", "minLabel", "maxLabel", "description", "survey"],
                "additionalProperties": false
            },
            "minItems": 0
        },
        "hydra:totalItems": {"type": "integer"},
        "hydra:search": {
            "type": "object",
            "properties": {
                "@type": {"type": "string"},
                "hydra:template": {"type": "string"},
                "hydra:variableRepresentation": {"type": "string"},
                "hydra:mapping": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "@type": {"type": "string"},
                            "variable": {"type": "string"},
                            "property": {"type": "string"},
                            "required" : {"type": "boolean"}
                        },
                        "required": [ "@type", "variable", "property", "required" ],
                        "additionalProperties": false
                    },
                    "minItems": 0
                }

            },
            "required": [ "@type", "hydra:template", "hydra:variableRepresentation", "hydra:mapping" ],
            "additionalProperties": false
        },
        "hydra:view": {
            "type": ["object", "null"],
            "properties": {
                "@id": { "type": "string" },
                "@type": { "type": "string" }
            },
            "required": [ "@id", "@type" ]
        }
    },
    "required": [ "@context", "@id", "@type", "hydra:member", "hydra:totalItems", "hydra:search" ]
}
