{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "@context"   : {"type": "string"},
        "@id": {"pattern": "^/surveys/rating_types/\\d+$"},
        "@type"      : {"type": "string"},
        "id"         : {"type": "integer"},
        "min"        : {"type": "integer"},
        "max"        : {"type": "integer"},
        "minLabel"   : {"type": "string"},
        "maxLabel"   : {"type": "string"},
        "description": {"type": ["string", "null"]},
        "survey": {
            "type": ["object", "null"],
            "properties": {
                "@id": {"pattern": "^/surveys/models/\\d+$"},
                "id"         : {"type": "integer"},
                "@type"      : {"type": "string"},
                "name"       : {"type": "string"},
                "description": {"type": ["string", "null"]},
                "expirationDate": {"type": ["string", "null"]},
                "createdAt"  : {"type": "string"},
                "updatedAt"  : {"type": "string"},
                "createdBy": {
                    "type": "object",
                    "properties": {
                        "@id": {"pattern": "^/people/\\d+$"},
                        "@type"    : {"type": "string"},
                        "firstname": {"type": "string"},
                        "lastname" : {"type": "string"},
                        "photo": {
                            "oneOf": [
                                { "type": "null" },
                                { "$ref": "../../shared/schemas/file_light.json" }
                            ]
                        },
                        "email"    : {"type": "string"},
                        "username" : {"type": "string"}
                    },
                    "required": [ "@id", "@type", "firstname", "lastname", "photo", "email", "username" ],
                    "additionalProperties": false
                },
                "updatedBy": {
                    "type": ["object", "null"],
                    "properties": {
                        "@id": {"pattern": "^/people/\\d+$"},
                        "@type"    : {"type": "string"},
                        "firstname": {"type": "string"},
                        "lastname" : {"type": "string"},
                        "photo": {
                            "oneOf": [
                                { "type": "null" },
                                { "$ref": "../../shared/schemas/file_light.json" }
                            ]
                        },
                        "email"    : {"type": "string"},
                        "username" : {"type": "string"}
                    },
                    "required": [ "@id", "@type", "firstname", "lastname", "photo", "email", "username" ],
                    "additionalProperties": false
                }
            },
            "required": [ "@id", "id", "name", "description", "expirationDate", "@type", "createdAt", "updatedAt", "createdBy", "updatedBy" ],
            "additionalProperties": false
        }
    },
    "required": [ "@context", "@id", "@type", "id", "min", "max", "minLabel", "maxLabel", "description", "survey" ],
    "additionalProperties": false
}
