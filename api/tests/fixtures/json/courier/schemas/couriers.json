{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/parts/couriers"},
    "hydra:member": {
      "type": "array",
      "items": {
        "properties": {
          "@id": {"pattern": "^/parts/couriers/\\d+$"},
          "@type": { "type": "string" },
          "id":  {"type": ["integer"]},
          "name":  {"type": ["string"]},
          "url":  {"type": ["string", "null"]},
          "parameterName": {"type": ["string", "null"]}
        },
        "required": ["@id", "@type", "id", "name", "url", "parameterName"],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:member"
  ]
}
