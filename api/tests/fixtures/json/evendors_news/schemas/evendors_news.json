                    },
                    "id": {
                        "type": "integer"
                    },
                    "content": {
                        "type": "string"
                    },
                    "publishedAt": {
                        "type": "string"
                    },
                    "unpublishedAt": {
                        "type": "string"
                    },
                    "createdAt": {
                        "type": "string"
                    },
                    "updatedAt": {
                        "type": ["string", "null"]
                    },
                    "createdBy": {"$ref": "../../directory_people/schemas/directory_people_public.json"},
                    "factories": {
                        "type": "array",
                        "items": {
                            "$ref": "../../directory_location/schemas/directory_location_public.json"
