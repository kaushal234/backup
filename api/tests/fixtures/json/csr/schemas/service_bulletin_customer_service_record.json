                      "type": "object",
                      "properties": {
                        "@id": {"pattern": "^/parts/spare_parts_request_parts/\\d+$"},
                        "@type": {"type": "string"},
                        "id": {"type": "integer"},
                        "createdAt": {"type": "string"},
                        "createdBy": {"$ref": "../../directory_people/schemas/directory_people_public.json"},
