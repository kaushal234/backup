{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/service/(technician_on_call_|default_|commissioning_|service_bulletin_|)customer_service_records"},
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {"pattern": "^/service/(technician_on_call_|default_|commissioning_|service_bulletin_|)customer_service_records/\\d+$"},
          "@type": {"type": "string"},
          "id": {"type": "integer"},
          "title": {"type": "string"},
          "completedAt": {"type": ["string", "null"]},
          "type" : {"type": "string"}
        },
        "required": [
          "@id",
          "@type",
          "id",
          "title",
          "completedAt",
          "type"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:member"
  ]
}
