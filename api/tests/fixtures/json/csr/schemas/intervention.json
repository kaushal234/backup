{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {"type": "string"},
    "@id": {"pattern": "^/service/interventions/\\d+$"},
    "@type": {"type": "string"},
    "id": {"type": "integer"},
    "startedAt": {"type": ["string", "null"]},
    "endedAt": {"type": ["string", "null"]},
    "status": {
      "type": "string"
    },
    "plannedBy" : {"oneOf": [{"type": "null"},{"$ref": "../../directory_people/schemas/directory_people_public.json"}]},
    "comments" : {"type": ["string", "null"]},
    "plannedAt": {"type": ["string", "null"]},
    "customerServiceRecord": {"type": "string", "pattern": "^/service/(technician_on_call_|default_|commissioning_|service_bulletin_|)customer_service_records/\\d+$"},
    "leader": {
      "type": "object",
      "properties": {
        "@id": {
          "pattern": "^/people/\\d+$"
        },
        "username": {"type": "string"},
        "hidden": {"type": "boolean"},
        "disabled": {"type": "boolean"},
        "passwordUpdatedAt": {"type": "string"},
        "email": {"type": "string"},
        "photo": {"type": ["string", "null"]},
        "firstname": {"type": "string"},
        "lastname": {"type": "string"},
        "passwordExpirationDate": {"type": "string"}
      },
      "required": [
        "@id",
        "@type",
        "username",
        "hidden",
        "disabled",
        "passwordUpdatedAt",
        "email",
        "photo",
        "firstname",
        "lastname",
        "passwordExpirationDate"
      ]
    },
    "operators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {
            "pattern": "^/people/\\d+$"
          },
          "username": {"type": "string"},
          "hidden": {"type": "boolean"},
          "disabled": {"type": "boolean"},
          "passwordUpdatedAt": {"type": "string"},
          "email": {"type": "string"},
          "photo": {"type": ["string", "null"]},
          "firstname": {"type": "string"},
          "lastname": {"type": "string"},
          "passwordExpirationDate": {"type": "string"}
        },
        "required": [
          "@id",
          "@type",
          "username",
          "hidden",
          "disabled",
          "passwordUpdatedAt",
          "email",
          "photo",
          "firstname",
          "lastname",
          "passwordExpirationDate"
        ]
      }
    }
  },
  "required": [
    "@id",
    "@type",
    "id",
    "startedAt",
    "endedAt",
    "plannedAt",
    "customerServiceRecord",
    "operators",
    "status",
    "comments",
    "plannedBy"
  ],
  "additionalProperties": false
}


