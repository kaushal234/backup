{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {
      "type": "string",
      "pattern": "^/public/equipment_records"
    },
    "@type": {
      "type": "string"
    },
    "hydra:totalItems": {
      "type": "integer"
    },
    "hydra:member": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "@id": {
            "type": "string"
          },
          "@type": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "serialNumber": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "type": {
            "type": ["string", "null"]
          },
          "airportCode": {
            "type": ["string", "null"]
          },
          "optionsDescription": {
            "type": ["string", "null"]
          }
        },
        "required": [
          "id",
          "serialNumber",
          "model",
          "type",
          "airportCode",
          "optionsDescription"
        ]
      }
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:member",
    "hydra:totalItems"
  ]
}
