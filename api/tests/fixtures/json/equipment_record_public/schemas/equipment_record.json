{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "integer"
    },
    "serialNumber": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "airportCode": {
      "type": ["string", "null"]
    },
    "optionsDescription": {
      "type": ["string", "null"]
    },
    "lastManual": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer"
            },
            "createdAt": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "documents": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "description": {
                    "type": ["string", "null"]
                  },
                  "categoryName": {
                    "type": ["string", "null"]
                  },
                  "fileId": {
                    "type": ["integer", "null"]
                  },
                  "extension": {
                    "type": ["string", "null"]
                  }
                },
                "required": [
                  "id",
                  "description",
                  "categoryName",
                  "fileId",
                  "extension"
                ]
              }
            }
          },
          "required": [
            "id",
            "createdAt",
            "documents"
          ]
        }
      ]
    }
  },
  "required": [
    "id",
    "serialNumber",
    "model",
    "type",
    "airportCode",
    "optionsDescription",
    "lastManual"
  ]
}
