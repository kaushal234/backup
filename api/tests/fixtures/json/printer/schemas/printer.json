{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "@context": {
            "type": "string"
        },
        "@id": {
            "readOnly": true,
            "type": "string",
            "pattern": "^/support/manual_printers/\\d+$"
        },
        "@type": {
            "readOnly": true,
            "type": "string"
        },
        "id": {
            "readOnly": true,
            "type": "integer"
        },
        "companyName": {
            "type": "string"
        },
        "firstname": {
            "type": "string"
        },
        "lastname": {
            "type": "string"
        },
        "email": {
            "maxLength": 255,
            "externalDocs": {
                "url": "https://schema.org/email"
            },
            "type": "string"
        },
        "address": {
            "type": "object",
            "$ref": "../../shared/schemas/address_with_country.json"
        },
        "prints": {
            "type": "array",
            "items": {
                "oneOf": [
                    {"type":  "string"},
                    {"$ref": "../../manual_prints/schemas/manual_print_public.json"}
                ]
            }
        }
    },
    "required": [
        "@id",
        "@type",
        "id",
        "companyName",
        "firstname",
        "lastname",
        "email",
        "address",
        "prints"
    ],
    "additionalProperties": false
}
