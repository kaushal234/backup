{
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/juridical_locations$"},
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {"pattern": "^/juridical_locations/\\d+$"},
          "@type": {"type": "string"},
          "id": {"type": "integer"},
          "legacyId": {"type": "integer"},
          "address": {
            "type": "object",
            "$ref": "../../shared/schemas/address_with_country.json"
          },
          "name": {"type": "string"}
        },
        "required": ["@id", "@type", "id", "legacyId", "name"],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": ["@context", "@id", "hydra:member"]
}
