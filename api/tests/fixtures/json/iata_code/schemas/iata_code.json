{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {"pattern": "^/(heliports|ferry_ports|metropolitan_areas|off_line_points|bus_stations|railway_stations|airports)/\\d+$"},
    "@type": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "id": {
      "type": "integer"
    },
    "legacyId": {
      "type": "integer"
    },
    "cityCode3": {
      "type": ["string", "null"]
    },
    "cityName": {
      "type": "string"
    },
    "state": {
      "type": ["string", "null"]
    },
    "country": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "@id": {"pattern": "^/countries/\\d+$"},
            "@type": {
              "type": "string"
            },
            "id": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "legacyId": {
              "type": "integer"
            },
            "isoCode2": {
              "type": "string"
            },
            "asms": {
              "type": "array",
              "items": {
                "oneOf": [
                  {"type": "null"},
                  {
                    "$ref": "../../directory_people/schemas/directory_people_public.json"
                  }
                ]
              }
            }
          },
          "required": [
            "@id",
            "@type",
            "id",
            "name",
            "legacyId"
          ]
        }
      ]
    },
    "code": {
      "type": "string"
    },
    "name": {
      "type": ["string", "null"]
    },
    "source": {
      "type": "string"
    },
    "latitude": {
      "type": ["number", "null"]
    },
    "longitude": {
      "type": ["number", "null"]
    }
  },
  "required": [
    "@id",
    "@type",
    "type",
    "id",
    "legacyId",
    "cityCode3",
    "cityName",
    "state",
    "country",
    "code",
    "name",
    "source",
    "latitude",
    "longitude"
  ]
}
