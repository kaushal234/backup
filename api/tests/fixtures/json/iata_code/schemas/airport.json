{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {"pattern": "^/(heliports|ferry_ports|metropolitan_areas|off_line_points|bus_stations|railway_stations|airports)/\\d+$"},
    "@type": {
      "type": "string"
    },
    "cityName": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "latitude": {
      "type": ["number", "null"]
    },
    "longitude": {
      "type": ["number", "null"]
    }
  },
  "required": [
    "@id",
    "@type",
    "cityName",
    "code",
    "latitude",
    "longitude"
  ]
}
