{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "@context": {"type": "string"},
    "@id": {"pattern": "^/sales/customer_erp_references/\\d+$"},
    "@type": {"type": "string"},
    "id": {"type": "integer"},
    "customerNumber": {"type": "string"},
    "customer": {"type": "string"},
    "sso": {
      "type": "object",
      "properties": {
        "@id": {"pattern": "^/locations/\\d+$"},
        "@type": {"type": "string"},
        "name": {"type": "string"},
        "erp": {"type": ["integer", "null"]}
      },
      "required": ["@id", "@type", "name", "erp"],
      "additionalProperties": false
    }
  },
  "required": ["@context", "@id", "@type", "id", "customer", "customerNumber", "sso"]
}
