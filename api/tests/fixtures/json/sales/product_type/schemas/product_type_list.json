{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/sales/product_types$"},
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {"pattern": "^/sales/product_types/\\d+$"},
          "@type": {
            "type": "string"
          },
          "englishName": {
            "type": ["string", "null"]
          }
        },
        "required": [
          "@id",
          "@type",
          "englishName"
        ],
        "additionalProperties": false,
        "minItems": 1
      }
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:member"
  ]
}
