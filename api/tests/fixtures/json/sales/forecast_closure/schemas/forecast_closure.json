    "forecastClosureFiles": {
      "type": "array"
    },
    "competitor": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "../../competitor/schemas/competitor_public.json"}
      ]
    },
    "legacyId": {
      "type": "integer"
    }
