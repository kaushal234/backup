{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/sales/competitors/\\d+$"},
    "@type": {
      "type": "string"
    },
    "legacyId": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    }
  },
  "required": ["@id", "@type", "legacyId", "name"],
  "additionalProperties": false
}
