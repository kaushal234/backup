{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/sales/competitors$"},
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {"pattern": "^/sales/competitors/\\d+$"},
          "@type": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "legacyId": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "shortDescription": {
            "type": "string"
          },
          "url": {
            "type": ["string", "null"]
          },
          "productTypes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "@id": {"pattern": "^/sales/product_types/\\d+$"},
                "@type": {
                  "type": "string"
                },
                "legacyId": {
                  "type": "integer"
                },
                "englishName": {
                  "type": ["string", "null"]
                }
              },
              "required": [
                "@id",
                "@type",
                "englishName"
              ],
              "additionalProperties": false,
              "minItems": 1
            }
          }
        },
        "required": ["@id", "@type", "id", "legacyId", "name", "shortDescription", "url"],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:member",
    "hydra:search"
  ]
}
