{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/sales/customers$"},
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {"pattern": "^/sales/customers/\\d+$"},
          "@type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "crt": {
            "type": "array"
          },
          "inforLnBusinessPartnerCodes": {
            "type": "array"
          }
        },
        "required": [
          "@id",
          "@type",
          "name",
          "crt"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:totalItems",
    "hydra:member",
    "hydra:search"
  ]
}
