{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {"pattern": "^/sales/customers/\\d+(|/status|/hierarchy|/watch_list)$"},
    "@type": {
      "type": "string"
    },
    "id": {
      "type": "integer"
    },
    "parentCustomer": {
      "type": ["object", "null"]
    },
    "childrenCustomers": {
      "type": "array"
    },
    "name": {
      "type": "string"
    },
    "legacyAddress": {
      "type": ["string", "null"]
    },
    "address": {
      "type": "object",
        "items": {
          "type": "object",
          "properties": {
            "street1": {
              "type": ["string", "null"]
            },
            "street2": {
              "type": ["string", "null"]
            },
            "postalCode": {
              "type": ["string", "null"]
            },
            "city": {
              "type": ["string", "null"]
            },
            "town": {
              "type": ["string", "null"]
            },
            "state": {
              "type": ["string", "null"]
            }
          }
        }
    },
    "country": {
      "type": ["object", "null"]
    },
    "hidden": {
      "type": "boolean"
    },
    "url": {
      "type": ["string", "null"]
    },
    "phone": {
      "type": ["string", "null"]
    },
    "fax": {
      "type": ["string", "null"]
    },
    "customerTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {"pattern": "^/sales/customer_types/\\d+$"},
          "@type": {"type": "string"},
          "id": {"type": "integer"},
          "name": {"type": "string"},
          "legacyId": {"type": "integer"}
        },
        "required": [
          "@id",
          "@type",
          "id",
          "name",
          "legacyId"
        ],
        "additionalProperties": false
      }
    },
    "secondarySalesRepresentatives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asm": {
            "type": "object",
            "properties": {
              "@id": {"pattern": "^/people/\\d+$"},
              "@type": {"type": "string"},
              "firstname": {"type": "string"},
              "lastname": {"type": "string"},
              "email": {"type": "string"},
              "username": {"type": "string"},
              "legacyId": {"type": "integer"}
            },
            "required": ["@id", "@type", "firstname", "lastname", "email", "username", "legacyId"],
            "additionalProperties": false
          },
          "subDivision": {
            "type": "object",
            "properties": {
              "@id": {"pattern": "^/sub_divisions/\\d+$"},
              "@type": {"type": "string"},
              "name": {"type": "string"},
              "legacyId": {"type": "integer"}
            },
            "required": ["@id", "@type", "name", "legacyId"],
            "additionalProperties": false
          }
        }
      }
    },
    "mainSalesRepresentative": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "asm": {
              "type": "object",
              "properties": {
                "@id": {"pattern": "^/people/\\d+$"},
                "@type": {"type": "string"},
                "firstname": {"type": "string"},
                "lastname": {"type": "string"},
                "email": {"type": "string"},
                "username": {"type": "string"},
                "legacyId": {"type": "integer"}
              },
              "required": ["@id", "@type", "firstname", "lastname", "email", "username", "legacyId"],
              "additionalProperties": false
            },
            "subDivision": {
              "type": "object",
              "properties": {
                "@id": {"pattern": "^/sub_divisions/\\d+$"},
                "@type": {"type": "string"},
                "name": {"type": "string"},
                "legacyId": {"type": "integer"}
              },
              "required": ["@id", "@type", "name", "legacyId"],
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "logo": {
      "oneOf": [
        { "type": "null" },
        { "type": "string" },
        { "$ref": "../../../shared/schemas/file.json" }
      ]
    },
    "legacyId": {
      "type": "integer"
    },
    "customerFiles": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          { "$ref": "../../../shared/schemas/file.json" }
        ]
      },
      "uniqueItems": true
    },
    "status": {
      "type": "string"
    },
    "watchList": {
      "type" : "boolean"
    },
    "watchListReason": {
      "type": ["string", "null"]
    },
    "creditLimits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {"pattern": "^/finance/credit_limits/\\d+$"},
          "@type": { "type": "string" },
          "type": {"type": "string"},
          "amount": { "type": "integer" },
          "currency": {
            "type": "object",
            "$ref": "../../../finance_currency/schemas/currency.json"
          }
        },
        "required": [
          "@id",
          "@type",
          "type",
          "amount",
          "currency"
        ],
        "additionalProperties": false
      }
    },
    "easymileJiraProjectKey": {
      "type": ["string", "null"]
    },
    "inforLnBusinessPartnerCodes": {
      "type": "array"
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "id",
    "parentCustomer",
    "childrenCustomers",
    "name",
    "address",
    "country",
    "hidden",
    "url",
    "phone",
    "fax",
    "customerTypes",
    "mainSalesRepresentative",
    "secondarySalesRepresentatives",
    "logo",
    "legacyId",
    "customerFiles",
    "status",
    "watchList",
    "watchListReason",
    "creditLimits"
  ],
  "additionalProperties": false
}
