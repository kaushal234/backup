{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/sales/customers/\\d+(|/status|/hierarchy|/watch_list)$"},
    "@type": {"type": "string"},
    "id": {"type": "integer"},
    "name": {"type": "string"},
    "address":  {
      "oneOf": [
        {"type": "array"},
        {"$ref": "../../../shared/schemas/address_without_country.json"}
      ]
    },
    "country": {"type": ["object", "null"]},
    "phone": {"type": ["string", "null"]},
    "fax": {"type": ["string", "null"]},
    "legacyId": {"type": "integer"}
  },
  "required": [
    "@id",
    "@type",
    "id",
    "name",
    "address",
    "country",
    "phone",
    "fax",
    "legacyId"
  ],
  "additionalProperties": false
}
