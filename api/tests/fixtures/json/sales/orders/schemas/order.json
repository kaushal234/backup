                  "name": {
                    "type": "string"
                  },
                  "legacyId": {
                    "type": "integer"
                  },
                  "id": {
                    "type": "integer"
                  }
                },
                "required": [
                  "@id",
                  "@type",
                  "name",
                  "id",
                  "legacyId"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "@id",
            "@type",
            "name",
            "country",
            "legacyId",
            "customerTypes"
          ],
          "additionalProperties": false
        }
      ]
    },
    "customerName": {
      "type": "string"
    },
    "newCustomer": {
      "type": "boolean"
    },
    "baanOrderNumbers": {
      "type": "array",
      "uniqueItems": true
    },
    "lines": {
      "type": "array"
    },
    "customerPurchaseOrders": {
      "type": "array",
      "uniqueItems": true
    },
    "xmlSource": {
      "type": [
        "null",
        "string"
      ]
    },
    "note": {
      "type": [
        "null",
        "string"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "../../../shared/schemas/file.json"
      },
      "uniqueItems": true
    },
    "legacyId": {
      "type": "integer"
    },
    "inforLnBusinessPartnerCode": {
      "type": ["null", "string"]
    }
