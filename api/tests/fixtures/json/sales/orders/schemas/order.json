  "required": [
    "@context",
    "@id",
    "@type",
    "id",
    "sso",
    "juridicalLocation",
    "inforLnBusinessPartnerCode",
    "enteredAt",
    "closedAt",
    "status",
    "equoteId",
    "baanOrderNumbers",
    "asm",
    "buyer",
    "contact",
    "endUser",
    "customerName",
    "newCustomer",
    "salesAgent",
    "customerPurchaseOrders",
    "xmlSource",
    "files",
    "note",
    "legacyId"
  ],
  "additionalProperties": false
}
