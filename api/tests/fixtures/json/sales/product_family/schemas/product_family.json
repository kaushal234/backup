{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {"pattern": "^/sales/product_families/\\d+$"},
    "@type": {
      "type": "string"
    },
    "id": {
      "type": "integer"
    },
    "legacyId": {
      "type": "integer"
    },
    "productType": {
      "type": "object",
      "properties": {
        "@id": {"pattern": "^/sales/product_types/\\d+$"},
        "@type": {
          "type": "string"
        },
        "id": {
          "type": "integer"
        },
        "legacyId": {
          "type": "integer"
        },
        "frenchName": {
          "type": ["string", "null"]
        },
        "englishName": {
          "type": ["string", "null"]
        },
        "spanishName": {
          "type": ["string", "null"]
        },
        "portugueseName": {
          "type": ["string", "null"]
        },
        "chineseName": {
          "type": ["string", "null"]
        },
        "japaneseName": {
          "type": ["string", "null"]
        },
        "germanName": {
          "type": ["string", "null"]
        },
        "russianName": {
          "type": ["string", "null"]
        },
        "dms": {
          "type": ["object", "null"]
        }
      },
      "required": [
        "@id",
        "@type",
        "id",
        "legacyId",
        "frenchName",
        "englishName",
        "spanishName",
        "portugueseName",
        "chineseName",
        "japaneseName",
        "germanName",
        "russianName",
        "dms"
      ],
      "additionalProperties": false
    },
    "name": {
      "type": "string"
    },
    "frenchDescription": {
      "type": ["string", "null"]
    },
    "englishDescription": {
      "type": ["string", "null"]
    },
    "spanishDescription": {
      "type": ["string", "null"]
    },
    "portugueseDescription": {
      "type": ["string", "null"]
    },
    "chineseDescription": {
      "type": ["string", "null"]
    },
    "japaneseDescription": {
      "type": ["string", "null"]
    },
    "germanDescription": {
      "type": ["string", "null"]
    },
    "russianDescription": {
      "type": ["string", "null"]
    },
    "hidden": {
      "type": "boolean"
    },
    "publicForTLD": {
      "type": "boolean"
    },
    "publicForAerospecialties": {
      "type": "boolean"
    },
    "publicForSAS": {
      "type": "boolean"
    },
    "products": {
      "type": ["array"]
    },
    "productFamilyDMS": {
      "type": ["array"]
    },
    "dmsPhoto": {
      "type": ["integer", "null"]
    },
    "tags": {
      "type": "array",
      "items": {
        "properties": {
          "@id": {"pattern": "^/sales/product_family_tags/\\d+$"},
          "@type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "@id",
          "@type",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "manufacturingFactories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {
            "pattern": "^/locations/\\d+$"
          },
          "@type": {
            "type": "string"
          },
          "erp": {
            "type": "integer"
          },
          "name": {
            "type": ["string", "null"]
          },
          "legacyId": {
            "type": "integer"
          }
        },
        "required": [
          "@id",
          "@type",
          "erp",
          "name",
          "legacyId"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "id",
    "legacyId",
    "productType",
    "name",
    "frenchDescription",
    "englishDescription",
    "spanishDescription",
    "portugueseDescription",
    "chineseDescription",
    "japaneseDescription",
    "germanDescription",
    "russianDescription",
    "hidden",
    "publicForTLD",
    "publicForAerospecialties",
    "publicForSAS",
    "manufacturingFactories",
    "products",
    "productFamilyDMS",
    "dmsPhoto",
    "tags"
  ],
  "additionalProperties": false
}
