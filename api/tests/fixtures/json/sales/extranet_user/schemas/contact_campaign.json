{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "id": {
      "pattern":"^/contact_campaign/\\d+$/contacts"
    },
    "type": {
      "type": "string"
    },
    "hydra:totalItems": {
      "type": "integer"
    },
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {
            "pattern": "^/sales/extranet_users/\\d+$"
          },
          "@type": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "extranetUserProfile": {
            "type": "object",
            "properties": {
              "@id": {
                "pattern": "^/sales/extranet_user_profiles/\\d+$"
              },
              "@type": {
                "type": "string"
              },
              "customer": {
                "type": "object",
                "properties": {
                  "@id": {
                    "pattern": "^/sales/customers/\\d+$"
                  },
                  "@type": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [

                ]
              }
            },
            "required": [
              "@id",
              "@type",
              "customer"
            ]
          },
          "firstname": {
            "type": "string"
          },
          "lastname": {
            "type": "string"
          }
        },
        "required": [
          "@id",
          "@type",
          "username",
          "email",
          "extranetUserProfile",
          "firstname",
          "lastname"
        ]
      }
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:totalItems"
  ],
  "additionalItems": false
}