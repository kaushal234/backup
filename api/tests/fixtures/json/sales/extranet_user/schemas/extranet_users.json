{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/sales/extranet_users$"},
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {"pattern": "^/sales/extranet_users/\\d+$"},
          "@type": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "legacyId": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "lastname": {
            "type": ["string", "null"]
          },
          "firstname": {
            "type": ["string", "null"]
          },
          "email": {
            "type": ["string", "null"]
          },
          "hidden": {
            "type": "boolean"
          },
          "disabled": {
            "type": "boolean"
          },
          "passwordUpdatedAt": {
            "type": "string"
          },
          "passwordExpirationDate": {
            "type": "string"
          },
          "phones": {
            "type": "array",
            "items": {
              "type": [
                "object"
              ],
              "properties": {
                "@id": {"pattern": "^/phones/\\d+$"},
                "@type": {"type": "string"},
                "type": {"type": "string"},
                "number": {"type": "string"}
              },
              "required": ["@id", "@type", "type", "number"],
              "additionalProperties": false
            }
          },
          "extranetUserProfile": {
            "type": "object",
            "properties": {
              "@id": {"pattern": "^/sales/extranet_user_profiles/\\d+$"},
              "id": {
                "type": "integer"
              },
              "@type": {
                "type": "string"
              },
              "legacyId": {
                "type": "integer"
              },
              "customer": {
                "oneOf": [
                  {"type": "null"},
                  {
                    "type": "object",
                    "properties": {
                      "@id": {"pattern": "^/sales/customers/\\d+$"},
                      "@type": {"type": "string"},
                      "name": {"type": "string"},
                      "status": {"type": "string"},
                      "legacyId": {"type": "integer"}
                    },
                    "required": ["@id", "@type", "name", "status", "legacyId"],
                    "additionalProperties": false
                  }
                ]
              },
              "erpLocation": {
                "oneOf": [
                  {"type": "null"},
                  { "$ref": "../../../directory_location/schemas/directory_location_public.json" }
                ]
              },
              "department": {
                "type": ["string", "null"]
              }
            },
            "required": [
              "@id",
              "@type",
              "id",
              "department",
              "erpLocation",
              "customer",
              "legacyId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "@id",
          "@type",
          "id",
          "username",
          "lastname",
          "firstname",
          "email",
          "hidden",
          "disabled",
          "legacyId",
          "passwordUpdatedAt",
          "passwordExpirationDate",
          "phones"
        ],
        "additionalProperties": false
      }
    },
    "minItems": 1
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:totalItems",
    "hydra:member",
    "hydra:search"
  ]
}
