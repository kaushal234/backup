{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type":"object",
  "properties":{
    "hydra:member":{
      "type":"array",
      "items":{
        "type":"object",
        "properties":{
          "@id": {"pattern": "^/sales/market_intelligence_types/\\d+$"},
          "@type": {"type": "string"},
          "id": {"type": "integer"},
          "name": {"type": "string"}
        },
        "required": ["@id", "@type", "id", "name"],
        "additionalProperties":false
      },
      "minItems":1
    }
  },
  "required":[
    "@context",
    "@id",
    "@type",
    "hydra:member"
  ]
}
