{
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {"pattern": "^/sales/competitor_pricings/\\d+$"},
    "@type": {
      "type": "string"
    },
    "id": {
      "type": "integer"
    },
    "forecastClosure": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "properties": {
            "@id": {"pattern": "^/sales/forecast_closures/\\d+$"},
            "@type": {
              "type": "string"
            },
            "legacyId": {
              "type": "integer"
            },
            "salesForecast": {
              "type": "object",
              "properties": {
                "@id": {"pattern": "^/sales/sales_forecasts/\\d+$"},
                "@type": {
                  "type": "string"
                },
                "legacyId": {
                  "type": "integer"
                },
                "sso": {
                  "$ref": "../../../directory_location/schemas/directory_location_public.json"
                },
                "factory": {
                  "$ref": "../../../directory_location/schemas/directory_location_public.json"
                },
                "asm": {
                  "$ref": "../../../directory_people/schemas/directory_people_public.json"
                },
                "buyer": {
                  "type": "object",
                  "properties": {
                    "@id": {"pattern": "^/sales/customers/\\d+$"},
                    "@type": {
                      "type": "string"
                    },
                    "legacyId": {
                      "type": "integer"
                    },
                    "name": {
                      "type": "string"
                    },
                    "country": {
                      "oneOf": [
                        {"type": "null"},
                        {
                          "type": "object",
                          "properties": {
                            "name": {"type": "string"}
                          },
                          "required": ["name"]
                        }
                      ]
                    }
                  },
                  "required": [
                    "@id",
                    "@type",
                    "legacyId",
                    "name",
                    "country"
                  ],
                  "additionalProperties": false
                },
                "endUser": {
                  "type": "object",
                  "properties": {
                    "@id": {"pattern": "^/sales/customers/\\d+$"},
                    "@type": {
                      "type": "string"
                    },
                    "legacyId": {
                      "type": "integer"
                    },
                    "name": {
                      "type": "string"
                    },
                    "country": {
                      "oneOf": [
                        {"type": "null"},
                        {
                          "type": "object",
                          "properties": {
                            "name": {"type": "string"}
                          },
                          "required": ["name"]
                        }
                      ]
                    }
                  },
                  "required": [
                    "@id",
                    "@type",
                    "legacyId",
                    "name",
                    "country"
                  ],
                  "additionalProperties": false
                },
                "product": {
                  "$ref": "../../../sales/product/schemas/product_public.json"
                },
                "quantity": {
                  "type": "integer"
                },
                "estimatedSaleDate": {
                  "type": "string"
                },
                "equoteId": {
                  "type": ["string", "null"]
                },
                "createdAt": {
                  "type": "string"
                },
                "closedAt": {
                  "type": ["string", "null"]
                },
                "status": {
                  "type": "string"
                }
              },
              "required": [
                "@id",
                "@type",
                "legacyId",
                "sso",
                "factory",
                "asm",
                "buyer",
                "endUser",
                "product",
                "quantity",
                "estimatedSaleDate",
                "equoteId",
                "createdAt",
                "closedAt",
                "status"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "@id",
            "@type",
            "legacyId",
            "salesForecast"
          ],
          "additionalProperties": false
        }
      ]
    },
    "quotationDate": {
      "type": "string"
    },
    "competitor": {
      "type": "object",
      "properties": {
        "@id": {"pattern": "^/sales/competitors/\\d+$"},
        "@type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "legacyId": {
          "type": "integer"
        }
      },
      "required": [
        "@id",
        "@type",
        "name",
        "legacyId"
      ],
      "additionalProperties": false
    },
    "competitorModel": {
      "type": ["string", "null"]
    },
    "competitorOptions": {
      "type": ["string", "null"]
    },
    "quantity": {
      "type": ["number", "null"]
    },
    "price": {
      "type": ["number", "null"]
    },
    "currency": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "../../../finance_currency/schemas/currency.json"}
      ]
    },
    "exchangeRate": {
      "type": ["number", "null"]
    },
    "incoterm": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "properties": {
            "@id": {"pattern": "^/sales/incoterms/\\d+$"},
            "@type": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "code": {
              "type": "string"
            }
          },
          "required": [
            "@id",
            "@type",
            "description",
            "code"
          ],
          "additionalProperties": false
        }
      ]
    },
    "incotermsLocation": {
      "type": ["string", "null"]
    },
    "markupPercentage": {
      "type": ["integer", "null"]
    },
    "competitorPricingFiles": {
      "type": "array"
    },
    "legacyId": {
      "type": "integer"
    },
    "createdAt": {
      "type": "string"
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "forecastClosure",
    "quotationDate",
    "competitor",
    "competitorModel",
    "competitorOptions",
    "quantity",
    "price",
    "currency",
    "exchangeRate",
    "incoterm",
    "incotermsLocation",
    "markupPercentage",
    "legacyId",
    "createdAt"
  ],
  "additionalProperties": false
}
