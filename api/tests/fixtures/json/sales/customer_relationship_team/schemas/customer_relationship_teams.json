{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/sales/customer_relationship_teams$"},
    "hydra:member": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "properties": {
          "@id": {"pattern": "^/sales/customer_relationship_teams/\\d+$"},
          "@type": {
            "type": "string"
          },
          "customerBusinessPartnerCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "customer": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "@id": {"pattern": "^/sales/customers/\\d+$"},
                  "@type": {
                    "type": "string"
                  },
                  "legacyId": {
                    "type": "integer"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "@id",
                  "@type",
                  "legacyId",
                  "name"
                ],
                "type": "object"
              }
            ]
          },
          "erpLocation": {
            "oneOf": [
              {"type": "null"},
              { "$ref": "../../../directory_location/schemas/directory_location_public.json" }
            ]
          },
          "id": {
            "type": "integer"
          },
          "legacyId": {
            "type": "integer"
          },
          "partsLocation": {
            "oneOf": [
              {"type": "null"},
              { "$ref": "../../../directory_location/schemas/directory_location_public.json" }
            ]
          },
          "partsRepresentative": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "../../../directory_people/schemas/directory_people_public.json"}
            ]
          },
          "salesRepresentative": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "../../../directory_people/schemas/directory_people_public.json"}
            ]
          },
          "serviceLocation": {
            "oneOf": [
              {"type": "null"},
              { "$ref": "../../../directory_location/schemas/directory_location_public.json" }
            ]
          },
          "serviceRepresentative": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "../../../directory_people/schemas/directory_people_public.json"}
            ]
          }
        },
        "required": [
          "customer",
          "serviceLocation",
          "customerBusinessPartnerCode",
          "erpLocation",
          "partsRepresentative",
          "id",
          "salesRepresentative",
          "legacyId",
          "partsLocation",
          "serviceRepresentative",
          "@id",
          "@type"
        ],
        "type": "object"
      },
      "minItems": 1
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:totalItems",
    "hydra:member",
    "hydra:search"
  ]
}
