{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {"pattern": "^/sales/sales_forecasts/\\d+(|/status|/unlink)$"},
    "@type": {
      "type": "string"
    },
    "id": {
      "type": "integer"
    },
    "masterSalesForecast": {
      "type": "object",
      "properties": {
        "@id": {"pattern": "^/sales/master_sales_forecasts/\\d+$"},
        "@type": {
          "type": "string"
        },
        "legacyId": {
          "type": "integer"
        }
      },
      "required": [
        "@id",
        "@type",
        "legacyId"
      ],
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string"
    },
    "lastCommentedAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": ["null", "string"]
    },
    "closedAt": {
      "type": ["null", "string"]
    },
    "status": {
      "type": "string"
    },
    "lastComment": {
      "type": ["null", "string"]
    },
    "sso": {
      "$ref": "../../../directory_location/schemas/directory_location_public_network_currency.json"
    },
    "factory": {
      "$ref": "../../../directory_location/schemas/directory_location_public_network_currency.json"
    },
    "asm": {
      "$ref": "../../../directory_people/schemas/directory_people_public.json"
    },
    "poster": {
      "$ref": "../../../directory_people/schemas/directory_people_public.json"
    },
    "equoteId": {
      "type": ["string", "null"]
    },
    "buyer": {
      "type": ["object", "null"],
      "properties": {
        "@id": {"pattern": "^/sales/customers/\\d+$"},
        "@type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "legacyId": {
          "type": "integer"
        },
        "country": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "properties": {
                "name": {"type": "string"}
              },
              "required": ["name"]
            }
          ]
        },
        "watchList": {
          "type" : "boolean"
        },
        "watchListReason": {
          "type": ["string", "null"]
        }
      },
      "required": [
        "@id",
        "@type",
        "name",
        "legacyId",
        "country",
        "watchList",
        "watchListReason"
      ],
      "additionalProperties": false
    },
    "endUser": {
      "type": ["object", "null"],
      "properties": {
        "@id": {"pattern": "^/sales/customers/\\d+$"},
        "@type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "legacyId": {
          "type": "integer"
        },
        "country": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "properties": {
                "name": {"type": "string"}
              },
              "required": ["name"]
            }
          ]
        },
        "watchList": {
          "type" : "boolean"
        },
        "watchListReason": {
          "type": ["string", "null"]
        }
      },
      "required": [
        "@id",
        "@type",
        "name",
        "legacyId",
        "country",
        "watchList",
        "watchListReason"
      ],
      "additionalProperties": false
    },
    "thirdParty": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "properties": {
            "@id": {"pattern": "^/sales/customers/\\d+$"},
            "@type": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "legacyId": {
              "type": "integer"
            },
            "country": {
              "oneOf": [
                {"type": "null"},
                {
                  "type": "object",
                  "properties": {
                    "name": {"type": "string"}
                  },
                  "required": ["name"]
                }
              ]
            }
          },
          "required": [
            "@id",
            "@type",
            "name",
            "country",
            "legacyId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "country": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "properties": {
            "@id": {"pattern": "^/countries/\\d+$"},
            "@type": {
              "type": "string"
            },
            "id": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "legacyId": {
              "type": "integer"
            }
          },
          "required": [
            "@id",
            "@type",
            "id",
            "name",
            "legacyId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "airport": {
      "oneOf": [
        {"type": "null"},
        { "$ref": "../../../iata_code/schemas/iata_code.json" }
      ]
    },
    "product": {
      "type": "object",
      "properties": {
        "@id": {"pattern": "^/sales/products/\\d+$"},
        "@type": {
          "type": "string"
        },
        "family": {
          "type": "object",
          "@id": {"pattern": "^/sales/product_families/\\d+$"},
          "@type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "legacyId": {
            "type": "integer"
          }
        },
        "name": {
          "type": "string"
        },
        "legacyId": {
          "type": "integer"
        }
      },
      "required": [
        "@id",
        "@type",
        "name",
        "legacyId"
      ],
      "additionalProperties": false
    },
    "quantity": {
      "type": "integer"
    },
    "estimatedSaleDate": {
      "type": "string"
    },
    "customerSuccessPercentage": {
      "type": "integer"
    },
    "successPercentage": {
      "type": "integer"
    },
    "tier": {
      "type": "object",
      "properties": {
        "@id": {"pattern": "^/emission_ratings/\\d+$"},
        "@type": {
          "type": "string"
        },
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "legacyId": {
          "type": "integer"
        }
      },
      "required": [
        "@id",
        "@type",
        "id",
        "name",
        "legacyId"
      ],
      "additionalProperties": false
    },
    "delinquent": {
      "type": "boolean"
    },
    "salesForecastFiles": {
      "type": "array",
      "uniqueItems": true
    },
    "forecastClosures": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "@id": {"pattern": "^/sales/forecast_closures/\\d+$"},
          "@type": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          },
          "orderedQuantity": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string"
          },
          "poster": {
            "$ref": "../../../directory_people/schemas/directory_people_public.json"
          },
          "legacyId": {
            "type": "integer"
          },
          "reason": {
            "type": "string"
          },
          "competitor": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "../../competitor/schemas/competitor_public.json"}
            ]
          },
          "competitorPricings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "@id": {"pattern": "^/sales/competitor_pricings/\\d+$"},
                "@type": {
                  "type": "string"
                },
                "id": {
                  "type": "integer"
                },
                "quotationDate": {
                  "type": "string"
                },
                "competitor": {
                  "type": "object",
                  "properties": {
                    "@id": {"pattern": "^/sales/competitors/\\d+$"},
                    "@type": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "legacyId": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "@id",
                    "@type",
                    "name",
                    "legacyId"
                  ],
                  "additionalProperties": false
                },
                "quantity": {
                  "type": ["integer", "null"]
                },
                "price": {
                  "type": ["number", "null"]
                },
                "currency": {
                  "oneOf": [
                    {"type": "null"},
                    {"$ref": "../../../finance_currency/schemas/currency.json"}
                  ]
                },
                "competitorModel": {
                  "type": ["string", "null"]
                },
                "incoterm": {
                  "oneOf": [
                    {"type": "null"},
                    {
                      "type": "object",
                      "properties": {
                        "@id": {"pattern": "^/sales/incoterms/\\d+$"},
                        "@type": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "code": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "@id",
                        "@type",
                        "description",
                        "code"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "markupPercentage": {
                  "type": ["integer", "null"]
                },
                "legacyId": {
                  "type": "integer"
                }
              },
              "required": [
                "@id",
                "@type",
                "quotationDate",
                "competitor",
                "quantity",
                "price",
                "currency",
                "competitorModel",
                "incoterm",
                "markupPercentage",
                "legacyId"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "@id",
          "@type",
          "status",
          "orderedQuantity",
          "createdAt",
          "poster",
          "reason",
          "competitor",
          "legacyId",
          "competitorPricings"
        ],
        "additionalProperties": false
      }
    },
    "quote": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "../../quotes/schemas/quote_light.json" }
      ]
    },
    "legacyId": {
      "type": "integer"
    },
    "price": {
      "type": ["integer", "null"]
    },
    "margin": {
      "type": ["number", "null"]
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "masterSalesForecast",
    "createdAt",
    "updatedAt",
    "closedAt",
    "status",
    "lastComment",
    "lastCommentedAt",
    "sso",
    "factory",
    "asm",
    "poster",
    "equoteId",
    "buyer",
    "endUser",
    "thirdParty",
    "country",
    "airport",
    "product",
    "quantity",
    "estimatedSaleDate",
    "customerSuccessPercentage",
    "successPercentage",
    "tier",
    "delinquent",
    "salesForecastFiles",
    "forecastClosures",
    "quote",
    "legacyId"
  ],
  "additionalProperties": false
}
