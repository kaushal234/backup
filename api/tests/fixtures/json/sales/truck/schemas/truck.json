{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {"pattern": "^/sales/trucks/\\d+$"},
    "@type": {
      "type": "string"
    },
    "id": {
      "type": "integer"
    },
    "quantity": {
      "type": "integer"
    },
    "truckType": {
      "type": "object",
      "properties": {
        "@id": {"pattern": "^/sales/truck_types/\\d+$"},
        "@type": {
          "type": "string"
        },
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "@id",
        "@type",
        "id",
        "name"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "@id",
    "@type",
    "id",
    "truckType"
  ],
  "additionalProperties": false
}
