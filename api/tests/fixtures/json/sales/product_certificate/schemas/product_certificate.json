{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {"pattern": "^/sales/product_certificates/\\d+$"},
    "@type": {
      "type": "string"
    },
    "id": {
      "type": "integer"
    },
    "product": {
      "type": "object",
      "properties": {
        "@id": {"pattern": "^/sales/products/\\d+$"},
        "@type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "family": {
          "type": "object",
          "properties": {
            "@id": {"pattern": "^/sales/product_families/\\d+$"},
            "@type": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "productType": {
              "type": "object",
              "properties": {
                "@id": {"pattern": "^/sales/product_types/\\d+$"},
                "@type": {
                  "type": "string"
                },
                "englishName": {
                  "type": "string"
                }
              },
              "required": [
                "@id",
                "@type",
                "englishName"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "@id",
            "@type",
            "name",
            "productType"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "@id",
        "@type",
        "name",
        "family"
      ],
      "additionalProperties": false
    },
    "factory": {
      "type": "object",
      "properties": {
        "@id": {"pattern": "^/locations/\\d+$"},
        "@type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "erp": {
          "type": ["integer", "null"]
        }
      },
      "required": [
        "@id",
        "@type",
        "name",
        "erp"
      ],
      "additionalProperties": false
    },
    "emissionRating": {
      "oneOf": [
        { "type": "null"},
        {
          "type": "object",
          "properties": {
            "@id": {"pattern": "^/emission_ratings/\\d+$"},
            "@type": {
              "type": "string"
            },
            "id": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "@id",
            "@type",
            "id",
            "name"
          ],
          "additionalProperties": false
        }
      ]
    },
    "engineeringActivityProcess": {
      "type": ["integer", "null"]
    },
    "url": {
      "type": ["string", "null"]
    },
    "testReportNumber": {
      "type": ["string", "null"]
    },
    "expectedAt": {
      "type": ["string", "null"]
    },
    "expiredAt": {
      "type": ["string", "null"]
    },
    "description": {
      "type": ["string", "null"]
    },
    "announcementCertificateNumber": {
      "type": ["string", "null"]
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "../../../shared/schemas/file.json"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "id",
    "product",
    "factory",
    "emissionRating",
    "engineeringActivityProcess",
    "url",
    "testReportNumber",
    "expectedAt",
    "expiredAt",
    "description",
    "announcementCertificateNumber",
    "files"
  ],
  "additionalProperties": false
}
