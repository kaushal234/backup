{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {"pattern": "^/sales/aircrafts/\\d+$"},
    "@type": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "id": {
      "type": "integer"
    },
    "manufacturer": {
      "type": "object",
      "properties": {
        "@id": {"pattern": "^/sales/manufacturers/\\d+$"},
        "@type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "id": {
          "type": "integer"
        }
      },
      "required": ["@id", "@type", "name", "id"],
      "additionalProperties": false
    }
  },
  "required": [
    "@id",
    "@type",
    "id",
    "name"
  ],
  "additionalProperties": false
}
