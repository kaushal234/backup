{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
      "type": "string"
    },
    "@id": {"pattern": "^/minutes_of_meeting/meetings$"},
    "@type": {
      "type": "string"
    },
    "hydra:member": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@id": {
            "pattern": "^/minutes_of_meeting/meetings/\\d+$"
          },
          "@type": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "quick": {
            "type": "boolean"
          },
          "createdBy": {
            "$ref": "../../directory_people/schemas/directory_people_public.json"
          },
          "createdAt": {
            "type": "string"
          },
          "meetingDate": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "@id",
        "@type",
        "status",
        "title",
        "quick",
        "createdBy",
        "createdAt",
        "meetingDate"
      ]
    },
    "uniqueItems": true,
    "minItems": 1
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "hydra:member"
  ]
}

