{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@id": {"pattern": "^/minutes_of_meeting/contacts/\\d+$"},
    "@type": {"type": "string"},
    "@context": {"type": "string"},
    "id": {"type": "integer"},
    "firstName": {"type": "string"},
    "lastName": {"type": "string"},
    "phone": {"type": "string"},
    "mail": {"type": "string"},
    "company": {"type": "string"},
    "createdAt": {"type": "string"},
    "meeting": {"pattern": "^/minutes_of_meeting/meetings/\\d+$"}
  },
  "additionalProperties": false,
  "required": [
    "@id",
    "@type",
    "@context",
    "id",
    "firstName",
    "lastName",
    "createdAt",
    "company",
    "meeting"
  ]
}
