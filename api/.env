# Snowflake SQL API (SVC_INTRANET_PRD service account)
# Database/schema/role are NOT set here: they depend on the data being
# queried and are configured per provider instead (see
# App\Snowflake\QueryBuilder::useConnection() / documentation/snowflake-integration.md).
SNOWFLAKE_API_BASE_URL=https://<account_identifier>.snowflakecomputing.com/api/v2/
SNOWFLAKE_TOKEN=
SNOWFLAKE_WAREHOUSE=QUERY_WH