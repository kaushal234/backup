{
  "name": "alvest/dms",
  "description": "The Alvest DMS portal",
  "require": {
    "php": ">=8.3.0",
    "symfony/http-client": "^7.4.16",
    "symfony/dotenv": "^7.4.15",
    "lcobucci/jwt": "^4.3",
    "monolog/monolog": "^2.11.0",
    "symfony/mime": "^7.4.16",
    "symfony/http-foundation": "^7.4.16",
    "symfony/routing": "^7.4.15"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95.11",
    "php-parallel-lint/php-var-dump-check": "^0.5.0",
    "phpstan/phpstan": "^1.12.33",
    "symfony/var-dumper": "^7.4.15",
    "phpunit/phpunit": "^9.6.34",
    "phpspec/prophecy": "^1.26.1"
  },
  "config": {
    "preferred-install": {
      "*": "dist"
    },
    "bump-after-update": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src"
    }
  },
  "scripts": {
    "cs": "php-cs-fixer fix --no-interaction --config=.php-cs-fixer.php --cache-file .php-cs-fixer.cache",
    "cs-check": "php-cs-fixer fix --dry-run --diff --using-cache=no --config=.php-cs-fixer.php"
  }
}
